{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "dotnet",
      "task": "build --configuration=Release",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Build the solution in Release"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "FAForever.sln",
        "--nologo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Run every test project once"
    },
    {
      "label": "test: watch",
      "type": "process",
      "command": "dotnet",
      "args": [
        "watch",
        "test",
        "--nologo"
      ],
      "options": {
        "cwd": "${workspaceFolder}/tests/FAForever.FileFormats.Replay.Tests"
      },
      "isBackground": true,
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Re-run the replay tests on every file change (dotnet watch takes one project)"
    },
    {
      "label": "benchmark",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--configuration=Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}/benchmarks/FAForever.FileFormats.Replay.Benchmarks"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Run all BenchmarkDotNet benchmarks (Release, takes several minutes)"
    },
    {
      "label": "viewer",
      "type": "process",
      "command": "dotnet",
      "args": [
        "watch"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/FAForever.Vault.Viewer",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$msCompile",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\s*(dotnet watch|Building|info: Microsoft\\.Hosting\\.Lifetime)",
          "endsPattern": "(Now listening on|Application started)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Serve the Blazor WASM viewer with hot reload"
    },
    {
      "label": "viewer: build (Release)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "--configuration=Release",
        "--output=release",
        "--nologo"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/FAForever.Vault.Viewer"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Publish the standalone viewer (without the server) to src/FAForever.Vault.Viewer/release"
    },
    {
      "label": "server",
      "type": "process",
      "command": "dotnet",
      "args": [
        "watch"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/FAForever.Vault.Server",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$msCompile",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\s*(dotnet watch|Building|info: Microsoft\\.Hosting\\.Lifetime)",
          "endsPattern": "(Now listening on|Application started)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Serve the hosted app (WASM + token proxy) on http://127.0.0.1:5080 with hot reload"
    },
    {
      "label": "tailwind: watch",
      "type": "process",
      "command": "${workspaceFolder}/tools/tailwindcss.exe",
      "args": [
        "-i",
        "Styles/app.css",
        "-o",
        "wwwroot/css/app.css",
        "--watch"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/FAForever.Vault.Viewer"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "detail": "Rebuild wwwroot/css/app.css on every change (run next to 'server' or 'viewer')"
    },
    {
      "label": "editor",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/FAForever.MapEditor.App",
        "--",
        "--automation",
        "5371"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Start the map editor, with automation on port 5371 (faf-map editor <command>)"
    },
    {
      "label": "editor: open a map",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/FAForever.MapEditor.App",
        "--",
        "${input:editorFolder}",
        "--automation",
        "5371"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Start the map editor with a project or a map folder of the game, with automation on port 5371"
    }
  ],
  "inputs": [
    {
      "id": "editorFolder",
      "type": "promptString",
      "description": "A project folder, or a map folder of the game to import",
      "default": "tests/FAForever.FileFormats.Map.Tests/assets/maps/theta_passage_-_faf_version.v0001"
    }
  ]
}
