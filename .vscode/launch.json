{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Server (hosted app)",
            "type": "coreclr",
            "request": "launch",
            "program": "dotnet",
            "args": [
                "watch"
            ],
            "cwd": "${workspaceFolder}/src/FAForever.Vault.Server",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\bNow listening on:\\s+(https?://\\S+)"
            },
            "preLaunchTask": "build"
        },
        {
            "name": "Viewer",
            "type": "coreclr",
            "request": "launch",
            "program": "dotnet",
            "args": [
                "watch"
            ],
            "cwd": "${workspaceFolder}/src/FAForever.Vault.Viewer",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "preLaunchTask": "build"
        },
        {
            "name": "Test",
            "type": "coreclr",
            "request": "launch",
            "program": "dotnet",
            "args": [
                "watch",
                "test"
            ],
            "cwd": "${workspaceFolder}/tests/FAForever.FileFormats.Replay.Tests",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "preLaunchTask": "build"
        },
        {
            "name": "Benchmarks",
            "type": "coreclr",
            "request": "launch",
            "program": "dotnet",
            "args": [
                "run",
                "--configuration=Release"
            ],
            "cwd": "${workspaceFolder}/benchmarks/FAForever.FileFormats.Replay.Benchmarks",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "preLaunchTask": "build"
        }
    ]
}
