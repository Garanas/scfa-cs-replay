@using System.Globalization
@* One bar cut into parts (2 px apart), each as wide as its share of the total, with a legend that
   names every part with its count and share. BarRows cannot cut a bar in more than a value and
   a pale rest, so the split between custom and matchmaker games has its own. *@
<div role="img" aria-label="@AriaLabel">
    @if (total > 0)
    {
        <div class="flex h-[18px] gap-0.5">
            @foreach (StackedSegment segment in Segments.Where(segment => segment.Value > 0))
            {
                <div class="h-full min-w-px first:rounded-l-[4px] last:rounded-r-[4px] @ChartColors.Bg(segment.Color)" style="width:@Share(segment.Value)%" title="@Text(segment)"></div>
            }
        </div>
        <div class="mt-3">
            <Legend Items="legend" />
        </div>
    }
    else
    {
        <p class="text-sm text-ink-muted">No games yet.</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<StackedSegment> Segments { get; set; }

    [Parameter] public string AriaLabel { get; set; } = "Split";

    private long total;
    private IReadOnlyList<LegendItem> legend = [];

    protected override void OnParametersSet()
    {
        total = Segments.Sum(segment => segment.Value);
        legend = [.. Segments.Select(segment => new LegendItem(Text(segment), segment.Color))];
    }

    private string Share(long value) => (total <= 0 ? 0 : (double)value / total * 100).ToString("0.##", CultureInfo.InvariantCulture);

    private string Text(StackedSegment segment)
        => $"{segment.Label}, {segment.Value.ToString("N0", CultureInfo.InvariantCulture)} ({(int)Math.Round(100.0 * segment.Value / Math.Max(total, 1))}%)";
}
