@using FAForever.Vault.Viewer.Services.Players
@* The other players of a game in the table: a label ("With", "Against") and their names as profile
   links with their ratings; at most MaxShown names, then how many more. An AI army has no profile. *@
@if (Players.Count > 0)
{
    <p class="text-xs">
        <span class="text-ink-faint">@Label</span>
        @for (int i = 0; i < Math.Min(Players.Count, MaxShown); i++)
        {
            MatchParticipant player = Players[i];
            @(i == 0 ? " " : ", ")
            @if (player.IsAi)
            {
                <span class="text-ink-muted">@player.Login</span>
            }
            else
            {
                <a href="@PlayerLinks.Profile(player.PlayerId)" class="text-ink transition hover:text-primary max-sm:inline-flex max-sm:min-h-11 max-sm:items-center">@player.Login</a>
            }
            @if (player.Rating is { } rating)
            {
                @(" ")<span class="text-ink-faint">(@MatchFormat.Count(rating))</span>
            }
        }
        @if (Players.Count > MaxShown)
        {
            @(" ")<span class="text-ink-faint">and @(Players.Count - MaxShown) more</span>
        }
    </p>
}

@code {
    [Parameter, EditorRequired] public required string Label { get; set; }

    [Parameter, EditorRequired] public required IReadOnlyList<MatchParticipant> Players { get; set; }

    [Parameter] public int MaxShown { get; set; } = 3;
}
