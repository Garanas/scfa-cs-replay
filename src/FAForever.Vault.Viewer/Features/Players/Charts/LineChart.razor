@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS

@* A line over time, drawn in an SVG of its real pixel width (a ResizeObserver reports the width, so
   text keeps its size at every width; the labels are HTML placed over the SVG). Rules: hairline solid
   gridlines at clean steps, a 2 px line, an optional wash of the same colour at 10 % opacity, the last
   value labelled at the end, one marked point (the peak), and a crosshair that snaps to the nearest
   point on pointer move or with the arrow keys, with a tooltip. A second line (the other player),
   vertical marks (games between the two) and a second, smaller panel on the same time axis (the
   rating's uncertainty) are optional. Step makes the line a staircase (the league journey). Text
   never wears the series colour. *@
<div class="w-full">
    @if (Other is not null)
    {
        <div class="mb-2">
            <Legend Items="legend" />
        </div>
    }
    <div @ref="host" class="relative w-full">
        <svg width="@W" height="@totalHeight" viewBox="0 0 @W @totalHeight" class="block max-w-full" role="img" aria-label="@AriaLabel">
            @foreach ((double y, string label) in yTicks)
            {
                <line x1="@Ml" x2="@(W - Mr)" y1="@F(y)" y2="@F(y)" stroke-width="1" class="stroke-edge" />
            }
            @if (Panel is { Count: > 0 })
            {
                @foreach ((double y, string label) in panelTicks)
                {
                    <line x1="@Ml" x2="@(W - Mr)" y1="@F(y)" y2="@F(y)" stroke-width="1" class="stroke-edge" />
                }
            }

            @* The time axis: a baseline and a tick per month (or per few days). *@
            <line x1="@Ml" x2="@(W - Mr)" y1="@F(axisY)" y2="@F(axisY)" stroke-width="1" class="stroke-edge" />
            @foreach ((double x, string label) in xTicks)
            {
                <line x1="@F(x)" x2="@F(x)" y1="@F(axisY)" y2="@F(axisY + 4)" stroke-width="1" class="stroke-edge" />
            }

            @if (VerticalMarks is not null)
            {
                @foreach (DateTimeOffset mark in VerticalMarks)
                {
                    <line x1="@F(X(mark))" x2="@F(X(mark))" y1="@F(Mt)" y2="@F(mainBottom)" stroke-width="1" stroke-dasharray="2 3" class="stroke-ink-faint" />
                }
            }

            @if (areaPath.Length > 0)
            {
                <path d="@areaPath" fill-opacity="0.1" stroke="none" class="@ChartColors.Fill(Color)" />
            }
            @if (otherPath.Length > 0)
            {
                <path d="@otherPath" fill="none" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" class="@ChartColors.Stroke(OtherColor)" />
            }
            @if (linePath.Length > 0)
            {
                <path d="@linePath" fill="none" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" class="@ChartColors.Stroke(Color)" />
            }
            @if (panelPath.Length > 0)
            {
                <path d="@panelPath" fill="none" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" class="@ChartColors.Stroke(PanelColor)" />
            }

            @if (Points.Count > 0)
            {
                LinePoint last = Points[^1];
                <circle cx="@F(X(last.Time))" cy="@F(Y(last.Value))" r="4" class="@ChartColors.Fill(Color) stroke-surface" stroke-width="2" />
            }
            @if (Marked is not null)
            {
                <circle cx="@F(X(Marked.Time))" cy="@F(Y(Marked.Value))" r="4.5" stroke-width="2" class="fill-surface @ChartColors.Stroke(Color)" />
            }

            @if (hover is int h && h < Points.Count)
            {
                LinePoint point = Points[h];
                double hx = X(point.Time);
                <line x1="@F(hx)" x2="@F(hx)" y1="@F(Mt)" y2="@F(axisY)" stroke-width="1" class="stroke-ink-muted" />
                <circle cx="@F(hx)" cy="@F(Y(point.Value))" r="5" stroke-width="2" class="@ChartColors.Fill(Color) stroke-surface" />
                @if (NearestOther(point.Time) is { } otherPoint)
                {
                    <circle cx="@F(X(otherPoint.Time))" cy="@F(Y(otherPoint.Value))" r="5" stroke-width="2" class="@ChartColors.Fill(OtherColor) stroke-surface" />
                }
                @if (Panel is { Count: > 0 } && Nearest(Panel, point.Time) is { } panelPoint)
                {
                    <circle cx="@F(X(panelPoint.Time))" cy="@F(PanelY(panelPoint.Value))" r="4" stroke-width="2" class="@ChartColors.Fill(PanelColor) stroke-surface" />
                }
            }
        </svg>

        @* The text, in HTML over the SVG: axis labels, the end label, the marked point's label. *@
        <div class="pointer-events-none absolute inset-0 text-[11px] leading-none text-ink-faint" aria-hidden="true">
            @foreach ((double y, string label) in yTicks)
            {
                <span class="absolute whitespace-nowrap text-right tabular-nums" style="left:0;width:@(Ml - 8)px;top:@F(y - 5.5)px">@label</span>
            }
            @if (Panel is { Count: > 0 })
            {
                @foreach ((double y, string label) in panelTicks)
                {
                    <span class="absolute whitespace-nowrap text-right tabular-nums" style="left:0;width:@(Ml - 8)px;top:@F(y - 5.5)px">@label</span>
                }
                @if (PanelLabel is { Length: > 0 })
                {
                    <span class="absolute whitespace-nowrap text-ink-muted" style="left:@(Ml)px;top:@F(panelTop - 20)px">@PanelLabel</span>
                }
            }
            @foreach ((double x, string label) in xTicks)
            {
                <span class="absolute whitespace-nowrap text-center tabular-nums" style="left:@F(x - 32)px;width:64px;top:@F(axisY + 10)px">@label</span>
            }
            @if (Points.Count > 0 && ShowEndLabel)
            {
                LinePoint last = Points[^1];
                <span class="absolute whitespace-nowrap text-right text-xs font-semibold text-ink" style="right:@F(Math.Max(0, W - X(last.Time)))px;top:@F(Y(last.Value) - 26)px">@Format(last.Value)</span>
            }
            @if (Marked is not null && MarkedLabel is { Length: > 0 })
            {
                <span class="absolute w-20 whitespace-nowrap text-center text-ink-muted" style="left:@F(Math.Clamp(X(Marked.Time), Ml + 40, W - Mr - 40) - 40)px;top:@F(Y(Marked.Value) - 22)px">@MarkedLabel</span>
            }
        </div>

        @* The surface that listens: HTML over the plot, so the pointer's offset is in plot pixels. *@
        @if (Points.Count > 0)
        {
            <div class="absolute cursor-crosshair touch-pan-y rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                 style="left:@(Ml)px;top:@(Mt)px;width:@F(plotW)px;height:@F(axisY - Mt)px"
                 tabindex="0" role="group" aria-label="@AriaLabel. Use the left and right arrow keys to inspect the points."
                 @onpointermove="OnPointerMove" @onpointerdown="OnPointerMove" @onpointerleave="Clear"
                 @onkeydown="OnKeyDown" @onfocus="OnFocus" @onblur="Clear"></div>
        }

        @if (hover is int index && index < Points.Count)
        {
            LinePoint point = Points[index];
            double tx = X(point.Time);
            bool flip = tx > W * 0.58;
            <div class="pointer-events-none absolute z-10 w-max max-w-[min(15rem,70%)] rounded-md border border-edge bg-raised px-3 py-2 text-xs shadow-lg"
                 style="top:@(Mt + 4)px;@(flip ? $"right:{F(W - tx + 12)}px" : $"left:{F(tx + 12)}px")">
                @if (Tooltip is not null)
                {
                    @Tooltip(point)
                }
                else
                {
                    <p class="text-ink-muted">@TimeText(point.Time)</p>
                    <p class="mt-0.5 text-base font-semibold text-ink">@Format(point.Value)</p>
                    @if (NearestOther(point.Time) is { } other)
                    {
                        <p class="mt-0.5 text-ink-muted">@OtherName @Format(other.Value)</p>
                    }
                }
            </div>
            <span class="sr-only" aria-live="polite">@TimeText(point.Time), @Format(point.Value)</span>
        }
    </div>
</div>

@code {
    private int Ml => LeftMargin;
    private const int Mr = 16;
    private const int Mt = 16;
    private const int AxisHeight = 26;
    private const int PanelGap = 30;

    /// <summary>The points, oldest first.</summary>
    [Parameter, EditorRequired] public required IReadOnlyList<LinePoint> Points { get; set; }

    /// <summary>The series' name, for the legend and the label of the chart.</summary>
    [Parameter] public string Name { get; set; } = "Rating";

    [Parameter] public ChartColor Color { get; set; } = ChartColor.Primary;

    /// <summary>A second series on the same scales (a legend appears).</summary>
    [Parameter] public IReadOnlyList<LinePoint>? Other { get; set; }

    [Parameter] public string OtherName { get; set; } = "Other";

    [Parameter] public ChartColor OtherColor { get; set; } = ChartColor.Viz2;

    /// <summary>A wash under the line, in the line's colour at 10 % opacity.</summary>
    [Parameter] public bool Area { get; set; }

    /// <summary>A staircase: the value holds until the next point (the league journey).</summary>
    [Parameter] public bool Step { get; set; }

    /// <summary>The point marked with a ring and <see cref="MarkedLabel"/> (the peak).</summary>
    [Parameter] public LinePoint? Marked { get; set; }

    [Parameter] public string? MarkedLabel { get; set; }

    [Parameter] public bool ShowEndLabel { get; set; } = true;

    /// <summary>Moments drawn as faint dashed verticals (games between two players).</summary>
    [Parameter] public IReadOnlyList<DateTimeOffset>? VerticalMarks { get; set; }

    /// <summary>The height of the main plot with its axis, in pixels; a panel adds to it.</summary>
    [Parameter] public int Height { get; set; } = 260;

    /// <summary>The distance between the lines of the value axis; default 10, 20, 50, 100, ... as the range needs.</summary>
    [Parameter] public double? YStep { get; set; }

    /// <summary>The value as text on the axis, the end label and the tooltip; default a rounded number.</summary>
    [Parameter] public Func<double, string>? ValueFormat { get; set; }

    /// <summary>The content of the tooltip for the point the crosshair is on; default the date and the value.</summary>
    [Parameter] public RenderFragment<LinePoint>? Tooltip { get; set; }

    /// <summary>A second, smaller panel under the chart on the same time axis (σ).</summary>
    [Parameter] public IReadOnlyList<LinePoint>? Panel { get; set; }

    [Parameter] public string? PanelLabel { get; set; }

    [Parameter] public int PanelHeight { get; set; } = 84;

    [Parameter] public ChartColor PanelColor { get; set; } = ChartColor.Viz7;

    [Parameter] public string AriaLabel { get; set; } = "Line chart";

    /// <summary>
    /// For a series whose x is a count (the game number) rather than a date: the time is that many
    /// seconds after the Unix epoch, the axis ticks fall on round counts, and this turns a time into
    /// its label (tooltip, ticks, screen reader text). Null draws a date axis.
    /// </summary>
    [Parameter] public Func<DateTimeOffset, string>? XFormat { get; set; }

    /// <summary>The room left of the plot for the y labels, in pixels (wider for labels that are names).</summary>
    [Parameter] public int LeftMargin { get; set; } = 44;

    private ElementReference host;
    private DotNetObjectReference<LineChart>? self;
    private bool observing;
    private double w = 640;
    private int? hover;

    private double plotW;
    private double mainH;
    private double mainBottom;
    private double panelTop;
    private double panelH;
    private double axisY;
    private double totalHeight;
    private DateTimeOffset t0;
    private DateTimeOffset t1;
    private double yMin;
    private double yMax;
    private double pMin;
    private double pMax;
    private string linePath = "";
    private string areaPath = "";
    private string otherPath = "";
    private string panelPath = "";
    private List<(double Y, string Label)> yTicks = [];
    private List<(double Y, string Label)> panelTicks = [];
    private List<(double X, string Label)> xTicks = [];
    private IReadOnlyList<LegendItem> legend = [];

    private double W => w;

    protected override void OnParametersSet()
    {
        hover = null;
        legend = [new LegendItem(Name, Color, LegendKind.Line), new LegendItem(OtherName, OtherColor, LegendKind.Line)];
        Recompute();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        self = DotNetObjectReference.Create(this);
        observing = true;
        double measured = await JS.InvokeAsync<double>("fafReplay.observeWidth", host, self);
        ApplyWidth(measured);
    }

    /// <summary>Called by js/app.js when the chart's container changes width.</summary>
    [JSInvokable]
    public Task OnWidth(double width) => InvokeAsync(() => ApplyWidth(width));

    private void ApplyWidth(double width)
    {
        width = Math.Max(200, Math.Floor(width));
        if (Math.Abs(width - w) < 1)
        {
            return;
        }

        w = width;
        Recompute();
        StateHasChanged();
    }

    private string TimeText(DateTimeOffset time) => XFormat?.Invoke(time) ?? time.ToLocalTime().ToString("d MMM yyyy", CultureInfo.InvariantCulture);

    private string Format(double value) => ValueFormat?.Invoke(value) ?? Math.Round(value).ToString("N0", CultureInfo.InvariantCulture);

    private static string F(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private double X(DateTimeOffset time)
    {
        double span = (t1 - t0).TotalSeconds;
        return span <= 0 ? Ml + plotW / 2 : Ml + (time - t0).TotalSeconds / span * plotW;
    }

    private double Y(double value) => yMax <= yMin ? Mt + mainH / 2 : Mt + (yMax - value) / (yMax - yMin) * mainH;

    private double PanelY(double value) => pMax <= pMin ? panelTop + panelH / 2 : panelTop + (pMax - value) / (pMax - pMin) * panelH;

    private void Recompute()
    {
        linePath = areaPath = otherPath = panelPath = "";
        yTicks = [];
        panelTicks = [];
        xTicks = [];
        bool hasPanel = Panel is { Count: > 0 };
        plotW = Math.Max(40, w - Ml - Mr);
        if (hasPanel)
        {
            mainH = Height - Mt - 6;
            mainBottom = Mt + mainH;
            panelTop = mainBottom + PanelGap;
            panelH = PanelHeight;
            axisY = panelTop + panelH;
            totalHeight = axisY + AxisHeight;
        }
        else
        {
            mainH = Math.Max(60, Height - Mt - AxisHeight);
            mainBottom = Mt + mainH;
            axisY = mainBottom;
            totalHeight = axisY + AxisHeight;
        }

        if (Points.Count == 0)
        {
            return;
        }

        IEnumerable<LinePoint> all = Other is null ? Points : Points.Concat(Other);
        t0 = all.Min(p => p.Time);
        t1 = all.Max(p => p.Time);
        (yMin, yMax) = NiceRange(all.Min(p => p.Value), all.Max(p => p.Value), YStep, out double step);
        yTicks = Ticks(yMin, yMax, step).Select(v => (Y(v), Format(v))).ToList();

        linePath = Path(Points, Y);
        if (Area)
        {
            areaPath = $"{linePath} L{F(X(Points[^1].Time))} {F(mainBottom)} L{F(X(Points[0].Time))} {F(mainBottom)}Z";
        }

        if (Other is { Count: > 0 })
        {
            otherPath = Path(Other, Y);
        }

        if (hasPanel)
        {
            (pMin, pMax) = NiceRange(Panel!.Min(p => p.Value), Panel!.Max(p => p.Value), null, out double pStep);
            panelTicks = Ticks(pMin, pMax, pStep).Select(v => (PanelY(v), Format(v))).ToList();
            panelPath = Path(Panel!, PanelY);
        }

        xTicks = TimeTicks();
    }

    private string Path(IReadOnlyList<LinePoint> points, Func<double, double> y)
    {
        var path = new System.Text.StringBuilder();
        for (int i = 0; i < points.Count; i++)
        {
            double px = X(points[i].Time), py = y(points[i].Value);
            if (i == 0)
            {
                path.Append('M').Append(F(px)).Append(' ').Append(F(py));
            }
            else if (Step)
            {
                path.Append(" H").Append(F(px)).Append(" V").Append(F(py));
            }
            else
            {
                path.Append(" L").Append(F(px)).Append(' ').Append(F(py));
            }
        }

        return path.ToString();
    }

    private static readonly double[] Steps = [1, 2, 5, 10, 20, 50, 100, 200, 500, 1000, 2000, 5000];

    private static (double Min, double Max) NiceRange(double min, double max, double? fixedStep, out double step)
    {
        double range = Math.Max(max - min, 1);
        step = fixedStep ?? Steps.FirstOrDefault(s => range / s <= 5, Steps[^1]);
        double lo = Math.Floor(min / step) * step;
        double hi = Math.Ceiling(max / step) * step;
        if (hi - lo < step)
        {
            hi = lo + step;
        }

        return (lo, hi);
    }

    private static IEnumerable<double> Ticks(double min, double max, double step)
    {
        for (double v = min; v <= max + step / 1000; v += step)
        {
            yield return v;
        }
    }

    /// <summary>Monthly ticks (every second, third, sixth or twelfth month when crowded); day ticks for a short span.</summary>
    private List<(double X, string Label)> TimeTicks()
    {
        var ticks = new List<(double, string)>();
        if (XFormat is not null)
        {
            double xSpan = (t1 - t0).TotalSeconds;
            double xFirst = t0.ToUnixTimeSeconds();
            if (xSpan <= 0)
            {
                ticks.Add((X(t0), XFormat(t0)));
                return ticks;
            }

            double xStep = Steps.FirstOrDefault(n => plotW * n / xSpan >= 48, Steps[^1]);
            for (double v = Math.Ceiling(xFirst / xStep) * xStep; v <= xFirst + xSpan + 0.001; v += xStep)
            {
                DateTimeOffset at = DateTimeOffset.FromUnixTimeSeconds((long)v);
                ticks.Add((X(at), XFormat(at)));
            }

            return ticks;
        }

        DateTimeOffset a = t0.ToLocalTime(), b = t1.ToLocalTime();
        double spanDays = (b - a).TotalDays;
        if (spanDays <= 0)
        {
            ticks.Add((X(t0), a.ToString("d MMM", CultureInfo.InvariantCulture)));
            return ticks;
        }

        const double minGap = 58;
        if (spanDays < 75)
        {
            int dayStep = new[] { 1, 2, 5, 7, 14 }.FirstOrDefault(d => plotW * d / spanDays >= minGap, 14);
            DateTimeOffset day = new(a.Year, a.Month, a.Day, 0, 0, 0, a.Offset);
            if (day < a)
            {
                day = day.AddDays(1);
            }

            for (; day <= b; day = day.AddDays(dayStep))
            {
                ticks.Add((X(day), day.ToString("d MMM", CultureInfo.InvariantCulture)));
            }

            return ticks;
        }

        int stride = new[] { 1, 2, 3, 6, 12 }.FirstOrDefault(m => plotW * m * 30.4 / spanDays >= minGap, 12);
        DateTimeOffset month = new(a.Year, a.Month, 1, 0, 0, 0, a.Offset);
        if (month < a)
        {
            month = month.AddMonths(1);
        }

        bool first = true;
        for (; month <= b; month = month.AddMonths(1))
        {
            if ((month.Month - 1) % stride != 0)
            {
                continue;
            }

            string label = stride == 12
                ? month.ToString("yyyy", CultureInfo.InvariantCulture)
                : first || month.Month == 1
                    ? month.ToString("MMM yyyy", CultureInfo.InvariantCulture)
                    : month.ToString("MMM", CultureInfo.InvariantCulture);
            ticks.Add((X(month), label));
            first = false;
        }

        return ticks;
    }

    private static LinePoint? Nearest(IReadOnlyList<LinePoint>? points, DateTimeOffset time)
    {
        if (points is null || points.Count == 0)
        {
            return null;
        }

        LinePoint best = points[0];
        double bestGap = Math.Abs((best.Time - time).TotalSeconds);
        foreach (LinePoint point in points)
        {
            double gap = Math.Abs((point.Time - time).TotalSeconds);
            if (gap < bestGap)
            {
                best = point;
                bestGap = gap;
            }
        }

        return best;
    }

    private LinePoint? NearestOther(DateTimeOffset time) => Nearest(Other, time);

    private int NearestIndex(double offsetX)
    {
        double span = (t1 - t0).TotalSeconds;
        DateTimeOffset time = t0.AddSeconds(plotW <= 0 ? 0 : Math.Clamp(offsetX / plotW, 0, 1) * span);
        int lo = 0, hi = Points.Count - 1;
        while (lo < hi)
        {
            int mid = (lo + hi) / 2;
            if (Points[mid].Time < time)
            {
                lo = mid + 1;
            }
            else
            {
                hi = mid;
            }
        }

        if (lo > 0 && Math.Abs((Points[lo - 1].Time - time).TotalSeconds) <= Math.Abs((Points[lo].Time - time).TotalSeconds))
        {
            lo--;
        }

        return lo;
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (Points.Count == 0)
        {
            return;
        }

        int index = NearestIndex(e.OffsetX);
        if (index != hover)
        {
            hover = index;
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (Points.Count == 0)
        {
            return;
        }

        int current = hover ?? Points.Count - 1;
        int? next = e.Key switch
        {
            "ArrowLeft" => Math.Max(0, current - 1),
            "ArrowRight" => Math.Min(Points.Count - 1, current + 1),
            "Home" => 0,
            "End" => Points.Count - 1,
            _ => null,
        };
        if (next is not null)
        {
            hover = next;
        }
    }

    private void OnFocus() => hover ??= Points.Count - 1;

    private void Clear() => hover = null;

    public async ValueTask DisposeAsync()
    {
        if (!observing)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("fafReplay.unobserveWidth", host);
        }
        catch (JSDisconnectedException)
        {
            // The page is going away: nothing left to release.
        }

        self?.Dispose();
    }
}
