@* A legend for two or more series (never for one): a swatch, a line or a dot per entry, the name in
   plain ink. Text never wears the series colour. *@
<ul class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-ink-muted" aria-label="Legend">
    @foreach (LegendItem item in Items)
    {
        string shape = item.Kind switch
        {
            LegendKind.Line => "h-0.5 w-4 rounded-full",
            LegendKind.Dot => "h-2.5 w-2.5 rounded-full",
            _ => "h-2.5 w-2.5 rounded-[3px]",
        };
        <li class="flex items-center gap-1.5">
            <span class="@shape @(item.CssColor is null ? ChartColors.Bg(item.Color) : "")" style="@SwatchStyle(item)" aria-hidden="true"></span>
            <span>@item.Label</span>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<LegendItem> Items { get; set; }

    private static string? SwatchStyle(LegendItem item)
    {
        string style = item.CssColor is null ? "" : $"background:{item.CssColor};";
        if (item.Opacity < 1)
        {
            style += $"opacity:{item.Opacity.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)};";
        }

        return style.Length == 0 ? null : style;
    }
}
