@using System.Globalization
@using FAForever.Vault.Viewer.Features.Players.Army
@using FAForever.Vault.Viewer.Features.Players.Compare
@using FAForever.Vault.Viewer.Services.Theming

@* One bar cut into parts, in one of two forms.
   With Shares: one player's games by faction, in the faction swatches, under the player's name with a
   dot in the player's series colour; the parts are named by the legend of the page and by their titles.
   With Segments: parts in series colours (2 px apart), each as wide as its share of the total, with a
   legend that names every part with its count and share. *@
@if (Shares is not null)
{
    <div>
        <div class="mb-1.5 flex items-center justify-between gap-3 text-sm">
            <span class="flex min-w-0 items-center gap-2">
                <span class="h-2.5 w-2.5 shrink-0 rounded-full @ChartColors.Bg(Color)" aria-hidden="true"></span>
                <span class="truncate text-ink">@Name</span>
            </span>
            <span class="shrink-0 text-xs text-ink-muted">@Summary</span>
        </div>
        @if (total > 0)
        {
            <div class="flex h-5 gap-0.5 overflow-hidden rounded-[4px]" role="img" aria-label="@AriaText">
                @foreach (FactionShare share in Shares.Where(s => s.Plays > 0))
                {
                    <div class="h-full min-w-px" style="width:@Width(share)%;background:@Factions.Swatch(share.Faction)"
                         title="@Title(share)"></div>
                }
            </div>
        }
        else
        {
            <div class="h-5 rounded-[4px] bg-raised" role="img" aria-label="@Name has no faction games on record"></div>
        }
    </div>
}
else
{
    <div role="img" aria-label="@AriaLabel">
        @if (total > 0)
        {
            <div class="flex h-[18px] gap-0.5">
                @foreach (StackedSegment segment in (Segments ?? []).Where(segment => segment.Value > 0))
                {
                    <div class="h-full min-w-px first:rounded-l-[4px] last:rounded-r-[4px] @ChartColors.Bg(segment.Color)" style="width:@SegmentWidth(segment.Value)%" title="@Text(segment)"></div>
                }
            </div>
            <div class="mt-3">
                <Legend Items="legend" />
            </div>
        }
        else
        {
            <p class="text-sm text-ink-muted">No games yet.</p>
        }
    </div>
}

@code {
    /// <summary>The player's name above the bar (the Shares form).</summary>
    [Parameter] public string Name { get; set; } = "";

    /// <summary>One player's games by faction: the bar of the Shares form.</summary>
    [Parameter] public IReadOnlyList<FactionShare>? Shares { get; set; }

    [Parameter] public ChartColor Color { get; set; } = ChartColor.Viz1;

    /// <summary>The parts of the Segments form.</summary>
    [Parameter] public IReadOnlyList<StackedSegment>? Segments { get; set; }

    [Parameter] public string AriaLabel { get; set; } = "Split";

    private long total;
    private IReadOnlyList<LegendItem> legend = [];

    private string Summary => total == 0
        ? "No games on record"
        : $"Most played: {Factions.Name(Shares!.OrderByDescending(s => s.Plays).First().Faction)} {Math.Round(Shares!.Max(s => s.Share) * 100):0}%";

    private string AriaText => $"{Name}: " + string.Join(", ", Shares!.Where(s => s.Plays > 0).Select(Title));

    protected override void OnParametersSet()
    {
        if (Shares is not null)
        {
            total = Shares.Sum(s => s.Plays);
            return;
        }

        total = (Segments ?? []).Sum(segment => segment.Value);
        legend = [.. (Segments ?? []).Select(segment => new LegendItem(Text(segment), segment.Color))];
    }

    private string Width(FactionShare share) => (share.Share * 100).ToString("0.##", CultureInfo.InvariantCulture);

    private string SegmentWidth(long value) => (total <= 0 ? 0 : (double)value / total * 100).ToString("0.##", CultureInfo.InvariantCulture);

    private static string Title(FactionShare share)
        => $"{Factions.Name(share.Faction)}: {Math.Round(share.Share * 100):0}% of {share.Plays:N0} games";

    private string Text(StackedSegment segment)
        => $"{segment.Label}, {segment.Value.ToString("N0", CultureInfo.InvariantCulture)} ({(int)Math.Round(100.0 * segment.Value / Math.Max(total, 1))}%)";
}
