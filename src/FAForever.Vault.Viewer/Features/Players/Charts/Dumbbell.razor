@using System.Globalization
@* Two values on one track per row, joined by a bar: the gap between two players is the difference.
   The first value is viz-1, the second viz-2, named in the legend above. The values are written at
   the end of the row, first then second. *@
<div>
    <div class="mb-3">
        <Legend Items="legend" />
    </div>
    <div class="grid grid-cols-[minmax(0,6rem)_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-3.5 sm:grid-cols-[minmax(0,9rem)_minmax(0,1fr)_auto]" role="list" aria-label="@AriaLabel">
        @foreach (DumbbellRow row in Rows)
        {
            <div class="contents" role="listitem">
                <div class="min-w-0 truncate text-sm text-ink">@row.Label</div>
                <div class="relative mx-1.5 h-4">
                    <div class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-edge"></div>
                    <div class="absolute top-1/2 h-[3px] -translate-y-1/2 rounded-full bg-ink-faint"
                         style="left:@At(Math.Min(row.A, row.B))%;width:@Span(row)%"></div>
                    <span class="absolute top-1/2 h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full bg-viz-1 ring-2 ring-surface" style="left:@At(row.A)%"></span>
                    <span class="absolute top-1/2 h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full bg-viz-2 ring-2 ring-surface" style="left:@At(row.B)%"></span>
                </div>
                <div class="text-right text-sm text-ink-muted">
                    @row.AText &middot; @row.BText
                    @if (row.GapText is { Length: > 0 })
                    {
                        <span class="block text-xs text-ink-faint">@row.GapText</span>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<DumbbellRow> Rows { get; set; }

    [Parameter] public string NameA { get; set; } = "First";

    [Parameter] public string NameB { get; set; } = "Second";

    /// <summary>The ends of the track; default the smallest and largest value with some room.</summary>
    [Parameter] public double? Min { get; set; }

    [Parameter] public double? MaxValue { get; set; }

    [Parameter] public string AriaLabel { get; set; } = "Comparison";

    private double lo, hi;

    private IReadOnlyList<LegendItem> legend = [];

    protected override void OnParametersSet()
    {
        double all0 = Rows.Count == 0 ? 0 : Rows.Min(row => Math.Min(row.A, row.B));
        double all1 = Rows.Count == 0 ? 1 : Rows.Max(row => Math.Max(row.A, row.B));
        double pad = Math.Max((all1 - all0) * 0.08, 1);
        lo = Min ?? all0 - pad;
        hi = MaxValue ?? all1 + pad;
        legend = [new LegendItem(NameA, ChartColor.Viz1, LegendKind.Dot), new LegendItem(NameB, ChartColor.Viz2, LegendKind.Dot)];
    }

    private double Fraction(double value) => hi <= lo ? 0.5 : Math.Clamp((value - lo) / (hi - lo), 0, 1) * 100;

    private string At(double value) => Fraction(value).ToString("0.##", CultureInfo.InvariantCulture);

    private string Span(DumbbellRow row) => Math.Abs(Fraction(row.A) - Fraction(row.B)).ToString("0.##", CultureInfo.InvariantCulture);
}
