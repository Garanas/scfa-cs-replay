@* The one quiet line of a page whose data is not wired up yet. Nothing here pretends to be a result. *@
<p class="mt-6 rounded-md border-l-4 border-edge bg-raised px-4 py-3 text-sm text-ink-muted">@(Text ?? "The data for this page arrives in the next step.")</p>

@code {
    [Parameter] public string? Text { get; set; }
}
