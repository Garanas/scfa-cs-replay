@using FAForever.FileFormats.Replay
@inherits UrlStateComponent

@* Every sim callback of the replay, grouped by endpoint: the raw mechanics behind chat,
   pings, resource sharing, self-destructs, control groups and mod features. *@

<div class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_3fr]">
    <FilterPanel Summary="@FilterSummary">
        <h3 class="hidden px-3 pb-1 pt-2 text-xs font-semibold uppercase tracking-wide text-ink-muted lg:block">Filters</h3>
        <TimeWindowFilter Duration="duration" />

        <h3 class="px-3 pb-1 pt-3 text-xs font-semibold uppercase tracking-wide text-ink-muted">Players</h3>
        <PlayerFilterList Items="playerItems" />

        <h3 class="px-3 pb-1 pt-3 text-xs font-semibold uppercase tracking-wide text-ink-muted">Endpoints</h3>
        <div role="group" aria-label="Callback endpoints">
            @foreach ((string endpoint, int count) in endpointCounts)
            {
                <button type="button"
                        class="@(endpoint == selectedEndpoint ? ActiveEndpointClass : EndpointClass)"
                        @onclick="() => Select(endpoint)">
                    <span class="truncate font-mono text-xs">@endpoint</span>
                    <span class="badge ml-auto shrink-0">@count.ToString("N0")</span>
                </button>
            }
        </div>
    </FilterPanel>

    <div class="card max-h-[70vh] self-start overflow-x-auto overflow-y-auto p-0">
        <table class="list-table w-full text-left text-sm">
            <thead class="sticky top-0 bg-raised text-xs uppercase tracking-wide text-ink-muted">
                <tr>
                    <th class="px-4 py-3 font-semibold">Time</th>
                    <th class="px-4 py-3 font-semibold">Player</th>
                    <th class="px-4 py-3 text-right font-semibold" title="Number of units the callback applies to">Units</th>
                    <th class="w-full px-4 py-3 font-semibold">Parameters</th>
                </tr>
            </thead>
            <tbody>
                @foreach (ReplayInput.SimCallback callback in SelectedCallbacks.Take(MaxRows))
                {
                    <tr class="border-t border-edge/60 align-top hover:bg-raised/50">
                        <td class="px-4 py-2 font-mono text-ink-muted max-sm:p-0">@ReplayView.FormatDuration(ReplayAnalysis.GetTimestamp(callback))</td>
                        <td class="whitespace-nowrap px-4 py-2 max-sm:p-0"><PlayerLabel Name="@PlayerName(callback.SourceId)" Color="@colorsBySource.GetValueOrDefault(callback.SourceId)" /></td>
                        <td class="px-4 py-2 text-right font-mono max-sm:p-0">
                            @if (callback.Units.UnitCount > 0)
                            {
                                @callback.Units.UnitCount<span class="font-sans text-ink-muted sm:hidden"> units</span>
                            }
                            else
                            {
                                <span class="max-sm:hidden">—</span>
                            }
                        </td>
                        <td class="list-table-wide px-4 py-2 max-sm:break-all font-mono text-xs text-ink-muted max-sm:p-0">@LuaDataFormatter.Format(callback.LuaParameters)</td>
                    </tr>
                }
            </tbody>
        </table>
        @{ int total = SelectedCallbacks.Count(); }
        @if (total == 0)
        {
            <p class="px-4 py-3 text-sm text-ink-muted">No callbacks match the current filters.</p>
        }
        else if (total > MaxRows)
        {
            <p class="border-t border-edge/60 px-4 py-2 text-xs text-ink-faint">
                Showing the first @MaxRows of @total.ToString("N0") callbacks.
            </p>
        }
    </div>
</div>

@code {
    private const int MaxRows = 250;
    private const string QueryParameter = "endpoint";

    private string FilterSummary => FilterPanel.Join(selectedEndpoint, FilterPanel.Window(windowFrom, windowTo), FilterPanel.Players(PlayerFilterList.SelectedFrom(Navigation, playerItems.Select(item => item.Name)).Count, playerItems.Count));
    private const string EndpointClass = "flex w-full cursor-pointer items-center gap-2 rounded-md px-3 py-1.5 text-left text-ink-muted transition hover:bg-raised hover:text-ink";
    private const string ActiveEndpointClass = "flex w-full cursor-pointer items-center gap-2 rounded-md bg-raised px-3 py-1.5 text-left font-semibold text-primary";

    [Parameter, EditorRequired] public required LoadedReplay Model { get; set; }

    private List<(string Endpoint, int Count)> endpointCounts = [];
    private List<(string Name, int Count, string? Color)> playerItems = [];
    private Dictionary<int, string> colorsBySource = [];
    private Dictionary<string, List<ReplayInput.SimCallback>> callbacksByEndpoint = [];
    private string? selectedEndpoint;
    private HashSet<int> selectedSources = [];
    private TimeSpan duration;
    private TimeSpan? windowFrom;
    private TimeSpan? windowTo;

    private IEnumerable<ReplayInput.SimCallback> SelectedCallbacks
    {
        get
        {
            if (selectedEndpoint is not { } endpoint || !callbacksByEndpoint.TryGetValue(endpoint, out List<ReplayInput.SimCallback>? callbacks))
            {
                return [];
            }

            IEnumerable<ReplayInput.SimCallback> filtered = callbacks.Where(callback => selectedSources.Contains(callback.SourceId));
            if (windowFrom is { } from)
            {
                int fromTick = (int)(from.TotalSeconds * ReplayAnalysis.TicksPerSecond);
                filtered = filtered.Where(callback => callback.Tick >= fromTick);
            }
            if (windowTo is { } to)
            {
                int toTick = (int)(to.TotalSeconds * ReplayAnalysis.TicksPerSecond);
                filtered = filtered.Where(callback => callback.Tick <= toTick);
            }

            return filtered;
        }
    }

    protected override void OnParametersSet()
    {
        duration = ReplayAnalysis.GetDuration(Model.Replay);
        (windowFrom, windowTo) = TimeWindowFilter.ReadWindow(Navigation, required: false, duration);

        callbacksByEndpoint = Model.Replay.Body.UserInput
            .OfType<ReplayInput.SimCallback>()
            .GroupBy(callback => callback.Endpoint)
            .ToDictionary(group => group.Key, group => group.ToList());

        colorsBySource = GameColors.BySource(Model.Replay.Header);
        playerItems = Model.Replay.Body.UserInput
            .OfType<ReplayInput.SimCallback>()
            .GroupBy(callback => callback.SourceId)
            .OrderByDescending(group => group.Count())
            .Select(group => (PlayerName(group.Key), group.Count(), colorsBySource.GetValueOrDefault(group.Key)))
            .ToList();
        HashSet<string> selectedNames = PlayerFilterList.SelectedFrom(Navigation, playerItems.Select(item => item.Name));
        selectedSources = Enumerable.Range(0, Model.Replay.Header.Clients.Length)
            .Where(sourceId => selectedNames.Contains(PlayerName(sourceId)))
            .ToHashSet();

        endpointCounts = callbacksByEndpoint
            .Select(pair => (pair.Key, pair.Value.Count))
            .OrderByDescending(pair => pair.Count)
            .ThenBy(pair => pair.Key)
            .ToList();

        // The URL is the source of truth: absent (or unknown) means the most frequent endpoint.
        string? fromQuery = UrlQuery.Get(Navigation, QueryParameter);
        selectedEndpoint = fromQuery is { Length: > 0 } && callbacksByEndpoint.ContainsKey(fromQuery)
            ? fromQuery
            : endpointCounts.Count > 0 ? endpointCounts[0].Endpoint : null;
    }

    private void Select(string endpoint)
    {
        selectedEndpoint = endpoint;
        string? value = endpointCounts.Count > 0 && endpoint == endpointCounts[0].Endpoint ? null : endpoint;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter(QueryParameter, value), replace: true);
    }

    private string PlayerName(int sourceId)
    {
        ReplaySource[] clients = Model.Replay.Header.Clients;
        return sourceId >= 0 && sourceId < clients.Length ? clients[sourceId].PlayerName : $"Source {sourceId}";
    }
}
