@using FAForever.FileFormats.Blueprints
@using FAForever.Vault.Viewer.Services.Replays
@using FAForever.Vault.Viewer.Services.Units
@implements IDisposable
@inject UnitCardService Cards
@inject UnitDatabase Database
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* The floating unit card of the replay page; rows ask for it through UnitCardService. It ignores the
   pointer, so it never takes the hover away from the row that opened it. *@
@if (Cards.Current is { } request && data is not null)
{
    <div id="@ElementId" class="pointer-events-none fixed left-0 top-0 z-50" style="visibility:hidden" aria-hidden="true">
        <UnitCard BlueprintId="@request.BlueprintId" Unit="@data.GetOrNull(request.BlueprintId)" DataVersion="@data.GameVersion" Notes="@notes" />
    </div>
}

@code {
    private const string ElementId = "unit-card";

    [Parameter, EditorRequired] public required LoadedReplay Model { get; set; }

    private UnitData? data;
    private IReadOnlyList<string> notes = [];
    private UnitCardService.Request? placed;

    protected override async Task OnInitializedAsync()
    {
        Cards.Changed += OnChanged;
        Navigation.LocationChanged += OnLocationChanged;

        // Load the data with the replay page rather than on the first hover: reading it takes
        // about a second in the WebAssembly interpreter, which would delay the first card.
        await LoadAsync();
    }

    // The notes depend on the replay; the page may show another one without a new host.
    protected override void OnParametersSet()
    {
        if (data is not null)
        {
            notes = UnitDataNotes.For(Model, data.GameVersion);
        }
    }

    private async Task LoadAsync()
    {
        if (data is not null)
        {
            return;
        }

        try
        {
            data = await Database.LoadAsync();
            notes = UnitDataNotes.For(Model, data.GameVersion);
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException)
        {
            // The card is an extra: without the data the rows keep working as before.
            Console.Error.WriteLine($"Unit data unavailable: {exception.Message}");
        }
    }

    private async void OnChanged()
    {
        if (Cards.Current is not null)
        {
            await LoadAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    // A tab switch removes the rows without a mouseleave; never leave a card behind.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) => Cards.Hide();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        UnitCardService.Request? request = Cards.Current;
        if (request is null || data is null || request == placed)
        {
            placed = request;
            return;
        }

        placed = request;
        await JS.InvokeVoidAsync("fafReplay.placeNear", ElementId, request.X, request.Y);
    }

    public void Dispose()
    {
        Cards.Changed -= OnChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        Cards.Hide();
    }
}
