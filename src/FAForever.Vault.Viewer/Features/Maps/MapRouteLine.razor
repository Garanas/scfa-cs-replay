@using System.Globalization
@using System.Numerics

@* A route of the navigational mesh as a dashed line in world coordinates, inside a MapSurface. *@
<polyline points="@points" fill="none" stroke="rgba(0,0,0,0.6)" stroke-width="@F(Unit * 2.2)" stroke-linejoin="round" stroke-linecap="round" />
<polyline points="@points" fill="none" stroke="@Color" stroke-width="@F(Unit * 1.2)" stroke-dasharray="@F(Unit * 4) @F(Unit * 3)" stroke-linejoin="round" stroke-linecap="round" />

@code {
    [Parameter, EditorRequired] public required NavRoute Route { get; set; }

    /// <summary>World units per 256th of the map, so a line looks the same on every size.</summary>
    [Parameter] public double Unit { get; set; } = 1;

    [Parameter] public string Color { get; set; } = "#ffffff";

    private string points = "";

    protected override void OnParametersSet()
    {
        // every third point is enough for a line and keeps the markup small
        IEnumerable<Vector2> kept = Route.Points.Where((_, i) => i % 3 == 0 || i == Route.Points.Count - 1);
        points = string.Join(" ", kept.Select(p => $"{F(p.X)},{F(p.Y)}"));
    }

    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}
