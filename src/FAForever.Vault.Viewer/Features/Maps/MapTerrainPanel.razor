@using System.Globalization
@inherits UrlStateComponent

@* The map four ways (its own preview, then from the heightmap: relief, elevation, and cliffs, the
   sides too steep for land units), the
   spread of heights with the water surface, and what the map looks like: its textures and effects. *@
<div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]">
    <div class="card self-start p-3 sm:p-3">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2 px-1">
            <div class="inline-flex rounded-lg border border-edge bg-raised p-0.5" role="group" aria-label="Terrain view">
                @foreach ((string value, string label) in Views)
                {
                    <button type="button" aria-pressed="@(view == value ? "true" : "false")"
                            class="cursor-pointer rounded-md px-3 py-1 text-xs font-medium transition @(view == value ? "bg-primary text-on-primary" : "text-ink-muted hover:text-ink")"
                            @onclick="() => SetView(value)">@label</button>
                }
            </div>
            <span class="text-xs text-ink-muted">@(view switch { "cliffs" => "Red: a side steeper than 0.75, which land units cannot climb", "elevation" => "Dark is low, light is high", "relief" => "The heightmap, lit from the north west", _ => "The preview the map maker saved with the map" })</span>
        </div>
        <MapSurface Map="Map" Terrain="@view" AriaLabel="@($"Terrain of {Map.Name}")" />
    </div>

    <div class="grid grid-cols-1 content-start gap-4">
        <div class="card">
            <h2 class="text-[16px] font-bold">Elevation</h2>
            <svg class="mt-3 w-full" viewBox="0 0 @Width @Height" role="img" aria-label="How many ogrids lie at each height">
                <line x1="@Pad" x2="@(Width - Pad)" y1="@(Height - Bottom)" y2="@(Height - Bottom)" class="stroke-edge" />
                @for (int i = 0; i < bins.Length; i++)
                {
                    double barHeight = peak == 0 ? 0 : bins[i] / (double)peak * (Height - Top - Bottom);
                    double barWidth = (Width - 2 * Pad) / (double)bins.Length;
                    bool under = Map.Scmap.Water.HasWater && min + (i + 0.5) * (max - min) / bins.Length < Map.Scmap.Water.Elevation;
                    <rect x="@F(Pad + i * barWidth + 0.5)" y="@F(Height - Bottom - barHeight)" width="@F(Math.Max(0.5, barWidth - 1))" height="@F(barHeight)" rx="1.5"
                          class="@(under ? "fill-viz-1" : "fill-viz-4")" />
                }
                @if (Map.Scmap.Water.HasWater && max > min)
                {
                    double x = Math.Clamp(Pad + (Map.Scmap.Water.Elevation - min) / (max - min) * (Width - 2 * Pad), Pad, Width - Pad);
                    <line x1="@F(x)" x2="@F(x)" y1="@Top" y2="@(Height - Bottom)" class="stroke-viz-1" stroke-width="1.5" stroke-dasharray="3 3" />
                    @Text(Math.Min(Width - 70, x + 4), Top + 10, $"water {Map.Scmap.Water.Elevation.ToString("0.#", CultureInfo.InvariantCulture)}", "start")
                }
                @Text(Pad, Height - 8, min.ToString("0.#", CultureInfo.InvariantCulture), "start")
                @Text(Width / 2.0, Height - 8, "height", "middle")
                @Text(Width - Pad, Height - 8, max.ToString("0.#", CultureInfo.InvariantCulture), "end")
            </svg>
            <div class="mt-3 grid grid-cols-2 gap-3">
                <div class="rounded-lg border border-edge bg-raised p-3">
                    <p class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Under water</p>
                    <p class="font-display text-2xl font-bold">@MapOverviewPanel.Percent(Map.UnderWater)</p>
                </div>
                <div class="rounded-lg border border-edge bg-raised p-3">
                    <p class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Cliffs</p>
                    <p class="font-display text-2xl font-bold">@MapOverviewPanel.Percent(Map.Steep)</p>
                    <p class="text-xs text-ink-muted">of ogrids have a steep side</p>
                </div>
            </div>
            <MapSource>The heightmap of the <code>.scmap</code>; the slope limit of 0.75 is the one of the game's AI (<code>lua/sim/NavGenerator.lua</code>).</MapSource>
        </div>

        <div class="card">
            <h2 class="text-[16px] font-bold">Look</h2>
            <dl class="mt-3 grid grid-cols-[max-content_minmax(0,1fr)] gap-x-4 gap-y-1.5 text-sm">
                <dt class="text-ink-muted">Textures</dt>
                <dd class="break-words">@string.Join(", ", Map.Scmap.Layers.Where(layer => layer.Albedo.Length > 0).Select(layer => Path.GetFileNameWithoutExtension(layer.Albedo)))</dd>
                <dt class="text-ink-muted">Shader</dt>
                <dd>@Map.Scmap.TerrainShader</dd>
                <dt class="text-ink-muted">Decals</dt>
                <dd>@Map.Scmap.Decals.Count.ToString("N0", CultureInfo.InvariantCulture)</dd>
                <dt class="text-ink-muted">Props</dt>
                <dd>@Map.Scmap.Props.Count.ToString("N0", CultureInfo.InvariantCulture)</dd>
                <dt class="text-ink-muted">Shore waves</dt>
                <dd>@Map.Scmap.WaveGenerators.Count.ToString("N0", CultureInfo.InvariantCulture)</dd>
                <dt class="text-ink-muted">Sky</dt>
                <dd>@(Map.Scmap.Skybox is null ? "The game's default" : "Its own (made with the FAF map editor)")</dd>
            </dl>
            <MapSource>The layers, decals, props, wave generators and skybox of the <code>.scmap</code>.</MapSource>
        </div>
    </div>
</div>

@code {
    private const int Width = 360;
    private const int Height = 150;
    private const int Pad = 8;
    private const int Top = 10;
    private const int Bottom = 26;
    private static readonly (string Value, string Label)[] Views = [("preview", "Preview"), ("relief", "Relief"), ("elevation", "Elevation"), ("cliffs", "Cliffs")];

    [Parameter, EditorRequired] public required LoadedMap Map { get; set; }

    private string view = "preview";
    private int[] bins = [];
    private int peak;
    private float min;
    private float max;
    private LoadedMap? measured;

    protected override void OnParametersSet()
    {
        string? requested = UrlQuery.Get(Navigation, "terrain")?.ToLowerInvariant();
        view = Views.Any(v => v.Value == requested) ? requested! : "preview";

        if (!ReferenceEquals(measured, Map))
        {
            measured = Map;
            Measure();
        }
    }

    private void Measure()
    {
        ScmapHeightmap heights = Map.Scmap.Heightmap;
        min = float.MaxValue;
        max = float.MinValue;
        foreach (ushort sample in heights.Samples)
        {
            float h = sample * heights.Scale;
            min = Math.Min(min, h);
            max = Math.Max(max, h);
        }

        bins = new int[36];
        float range = Math.Max(1e-6f, max - min);
        foreach (ushort sample in heights.Samples)
        {
            bins[Math.Min(bins.Length - 1, (int)((sample * heights.Scale - min) / range * bins.Length))]++;
        }
        peak = bins.Max();
    }

    private void SetView(string value)
        => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("terrain", value == "preview" ? null : value), replace: true);

    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static MarkupString Text(double x, double y, string content, string anchor)
        => new($"<text x=\"{F(x)}\" y=\"{F(y)}\" text-anchor=\"{anchor}\" class=\"fill-ink-muted\" font-size=\"11\">{System.Net.WebUtility.HtmlEncode(content)}</text>");
}
