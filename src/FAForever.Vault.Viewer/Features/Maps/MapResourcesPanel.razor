@using System.Globalization
@using System.Numerics
@inherits UrlStateComponent
@inject MapImages Images

@* The mass spots by role, after conventions for map makers: at least 4 safe,
   at least 3 expandable (an expansion of 3 or more), 2 to 6 raidable and 1 to 2 contestable
   extractors per player. The roles come from the distances along the routes (ExtractorLayout);
   the conventions name the roles, not the distances, so the thresholds are in the URL and can be
   changed here. *@
<div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]">
    <div class="card self-start p-3 sm:p-3">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2 px-1">
            <div class="inline-flex rounded-lg border border-edge bg-raised p-0.5" role="group" aria-label="Resource view">
                @foreach ((string value, string label) in Views)
                {
                    <button type="button" aria-pressed="@(view == value ? "true" : "false")"
                            class="cursor-pointer rounded-md px-3 py-1 text-xs font-medium transition @(view == value ? "bg-primary text-on-primary" : "text-ink-muted hover:text-ink")"
                            @onclick="() => SetView(value)">@label</button>
                }
            </div>
            <span class="text-xs text-ink-muted">@(view == "closest" ? "Each ogrid in the colour of its closest start position" : $"Rings: the base radius of {Fmt(thresholds.BaseRadius)} ogrids")</span>
        </div>
        <MapSurface Map="Map" Terrain="muted" Overlay="overlay" AriaLabel="@($"Mass spots of {Map.Name} by role")">
            @if (view == "roles")
            {
                @foreach (MapMarker start in Map.Starts)
                {
                    <circle cx="@F(start.Position.X)" cy="@F(start.Position.Z)" r="@F(thresholds.BaseRadius)" fill="rgba(95,209,122,0.10)" stroke="rgba(95,209,122,0.8)" stroke-width="@F(unit * 0.6)" stroke-dasharray="@F(unit * 3) @F(unit * 2.5)" />
                }
            }
            <MapResourceMarkers Map="Map" Unit="unit" MassColor="MassColor" />
        </MapSurface>
        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 px-1 text-xs text-ink-muted">
            @if (view == "roles")
            {
                @foreach (ExtractorRole role in Enum.GetValues<ExtractorRole>())
                {
                    <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 @RoleSwatch(role)"></span>@RoleName(role)</span>
                }
            }
            else
            {
                @for (int i = 0; i < Map.Starts.Count; i++)
                {
                    <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm @StartSwatch(i)"></span>Closest to start @(i + 1)</span>
                }
            }
            <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full border-2 border-[#f5b83d]"></span>Hydrocarbon</span>
        </div>
    </div>

    <div class="grid grid-cols-1 content-start gap-4">
        <MapVerdict Title="@($"Meets {layout.GuidelinesMet} of 4 extractor conventions")"
                    Tone="@(layout.GuidelinesMet == 4 ? MapVerdict.VerdictTone.Good : layout.GuidelinesMet >= 2 ? MapVerdict.VerdictTone.Notice : MapVerdict.VerdictTone.Problem)">
            Each mass spot gets a role from its distance to the start positions@(Map.Extractors.Layer switch { NavLayer.Land => " over land", { } layer => $" by {MapOverviewPanel.LayerName(layer)}, the only way between the bases", null => " in a straight line, as no route links the bases" }).
            @(Map.Symmetry is null ? "No symmetry found in the markers." : MapOverviewPanel.SymmetryLabel(Map.Symmetry) + ".")
        </MapVerdict>

        <div class="card">
            <div class="flex items-baseline justify-between gap-3">
                <h2 class="text-[16px] font-bold">Extractor layout</h2>
                <span class="text-xs text-ink-muted">per player</span>
            </div>
            <div class="mt-3 overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-edge text-left text-xs text-ink-muted">
                            <th class="py-1.5 pr-2 font-semibold">Role</th>
                            @for (int i = 0; i < Map.Starts.Count; i++)
                            {
                                <th class="px-2 py-1.5 text-right font-semibold">Start @(i + 1)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ExtractorGuideline guideline in ExtractorGuideline.All)
                        {
                            <tr class="border-b border-edge/60">
                                <td class="whitespace-nowrap py-1.5 pr-2"><span class="mr-1.5 inline-block h-2.5 w-2.5 @RoleSwatch(guideline.Role)"></span>@RoleName(guideline.Role)</td>
                                @foreach (IReadOnlyDictionary<ExtractorRole, double> counts in layout.PerPlayer)
                                {
                                    <td class="px-2 py-1.5 text-right tabular-nums">@counts[guideline.Role].ToString("0.#", CultureInfo.InvariantCulture)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <ul class="mt-3 grid gap-1 text-xs text-ink-muted">
                <li><span class="font-semibold text-ink">Safe, at least 4.</span> In the base: within the base radius of a start position.</li>
                <li><span class="font-semibold text-ink">Expandable, at least 3.</span> Part of an expansion: a group of 3 or more on one side, outside the base. It rewards expanding.</li>
                <li><span class="font-semibold text-ink">Raidable, 2 to 6.</span> On your side but far from the base, alone or in pairs: easy to raid when left unprotected. It rewards presence and intel.</li>
                <li><span class="font-semibold text-ink">Contestable, 1 to 2.</span> About as far from two start positions: it rewards map control. Contestable spots belong to no one, so each player counts their share.</li>
            </ul>
            @if (Map.Extractors.Routed.Count(routed => !routed) is > 0 and var unrouted)
            {
                <p class="mt-2 text-xs text-ink-muted">@unrouted @(unrouted == 1 ? "spot" : "spots") that no start position reaches by @MapOverviewPanel.LayerName(Map.Extractors.Layer) @(unrouted == 1 ? "is" : "are") measured in a straight line.</p>
            }
            <MapSource>Distances along the routes of the navigational mesh (a port of <FaSourceLink Path="lua/sim/NavGenerator.lua" />) to the mass markers of the <code>_save.lua</code>.</MapSource>
        </div>

        <details class="card" open="@thresholdsOpen">
            <summary class="cursor-pointer font-display text-[16px] font-bold">Thresholds</summary>
            <p class="mt-2 text-sm text-ink-muted">The conventions name the roles, not the distances. These defaults fit 5 to 10 km maps; a changed value is part of the address.</p>
            <div class="mt-3 grid gap-3">
                @foreach (Threshold threshold in Thresholds)
                {
                    int value = threshold.Read(thresholds);
                    <label for="threshold-@threshold.Parameter" class="grid gap-1 text-sm">
                        <span><span class="font-semibold">@threshold.Label</span> <span class="tabular-nums">@value</span> @threshold.Unit</span>
                        <input type="range" id="threshold-@threshold.Parameter" min="@threshold.Min" max="@threshold.Max" value="@value" class="w-full accent-primary"
                               @onchange="e => SetThreshold(threshold, e.Value)" />
                    </label>
                }
                @if (!thresholds.Equals(ExtractorThresholds.Default))
                {
                    <button type="button" class="btn-secondary justify-self-start" @onclick="ResetThresholds">Back to the defaults</button>
                }
            </div>
        </details>

    </div>
</div>

@code {
    private static readonly (string Value, string Label)[] Views = [("roles", "Extractor roles"), ("closest", "Closest start")];

    private sealed record Threshold(string Parameter, string Label, string Unit, int Min, int Max, Func<ExtractorThresholds, int> Read, Func<ExtractorThresholds, int, ExtractorThresholds> With, int Default);

    private static readonly Threshold[] Thresholds =
    [
        new("base", "Base radius", "ogrids along the route", 20, 120, t => (int)Math.Round(t.BaseRadius), (t, v) => t with { BaseRadius = v }, 60),
        new("contested", "Contested when within", "% of each other", 5, 40, t => (int)Math.Round(t.ContestedWithin * 100), (t, v) => t with { ContestedWithin = v / 100f }, 15),
        new("spacing", "Expansion spots within", "ogrids of each other", 8, 50, t => (int)Math.Round(t.ExpansionSpacing), (t, v) => t with { ExpansionSpacing = v }, 25),
    ];

    /// <summary>
    /// The thresholds in the URL (<c>base</c>, <c>contested</c> in percent, <c>spacing</c>), each within
    /// the range of its slider; absent or unreadable values are the defaults.
    /// </summary>
    public static ExtractorThresholds ReadThresholds(NavigationManager navigation)
    {
        ExtractorThresholds thresholds = ExtractorThresholds.Default;
        foreach (Threshold threshold in Thresholds)
        {
            if (int.TryParse(UrlQuery.Get(navigation, threshold.Parameter), NumberStyles.Integer, CultureInfo.InvariantCulture, out int value))
            {
                thresholds = threshold.With(thresholds, Math.Clamp(value, threshold.Min, threshold.Max));
            }
        }
        return thresholds;
    }

    [Parameter, EditorRequired] public required LoadedMap Map { get; set; }

    private string view = "roles";
    private ExtractorThresholds thresholds = ExtractorThresholds.Default;
    private ExtractorLayout layout = default!;
    private Dictionary<MapMarker, ExtractorRole> roles = [];
    private Task<string>? overlay;
    private double unit;
    private bool thresholdsOpen;

    protected override void OnParametersSet()
    {
        unit = Math.Max(Map.Width, Map.Height) / 256.0;
        view = UrlQuery.Get(Navigation, "resources")?.ToLowerInvariant() == "closest" ? "closest" : "roles";
        thresholds = ReadThresholds(Navigation);
        thresholdsOpen |= !thresholds.Equals(ExtractorThresholds.Default);
        layout = ExtractorLayout.Classify(Map.Extractors, thresholds);
        roles = layout.Spots.ToDictionary(spot => spot.Marker, spot => spot.Role);
        overlay = view == "closest" ? ClosestOverlay() : null;
    }

    private Task<string> ClosestOverlay()
        => Images.GridAsync(Map, "closest", Map.Width, Map.Height, () =>
        {
            byte[] values = new byte[Map.Width * Map.Height];
            for (int z = 0; z < Map.Height; z++)
            {
                for (int x = 0; x < Map.Width; x++)
                {
                    int best = 0;
                    float bestDistance = float.PositiveInfinity;
                    for (int i = 0; i < Map.Starts.Count; i++)
                    {
                        float d = Vector2.DistanceSquared(new Vector2(x + 0.5f, z + 0.5f), new Vector2(Map.Starts[i].Position.X, Map.Starts[i].Position.Z));
                        if (d < bestDistance)
                        {
                            bestDistance = d;
                            best = i;
                        }
                    }
                    values[z * Map.Width + x] = (byte)(best % StartColors.Length + 1);
                }
            }
            return values;
        }, ClosestPalette);

    private static readonly string[] StartColors = ["#3987e5", "#d95926", "#199e70", "#c98500", "#d55181", "#9085e9", "#008300", "#e66767"];

    private static readonly byte[] ClosestPalette = [0, 0, 0, 0, .. StartColors.SelectMany(hex => new byte[] { Convert.ToByte(hex[1..3], 16), Convert.ToByte(hex[3..5], 16), Convert.ToByte(hex[5..7], 16), 80 })];

    private static string StartColor(int index) => StartColors[index % StartColors.Length];

    // literal classes, so Tailwind finds them
    private static string StartSwatch(int index) => (index % StartColors.Length) switch
    {
        0 => "bg-[#3987e5]",
        1 => "bg-[#d95926]",
        2 => "bg-[#199e70]",
        3 => "bg-[#c98500]",
        4 => "bg-[#d55181]",
        5 => "bg-[#9085e9]",
        6 => "bg-[#008300]",
        _ => "bg-[#e66767]",
    };

    private string MassColor(MapMarker mass)
    {
        if (view == "closest")
        {
            int best = 0;
            for (int i = 1; i < Map.Starts.Count; i++)
            {
                if (Vector2.Distance(new Vector2(mass.Position.X, mass.Position.Z), new Vector2(Map.Starts[i].Position.X, Map.Starts[i].Position.Z))
                    < Vector2.Distance(new Vector2(mass.Position.X, mass.Position.Z), new Vector2(Map.Starts[best].Position.X, Map.Starts[best].Position.Z)))
                {
                    best = i;
                }
            }
            return StartColor(best);
        }
        return roles.TryGetValue(mass, out ExtractorRole role) ? RoleColor(role) : "#7fe08a";
    }

    /// <summary>The colour of a role on the map; the same in both modes, as the map below is.</summary>
    public static string RoleColor(ExtractorRole role) => role switch
    {
        ExtractorRole.Safe => "#5fd17a",
        ExtractorRole.Expandable => "#4aa8ff",
        ExtractorRole.Raidable => "#f0a43a",
        _ => "#e5627f",
    };

    // literal classes, so Tailwind finds them
    private static string RoleSwatch(ExtractorRole role) => role switch
    {
        ExtractorRole.Safe => "rounded-sm bg-[#5fd17a]",
        ExtractorRole.Expandable => "rounded-sm bg-[#4aa8ff]",
        ExtractorRole.Raidable => "rounded-sm bg-[#f0a43a]",
        _ => "rounded-sm bg-[#e5627f]",
    };

    public static string RoleName(ExtractorRole role) => role.ToString();

    private void SetView(string value)
        => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("resources", value == "roles" ? null : value), replace: true);

    private void SetThreshold(Threshold threshold, object? raw)
    {
        if (!int.TryParse(raw?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int value))
        {
            return;
        }
        value = Math.Clamp(value, threshold.Min, threshold.Max);
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter(threshold.Parameter, value == threshold.Default ? null : value), replace: true);
    }

    private void ResetThresholds()
        => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["base"] = null, ["contested"] = null, ["spacing"] = null }), replace: true);

    private static string Fmt(double value) => value.ToString("N0", CultureInfo.InvariantCulture);

    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}
