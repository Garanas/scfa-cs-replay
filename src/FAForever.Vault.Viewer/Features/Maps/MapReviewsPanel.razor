@using System.Globalization
@inherits UrlStateComponent
@inject FafApiClient Api
@inject AuthService Auth

@* The reviews of this map version, and the signed-in player's own: one per player and version,
   written with the same requests as the FAF client (FafApiClient.SaveMapReviewAsync). A new
   version of a map starts without reviews. *@
@if (!Auth.IsAuthenticated)
{
    <MapLoginGate What="and write reviews" Why="Reviews are kept by the FAForever API. Reading them needs a sign in like every API request, and a review is tied to your FAF account: one review per player for each version of a map." />
}
else if (VaultError is not null || error is not null)
{
    <div class="card" role="alert">
        <p class="font-semibold">The reviews could not be loaded</p>
        <p class="mt-1 text-sm text-ink-muted">@(error ?? VaultError)</p>
    </div>
}
else if (Vault is null || reviews is null)
{
    <div class="card animate-pulse text-center text-sm text-ink-muted">Loading the reviews&hellip;</div>
}
else
{
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
        <div class="card">
            <h2 class="text-[16px] font-bold">Reviews of version @Vault.Version</h2>
            @if (reviews.Count == 0)
            {
                <p class="mt-2 text-sm text-ink-muted">Nobody has reviewed this version yet.</p>
            }
            else
            {
                <div class="mt-3 flex flex-wrap items-center gap-6">
                    <div class="grid gap-1">
                        <span class="font-display text-4xl font-extrabold leading-none">@Average.ToString("0.0", CultureInfo.InvariantCulture)</span>
                        <span class="text-accent" aria-label="@($"{Average:0.0} out of 5")">@Stars((int)Math.Round(Average))</span>
                        <span class="text-xs text-ink-muted">@reviews.Count @(reviews.Count == 1 ? "review" : "reviews")</span>
                    </div>
                    <div class="grid min-w-48 flex-1 gap-1">
                        @for (int score = 5; score >= 1; score--)
                        {
                            int count = reviews.Count(review => review.Score == score);
                            <div class="grid grid-cols-[2.5rem_minmax(0,1fr)_2rem] items-center gap-2 text-xs">
                                <span>@score ★</span>
                                <span class="h-2 overflow-hidden rounded-full border border-edge bg-raised"><span class="block h-full rounded-full bg-accent" style="width: @((100.0 * count / reviews.Count).ToString("0", CultureInfo.InvariantCulture))%"></span></span>
                                <span class="text-right tabular-nums text-ink-muted">@count</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="mt-4 divide-y divide-edge">
                    @foreach (MapReview review in reviews.Skip((CurrentPage - 1) * PageSize).Take(PageSize))
                    {
                        <article class="py-3">
                            <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                                <span class="font-semibold">@review.Player@(IsMine(review) ? " (you)" : "")</span>
                                <span class="text-accent" aria-label="@($"{review.Score} out of 5")">@Stars(review.Score)</span>
                                <span class="text-xs text-ink-faint">@(review.UpdatedAt?.ToString("d MMM yyyy", CultureInfo.InvariantCulture))</span>
                            </div>
                            @if (review.Text is { Length: > 0 } text)
                            {
                                <p class="mt-1 whitespace-pre-line break-words text-sm">@text</p>
                            }
                        </article>
                    }
                </div>
                @if (PageCount > 1)
                {
                    <nav class="mt-3 flex items-center justify-between gap-3 border-t border-edge pt-3 text-sm" aria-label="Pages of reviews">
                        <button type="button" class="btn-secondary" disabled="@(CurrentPage == 1)" @onclick="() => SetPage(CurrentPage - 1)">← Newer</button>
                        <span class="text-ink-muted">Page @CurrentPage of @PageCount</span>
                        <button type="button" class="btn-secondary" disabled="@(CurrentPage == PageCount)" @onclick="() => SetPage(CurrentPage + 1)">Older →</button>
                    </nav>
                }
            }
        </div>

        <div class="card self-start">
            <h2 class="text-[16px] font-bold">@(mine is null ? "Write a review" : "Your review")</h2>
            <p class="mt-1 text-sm text-ink-muted">You review version @Vault.Version, the version on this page.</p>
            <form class="mt-4 grid gap-4" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <div>
                    <p id="review-score-label" class="text-sm font-semibold">Score</p>
                    <div class="mt-1 flex gap-1" role="radiogroup" aria-labelledby="review-score-label">
                        @for (int value = 1; value <= 5; value++)
                        {
                            int star = value;
                            <button type="button" role="radio" aria-checked="@(score == star ? "true" : "false")" aria-label="@($"{star} of 5")"
                                    class="cursor-pointer rounded px-0.5 text-3xl leading-none transition @(star <= score ? "text-accent" : "text-edge hover:text-accent/60")"
                                    @onclick="() => score = star">★</button>
                        }
                    </div>
                </div>
                <div class="grid gap-1">
                    <label for="review-text" class="text-sm font-semibold">What makes this map good or bad to play?</label>
                    <textarea id="review-text" class="input-field min-h-28" maxlength="2000" @bind="text"
                              placeholder="The layout, the balance between the start positions, how games tend to go"></textarea>
                    <span class="text-xs text-ink-faint">Optional. Everyone signed in can read it.</span>
                </div>
                @if (formError is not null)
                {
                    <p class="text-sm text-accent" role="alert">@formError</p>
                }
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                        @if (mine is not null)
                        {
                            @if (confirmDelete)
                            {
                                <span class="mr-2 text-sm">Delete your review?</span>
                                <button type="button" class="btn-secondary" disabled="@busy" @onclick="DeleteAsync">Delete</button>
                                <button type="button" class="ml-1 cursor-pointer text-sm text-ink-muted hover:text-ink" @onclick="() => confirmDelete = false">Keep it</button>
                            }
                            else
                            {
                                <button type="button" class="btn-secondary" disabled="@busy" @onclick="() => confirmDelete = true">Delete</button>
                            }
                        }
                    </div>
                    <button type="submit" class="btn-primary" disabled="@(busy || score == 0)">@(mine is null ? "Post review" : "Update review")</button>
                </div>
                @if (saved is not null)
                {
                    <p class="text-sm text-primary" role="status">@saved</p>
                }
            </form>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public required LoadedMap Map { get; set; }

    [Parameter] public MapVersionDetails? Vault { get; set; }

    [Parameter] public string? VaultError { get; set; }

    /// <summary>Called after the player's review changed, so the page can update the vault's numbers.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private IReadOnlyList<MapReview>? reviews;
    private MapReview? mine;
    private int? loadedVersion;
    private string? error;
    private int score;
    private string? text;
    private bool busy;
    private bool confirmDelete;
    private string? formError;
    private string? saved;

    private const int PageSize = 5;

    private int requestedPage = 1;

    private int PageCount => reviews is { Count: > 0 } list ? (list.Count + PageSize - 1) / PageSize : 1;

    /// <summary>The page in the URL (<c>page</c>), within the pages there are.</summary>
    private int CurrentPage => Math.Clamp(requestedPage, 1, PageCount);

    protected override void OnParametersSet()
        => requestedPage = int.TryParse(UrlQuery.Get(Navigation, "page"), NumberStyles.Integer, CultureInfo.InvariantCulture, out int page) ? page : 1;

    private void SetPage(int page)
        => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("page", page <= 1 ? null : page), replace: true);

    private double Average => reviews is { Count: > 0 } list ? list.Average(review => review.Score) : 0;

    protected override async Task OnParametersSetAsync()
    {
        if (Vault is null || loadedVersion == Vault.VersionId)
        {
            return;
        }

        loadedVersion = Vault.VersionId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        error = null;
        try
        {
            reviews = await Api.GetMapReviewsAsync(Vault!.VersionId, CancellationToken.None);
            mine = reviews.FirstOrDefault(IsMine);
            score = mine?.Score ?? 0;
            text = mine?.Text;
        }
        catch (NotAuthenticatedException)
        {
            error = "Your session has expired. Sign in again to see the reviews.";
        }
        catch (HttpRequestException exception)
        {
            error = $"The FAF API could not be reached: {exception.Message}";
        }
    }

    private bool IsMine(MapReview review)
        => review.PlayerId is { } id && Auth.Session?.UserId == id.ToString(CultureInfo.InvariantCulture);

    private async Task SaveAsync()
    {
        if (Vault is null || score is < 1 or > 5)
        {
            formError = "Pick a score from 1 to 5 stars.";
            return;
        }

        busy = true;
        formError = null;
        saved = null;
        try
        {
            await Api.SaveMapReviewAsync(Vault.VersionId, mine?.Id, score, text, CancellationToken.None);
            saved = mine is null ? "Your review is posted." : "Your review is updated.";
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
        catch (NotAuthenticatedException)
        {
            formError = "Your session has expired. Sign in again to post the review.";
        }
        catch (HttpRequestException exception)
        {
            formError = $"The review was not saved: {exception.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (mine is null)
        {
            return;
        }

        busy = true;
        formError = null;
        saved = null;
        try
        {
            await Api.DeleteMapReviewAsync(mine.Id, CancellationToken.None);
            confirmDelete = false;
            saved = "Your review is deleted.";
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
        catch (NotAuthenticatedException)
        {
            formError = "Your session has expired. Sign in again to delete the review.";
        }
        catch (HttpRequestException exception)
        {
            formError = $"The review was not deleted: {exception.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private static string Stars(int score) => new string('★', Math.Clamp(score, 0, 5)) + new string('☆', 5 - Math.Clamp(score, 0, 5));
}
