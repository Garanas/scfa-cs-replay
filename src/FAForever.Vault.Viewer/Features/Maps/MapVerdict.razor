@* A one line conclusion with a coloured bar: good (the green of the chart palette, the same for every faction), worth a look (accent) or
   a problem (faint). *@
<div class="flex items-stretch gap-3 rounded-lg border border-edge bg-raised p-3">
    <span class="w-1 shrink-0 rounded-full @(Tone switch { VerdictTone.Good => "bg-viz-3", VerdictTone.Notice => "bg-accent", _ => "bg-ink-faint" })" aria-hidden="true"></span>
    <div class="min-w-0">
        <p class="font-semibold">@Title</p>
        @if (ChildContent is not null)
        {
            <p class="mt-0.5 text-sm text-ink-muted">@ChildContent</p>
        }
    </div>
</div>

@code {
    public enum VerdictTone { Good, Notice, Problem }

    [Parameter, EditorRequired] public required string Title { get; set; }

    [Parameter] public VerdictTone Tone { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
