@using FAForever.Vault.Viewer.Services.Units
@inject UnitDatabase Database

@* One unit across every game version with data: a column per stretch of versions in which it stayed
   the same, a row per value, changed values marked against the column before. A card of the
   unit history page (Pages/UnitHistory.razor). *@

<section class="card p-3 sm:p-4" aria-label="@($"History of {Title}")">
    <div class="flex flex-wrap items-center gap-3">
        <UnitIcon BlueprintId="@BlueprintId" Size="40" />
        <div class="min-w-0">
            <h2 class="text-lg font-bold">@Title</h2>
            <p class="text-sm text-ink-muted">@(latest is not null ? Subtitle(latest) : BlueprintId)</p>
        </div>
        <div class="ml-auto flex items-center gap-2">
            @if (states is { Count: > 0 })
            {
                <a class="btn-secondary px-3 py-1 text-xs" href="@($"{UnitLinks.Database}?unit={Id}{VersionQuery(states[^1])}")">Show in the database</a>
            }
            <button type="button" class="cursor-pointer rounded-md px-2 py-1 text-lg leading-none text-ink-muted transition hover:bg-raised hover:text-ink"
                    title="Remove from the page" aria-label="@($"Remove {Title} from the page")" @onclick="OnRemove">×</button>
        </div>
    </div>

    @if (error is not null)
    {
        <p class="mt-3 text-sm text-ink-muted" role="alert">The unit data could not be loaded: @error</p>
    }
    else if (states is null || index is null)
    {
        <p class="mt-3 animate-pulse text-sm text-ink-muted">Loading the history&hellip;</p>
    }
    else if (latest is null)
    {
        <p class="mt-3 text-sm text-ink-muted">No game version since @index.Versions.Keys.Min() has a unit @BlueprintId; mod and campaign units are not in the unit data.</p>
    }
    else
    {
        <p class="mt-3 text-sm text-ink-muted">@Summary()</p>

        <div class="mt-2 overflow-x-auto">
            <table class="sticky-first-column w-full min-w-max text-sm">
                <thead>
                    <tr class="border-b border-edge text-left">
                        <th class="bg-surface py-2 pr-3 text-xs font-medium text-ink-faint">Game version</th>
                        @foreach (UnitState state in states)
                        {
                            <th class="px-3 py-2 align-bottom font-normal">
                                <a class="font-mono font-semibold text-ink transition hover:text-primary" href="@($"{UnitLinks.Database}?unit={Id}{VersionQuery(state)}")"
                                   title="Show this version in the unit database">@Range(state)</a>
                                @if (index.Versions.GetValueOrDefault(state.From)?.Released is { } released)
                                {
                                    <span class="block text-[11px] text-ink-faint">@released.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int row = 0; row < rows.Count; row++)
                    {
                        (string key, string label, string? group) = rows[row];
                        @* A weapon's name heads its values once, so the first column stays narrow on a phone;
                           the name keeps to the left edge while the table scrolls sideways. *@
                        if (group is not null && (row == 0 || rows[row - 1].Group != group))
                        {
                            <tr class="border-b border-edge/60">
                                <th colspan="@(states.Count + 1)" class="bg-surface pb-1 pr-3 pt-3 text-left text-xs font-semibold text-ink">
                                    <span class="sticky left-0 inline-block">@group</span>
                                </th>
                            </tr>
                        }
                        <tr class="border-b border-edge/60">
                            <th class="bg-surface py-1.5 pr-3 text-left text-xs font-normal text-ink-faint max-sm:min-w-24 max-sm:max-w-28 @(group is not null ? "pl-3" : "")">@label</th>
                            @for (int column = 0; column < states.Count; column++)
                            {
                                UnitStats.Line? line = lines[column].GetValueOrDefault(key);
                                UnitStats.Line? before = column > 0 ? lines[column - 1].GetValueOrDefault(key) : null;
                                bool changed = column > 0 && line?.Text != before?.Text;
                                <td class="whitespace-nowrap px-3 py-1.5 @(line?.Number is not null ? "font-mono" : "") @(changed ? "font-semibold text-primary" : "text-ink")">
                                    @(line?.Text ?? "—")
                                    @if (changed && line?.Number is { } now && before?.Number is { } then && now != then)
                                    {
                                        <span class="ml-1 text-[10px]" title="@(now > then ? "Higher" : "Lower") than before">@(now > then ? "▲" : "▼")</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                    @* Categories rarely matter on their own, but a change in them explains a column that looks the same. *@
                    @if (states.Count > 1)
                    {
                        <tr class="border-b border-edge/60">
                            <th class="bg-surface py-1.5 pr-3 text-left text-xs font-normal text-ink-faint">Categories</th>
                            @for (int column = 0; column < states.Count; column++)
                            {
                                string change = column > 0 ? CategoryChange(states[column - 1].Unit, states[column].Unit) : "";
                                <td class="max-w-64 px-3 py-1.5 text-xs @(change.Length > 0 ? "font-semibold text-primary" : "text-ink-faint")">@(column == 0 ? $"{states[0].Unit.Categories.Count} categories" : change)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    /// <summary>The unit, by blueprint id (any case).</summary>
    [Parameter, EditorRequired] public required string BlueprintId { get; set; }

    /// <summary>Takes the card off the page (the page removes the unit from its parameter).</summary>
    [Parameter] public EventCallback OnRemove { get; set; }

    private UnitDataIndex? index;
    private IReadOnlyList<UnitState>? states;
    private UnitSummary? latest;
    // A row per value: its key across versions, its label, and the weapon it belongs to.
    private List<(string Key, string Label, string? Group)> rows = [];
    private List<Dictionary<string, UnitStats.Line>> lines = [];
    private string? error;
    private string? loadedFor;

    private string Id => BlueprintId.ToLowerInvariant();

    private string Title => latest is not null ? UnitFilters.DisplayName(latest) : BlueprintId;

    // A card stays when the page's list changes around it: load again only for another unit.
    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == Id)
        {
            return;
        }

        loadedFor = Id;
        states = null;
        try
        {
            index = await Database.LoadIndexAsync();
            IReadOnlyList<UnitState> history = await Database.LoadHistoryAsync(Id);

            List<IReadOnlyList<UnitStats.Line>> columns = history.Select(state => UnitStats.For(state.Unit)).ToList();
            lines = columns.Select(column => column.ToDictionary(line => line.Key)).ToList();
            // every value in the order it first appears, so a weapon added later comes last; a weapon's
            // values stay together, even when a later version adds one (a salvo) to a weapon
            rows = columns.SelectMany(column => column)
                .DistinctBy(line => line.Key)
                .GroupBy(line => line.Group)
                .SelectMany(group => group)
                .Select(line => (line.Key, line.Label, line.Group))
                .ToList();
            latest = history.Count > 0 ? history[^1].Unit : null;
            states = history;
            error = null;
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException or InvalidOperationException)
        {
            error = exception.Message;
        }
    }

    /// <summary>The categories added (+) and removed (−) from one state to the next, e.g. "+VOLATILE −SNIPEMODE".</summary>
    private static string CategoryChange(UnitSummary before, UnitSummary after) => string.Join(" ",
        after.Categories.Except(before.Categories).Select(category => $"+{category}")
            .Concat(before.Categories.Except(after.Categories).Select(category => $"−{category}")));

    private static string Range(UnitState state) => state.From == state.To ? $"{state.From}" : $"{state.From}–{state.To}";

    // A stretch of versions opens its last version in the unit database; the latest is its default.
    private string VersionQuery(UnitState state) => state.To == index?.Latest ? "" : $"&version={state.To}";

    private static string Subtitle(UnitSummary unit) => string.Join(" · ", new[]
    {
        unit.Name is not null ? unit.Description : null,
        unit.Faction,
        unit.TechLevel switch { 4 => "Experimental", { } tech => $"Tech {tech}", null => null },
        UnitRoles.Layer(unit),
        unit.BlueprintId,
    }.Where(part => part is not null));

    private string Summary()
    {
        UnitState first = states![0];
        UnitState last = states[^1];
        int oldest = index!.Versions.Keys.Min();
        string since = first.From == oldest ? $"since {oldest}, the oldest version with data" : $"since it was added in {first.From}";
        string changes = states.Count == 1 ? "it has not changed" : $"it changed {states.Count - 1} {(states.Count == 2 ? "time" : "times")}";
        string removed = last.To != index.Latest ? $" It is not in the versions after {last.To}." : "";
        return $"In every version {since}, {changes}: each column is a stretch of versions in which it stayed the same.{removed}";
    }
}
