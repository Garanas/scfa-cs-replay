{
  "id": "./",
  "name": "Vault of FAForever",
  "short_name": "Vault of FAF",
  "description": "Search, inspect and analyse Supreme Commander: Forged Alliance Forever replays.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0c0f14",
  "theme_color": "#0c0f14",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Replays", "short_name": "Replays", "url": "./replays", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Unit database", "short_name": "Units", "url": "./units/database", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "About Vault of FAForever", "short_name": "About", "url": "./about", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/octet-stream": [".fafreplay", ".scfareplay"]
      }
    }
  ]
}
