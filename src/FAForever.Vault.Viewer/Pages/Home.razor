@page "/"
@implements IDisposable
@inject NavigationManager Navigation
@inject LocalReplayLoader Opener
@using FAForever.Vault.Viewer.Features.Home
@using FAForever.Vault.Viewer.Features.Units
@inject IJSRuntime JS

<PageTitle>Vault of FAForever</PageTitle>

@* The front door: open a replay first, then a map and a unit to look at, then what the site is.
   Same writing style as the About pages: simple English, short sentences, no hyphens, underscores
   or dashes in the visible text. The map and the unit are picked at random from a fixed set on
   every visit (HomeExamples); nothing is fetched for them but the map's preview and the unit's icon. *@

<section class="py-10 text-center sm:py-14">
    <h1 class="mx-auto max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">
        Explore the content of <span class="text-primary">FAForever</span>
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-ink-muted">
        Replay a game, study a map or look up any unit, straight from your browser.
    </p>
</section>

<section class="mx-auto max-w-4xl" aria-labelledby="home-replays">
    <h2 id="home-replays" class="text-xs font-semibold uppercase tracking-wide text-ink-faint">Open a replay</h2>
    <div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="card">
            <h3 class="text-lg font-bold">From the vault</h3>
            <p class="mt-1 text-sm text-ink-muted">Paste a replay ID or link, e.g.
                <button type="button" class="cursor-pointer font-mono text-primary hover:underline disabled:cursor-default disabled:text-ink disabled:no-underline"
                        title="Open this replay" @onclick="OpenExampleReplay" disabled="@IsLoading">@ExampleReplayId</button>.</p>
            <form class="mt-4 flex gap-2" @onsubmit="OpenVaultReplay" @onsubmit:preventDefault>
                <input @ref="vaultReplayInput" class="input-field font-mono" placeholder="Replay ID" inputmode="numeric"
                       @bind="vaultReplayId" @bind:event="oninput" @bind:after="ExtractReplayIdFromLink" disabled="@IsLoading" />
                <button type="submit" class="btn-primary" disabled="@(!CanOpenVaultReplay)">Open</button>
            </form>
        </div>

        <div class="card">
            <h3 class="text-lg font-bold">From a file</h3>
            <p class="mt-1 text-sm text-ink-muted">A <span class="font-mono text-ink">.fafreplay</span> or <span class="font-mono text-ink">.scfareplay</span> file.</p>
            <div class="relative mt-4 flex min-h-20 cursor-pointer items-center justify-center rounded-md border-2 border-dashed border-edge px-4 text-sm text-ink-muted transition hover:border-primary hover:text-ink">
                <InputFile OnChange="OnFileSelected" accept=".fafreplay,.scfareplay" disabled="@IsLoading"
                           class="absolute inset-0 cursor-pointer opacity-0" title="" />
                <span>Choose a replay file, or drop one here</span>
            </div>
        </div>
    </div>

    <div class="mt-6 empty:hidden" aria-live="polite">
        @if (IsLoading)
        {
            <LoadProgress Progress="progress" OnCancel="CancelLoad" />
        }
        @if (error is not null)
        {
            <div class="card border-primary/50" role="alert">
                <p class="font-semibold">Could not load the replay</p>
                <p class="mt-1 text-sm text-ink-muted">@error</p>
            </div>
        }
    </div>
</section>

<section class="mx-auto mt-14 max-w-4xl" aria-labelledby="home-explore">
    <h2 id="home-explore" class="text-xs font-semibold uppercase tracking-wide text-ink-faint">Look around</h2>
    <div class="mt-4 grid grid-cols-1 gap-6 md:grid-cols-2">
        <a href="@MapLinks.Map(map.Folder)" class="@CardClass">
            @* The preview fills the panel twice: blurred behind, whole in front. The vault's previews
               have a thin black frame, which the slight zoom of the front one cuts off. *@
            <div class="relative -mx-4 -mt-4 flex h-64 items-center justify-center overflow-hidden border-b border-edge bg-raised sm:-mx-6 sm:-mt-6 sm:h-72" aria-hidden="true">
                <img src="@MapPreviews.Url(map.Folder)" alt="" loading="lazy"
                     class="absolute inset-0 h-full w-full scale-125 object-cover opacity-70 blur-2xl" />
                <span class="relative aspect-square h-[85%] overflow-hidden rounded-lg shadow-xl ring-1 ring-black/20 transition duration-500 group-hover:scale-105">
                    <img src="@MapPreviews.Url(map.Folder)" alt="" loading="lazy" class="h-full w-full scale-[1.04] object-cover" />
                </span>
            </div>
            <p class="mt-6 font-display text-sm font-bold tracking-[0.2em] text-primary">MAPS</p>
            <h3 class="mt-1 text-2xl font-bold text-ink">@map.Name</h3>
            <p class="mt-1 font-mono text-sm text-primary">@MapSizes.Kilometres(map.Size) · @map.Players players · by @map.Author</p>
            <p class="mt-3 text-[16px] leading-relaxed text-ink-muted">
                Every map in the vault has a page of its own. See its terrain, where the mass is, how units can
                move across it and how much there is to reclaim.
            </p>
            <p class="mt-auto pt-6 text-sm font-semibold text-primary">
                Open the map <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">→</span>
            </p>
        </a>

        <a href="@UnitLinks.History([unit.BlueprintId])" class="@CardClass">
            @* Its numbers in one release, as decoration: its history shows the current ones. *@
            <div class="-mx-4 -mt-4 flex h-64 flex-col items-center justify-center gap-5 border-b border-edge bg-raised sm:-mx-6 sm:-mt-6 sm:h-72" aria-hidden="true">
                <span class="rounded-lg border border-edge bg-surface p-1.5 transition duration-500 group-hover:scale-110 group-hover:border-primary">
                    <UnitIcon BlueprintId="@unit.BlueprintId" Size="96" Title="" />
                </span>
                <span class="flex gap-2 font-mono text-sm">
                    @foreach ((string label, string value) in unit.Stats)
                    {
                        <span class="flex flex-col items-center rounded-md border border-edge bg-surface px-3 py-1.5">
                            <span class="text-xs text-ink-muted">@label</span>
                            <span class="font-semibold text-primary">@value</span>
                        </span>
                    }
                </span>
            </div>
            <p class="mt-6 font-display text-sm font-bold tracking-[0.2em] text-primary">UNITS</p>
            <h3 class="mt-1 text-2xl font-bold text-ink">@unit.Name</h3>
            <p class="mt-1 font-mono text-sm text-primary">@unit.Faction.DisplayName() · @unit.Tech · @unit.Description</p>
            <p class="mt-3 text-[16px] leading-relaxed text-ink-muted">
                Every unit of every FAF release. Follow how its cost, health and weapons changed over
                the years, release by release.
            </p>
            <p class="mt-auto pt-6 text-sm font-semibold text-primary">
                See its history <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">→</span>
            </p>
        </a>

        <a href="@PlayerLinks.Landing" class="@CardClass md:col-span-2">
            <p class="font-display text-sm font-bold tracking-[0.2em] text-primary">PLAYERS</p>
            <h3 class="mt-1 text-2xl font-bold text-ink">Look up a player</h3>
            <p class="mt-1 font-mono text-sm text-primary">Rating history · Matches · Rankings · Leagues</p>
            <p class="mt-3 max-w-2xl text-[16px] leading-relaxed text-ink-muted">
                Find a player by name and follow their rating, their games and their factions, see who leads
                each leaderboard and where everyone stands in the leagues, or compare two players side by side.
                Sign in with your FAForever account to read it.
            </p>
            <p class="mt-6 text-sm font-semibold text-primary">
                Open Players <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">→</span>
            </p>
        </a>
    </div>
</section>

<section class="mx-auto mt-14 max-w-4xl" aria-labelledby="home-about">
    <h2 id="home-about" class="text-xs font-semibold uppercase tracking-wide text-ink-faint">About</h2>
    <a href="about" class="@CardClass mt-4">
        <h3 class="text-2xl font-bold text-ink">How Vault of FAForever reads your games</h3>
        <p class="mt-1 font-mono text-sm text-primary">.fafreplay · .scfareplay · .bp</p>
        <p class="mt-3 max-w-2xl text-[16px] leading-relaxed text-ink-muted">
            Everything happens in your own browser. Read what is inside a replay and a blueprint, explained
            for players, and find the places where the FAF community meets.
        </p>
        <p class="mt-6 text-sm font-semibold text-primary">
            Read about it <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">→</span>
        </p>
    </a>
</section>

@code {
    private const int ExampleReplayId = 25692731;

    // Picked once per visit: a new instance of the page is a new pick.
    private readonly ExampleMap map = HomeExamples.PickMap();
    private readonly ExampleUnit unit = HomeExamples.PickUnit();

    private const string CardClass = "card group relative flex flex-col overflow-hidden transition hover:border-primary hover:shadow-[0_0_60px_-24px_var(--th-glow)]";

    private string vaultReplayId = string.Empty;
    private ElementReference vaultReplayInput;
    private string? error;
    private ReplayLoadProgress? progress;
    private CancellationTokenSource? loadCancellation;
    private DotNetObjectReference<Home>? launchListener;

    private bool IsLoading => loadCancellation is not null;

    private bool CanOpenVaultReplay => !IsLoading && NormalizeReplayId() is not null;

    private void OpenVaultReplay()
    {
        if (NormalizeReplayId() is int replayId)
        {
            Navigation.NavigateTo($"replays/{replayId}");
        }
    }

    private void OpenExampleReplay()
    {
        vaultReplayId = ExampleReplayId.ToString(System.Globalization.CultureInfo.InvariantCulture);
        OpenVaultReplay();
    }

    // The FAF client copies a replay as a link (https://replay.faforever.com/25692731); keep just the id.
    private void ExtractReplayIdFromLink()
    {
        if (TryParseFafReplayLink(vaultReplayId.Trim(), out int replayId))
        {
            vaultReplayId = replayId.ToString(System.Globalization.CultureInfo.InvariantCulture);
        }
    }

    private static bool TryParseFafReplayLink(string candidate, out int replayId)
    {
        replayId = 0;
        return Uri.TryCreate(candidate, UriKind.Absolute, out Uri? link)
            && link.Host.Equals("replay.faforever.com", StringComparison.OrdinalIgnoreCase)
            && int.TryParse(link.AbsolutePath.Trim('/'), out replayId) && replayId > 0;
    }

    protected override void OnInitialized()
    {
        // Web Share Target (manifest.webmanifest): sharing to the installed app opens it here with
        // the shared title, text and url. Apps put a link in any of them, often amid other text.
        string[] shared = new[] { "url", "text", "title" }
            .Select(name => UrlQuery.Get(Navigation, name))
            .OfType<string>()
            .Where(value => value.Length > 0)
            .ToArray();
        if (shared.Length > 0)
        {
            OpenSharedLink(shared);
        }
    }

    /// <summary>
    /// Opens what was shared: a link into this app as is (it carries its view), a FAF replay link or
    /// a bare replay id as that replay. Anything else lands in the replay input, to be fixed by hand.
    /// </summary>
    private void OpenSharedLink(string[] shared)
    {
        foreach (string value in shared)
        {
            string[] words = value.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries);
            foreach (string word in words)
            {
                if (word.StartsWith(Navigation.BaseUri, StringComparison.OrdinalIgnoreCase))
                {
                    Navigation.NavigateTo(word, replace: true);
                    return;
                }

                // A number only counts as an id when it is all that was shared, not "3 replays".
                if (TryParseFafReplayLink(word, out int replayId)
                    || words.Length == 1 && int.TryParse(word.TrimStart('#'), out replayId) && replayId > 0)
                {
                    Navigation.NavigateTo($"replays/{replayId}", replace: true);
                    return;
                }
            }
        }

        vaultReplayId = shared[0];
        Navigation.NavigateTo("", replace: true);
    }

    private int? NormalizeReplayId()
    {
        string candidate = vaultReplayId.Trim().TrimStart('#');
        return int.TryParse(candidate, out int replayId) && replayId > 0 ? replayId : null;
    }

    private Task OnFileSelected(InputFileChangeEventArgs args)
    {
        IBrowserFile file = args.File;
        return LoadFileAsync(file.Name, cancellationToken => Task.FromResult(file.OpenReadStream(LocalReplayLoader.MaxReplayFileBytes, cancellationToken)));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Ready to paste a replay id or link right away.
            await vaultReplayInput.FocusAsync();

            // The installed app opens .fafreplay and .scfareplay files ("Open with"); see js/app.js.
            launchListener = DotNetObjectReference.Create(this);
            if (await JS.InvokeAsync<bool>("fafReplay.onFileLaunched", launchListener))
            {
                await OnFileLaunched();
            }
        }
    }

    [JSInvokable]
    public async Task OnFileLaunched()
    {
        if (IsLoading || await JS.InvokeAsync<string?>("fafReplay.takeLaunchedFileName") is not string fileName)
        {
            return;
        }

        await using IJSStreamReference content = await JS.InvokeAsync<IJSStreamReference>("fafReplay.takeLaunchedFileContent");
        await LoadFileAsync(fileName, async cancellationToken => await content.OpenReadStreamAsync(LocalReplayLoader.MaxReplayFileBytes, cancellationToken));
        StateHasChanged();
    }

    private async Task LoadFileAsync(string fileName, Func<CancellationToken, Task<Stream>> openRead)
    {
        error = null;
        using CancellationTokenSource cancellation = new();
        loadCancellation = cancellation;
        try
        {
            error = await Opener.OpenAsync(fileName, openRead, new Progress<ReplayLoadProgress>(OnProgress), cancellation.Token);
        }
        finally
        {
            loadCancellation = null;
            progress = null;
        }
    }

    private void OnProgress(ReplayLoadProgress update)
    {
        progress = update;
        StateHasChanged();
    }

    private void CancelLoad() => loadCancellation?.Cancel();

    public void Dispose()
    {
        loadCancellation?.Cancel();
        if (launchListener is not null)
        {
            _ = JS.InvokeVoidAsync("fafReplay.offFileLaunched").AsTask().ContinueWith(_ => launchListener.Dispose());
        }
    }
}
