@page "/players/{Id:int}"
@inherits UrlStateComponent

@* A player's profile, by id: the header and a tab per way to look at the player. The tab is in the
   address (?tab=rating, matches or army; Overview has none), the other parameters belong to the
   tabs. Every number comes from the FAF API, so a signed out visitor gets the login gate under the
   header. Wave 31 draws the chrome; the tabs fill in with the API data. *@

<PageTitle>@(name ?? $"Player {Id}") · Vault of FAForever</PageTitle>

<a href="@PlayerLinks.Landing" class="text-sm text-ink-muted transition hover:text-primary">← Players</a>

<div class="mt-3">
    <PlayerHeader Id="Id" Name="@name" ClanTag="@clanTag" ClanName="@clanName" MemberSince="memberSince" FormerNames="formerNames">
        <Actions>
            <a href="@PlayerLinks.CompareWith(Id)" class="btn-secondary min-h-11">Compare with…</a>
            <ShareButton Title="@ShareTitle" Class="btn-secondary min-h-11 gap-1.5 px-3" />
        </Actions>
    </PlayerHeader>
</div>

<AuthorizeView>
    <NotAuthorized>
        <PlayersLoginGate What="this player" />
    </NotAuthorized>
    <Authorized>
        <nav class="tab-strip mt-6 border-b border-edge pb-px" aria-label="Player sections">
            @foreach (PlayerTab tab in Enum.GetValues<PlayerTab>())
            {
                bool active = tab == activeTab;
                <button type="button" id="@($"player-tab-{tab.ToString().ToLowerInvariant()}")" aria-current="@(active ? "page" : null)"
                        class="@(active ? ActiveTabClass : TabClass) inline-flex min-h-11 items-center" @onclick="() => SelectTab(tab)">
                    @PlayerLinks.TabLabel(tab)
                </button>
            }
        </nav>

        <div class="py-6">
            @switch (activeTab)
            {
                case PlayerTab.Rating:
                    <RatingHistoryTab PlayerId="Id" />
                    break;
                case PlayerTab.Matches:
                    <MatchesTab PlayerId="Id" />
                    break;
                case PlayerTab.Army:
                    <ArmyTab PlayerId="Id" />
                    break;
                default:
                    <ProfileOverview PlayerId="Id" />
                    break;
            }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private const string TabClass = "shrink-0 cursor-pointer whitespace-nowrap rounded-t-md px-3 py-2 text-sm font-medium text-ink-muted transition hover:bg-raised hover:text-ink sm:px-4";
    private const string ActiveTabClass = "shrink-0 cursor-pointer whitespace-nowrap rounded-t-md border-b-2 border-primary bg-raised px-3 py-2 text-sm font-semibold text-primary sm:px-4";

    [Parameter] public int Id { get; set; }

    private PlayerTab activeTab;

    // What the header shows. Not loaded yet: the header then says "Player {id}".
    private string? name = null;
    private string? clanTag = null;
    private string? clanName = null;
    private DateTimeOffset? memberSince = null;
    private IReadOnlyList<FormerName>? formerNames = null;

    private string ShareTitle => $"{name ?? $"Player {Id}"} · {PlayerLinks.TabLabel(activeTab)}";

    protected override void OnParametersSet()
        => activeTab = PlayerLinks.ParseTab(UrlQuery.Get(Navigation, PlayerLinks.TabParameter));

    /// <summary>Switching tabs leaves the filters alone, except the page of a list.</summary>
    private void SelectTab(PlayerTab tab)
    {
        var parameters = new Dictionary<string, object?>
        {
            [PlayerLinks.TabParameter] = PlayerLinks.TabToken(tab),
            ["page"] = null,
        };
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(parameters), replace: true);
    }
}
