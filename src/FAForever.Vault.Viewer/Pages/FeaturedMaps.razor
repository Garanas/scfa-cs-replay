@page "/maps/featured"
@inject FafApiClient Api
@inject AuthService Auth

@* The featured maps ("recommended" in the API, 33 visible on 2026-10-06), all on one page, the
   most played first. No filters: the list is short enough to read whole. *@

<PageTitle>Featured maps · Vault of FAForever</PageTitle>

<a href="@MapLinks.Landing" class="text-sm text-ink-muted transition hover:text-primary">← Maps</a>
<h1 class="mt-2 text-2xl font-bold">Featured maps</h1>
<p class="mt-1 text-sm text-ink-muted">
    A short list of high quality maps, chosen by the FAF team.
</p>

<AuthorizeView>
    <NotAuthorized>
        <div class="card mt-6 max-w-xl text-center">
            <p class="font-semibold">Sign in to see the featured maps</p>
            <p class="mt-2 text-sm text-ink-muted">
                The FAForever API requires a signed-in account to browse the map vault.
            </p>
            <button type="button" class="btn-primary mt-4" @onclick="() => Auth.BeginLoginAsync()">Sign in with FAForever</button>
        </div>
    </NotAuthorized>
    <Authorized>
        @if (error is not null)
        {
            <div class="card mt-6" role="alert">
                <p class="font-semibold">The featured maps could not be loaded</p>
                <p class="mt-1 text-sm text-ink-muted">@error</p>
            </div>
        }
        else if (result is null)
        {
            <div class="card mt-6 animate-pulse text-center text-sm text-ink-muted">Loading the featured maps&hellip;</div>
        }
        else if (result.Maps.Count == 0)
        {
            <div class="card mt-6 text-center text-sm text-ink-muted">There are no featured maps right now.</div>
        }
        else
        {
            <p class="mt-6 text-sm text-ink-muted">@result.Maps.Count @(result.Maps.Count == 1 ? "map" : "maps"), the most played first</p>
            <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                @foreach (MapSummary map in result.Maps)
                {
                    <MapCard @key="map.Id" Map="map" />
                }
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    private MapSearchResult? result;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // One page holds them all; the API allows pages of up to 100.
            result = await Api.SearchMapsAsync(new MapSearchQuery { FeaturedOnly = true, PageSize = 100 }, CancellationToken.None);
        }
        catch (NotAuthenticatedException)
        {
            error = "Your session has expired. Sign in again to see the featured maps.";
        }
        catch (HttpRequestException exception)
        {
            error = $"The FAForever API could not be reached: {exception.Message}";
        }
    }
}
