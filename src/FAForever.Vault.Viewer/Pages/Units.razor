@page "/units"
@using FAForever.Vault.Viewer.Features.Units
@inject NavigationManager Navigation

@* The entry to the unit pages (the Units tab in the header): a card for the unit database and one
   for the unit history. Same writing style as the About pages: simple English, short sentences, no
   hyphens, underscores or dashes in the visible text. *@

<PageTitle>Units · Vault of FAF</PageTitle>

<section class="py-10 sm:py-14">
    <p class="font-display text-sm font-bold tracking-[0.2em] text-primary">UNITS</p>
    <h1 class="mt-2 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">Every unit, in every version</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted">
        FAF changes the game with every release. Here you can look up what a unit is today,
        and see how it got there.
    </p>
</section>

<div class="grid gap-6 md:grid-cols-2">
    <a href="@UnitLinks.Database" class="card group relative flex flex-col overflow-hidden transition hover:border-primary hover:shadow-[0_0_60px_-24px_var(--th-glow)]">
        @* A row of the units the list holds: the tanks and commanders of each faction. *@
        <div class="flex min-h-14 flex-wrap items-center gap-1.5" aria-hidden="true">
            @foreach (string id in DatabaseIcons)
            {
                @* Seven fit beside each other on a phone. *@
                <span class="rounded-md border border-edge bg-raised p-1 transition group-hover:border-primary max-sm:last:hidden">
                    <UnitIcon BlueprintId="@id" Size="28" Title="" />
                </span>
            }
        </div>
        <h2 class="mt-6 text-2xl font-bold text-ink">The unit database</h2>
        <p class="mt-1 font-mono text-sm text-primary">every unit · one game version</p>
        <p class="mt-3 text-[16px] leading-relaxed text-ink-muted">
            All units of one release, as its blueprints define them. Filter by faction, tech level or role,
            sort by cost or range, and put units side by side to compare them.
        </p>
        <p class="mt-6 text-sm font-semibold text-primary">
            Open the database <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">→</span>
        </p>
    </a>

    <a href="@UnitLinks.HistoryPage" class="card group relative flex flex-col overflow-hidden transition hover:border-primary hover:shadow-[0_0_60px_-24px_var(--th-glow)]">
        @* One unit along a row of versions, a mark where it changed. *@
        <div class="flex h-14 items-center gap-1.5 font-mono text-sm" aria-hidden="true">
            <span class="rounded-md border border-edge bg-raised p-1 transition group-hover:border-primary">
                <UnitIcon BlueprintId="uel0201" Size="28" Title="" />
            </span>
            @foreach ((string version, string mark) in HistorySteps)
            {
                <span class="flex w-12 flex-col items-center rounded-md border border-edge bg-raised py-1">
                    <span class="text-ink-muted">@version</span>
                    <span class="font-semibold text-primary transition group-hover:scale-125">@mark</span>
                </span>
            }
            <span class="self-center pl-1 text-ink-faint">…</span>
        </div>
        <h2 class="mt-6 text-2xl font-bold text-ink">The unit history</h2>
        <p class="mt-1 font-mono text-sm text-primary">one unit · every game version</p>
        <p class="mt-3 text-[16px] leading-relaxed text-ink-muted">
            Follow a unit through every release since @UnitHistoryFrom. See which values went up or down,
            and when. Put up to six units on one page.
        </p>
        <p class="mt-6 text-sm font-semibold text-primary">
            Open the history <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">→</span>
        </p>
    </a>
</div>

@code {
    private static readonly string[] DatabaseIcons =
        ["uel0201", "ual0201", "url0107", "xsl0201", "uel0001", "ual0001", "url0001", "xsl0001"];

    // Decoration, not data: what a history looks like, a version and whether a value rose or fell.
    private static readonly (string Version, string Mark)[] HistorySteps =
        [("3801", "•"), ("3812", "▲"), ("3824", "▼"), ("3839", "▲")];

    /// <summary>The first game version with unit data.</summary>
    private const int UnitHistoryFrom = 3801;

    // Before the landing page, /units was the database: a link to it with a selection
    // (/units?unit=uel0201) still opens that view.
    protected override void OnInitialized()
    {
        string query = new Uri(Navigation.Uri).Query;
        if (query.Length > 1)
        {
            Navigation.NavigateTo(UnitLinks.Database + query, replace: true);
        }
    }
}
