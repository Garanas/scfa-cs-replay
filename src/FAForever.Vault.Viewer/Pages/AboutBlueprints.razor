@page "/about/blueprints"
@using System.Globalization
@using FAForever.FileFormats.Blueprints
@using FAForever.Vault.Viewer.Features.Units
@using FAForever.Vault.Viewer.Services.Units
@using static FAForever.Vault.Viewer.Features.About.ExampleBlueprint
@inject UnitDatabase Database

@* An explainer for players, not programmers: how a game can be made of data, told through one
   unit. All numbers come from release 3839 (ExampleBlueprint). Writing style, on request of the
   owner: simple English, short sentences, and no hyphens, underscores or dashes in the visible
   prose. Quoted blueprint and script code is shown as the game writes it. *@

<PageTitle>Blueprints · Vault of FAF</PageTitle>

<nav class="text-sm text-ink-faint" aria-label="Breadcrumb">
    <a href="about" class="transition hover:text-ink">About</a>
    <span class="mx-1.5" aria-hidden="true">/</span>
    <span class="text-ink-muted">Blueprints</span>
</nav>

@* Hero: the promise of the page, next to the real first lines of the Fatboy's blueprint. *@
<header class="mt-6 grid grid-cols-1 items-center gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
    <div>
        <p class="font-display text-sm font-bold tracking-[0.2em] text-primary">FILE FORMATS</p>
        <h1 class="mt-2 text-4xl font-extrabold tracking-tight sm:text-5xl">Inside a blueprint</h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-muted">
            Every unit in the game is described in a text file: its blueprint.
            This page opens the blueprint of the Fatboy and shows how a whole game can be built from files like it.
        </p>
        <p class="mt-3 text-lg leading-relaxed text-ink-muted">You do not need to know how to program. Curiosity is enough.</p>
        <div class="mt-7 flex flex-wrap gap-3">
            <a href="about/blueprints#idea" class="btn-primary">Start reading</a>
            <a href="@DatabaseLink" class="btn-secondary">See the Fatboy in the database</a>
        </div>
    </div>

    <figure class="card relative overflow-hidden p-0 shadow-[0_0_60px_-20px_var(--th-glow)]">
        <figcaption class="flex items-center justify-between border-b border-edge px-4 py-2.5 text-xs text-ink-faint">
            <span class="flex items-center gap-1.5" aria-hidden="true">
                <span class="h-2.5 w-2.5 rounded-full bg-viz-8/70"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-viz-4/70"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-viz-3/70"></span>
            </span>
            <span>The first lines of the Fatboy</span>
        </figcaption>
        <div class="overflow-x-auto px-4 py-4 font-mono text-[13px] leading-6 sm:text-sm">
            @for (int i = 0; i < HeroLines.Length; i++)
            {
                <div class="flex gap-4 whitespace-pre">
                    <span class="w-5 shrink-0 text-right text-ink-faint">@(HeroLines[i].Number)</span>
                    <span class="text-ink">@HeroLines[i].Text</span>
                </div>
            }
            <div class="flex gap-4 text-ink-faint/60" aria-hidden="true">
                <span class="w-5 shrink-0"></span><span>… and @((Lines.Count - HeroLines[^1].Number).ToString("N0", CultureInfo.InvariantCulture)) lines more</span>
            </div>
        </div>
    </figure>
</header>

@* The example in four numbers. *@
<section class="mt-12 grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="The Fatboy in numbers">
    @foreach ((string value, string label) in HeroStats)
    {
        <div class="card p-5">
            <p class="font-display text-3xl font-bold text-ink">@value</p>
            <p class="mt-1 text-sm text-ink-muted">@label</p>
        </div>
    }
</section>
<p class="mt-3 text-sm text-ink-faint">
    Every number on this page comes from release @GameVersion of FAF, from August 2026.
</p>

<div class="mt-14 grid grid-cols-1 gap-12 xl:grid-cols-[190px_minmax(0,1fr)]">
    <aside class="hidden xl:block">
        <nav class="sticky top-24" aria-label="Chapters">
            <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-ink-faint">On this page</p>
            <ol class="space-y-1 text-sm">
                @foreach ((string id, string number, string title) in Chapters)
                {
                    <li>
                        <a href="about/blueprints#@id" class="flex gap-2.5 rounded-md px-2 py-1 text-ink-muted transition hover:bg-raised hover:text-ink">
                            <span class="font-mono text-xs leading-5 text-primary">@number</span>
                            <span>@title</span>
                        </a>
                    </li>
                }
            </ol>
        </nav>
    </aside>

    <article class="max-w-3xl space-y-16">

        <AboutChapter Id="idea" Number="01" Title="A game made of data">
            <p>
                A Mantis and a Fatboy could not be more different. Yet the game uses the same program for both.
                That program knows how to move a unit, aim a gun and build. What it does not know is <strong>what a Fatboy is</strong>.
                That comes from a file: the blueprint.
            </p>
            <p>
                Programmers call this <strong>data driven</strong>. The program stays the same,
                and the data makes every unit what it is. Supreme Commander is built from three layers:
            </p>
            <ol class="grid gap-4 sm:grid-cols-3">
                @for (int i = 0; i < Layers.Length; i++)
                {
                    (string title, string text) = Layers[i];
                    <li class="rounded-xl border border-edge bg-surface p-5">
                        <p class="font-mono text-xs font-bold text-primary">LAYER @(i + 1)</p>
                        <p class="mt-1 font-display font-bold text-ink">@title</p>
                        <p class="mt-2 text-sm leading-relaxed text-ink-muted">@text</p>
                    </li>
                }
            </ol>
            <p>
                This is why a balance patch can be tiny. In release @MobileFactoryVersion, the build power of the Fatboy went from 180 to 135.
                That change is one line in its blueprint. It is also why mods work:
                a mod adds or changes blueprints, and the program does the rest.
            </p>
            <p class="rounded-xl border-l-4 border-primary bg-raised px-5 py-4 text-[16px]">
                <strong>Blueprint</strong> is the word the game itself uses. Like the blueprint of a house, it describes a thing once.
                Every Fatboy on the battlefield is built from that same description.
            </p>
        </AboutChapter>

        <AboutChapter Id="text" Number="02" Title="Text you can read">
            <p>
                A replay is a long row of bytes, glued together. To read it, you have to know the size and order of every piece.
                A blueprint is the opposite. It is <strong>plain text</strong>. You could open it in Notepad.
            </p>
            <div class="card overflow-x-auto font-mono text-sm leading-6">
                @foreach (string line in DefenseSnippet)
                {
                    <p class="whitespace-pre text-ink">@line</p>
                }
            </div>
            <p>
                Every value has a <strong>name</strong> in front of it. You do not need to count anything:
                <code class="font-mono text-ink">MaxHealth = 12500</code> says it all. Because of the names, the order does not matter either.
                The game finds MaxHealth wherever it is.
            </p>
            <p>The file can even talk to people. Everything after two dashes is a note. The game skips it:</p>
            <div class="card overflow-x-auto font-mono text-sm leading-6">
                <pre><span class="text-ink">RateOfFire = 10/10, </span><span class="text-ink-faint">--10/integer interval in ticks</span></pre>
            </div>
            <p>
                The language of the file is <strong>Lua</strong>. The game is full of it: it also stores lobby settings in a replay as Lua,
                and it writes the behaviour of units in it too. We will get back to that.
            </p>
        </AboutChapter>

        <AboutChapter Id="blocks" Number="03" Title="The building blocks">
            <p>A blueprint is made of only a few kinds of values:</p>
            <div class="grid gap-3 sm:grid-cols-2">
                @foreach ((string title, string example, string result, string text) in BuildingBlocks)
                {
                    <div class="rounded-xl border border-edge bg-surface p-5">
                        <p class="font-display font-bold text-ink">@title</p>
                        <p class="mt-2 text-sm leading-relaxed text-ink-muted">@text</p>
                        <p class="mt-3 flex flex-wrap items-center gap-2 font-mono text-sm">
                            <span class="rounded-md border border-edge bg-raised px-2 py-0.5 text-ink">@example</span>
                            <span class="text-ink-faint" aria-hidden="true">→</span>
                            <span class="font-semibold text-primary">@result</span>
                        </p>
                    </div>
                }
            </div>
            <p>
                Tables can hold tables, which can hold tables again. That is how one file holds ten weapons,
                each with its own settings, and each of those with lists of their own.
            </p>
            <p>
                The whole file is one big table, handed to a single word at the very top: <code class="font-mono text-ink">UnitBlueprint</code>.
                That word tells the game what kind of blueprint follows. Sounds use the same trick:
                <code class="font-mono text-ink">Sound { ... }</code> turns a small table into a sound.
            </p>
        </AboutChapter>

        <AboutChapter Id="tour" Number="04" Title="A walk through the Fatboy">
            <p>
                Here is the whole blueprint of the Fatboy, all @Lines.Count.ToString("N0", CultureInfo.InvariantCulture) lines,
                exactly as release @GameVersion has it. <strong>Pick a part to see what it does.</strong>
            </p>
            <div class="card">
                <AnnotatedBlueprint />
            </div>
            <div class="card">
                <h3 class="mb-5 text-lg font-bold text-ink">Where the lines go</h3>
                <div class="flex h-7 w-full overflow-hidden rounded-full bg-raised" role="img"
                     aria-label="@string.Join(", ", Shares.Select(share => $"{share.Label} {SharePercent(share)}"))">
                    @foreach (PartShare share in Shares)
                    {
                        <span class="@AnnotatedBytes.Swatch(share.Tone) h-full border-r-2 border-surface last:border-r-0" style="width: @ShareWidth(share)" title="@share.Label: @SharePercent(share)"></span>
                    }
                </div>
                <table class="mt-5 w-full text-sm">
                    <thead>
                        <tr class="border-b border-edge text-left text-xs uppercase tracking-wide text-ink-faint">
                            <th class="py-2 font-semibold">Part</th>
                            <th class="py-2 text-right font-semibold">Share</th>
                            <th class="py-2 text-right font-semibold">Lines</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (PartShare share in Shares)
                        {
                            <tr class="border-b border-edge/60 last:border-0">
                                <td class="py-2">
                                    <span class="flex items-center gap-2.5">
                                        <span class="h-3 w-3 shrink-0 rounded-sm @AnnotatedBytes.Swatch(share.Tone)" aria-hidden="true"></span>
                                        <span class="text-ink">@share.Label</span>
                                    </span>
                                </td>
                                <td class="py-2 text-right font-mono font-semibold text-ink">@SharePercent(share)</td>
                                <td class="py-2 text-right font-mono text-ink-muted">@share.Lines.ToString("N0", CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p>
                Two thirds of the file are weapons. Every weapon spells out all of its settings,
                so each of the four Gauss cannons takes almost 80 lines, although they are nearly the same.
                Gameplay is only part of the story: a good share of the file is about what you see and hear.
            </p>
        </AboutChapter>

        <AboutChapter Id="categories" Number="05" Title="Categories hold it together">
            <p>
                The Fatboy has @CategoryCount categories. They are labels in capitals, such as <strong>LAND</strong>,
                <strong>EXPERIMENTAL</strong> and <strong>UEF</strong>. On their own they do nothing.
                Their power is that the rest of the game <strong>searches by them</strong>.
            </p>
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="rounded-xl border border-edge bg-surface p-5">
                    <p class="font-display font-bold text-ink">Who can build it</p>
                    <p class="mt-2 flex flex-wrap gap-1.5 font-mono text-xs">
                        <span class="badge">BUILTBYTIER3ENGINEER</span>
                        <span class="badge">BUILTBYTIER3COMMANDER</span>
                    </p>
                    <p class="mt-3 text-sm leading-relaxed text-ink-muted">
                        A tech 3 engineer looks for units with the first label. A Commander with the tech 3 upgrade, or a support commander, looks for the second.
                    </p>
                </div>
                <div class="rounded-xl border border-edge bg-surface p-5">
                    <p class="font-display font-bold text-ink">What it shoots first</p>
                    <p class="mt-2 flex flex-wrap gap-1.5 font-mono text-xs">
                        <span class="badge">EXPERIMENTAL</span>
                        <span class="badge">SUBCOMMANDER</span>
                        <span class="badge">TECH3 MOBILE</span>
                    </p>
                    <p class="mt-3 text-sm leading-relaxed text-ink-muted">
                        Each Gauss cannon has a list of targets in order. Other experimentals come first, then support commanders, then tech 3 units.
                    </p>
                </div>
            </div>
            <div class="card">
                <h3 class="text-lg font-bold text-ink">What it builds</h3>
                <p class="mt-2 text-[16px]">
                    The Fatboy is a factory too. Its build list is not a list of units. It is a list of labels:
                </p>
                <p class="mt-3 overflow-x-auto font-mono text-sm text-ink">"BUILTBYTIER3FACTORY UEF MOBILE LAND"</p>
                <p class="mt-3 text-[16px]">
                    Every unit that carries <strong>all four</strong> of these labels can roll out of the Fatboy. In release @GameVersion, that is @Builds.Length units:
                </p>
                <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="The units the Fatboy builds">
                    @foreach (string id in Builds)
                    {
                        <li class="rounded-md border border-edge bg-raised p-1">
                            <UnitIcon BlueprintId="@id" Size="36" Title="@(UnitNames.GetOrNull(id) ?? id)" />
                        </li>
                    }
                </ul>
                <p class="mt-4 text-sm leading-relaxed text-ink-muted">
                    The nice thing: a new UEF tank with these labels shows up in the Fatboy by itself. Nobody has to add it to a list.
                </p>
            </div>
            <p>
                Even the name of the blueprint is a code. Take <strong>uel0401</strong>. The <strong>u</strong> means it comes from the first game;
                units added in Forged Alliance start with an x. The <strong>e</strong> is for UEF, the <strong>l</strong> for land,
                and <strong>0401</strong> is its number. Numbers in the 400s are experimentals.
            </p>
        </AboutChapter>

        <AboutChapter Id="kinds" Number="06" Title="Many kinds of blueprints">
            <p>
                Units are only one kind. The game has @KindsTotal.ToString("N0", CultureInfo.InvariantCulture) blueprints, and most of them are not units at all:
            </p>
            <div class="card space-y-3">
                @foreach ((string kind, int count, string text) in Kinds)
                {
                    <div class="grid grid-cols-[6.5rem_minmax(0,1fr)_3.5rem] items-center gap-3 sm:grid-cols-[7rem_minmax(0,1fr)_4rem]">
                        <span class="font-semibold text-ink">@kind</span>
                        <span class="min-w-0">
                            <span class="block h-3 overflow-hidden rounded-full bg-raised">
                                <span class="block h-full rounded-full bg-primary" style="width: @((count * 100.0 / Kinds[0].Count).ToString("0.#", CultureInfo.InvariantCulture))%"></span>
                            </span>
                            <span class="mt-1 block text-xs text-ink-faint">@text</span>
                        </span>
                        <span class="text-right font-mono text-sm text-ink">@count.ToString("N0", CultureInfo.InvariantCulture)</span>
                    </div>
                }
            </div>
            <p>
                They point at each other by name. Follow one shot of the Fatboy and you pass through four kinds of blueprint:
            </p>
            <ol class="grid gap-2 sm:grid-cols-4" aria-label="From unit to explosion">
                @for (int i = 0; i < ShotChain.Length; i++)
                {
                    (string kind, string name, string text) = ShotChain[i];
                    <li class="relative rounded-xl border @(i == ShotChain.Length - 1 ? "border-primary/60 bg-primary/10" : "border-edge bg-surface") px-4 py-4">
                        <p class="font-mono text-xs font-bold text-primary">@kind</p>
                        <p class="mt-1 break-words font-display font-bold text-ink">@name</p>
                        <p class="mt-1 text-sm text-ink-muted">@text</p>
                        @if (i < ShotChain.Length - 1)
                        {
                            <span class="absolute -right-2.5 top-1/2 z-10 hidden -translate-y-1/2 text-primary sm:block" aria-hidden="true">▶</span>
                        }
                    </li>
                }
            </ol>
            <p>
                Effects deserve a closer look. An <strong>emitter</strong> is a recipe for particles: sparks, smoke, dust, a flash.
                Its blueprint holds 21 curves. Each curve says how one thing changes during the short life of a particle:
                its size, its speed, its colour, how fast it spins. A <strong>trail</strong> is the streak behind a shell,
                and a <strong>beam</strong> is a laser drawn between two points.
            </p>
            <p>
                When a Gauss shell of the Fatboy hits the ground, seven emitters go off at once. Together they make one explosion.
                But here is a twist: that list of seven is not in any blueprint. It is in a script. Which brings us to the second file.
            </p>
        </AboutChapter>

        <AboutChapter Id="script" Number="07" Title="The script brings it to life">
            <p>
                Next to the blueprint of every unit sits a second file: its <strong>script</strong>.
                For the Fatboy that is <code class="font-mono text-ink">UEL0401_script.lua</code>, @ScriptLines lines long. All 606 units have one.
            </p>
            <p class="rounded-xl border-l-4 border-primary bg-raised px-5 py-4 text-[16px]">
                The blueprint sets how the Fatboy <strong>behaves</strong>. The script decides how it <strong>reacts</strong> to what happens in the game.
            </p>
            <p>Both files name the same weapons. The name in <strong>Label</strong> is the link between them:</p>
            <div class="grid gap-4 md:grid-cols-2">
                <figure class="card overflow-hidden p-0">
                    <figcaption class="border-b border-edge px-4 py-2.5 text-xs text-ink-faint">The blueprint: the numbers</figcaption>
                    @Code(WeaponInBlueprint)
                </figure>
                <figure class="card overflow-hidden p-0">
                    <figcaption class="border-b border-edge px-4 py-2.5 text-xs text-ink-faint">The script: the behaviour</figcaption>
                    @Code(WeaponInScript)
                </figure>
            </div>
            <p>
                The blueprint holds everything the engine needs to use the cannon: its damage, its range, how often it fires,
                how fast the turret turns and what it shoots first. The engine aims with those numbers.
                The script gives the cannon a <strong>kind of weapon</strong>, a Gauss cannon, which fires the shell and flashes at the muzzle.
                Without that line in the script, the cannon would have all its numbers and never fire.
            </p>
            <p>
                The rest of a script answers <strong>events</strong>. The game calls out when something happens to the unit,
                and the script decides what to do. That is also where a unit gets abilities the blueprint cannot describe.
                A few of the Fatboy's answers:
            </p>
            <div class="grid gap-3 sm:grid-cols-2">
                @foreach ((string name, string title, string text) in Events)
                {
                    <div class="rounded-xl border border-edge bg-surface p-5">
                        <p class="flex flex-wrap items-baseline justify-between gap-x-3">
                            <span class="font-display font-bold text-ink">@title</span>
                            <span class="font-mono text-xs text-ink-faint">@name</span>
                        </p>
                        <p class="mt-2 text-sm leading-relaxed text-ink-muted">@text</p>
                    </div>
                }
            </div>
            <p>
                Blueprints and scripts are not equals. A blueprint is only data, so anyone can read it, including this site.
                A script is a real program that can do anything. That is why everything this site shows about units comes from blueprints.
            </p>
        </AboutChapter>

        <AboutChapter Id="loading" Number="08" Title="From file to game">
            <p>When a game starts, it reads every blueprint there is, in this order:</p>
            <ol class="relative space-y-0 border-l-2 border-edge pl-0">
                @for (int i = 0; i < LoadSteps.Length; i++)
                {
                    (string title, string text) = LoadSteps[i];
                    <li class="relative pb-6 pl-8 last:pb-0">
                        <span class="absolute -left-[13px] top-0 flex h-6 w-6 items-center justify-center rounded-full border-2 border-edge bg-surface font-mono text-[11px] font-bold text-primary">@(i + 1)</span>
                        <p class="font-semibold text-ink">@title</p>
                        <p class="mt-1.5 text-[16px] leading-relaxed">@text</p>
                    </li>
                }
            </ol>
            <p>
                That last step means <strong>what you read is not always what you get</strong>.
                The game adds things on its own. Every unit becomes a category of its own, for example,
                so a build list can name one exact unit. And some values are not in the file at all, such as how often a weapon looks for a new target:
                the game works that out from the rate of fire and the range.
            </p>
            <div class="card">
                <h3 class="text-lg font-bold text-ink">The Fatboy gets a second unit</h3>
                <p class="mt-2 text-[16px]">
                    The biggest change happens to the Fatboy. It has the category <strong>EXTERNALFACTORY</strong>.
                    When the game sees it, it makes a whole new blueprint, <strong>uel0401ef</strong>:
                    a copy of a hidden helper unit, with the build power and the build list of the Fatboy.
                </p>
                <div class="mt-5 grid items-center gap-2 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)]" aria-hidden="true">
                    <div class="space-y-2">
                        <p class="rounded-lg border border-edge bg-raised px-3 py-2 font-mono text-sm text-ink">uel0401 <span class="text-ink-faint">the Fatboy</span></p>
                        <p class="rounded-lg border border-edge bg-raised px-3 py-2 font-mono text-sm text-ink">zxa0002 <span class="text-ink-faint">a hidden helper</span></p>
                    </div>
                    <p class="text-center text-primary">▶</p>
                    <div class="space-y-2">
                        <p class="rounded-lg border border-edge bg-raised px-3 py-2 font-mono text-sm text-ink">uel0401 <span class="text-ink-faint">drives and shoots</span></p>
                        <p class="rounded-lg border border-primary/60 bg-primary/10 px-3 py-2 font-mono text-sm text-ink">uel0401ef <span class="text-ink-faint">rides along and builds</span></p>
                    </div>
                </div>
                <p class="mt-5 text-[16px]">
                    In battle, the helper rides along on the Fatboy and does all the building.
                    That is how the Fatboy can <strong>build while it drives</strong>. It learned this in release @MobileFactoryVersion, in September 2023.
                    Seven units use the trick today, most of them aircraft carriers.
                </p>
            </div>
            <p>
                This is one more reason a replay only works with its own game version.
                Change one number in one blueprint, and the same orders lead to a different game.
            </p>
        </AboutChapter>

        <AboutChapter Id="reading" Number="09" Title="How we read it">
            <p>
                A blueprint is written in Lua, and Lua is a programming language. The game reads a blueprint by running it.
                We do something smaller and safer: we only <strong>work out values</strong>.
            </p>
            <p>
                Our reader understands numbers, texts, yes or no, tables and simple sums, and the few words such as UnitBlueprint and Sound.
                Anything else, like a loop or a new function, it refuses. Blueprints never need those,
                so every one of the 4,569 blueprint files in the game reads fine.
            </p>
            <div class="grid gap-4 sm:grid-cols-3">
                @foreach ((string value, string title, string text) in ReadingFacts)
                {
                    <div class="rounded-xl border border-edge bg-surface p-5">
                        <p class="font-display text-2xl font-bold text-primary">@value</p>
                        <p class="mt-1 font-semibold text-ink">@title</p>
                        <p class="mt-2 text-sm leading-relaxed text-ink-muted">@text</p>
                    </div>
                }
            </div>
            <p>
                One more step keeps the history honest. Not every change to a file is a change to the game.
                Between releases 3801 and @GameVersion, the blueprint of the Fatboy changed in a hundred lines. Some changes were real:
                its shield now comes back twice as fast. Others only changed how a value is written:
            </p>
            <div class="card overflow-x-auto font-mono text-sm leading-7">
                <p class="whitespace-pre text-ink-muted"><span class="text-viz-8">before</span>  RateOfFire = 1.428,</p>
                <p class="whitespace-pre text-ink"><span class="text-viz-3">after </span>  RateOfFire = 10/7,</p>
            </div>
            <p>
                Both mean the same thing. The game can only fire on a tick, a tenth of a second, so both lines mean: fire every 7 ticks.
                We even out changes like that, so the history of a unit only shows what you would notice in a game.
            </p>
        </AboutChapter>

        <AboutChapter Id="answers" Number="10" Title="From data to answers">
            <p>
                Once the blueprints are read, the fun begins. This is the card the site builds from those @Lines.Count.ToString("N0", CultureInfo.InvariantCulture) lines:
            </p>
            <div class="flex justify-center">
                @if (data is not null)
                {
                    <UnitCard BlueprintId="@BlueprintId" Unit="@data.Data.GetOrNull(BlueprintId)" DataVersion="@data.GameVersion" Class="w-full max-w-sm shadow-lg" />
                }
                else
                {
                    <div class="w-full max-w-sm rounded-lg border border-edge bg-surface p-6 text-center text-sm text-ink-faint">
                        @(loadFailed ? "The unit data could not be loaded." : "Loading the unit data…")
                    </div>
                }
            </div>
            <div class="space-y-4">
                <div class="card">
                    <h3 class="text-lg font-bold text-ink">How long does a Percival take?</h3>
                    <p class="mt-2 text-[16px]">
                        Divide the build time of the unit by the build power of the factory.
                        A Percival has a build time of 4,800. The Fatboy has a build power of 135.
                        So one Percival takes <strong>35.6 seconds</strong>, even while the Fatboy is on the move.
                    </p>
                </div>
                <div class="card">
                    <h3 class="text-lg font-bold text-ink">What did a patch change?</h3>
                    <p class="mt-2 text-[16px]">
                        Compare the blueprints of two releases. Release @MobileFactoryVersion turned the Fatboy into a factory on wheels.
                        In its blueprint, it took three changes:
                    </p>
                    <ul class="mt-4 space-y-2">
                        @foreach ((string line, string text) in MobileFactoryChanges)
                        {
                            <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                                <code class="rounded-md bg-raised px-2 py-0.5 font-mono text-sm text-primary">@line</code>
                                <span class="text-sm text-ink-muted">@text</span>
                            </li>
                        }
                    </ul>
                    <p class="mt-4 text-sm leading-relaxed text-ink-muted">
                        The script changed much more: it grew from @ScriptLinesBefore to @ScriptLinesAfter lines.
                        The blueprint file itself has been changed @BlueprintCommits times since 2012.
                    </p>
                </div>
                <div class="rounded-xl border-l-4 border-primary bg-raised px-5 py-4">
                    <h3 class="font-bold text-ink">What a blueprint cannot tell</h3>
                    <p class="mt-2 text-[16px]">
                        A blueprint holds numbers, not behaviour. How much damage the Fatboy deals per second depends on its script
                        and on the game's own math, so the card shows the parts and not the total.
                        And it shows FAF as it is, without mods.
                    </p>
                </div>
            </div>
        </AboutChapter>

        <AboutChapter Id="try" Number="11" Title="Try it yourself">
            <p>
                Every unit of every release is waiting for you. Compare them, follow them through the years,
                or open the files yourself.
            </p>
            <div class="relative overflow-hidden rounded-2xl border border-primary/50 bg-surface p-8 shadow-[0_0_80px_-30px_var(--th-glow)]">
                <h3 class="text-2xl font-bold text-ink">Pick a unit and look inside</h3>
                <p class="mt-2 max-w-xl text-[16px]">
                    Start with the Fatboy, or look up any unit you like.
                </p>
                <div class="mt-6 flex flex-wrap gap-3">
                    <a href="@DatabaseLink" class="btn-primary">The Fatboy in the database</a>
                    <a href="@UnitLinks.History([BlueprintId])" class="btn-secondary">The Fatboy through the years</a>
                    <a href="@($"https://github.com/FAForever/fa/blob/{GameVersion}/units/UEL0401/UEL0401_unit.bp")" target="_blank" rel="noreferrer" class="btn-secondary">The blueprint on GitHub</a>
                    <a href="@($"{BuildInfo.Repository}/tree/main/src/FAForever.FileFormats.Blueprints")" target="_blank" rel="noreferrer" class="btn-secondary">Read our code</a>
                </div>
            </div>
            <p class="text-sm text-ink-faint">
                The blueprints, the scripts and the way the game loads them live in the
                <a href="https://github.com/FAForever/fa" target="_blank" rel="noreferrer" class="text-primary hover:underline">FA repository</a> of FAF.
                Its loader was our guide.
            </p>
        </AboutChapter>
    </article>
</div>

@code {
    private UnitDataVersion? data;
    private bool loadFailed;

    private static readonly string DatabaseLink = $"{UnitLinks.Database}?{UnitLinks.UnitParameter}={BlueprintId}";

    private static readonly (int Number, string Text)[] HeroLines = Lines.Take(10).Select((line, i) => (i + 1, line.Text)).ToArray();

    private static readonly int CategoryCount = Lines.Count(line => line.Text.StartsWith("        \"", StringComparison.Ordinal) && Parts[line.Part].Id == "categories");

    private static readonly int KindsTotal = Kinds.Sum(kind => kind.Count);

    private static readonly (string Value, string Label)[] HeroStats =
    [
        (Lines.Count.ToString("N0", CultureInfo.InvariantCulture), "lines of blueprint"),
        (ScriptLines.ToString(CultureInfo.InvariantCulture), "lines of script"),
        ("10", "weapons in one unit"),
        (Kinds.Sum(kind => kind.Count).ToString("N0", CultureInfo.InvariantCulture), "blueprints in the game"),
    ];

    private static readonly (string Id, string Number, string Title)[] Chapters =
    [
        ("idea", "01", "Made of data"),
        ("text", "02", "Text you can read"),
        ("blocks", "03", "Building blocks"),
        ("tour", "04", "The Fatboy"),
        ("categories", "05", "Categories"),
        ("kinds", "06", "Many kinds"),
        ("script", "07", "The script"),
        ("loading", "08", "File to game"),
        ("reading", "09", "How we read it"),
        ("answers", "10", "Data to answers"),
        ("try", "11", "Try it yourself"),
    ];

    private static readonly (string Title, string Text)[] Layers =
    [
        ("The engine", "The program you start. It draws the world, moves units and does the math. It is the same for every unit."),
        ("The blueprints", "Data in Lua that sets how each unit behaves: its health, its cost, how it moves and how its weapons fire."),
        ("The scripts", "Code in Lua that reacts to what happens in the game: a unit is built, starts to build or dies."),
    ];

    private static readonly (string Title, string Example, string Result, string Text)[] BuildingBlocks =
    [
        ("A number", "MaxHealth = 12500", "12500", "Whole or with a fraction, like a speed of 1.75."),
        ("A text", "FactionName = \"UEF\"", "UEF", "Letters between quotes."),
        ("Yes or no", "RotateOnSpot = false", "no", "Written as true or false."),
        ("A list", "{ \"LAND\", \"UEF\" }", "two labels", "Values between curly brackets, one after another."),
        ("A table", "Intel = { VisionRadius = 32 }", "a group", "Values with names, kept together under one name."),
        ("A sum", "RateOfFire = 10/10", "1", "Lua works it out when the file is read."),
    ];

    private static readonly (string Kind, string Name, string Text)[] ShotChain =
    [
        ("UNIT", "Fatboy", "Its weapon list holds the Gauss cannon."),
        ("PROJECTILE", "TDFGauss04", "The shell the cannon fires: its speed and how it flies."),
        ("MESH", "TDFGauss01", "The shape of the shell you see in flight."),
        ("EMITTERS", "7 at once", "The explosion when the shell lands."),
    ];

    /// <summary>Lines of code, with the weapon label marked wherever it appears.</summary>
    private static RenderFragment Code(string[] lines) => @<div class="overflow-x-auto px-4 py-3 font-mono text-[13px] leading-6 text-ink-muted">
        @foreach (string line in lines)
        {
            int at = line.IndexOf(WeaponLabel, StringComparison.Ordinal);
            if (at < 0)
            {
                <p class="whitespace-pre">@line</p>
            }
            else
            {
                <p class="whitespace-pre">@line[..at]<span class="rounded bg-primary/15 px-0.5 font-semibold text-ink">@WeaponLabel</span>@line[(at + WeaponLabel.Length)..]</p>
            }
        }
    </div>;

    private static readonly (string Name, string Title, string Text)[] Events =
    [
        ("OnCreate", "It appears", "The Fatboy looks up its build arms in its blueprint, so the building beams know where to start."),
        ("OnStartBuild", "It starts to build", "The Fatboy opens up, and the new unit takes shape on top of it."),
        ("OnLayerChange", "It dives", "On the seabed the factory stops: nothing can be built under water. Back on land, it works again."),
        ("DeathThread", "It dies", "Explosions start on the side closest to the attacker and spread out, tick after tick."),
    ];

    private static readonly (string Title, string Text)[] LoadSteps =
    [
        ("The game's own files", "Every blueprint in six folders: effects, env, meshes, projectiles, props and units."),
        ("The map", "A map can bring blueprints of its own."),
        ("The mods", "A mod can add new blueprints, replace old ones, or change only the values it names."),
        ("The game's own changes", "Then the game goes over everything once more, fills in what the files leave out and tidies up."),
    ];

    private static readonly (string Value, string Title, string Text)[] ReadingFacts =
    [
        ("4.3 MB", "Of unit blueprints", "The 606 unit blueprints of one release, as text."),
        ("0.4 MB", "What we keep", "We read the blueprints once per release, ahead of time, and keep only what the unit pages show."),
        ("1 file", "Per release", "Your browser loads that small file, not the blueprints. A release that changed no unit shares the file of the one before."),
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            data = await Database.LoadAsync(GameVersion);
        }
        catch (Exception)
        {
            loadFailed = true;
        }
    }

    private static int SharesTotal => Shares.Sum(share => share.Bytes);

    private static string SharePercent(PartShare share) => (share.Bytes * 100.0 / SharesTotal).ToString("0", CultureInfo.InvariantCulture) + "%";

    private static string ShareWidth(PartShare share) => (share.Bytes * 100.0 / SharesTotal).ToString("0.###", CultureInfo.InvariantCulture) + "%";
}
