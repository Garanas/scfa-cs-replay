@page "/about"

@* The entry to the explainers. Each file format gets a card here and its own page below
   about/. Same writing style as those pages: simple English, short sentences, no hyphens,
   underscores or dashes in the visible text. *@

<PageTitle>About · Vault of FAF</PageTitle>

<section class="py-10 sm:py-14">
    <p class="font-display text-sm font-bold tracking-[0.2em] text-primary">ABOUT</p>
    <h1 class="mt-2 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">How Vault of FAF reads your games</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted">
        Vault of FAF opens the files of Supreme Commander: Forged Alliance right in your browser.
        These pages explain how that works. They are written for players, not for programmers.
    </p>
</section>

<section aria-labelledby="formats">
    <h2 id="formats" class="text-xs font-semibold uppercase tracking-wide text-ink-faint">File formats</h2>
    <div class="mt-4 grid gap-6 md:grid-cols-2">
        <a href="about/replay-format" class="card group relative flex flex-col overflow-hidden transition hover:border-primary hover:shadow-[0_0_60px_-24px_var(--th-glow)]">
            @* The first bytes of a replay spell the name of the game. *@
            <div class="flex gap-1.5 font-mono text-sm" aria-hidden="true">
                @foreach (byte value in ExampleReplay.FirstBytes.Take(7))
                {
                    <span class="flex w-9 flex-col items-center rounded-md border border-edge bg-raised py-1.5">
                        <span class="text-ink-muted">@value.ToString("X2")</span>
                        <span class="font-semibold text-primary transition group-hover:scale-125">@((char)value)</span>
                    </span>
                }
                <span class="self-center pl-1 text-ink-faint">…</span>
            </div>
            <h3 class="mt-6 text-2xl font-bold text-ink">The replay format</h3>
            <p class="mt-1 font-mono text-sm text-primary">.fafreplay · .scfareplay</p>
            <p class="mt-3 text-[16px] leading-relaxed text-ink-muted">
                What is inside a replay, how we read it byte by byte, and how a long row of numbers
                turns into build orders, APM and chat.
            </p>
            <p class="mt-6 text-sm font-semibold text-primary">
                Read the story <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">→</span>
            </p>
        </a>

        <a href="about/blueprints" class="card group relative flex flex-col overflow-hidden transition hover:border-primary hover:shadow-[0_0_60px_-24px_var(--th-glow)]">
            @* The first line of a blueprint: a name and a value. *@
            <div class="flex h-14 items-center gap-2 font-mono text-sm" aria-hidden="true">
                <span class="rounded-md border border-edge bg-raised p-1 transition group-hover:border-primary">
                    <UnitIcon BlueprintId="@ExampleBlueprint.BlueprintId" Size="28" Title="" />
                </span>
                <span class="rounded-md border border-edge bg-raised px-2 py-1.5 text-ink-muted">MaxHealth</span>
                <span class="text-ink-faint">=</span>
                <span class="rounded-md border border-edge bg-raised px-2 py-1.5 font-semibold text-primary transition group-hover:scale-110">12500</span>
            </div>
            <h3 class="mt-6 text-2xl font-bold text-ink">Blueprints</h3>
            <p class="mt-1 font-mono text-sm text-primary">.bp · .lua</p>
            <p class="mt-3 text-[16px] leading-relaxed text-ink-muted">
                How a whole game is built from text files, told through the Fatboy: its blueprint,
                its script, and what the game does with both.
            </p>
            <p class="mt-6 text-sm font-semibold text-primary">
                Read the story <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">→</span>
            </p>
        </a>
    </div>
</section>

@* The official FAF places, as linked from faforever.com (checked 2026-10-06). *@
<section class="mt-14" aria-labelledby="get-involved">
    <h2 id="get-involved" class="text-xs font-semibold uppercase tracking-wide text-ink-faint">Get involved</h2>
    <p class="mt-3 max-w-2xl text-[16px] leading-relaxed text-ink-muted">
        Forged Alliance Forever is made and run by its players. Here is where to find them,
        whether you want to play, watch or help.
    </p>
    <div class="mt-6 grid gap-8 lg:grid-cols-3">
        @foreach ((string group, Place[] places) in Places)
        {
            <div>
                <h3 class="text-sm font-semibold text-ink">@group</h3>
                <ul class="mt-3 space-y-3">
                    @foreach (Place place in places)
                    {
                        <li>
                            <a href="@place.Url" target="_blank" rel="noreferrer"
                               class="card group flex flex-col p-4 transition hover:border-primary hover:shadow-[0_0_60px_-24px_var(--th-glow)]">
                                <span class="flex items-baseline justify-between gap-3">
                                    <span class="font-semibold text-ink transition group-hover:text-primary">@place.Name</span>
                                    <span class="truncate font-mono text-xs text-ink-faint">@place.Site</span>
                                </span>
                                <span class="mt-1 text-sm leading-relaxed text-ink-muted">@place.Text</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</section>

<section class="mt-14 max-w-2xl text-[16px] leading-relaxed text-ink-muted">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-ink-faint">This site</h2>
    <p class="mt-3">
        Vault of FAF is open source. All of the reading and counting happens on your own computer, in your browser.
        The code is on <a href="@BuildInfo.Repository" target="_blank" rel="noreferrer" class="text-primary hover:underline">GitHub</a>.
    </p>
</section>

<section class="mt-14 max-w-2xl text-[16px] leading-relaxed text-ink-muted">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-ink-faint">With special thanks</h2>
    <ul class="mt-3 space-y-2">
        <li>
            <span class="font-semibold text-ink">Sheppy</span>, for the service that draws a preview of a generated map.
        </li>
    </ul>
</section>

@code {
    // A place to find FAF: its name, the address shown, the link and one line about it.
    private sealed record Place(string Name, string Site, string Url, string Text);

    private static (string Group, Place[] Places)[] Places =>
    [
        ("Play", [
            new("Play FAF", "faforever.com/play", "https://www.faforever.com/play",
                "Download the FAF client and start playing. You need Supreme Commander: Forged Alliance on Steam."),
            new("Wiki", "wiki.faforever.com", "https://wiki.faforever.com/en/home",
                "Guides for new players, and answers to most questions."),
            new("Forums", "forum.faforever.com", "https://forum.faforever.com/",
                "News from the team and longer discussions."),
        ]),
        ("Talk and watch", [
            new("Discord", "discord.gg", "https://discord.gg/mXahVSKGVb",
                "Chat with other players, find a game or ask for help."),
            new("YouTube", "youtube.com", "https://www.youtube.com/c/ForgedAllianceForever",
                "The official channel of FAF."),
            new("Twitch", "twitch.tv/faflive", "https://www.twitch.tv/faflive",
                "The official channel for live streams."),
            new("Reddit", "reddit.com/r/FAF", "https://www.reddit.com/r/FAF",
                "Posts and discussions from the community."),
        ]),
        ("Help build it", [
            new("Contribute", "faforever.com/contribution", "https://www.faforever.com/contribution",
                "FAF is run by volunteers. See where you can help."),
            new("GitHub", "github.com/FAForever", "https://github.com/FAForever",
                "The client, the server and the game code are open source."),
            new("Donate", "faforever.com/donation", "https://www.faforever.com/donation",
                "Help pay for the servers that keep FAF running."),
        ]),
    ];
}
