@page "/replays"
@inject IJSRuntime JS

@* The entry to the replay pages (the Replays tab in the header), like the Maps and Units tabs: the
   vault search, the replay folder on this computer and a single replay file. The folder only works
   in the installed app, on request of the owner: in a browser tab its card explains how to install.
   Same writing style as the About pages: simple English, short sentences, no hyphens, underscores
   or dashes in the visible text. *@

<PageTitle>Replays · Vault of FAForever</PageTitle>

<section class="py-10 sm:py-14">
    <p class="font-display text-sm font-bold tracking-[0.2em] text-primary">REPLAYS</p>
    <h1 class="mt-2 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">Watch any game again</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted">
        Every game on FAF is saved as a replay. Search the vault, browse the replays on your own computer,
        or open a single file. Replays are read in your browser and never leave your computer.
    </p>
</section>

<div class="grid gap-6 lg:grid-cols-3">
    <a href="@ReplayLinks.Search" class="@CardClass">
        <div class="flex h-14 flex-wrap items-center gap-1.5 font-mono text-sm" aria-hidden="true">
            @foreach (string filter in SearchFilters)
            {
                <span class="rounded-md border border-edge bg-raised px-2 py-1 text-ink-muted transition group-hover:border-primary group-hover:text-primary">@filter</span>
            }
        </div>
        <h2 class="mt-6 text-2xl font-bold text-ink">Search the vault</h2>
        <p class="mt-1 font-mono text-sm text-primary">every game on FAF · sign in</p>
        <p class="mt-3 text-[16px] leading-relaxed text-ink-muted">
            Find any game by player, map, featured mod or date. You need to sign in with your FAF account.
        </p>
        <p class="mt-auto pt-6 text-sm font-semibold text-primary">
            Search the vault <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">→</span>
        </p>
    </a>

    @if (installed)
    {
        <a href="@ReplayLinks.Folder" class="@CardClass">
            @FolderIcon
            <h2 class="mt-6 text-2xl font-bold text-ink">Your replay folder</h2>
            <p class="mt-1 font-mono text-sm text-primary">your computer · no sign in</p>
            <p class="mt-3 text-[16px] leading-relaxed text-ink-muted">
                The FAF client saves every game you play or watch. Pick that folder and browse them all,
                newest first.
            </p>
            <p class="mt-auto pt-6 text-sm font-semibold text-primary">
                Open your replay folder <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">→</span>
            </p>
        </a>
    }
    else
    {
        @* Not a link: the folder works in the installed app only. *@
        <div class="card relative flex flex-col overflow-hidden">
            @FolderIcon
            <h2 class="mt-6 text-2xl font-bold text-ink">Your replay folder</h2>
            <p class="mt-1 font-mono text-sm text-primary">installed app only</p>
            <p class="mt-3 text-[16px] leading-relaxed text-ink-muted">
                Browse every game the FAF client saved on your computer. Install Vault of FAForever to use this.
            </p>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">
                In Chrome or Edge on your computer: click the install icon at the right of the address bar,
                or open the browser menu and choose to install Vault of FAForever. Then open it from your
                start menu or desktop.
            </p>
        </div>
    }

    <a href="@ReplayLinks.Local" class="@CardClass">
        <div class="flex h-14 items-center" aria-hidden="true">
            <span class="flex h-12 w-full max-w-48 items-center justify-center rounded-md border-2 border-dashed border-edge font-mono text-xs text-ink-muted transition group-hover:border-primary group-hover:text-primary">.fafreplay</span>
        </div>
        <h2 class="mt-6 text-2xl font-bold text-ink">Open a replay file</h2>
        <p class="mt-1 font-mono text-sm text-primary">one file · no sign in</p>
        <p class="mt-3 text-[16px] leading-relaxed text-ink-muted">
            Have a <span class="font-mono text-ink">.fafreplay</span> or <span class="font-mono text-ink">.scfareplay</span>
            file? Choose it or drop it on the page, and it opens right away.
        </p>
        <p class="mt-auto pt-6 text-sm font-semibold text-primary">
            Open a file <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">→</span>
        </p>
    </a>
</div>

@code {
    private const string CardClass = "card group relative flex flex-col overflow-hidden transition hover:border-primary hover:shadow-[0_0_60px_-24px_var(--th-glow)]";

    // Decoration, not data: what the search filters on.
    private static readonly string[] SearchFilters = ["player", "map", "mod", "date"];

    private bool installed;

    private static readonly RenderFragment FolderIcon = @<div class="flex h-14 items-center" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="h-12 w-12 text-ink-muted transition group-hover:text-primary" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
            <path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4.6l2 2.2h8.4A1.5 1.5 0 0 1 21 8.7v9.8a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5v-12Z" />
            <path d="M10 11.5v5l4-2.5-4-2.5Z" fill="currentColor" stroke="none" />
        </svg>
    </div>;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && await JS.InvokeAsync<bool>("fafReplay.isInstalled"))
        {
            installed = true;
            StateHasChanged();
        }
    }
}
