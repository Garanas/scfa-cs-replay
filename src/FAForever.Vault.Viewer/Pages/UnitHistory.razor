@page "/units/{BlueprintId}"
@using FAForever.Vault.Viewer.Features.Units
@using FAForever.Vault.Viewer.Services.Units
@inject UnitDatabase Database

@* One unit across every game version with data: a column per stretch of versions in which it stayed
   the same, a row per value, changed values marked against the column before. *@

<PageTitle>@(latest is not null ? UnitFilters.DisplayName(latest) : BlueprintId) · Units · Vault of FAF</PageTitle>

<a href="units" class="text-sm text-ink-muted transition hover:text-primary">← Units</a>

@if (error is not null)
{
    <div class="card mt-4" role="alert">
        <p class="font-semibold">The unit data could not be loaded</p>
        <p class="mt-1 text-sm text-ink-muted">@error</p>
    </div>
}
else if (states is null || index is null)
{
    <div class="card mt-4 animate-pulse text-center text-sm text-ink-muted">Loading the history of @BlueprintId&hellip;</div>
}
else if (latest is null)
{
    <div class="card mt-4">
        <p class="font-semibold">No game version has a unit @BlueprintId</p>
        <p class="mt-1 text-sm text-ink-muted">The unit data covers the FAF game versions since @index.Versions.Keys.Min(); mod and campaign units are not in it.</p>
    </div>
}
else
{
    <div class="mt-3 flex flex-wrap items-center gap-3">
        <UnitIcon BlueprintId="@BlueprintId" Size="48" />
        <div class="min-w-0">
            <h1 class="text-2xl font-bold">@UnitFilters.DisplayName(latest)</h1>
            <p class="text-sm text-ink-muted">@Subtitle(latest)</p>
        </div>
        <a class="btn-secondary ml-auto" href="@($"units?unit={BlueprintId.ToLowerInvariant()}{VersionQuery(states[^1])}")">Show in the unit list</a>
    </div>

    <p class="mt-4 text-sm text-ink-muted">@Summary()</p>

    <section class="card mt-3 overflow-x-auto p-0 sm:p-2" aria-label="History">
        <table class="sticky-first-column w-full min-w-max text-sm">
            <thead>
                <tr class="border-b border-edge text-left">
                    <th class="bg-surface px-3 py-2 text-xs font-medium text-ink-faint">Game version</th>
                    @foreach (UnitState state in states)
                    {
                        <th class="px-3 py-2 align-bottom font-normal">
                            <a class="font-mono font-semibold text-ink transition hover:text-primary" href="@($"units?unit={BlueprintId.ToLowerInvariant()}{VersionQuery(state)}")"
                               title="Show this version in the unit list">@Range(state)</a>
                            @if (index.Versions.GetValueOrDefault(state.From)?.Released is { } released)
                            {
                                <span class="block text-[11px] text-ink-faint">@released.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (string label in labels)
                {
                    <tr class="border-b border-edge/60">
                        <th class="bg-surface px-3 py-1.5 text-left text-xs font-normal text-ink-faint">@label</th>
                        @for (int column = 0; column < states.Count; column++)
                        {
                            UnitStats.Line? line = lines[column].GetValueOrDefault(label);
                            UnitStats.Line? before = column > 0 ? lines[column - 1].GetValueOrDefault(label) : null;
                            bool changed = column > 0 && line?.Text != before?.Text;
                            <td class="whitespace-nowrap px-3 py-1.5 @(line?.Number is not null ? "font-mono" : "") @(changed ? "font-semibold text-primary" : "text-ink")">
                                @(line?.Text ?? "—")
                                @if (changed && line?.Number is { } now && before?.Number is { } then && now != then)
                                {
                                    <span class="ml-1 text-[10px]" title="@(now > then ? "Higher" : "Lower") than before">@(now > then ? "▲" : "▼")</span>
                                }
                            </td>
                        }
                    </tr>
                }
                @* Categories rarely matter on their own, but a change in them explains a column that looks the same. *@
                @if (states.Count > 1)
                {
                    <tr class="border-b border-edge/60">
                        <th class="bg-surface px-3 py-1.5 text-left text-xs font-normal text-ink-faint">Categories</th>
                        @for (int column = 0; column < states.Count; column++)
                        {
                            string change = column > 0 ? CategoryChange(states[column - 1].Unit, states[column].Unit) : "";
                            <td class="max-w-64 px-3 py-1.5 text-xs @(change.Length > 0 ? "font-semibold text-primary" : "text-ink-faint")">@(column == 0 ? $"{states[0].Unit.Categories.Count} categories" : change)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    [Parameter] public required string BlueprintId { get; set; }

    private UnitDataIndex? index;
    private IReadOnlyList<UnitState>? states;
    private UnitSummary? latest;
    private List<string> labels = [];
    private List<Dictionary<string, UnitStats.Line>> lines = [];
    private string? error;
    private string? loadedFor;

    // The page stays when it navigates to another unit (a link on it): load again for the new id.
    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == BlueprintId)
        {
            return;
        }

        loadedFor = BlueprintId;
        states = null;
        try
        {
            index = await Database.LoadIndexAsync();
            IReadOnlyList<UnitState> history = await Database.LoadHistoryAsync(BlueprintId);

            List<IReadOnlyList<UnitStats.Line>> columns = history.Select(state => UnitStats.For(state.Unit)).ToList();
            lines = columns.Select(column => column.ToDictionary(line => line.Label)).ToList();
            // every label in the order it first appears, so a weapon added later comes last
            labels = columns.SelectMany(column => column.Select(line => line.Label)).Distinct().ToList();
            latest = history.Count > 0 ? history[^1].Unit : null;
            states = history;
            error = null;
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException or InvalidOperationException)
        {
            error = exception.Message;
        }
    }

    /// <summary>The categories added (+) and removed (−) from one state to the next, e.g. "+VOLATILE −SNIPEMODE".</summary>
    private static string CategoryChange(UnitSummary before, UnitSummary after) => string.Join(" ",
        after.Categories.Except(before.Categories).Select(category => $"+{category}")
            .Concat(before.Categories.Except(after.Categories).Select(category => $"−{category}")));

    private string Range(UnitState state) => state.From == state.To ? $"{state.From}" : $"{state.From}–{state.To}";

    // A stretch of versions opens its last version in the unit list; the latest is the list's default.
    private string VersionQuery(UnitState state) => state.To == index?.Latest ? "" : $"&version={state.To}";

    private static string Subtitle(UnitSummary unit) => string.Join(" · ", new[]
    {
        unit.Name is not null ? unit.Description : null,
        unit.Faction,
        unit.TechLevel switch { 4 => "Experimental", { } tech => $"Tech {tech}", null => null },
        UnitRoles.Layer(unit),
        unit.BlueprintId,
    }.Where(part => part is not null));

    private string Summary()
    {
        UnitState first = states![0];
        UnitState last = states[^1];
        int oldest = index!.Versions.Keys.Min();
        string since = first.From == oldest ? $"since {oldest}, the oldest version with data" : $"since it was added in {first.From}";
        string changes = states.Count == 1 ? "it has not changed" : $"it changed {states.Count - 1} {(states.Count == 2 ? "time" : "times")}";
        string removed = last.To != index.Latest ? $" It is not in the versions after {last.To}." : "";
        return $"In every version {since}, {changes}: each column below is a stretch of versions in which it stayed the same.{removed}";
    }
}
