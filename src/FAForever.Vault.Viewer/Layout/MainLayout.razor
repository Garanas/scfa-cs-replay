@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<div class="flex min-h-dvh flex-col">
    <AppHeader Container="@Container" />
    <UpdateBanner Container="@Container" />

    <main class="mx-auto w-full @Container flex-1 px-4 py-8 sm:px-6">
        @Body
    </main>

    <footer class="border-t border-edge">
        <div class="mx-auto flex w-full @Container flex-wrap items-center justify-between gap-2 px-4 py-6 text-sm text-ink-faint sm:px-6">
            <span>Replay analysis for Supreme Commander: Forged Alliance Forever.</span>
            <span class="flex items-center gap-2">
                <a class="transition hover:text-ink" href="@BuildInfo.Repository" target="_blank" rel="noreferrer">Source on GitHub</a>
                @if (BuildInfo.CommitUrl is { } commitUrl)
                {
                    <span aria-hidden="true">·</span>
                    <a class="font-mono transition hover:text-ink" href="@commitUrl" target="_blank" rel="noreferrer"
                       title="The commit this version was built from">@BuildInfo.ShortCommit</a>
                }
            </span>
        </div>
    </footer>
</div>

@code {
    /// <summary>
    /// The width of header, page and footer. Side-by-side views (the Build order tab compares
    /// two players) and the unit pages below units/ (wide tables: the database and a unit's history)
    /// get the width of a full HD screen; everything else, the Units landing page too, keeps the
    /// reading width.
    /// </summary>
    private string Container =>
        string.Equals(UrlQuery.Get(Navigation, "tab"), "buildorder", StringComparison.OrdinalIgnoreCase) || IsUnitPage
            ? "max-w-[1824px]"
            : "max-w-6xl";

    private bool IsUnitPage => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0] is var path
        && path.StartsWith("units/", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
