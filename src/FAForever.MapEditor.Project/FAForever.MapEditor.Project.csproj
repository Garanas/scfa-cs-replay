<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q16-AnyCPU" />
  </ItemGroup>

  <ItemGroup>
    <!-- the example unit presets every workspace starts with (ExampleUnitPresets), made by faf-map dev unit-templates -->
    <EmbeddedResource Include="Workspaces\ExampleUnitPresets\units\*.json" LogicalName="ExampleUnitPresets/%(Filename)%(Extension)" />
    <!-- the example unit palettes every workspace starts with (ExampleUnitPalettes, user story U-8) -->
    <EmbeddedResource Include="Workspaces\ExampleUnitPalettes\palettes\*.json" LogicalName="ExampleUnitPalettes/%(Filename)%(Extension)" />
    <!-- the style of the preview page the export writes (PreviewPage) -->
    <EmbeddedResource Include="Generation\PreviewPage.css" LogicalName="PreviewPage.css" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FAForever.MapEditor.Project.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FAForever.FileFormats.Blueprints\FAForever.FileFormats.Blueprints.csproj" />
    <ProjectReference Include="..\FAForever.FileFormats.Map\FAForever.FileFormats.Map.csproj" />
    <ProjectReference Include="..\FAForever.FileFormats.Mesh\FAForever.FileFormats.Mesh.csproj" />
  </ItemGroup>

</Project>
