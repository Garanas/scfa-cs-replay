<!-- The looks of the editor's own controls. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:FAForever.MapEditor.App.Controls">

  <ControlTheme x:Key="{x:Type controls:Section}" TargetType="controls:Section">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Classes="stack">
          <TextBlock Classes="heading" Text="{TemplateBinding Header}" />
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
