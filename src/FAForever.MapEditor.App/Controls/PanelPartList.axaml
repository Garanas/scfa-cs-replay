<!-- A mode panel's list of what there is to edit (the Map, Water and Lighting panels): its entries under their headings,
     each a button with its title and a short detail (PartEntryText, as every list mode's entries); the chosen one is
     filled and the inspector edits it. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             x:Class="FAForever.MapEditor.App.Controls.PanelPartList"
             x:DataType="vm:PanelParts"
             x:Name="Root">
  <ItemsControl ItemsSource="{Binding Groups}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Classes="stack" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:PanelPartGroup">
        <StackPanel Classes="partgroup">
          <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
          <ItemsControl ItemsSource="{Binding Parts}" AutomationProperties.Name="{Binding Title}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Classes="partentries" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PanelPart">
                <Button Classes="partentry" Classes.selected="{Binding LooksChosen}" Classes.partwithpreview="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Command="{Binding #Root.((vm:PanelParts)DataContext).ChooseItemCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding Help}"
                        AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Label}">
                  <DockPanel>
                    <!-- a picture of it when it has one (a water map's) -->
                    <Border DockPanel.Dock="Left" Classes="thumbnail imagepreview" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <controls:ImagePreview Picture="{Binding Preview}" AutomationProperties.Name="{Binding PreviewLabel}" />
                    </Border>
                    <controls:PartEntryText Title="{Binding Title}" Detail="{Binding Detail}" />
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- the heading's footer: a line while it has no entries, and its buttons (the Map panel's Add army) -->
          <TextBlock Classes="caption" Text="{Binding Footer.EmptyText}" IsVisible="{Binding ShowsEmptyText}" />
          <ItemsControl ItemsSource="{Binding Footer.Actions}" IsVisible="{Binding HasActions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PanelPartAction">
                <Button HorizontalAlignment="Stretch" Content="{Binding Title}" Command="{Binding Command}" CommandParameter="{Binding Parameter}"
                        ToolTip.Tip="{Binding Help}"
                        AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Help}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
