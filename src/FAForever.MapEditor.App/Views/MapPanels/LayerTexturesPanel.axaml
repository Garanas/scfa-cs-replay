<!-- The Paint panel's layers (S-1, S-2): the layers as they lie on each other, the upper first; a stratum chosen here is the one the
     strata tool paints, and the inspector shows the chosen layer's textures; add, remove and reorder strata. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             xmlns:editing="using:FAForever.MapEditor.Project.Editing"
             x:Class="FAForever.MapEditor.App.Views.MapPanels.LayerTexturesPanel"
             x:DataType="vm:MainViewModel">
  <Border Classes="group">
    <StackPanel Classes="stack">
      <TextBlock Classes="overline" Text="{Binding Source='Layers', Converter={x:Static controls:UpperCaseConverter.Instance}}" />
      <ListBox ItemsSource="{Binding LayerTextures.Items}" SelectedItem="{Binding LayerTextures.Selected}" AutomationProperties.Name="Layer textures"
               AutomationProperties.HelpText="The chosen stratum is the one the strata tool paints; the chosen layer's textures, scales and mask layers are in the inspector">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LayerItem">
            <DockPanel>
              <Border DockPanel.Dock="Left" Classes="thumbnail imagepreview">
                <controls:ImagePreview Picture="{Binding Texture}" AutomationProperties.Name="{Binding TextureLabel}" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" />
                <TextBlock Classes="caption" Text="{Binding Textures}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Classes="caption" Text="{Binding LayerTextures.Summary}" />
      <!-- the terrain shader that blends the layers (S-4) -->
      <StackPanel Classes="inline">
        <TextBlock Classes="label" Text="Shader" />
        <ComboBox ItemsSource="{Binding LayerTextures.Shaders}" SelectedItem="{Binding LayerTextures.Shader}" IsEnabled="{Binding HasMap}"
                  AutomationProperties.Name="Terrain shader" AutomationProperties.HelpText="How the game blends the layers; the 3D view and the generated preview blend them so too">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="editing:TerrainShaderInfo">
              <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Summary}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding LayerTextures.ShaderSummary}" AutomationProperties.Name="What the terrain shader is" />
      <ItemsControl ItemsSource="{Binding LayerTextures.ShaderUses}" AutomationProperties.Name="What the terrain shader reads">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding StringFormat='· {0}'}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <WrapPanel Classes="chips">
        <Button Content="Add a stratum" Command="{Binding LayerTextures.AddCommand}" IsEnabled="{Binding HasMap}"
                AutomationProperties.HelpText="Gives the first unused stratum a texture from the picker" />
        <Button Content="Remove" Command="{Binding LayerTextures.RemoveCommand}" IsEnabled="{Binding LayerTextures.CanRemove}"
                AutomationProperties.Name="Remove the stratum" AutomationProperties.HelpText="With its mask; the strata above move down" />
        <Button Content="Up" Command="{Binding LayerTextures.MoveUpCommand}" IsEnabled="{Binding LayerTextures.CanMoveUp}"
                AutomationProperties.Name="Move the stratum up" AutomationProperties.HelpText="Over the stratum above it, with its mask" />
        <Button Content="Down" Command="{Binding LayerTextures.MoveDownCommand}" IsEnabled="{Binding LayerTextures.CanMoveDown}"
                AutomationProperties.Name="Move the stratum down" AutomationProperties.HelpText="Under the stratum below it, with its mask" />
      </WrapPanel>
    </StackPanel>
  </Border>
</UserControl>
