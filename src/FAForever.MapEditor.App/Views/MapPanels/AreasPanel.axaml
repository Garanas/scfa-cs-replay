<!-- The Map panel's areas (M-5): their names to type over, select, show in the 3D view, remove; the first is the playable area. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             x:Class="FAForever.MapEditor.App.Views.MapPanels.AreasPanel"
             x:DataType="vm:MainViewModel">
  <Border Classes="group">
    <StackPanel Classes="stack">
      <TextBlock Classes="overline" Text="{Binding Source=Areas, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
      <ItemsControl ItemsSource="{Binding AreaList.Items}" AutomationProperties.Name="Areas">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Classes="stack" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AreaItem">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="beside" Content="×" Command="{Binding DeleteCommand}"
                        AutomationProperties.Name="{Binding Area.Name, StringFormat='Remove the area {0}'}" />
                <Button DockPanel.Dock="Right" Classes="beside" Content="Show" Command="{Binding FocusCommand}"
                        AutomationProperties.Name="{Binding Area.Name, StringFormat='Show the area {0} in the 3D view'}" />
                <Button DockPanel.Dock="Right" Classes="beside" Content="Select" Command="{Binding SelectCommand}"
                        AutomationProperties.Name="{Binding Area.Name, StringFormat='Select the area {0}'}" />
                <TextBox Classes="commit" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                         AutomationProperties.Name="{Binding Area.Name, StringFormat='Name of the area {0}'}" />
              </DockPanel>
              <TextBlock Classes="caption mono" Text="{Binding Rectangle}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="caption" Text="No areas yet. The first area is the playable area." IsVisible="{Binding AreaList.IsEmpty}" />
      <StackPanel Classes="inline">
        <Button Content="Add an area" Command="{Binding AreaList.AddCommand}" IsEnabled="{Binding HasMap}" />
        <Button Content="Draw" Command="{Binding RunCommand}" CommandParameter="tool.map.areas" IsEnabled="{Binding HasMap}"
                AutomationProperties.Name="Draw areas with the areas tool"
                AutomationProperties.HelpText="Drag a rectangle in a view; drag the selected area's corners or edges to resize it" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
