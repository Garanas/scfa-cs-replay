<!-- The Lighting panel's Skybox entry (L-1): what the skybox holds, then its dome, sky objects, cirrus and cirrus layers
     (lighting.setSkybox, lighting.setCirrusLayer; always four layers); without one, Add (made from the lighting) and Read a preset. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             x:Class="FAForever.MapEditor.App.Views.MapPanels.SkyboxPartView"
             x:DataType="vm:SkyboxPart">
  <StackPanel>
    <Border Classes="group">
      <StackPanel Classes="stack">
        <TextBlock Classes="caption" Text="{Binding Summary}" AutomationProperties.Name="What the skybox holds" />
        <TextBlock Classes="caption warning" Text="{Binding VersionNote}" IsVisible="{Binding VersionNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <WrapPanel Classes="chips">
          <Button Content="Add a skybox" Command="{Binding AddCommand}" IsVisible="{Binding HasNoSkybox}"
                  AutomationProperties.HelpText="A plain dome made from the lighting: the horizon in the fog's colour, a deeper blue overhead" />
          <Button Content="Read a preset..." Command="{Binding ImportCommand}"
                  AutomationProperties.Name="Read a skybox preset"
                  AutomationProperties.HelpText="A skybox the FAF map editor saved (.scmskybox or .json); it takes the place of the map's" />
          <Button Content="Remove the skybox" Command="{Binding RemoveCommand}" IsVisible="{Binding HasSkybox}"
                  AutomationProperties.HelpText="The sky cube map is then made from the lighting" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <StackPanel IsVisible="{Binding HasSkybox}">
      <Border Classes="group">
        <controls:SettingList DataContext="{Binding Dome}" ShowsTitle="True" />
      </Border>
      <Border Classes="group">
        <controls:SettingList DataContext="{Binding SkyObjects}" ShowsTitle="True" />
      </Border>
      <Border Classes="group">
        <controls:SettingList DataContext="{Binding Cirrus}" ShowsTitle="True" />
      </Border>
      <ItemsControl ItemsSource="{Binding CirrusLayers}" AutomationProperties.Name="Cirrus layers">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SettingGroup">
            <Border Classes="group">
              <controls:SettingList ShowsTitle="True" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
