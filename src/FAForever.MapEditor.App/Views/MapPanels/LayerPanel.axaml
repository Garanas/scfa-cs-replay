<!-- The Paint inspector (S-2): the layer chosen in the panel, its albedo and normal texture (typed or from the picker) and their scales. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             x:Class="FAForever.MapEditor.App.Views.MapPanels.LayerPanel"
             x:DataType="vm:MainViewModel">
  <Border Classes="group">
    <StackPanel Classes="stack">
      <TextBlock Classes="heading" Text="{Binding LayerTextures.SelectedTitle}" AutomationProperties.Name="Layer" />
      <controls:SettingList DataContext="{Binding LayerTextures.Layer}" ShowsTitle="False" />
    </StackPanel>
  </Border>
</UserControl>
