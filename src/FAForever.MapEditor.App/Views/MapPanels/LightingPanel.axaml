<!-- The Lighting panel (L-1): the sun's direction, colours, ambience, shadow fill, multiplier, specular, bloom and fog; the 3D view shows them at once. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             x:Class="FAForever.MapEditor.App.Views.MapPanels.LightingPanel"
             x:DataType="vm:MainViewModel">
  <Border Classes="group">
    <StackPanel Classes="stack">
      <TextBlock Classes="overline" Text="{Binding Source=Lighting, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
      <controls:SettingList DataContext="{Binding LightingSettings.Sun}" />
      <controls:SettingList DataContext="{Binding LightingSettings.Fog}" Classes="section" />
      <TextBlock Classes="caption" Text="The Sun tool turns the sun: drag in a view to where it is to stand." />
    </StackPanel>
  </Border>
</UserControl>
