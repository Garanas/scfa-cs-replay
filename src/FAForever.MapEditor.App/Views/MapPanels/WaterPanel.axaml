<!-- The Water panel (W-1, W-2): on or off, then what there is: the settings groups, the three maps and the wave generators;
     the inspector edits the chosen one (Views/MapPanels/PanelPartView). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             x:Class="FAForever.MapEditor.App.Views.MapPanels.WaterPanel"
             x:DataType="vm:MainViewModel">
  <Border Classes="group">
    <StackPanel Classes="stack">
      <controls:SettingList DataContext="{Binding WaterSettings.On}" ShowsTitle="False" />
      <controls:PanelPartList DataContext="{Binding WaterSettings.Parts}" />
    </StackPanel>
  </Border>
</UserControl>
