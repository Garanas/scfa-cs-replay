<!-- Workspace settings (F-5): where the workspace finds the game, FAF's data and the vault maps are exported to
     (workspace.json), the converted assets with Convert again, and the plugins and diagnostics pages. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             x:Class="FAForever.MapEditor.App.Views.WorkspaceSettingsPage"
             x:DataType="vm:MainViewModel">
  <Border Classes="scrim">
    <Border Classes="dialog workspacesettings">
      <StackPanel>
        <Border Classes="dialogpart">
          <StackPanel Classes="stack">
            <TextBlock Classes="heading" Text="Workspace settings" />
            <TextBlock Classes="secondary" Text="{Binding WorkspaceSettings.Folder}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Workspace folder" />
          </StackPanel>
        </Border>
        <Border Classes="dialogpart">
          <ScrollViewer Classes="workspacesettingslist">
            <StackPanel Classes="stack">
              <controls:FolderField Heading="Supreme Commander: Forged Alliance" Label="game folder of the workspace"
                                    Help="The folder the game is installed in, with gamedata\env.scd and gamedata\units.scd."
                                    Folder="{Binding WorkspaceSettings.GameFolder}" BrowseCommand="{Binding WorkspaceSettings.BrowseGameFolderCommand}" />
              <controls:FolderField Heading="FAF's data" Label="FAF data folder of the workspace"
                                    Help="FAF's gamedata folder: its env.nx2 and units.nx2 replace files of the game. Empty without FAF."
                                    Folder="{Binding WorkspaceSettings.FafDataFolder}" BrowseCommand="{Binding WorkspaceSettings.BrowseFafDataFolderCommand}" />
              <controls:FolderField Heading="Export folder: the vault" Label="vault folder of the workspace"
                                    Help="The folder the FAF client keeps maps and mods in. Maps are exported into its maps folder."
                                    Folder="{Binding WorkspaceSettings.VaultFolder}" BrowseCommand="{Binding WorkspaceSettings.BrowseVaultFolderCommand}" />
              <TextBlock Classes="error" Text="{Binding WorkspaceSettings.Error}" IsVisible="{Binding WorkspaceSettings.HasError}" AutomationProperties.Name="What is wrong with the folders" />
              <StackPanel Classes="inline">
                <Button Content="Save" Command="{Binding WorkspaceSettings.SaveCommand}" AutomationProperties.Name="Save the workspace's folders"
                        AutomationProperties.HelpText="Writes them into workspace.json; another game or FAF folder asks for the assets to be converted again" />
                <Button Content="Revert" Command="{Binding WorkspaceSettings.RevertCommand}" AutomationProperties.Name="Put the folders back as saved" />
              </StackPanel>

              <TextBlock Classes="heading section" Text="Converted assets" />
              <TextBlock Classes="caption" Text="{Binding WorkspaceSettings.AssetsText}" AutomationProperties.Name="Format of the converted assets" />
              <TextBlock Classes="caption" Text="{Binding WorkspaceSettings.AssetsCounts}" AutomationProperties.Name="What was converted" />
              <TextBlock Classes="caption" Classes.warning="{Binding WorkspaceSettings.IsOutdated}" Text="{Binding WorkspaceSettings.AssetsState}"
                         AutomationProperties.Name="Whether the assets are current" />
              <Button Content="Convert again" Command="{Binding WorkspaceSettings.ConvertAgainCommand}" AutomationProperties.Name="Convert the assets again"
                      AutomationProperties.HelpText="Converts the game's and FAF's environment and units into the workspace again: about a minute; the editor waits until it is done" />

              <TextBlock Classes="heading section" Text="More about the workspace" />
              <StackPanel Classes="inline">
                <Button Content="Plugins..." Command="{Binding WorkspaceSettings.OpenPluginsCommand}" AutomationProperties.Name="Open the plugins page" />
                <Button Content="Diagnostics..." Command="{Binding WorkspaceSettings.OpenDiagnosticsCommand}" AutomationProperties.Name="Open the diagnostics page" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <Border Classes="dialogpart">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="accent" Content="Close" Command="{Binding WorkspaceSettings.CloseCommand}" />
            <TextBlock Classes="caption" Text="Help, Folders shows each of these folders in the file manager." VerticalAlignment="Center" />
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>
  </Border>
</UserControl>
