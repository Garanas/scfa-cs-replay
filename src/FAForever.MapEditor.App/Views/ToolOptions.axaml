<!-- The active tool's settings, in one row of a fixed height whatever the tool and the window's width, so the views
     never move (what does not fit shows behind More): a template per tool class; a tool not built yet says what it will do. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:tools="using:FAForever.MapEditor.App.Tools"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             x:Class="FAForever.MapEditor.App.Views.ToolOptions"
             x:DataType="vm:MainViewModel" ClipToBounds="False">
  <UserControl.Styles>
    <!-- what overflows starts below the views' own bar (symmetry, overlay chips), which stays reachable -->
    <Style Selector="controls|ToolRow">
      <Setter Property="OverflowOffset" Value="{StaticResource ToolbarHeight}" />
    </Style>
  </UserControl.Styles>
  <Border Classes="toolbar options">
    <!-- what does not fit goes behind the row's More button (controls:ToolRow), so the height stays -->
    <DockPanel IsEnabled="{Binding HasMap}">
      <TextBlock DockPanel.Dock="Left" Classes="heading toolname" Text="{Binding ActiveTool.Definition.Title}" />
      <Panel>
        <ContentControl ClipToBounds="False" Content="{Binding ActiveTool.Tool}" IsVisible="{Binding ActiveTool.Tool, Converter={x:Static ObjectConverters.IsNotNull}}">
          <ContentControl.DataTemplates>
            <!-- sculpting the heights (T-1) -->
            <DataTemplate DataType="tools:SculptTool">
              <controls:ToolRow Classes="toolrow">
                <ComboBox ItemsSource="{Binding Shape.Choices}" SelectedItem="{Binding Shape.Chosen}" MaxWidth="{StaticResource ToolSliderWidth}"
                          ToolTip.Tip="{Binding Shape.Chosen.Path}" AutomationProperties.Name="Brush shape"
                          AutomationProperties.HelpText="Round, or a picture of the workspace's brushes folder; choosing a brush on the asset shelf chooses it here" />
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" AutomationProperties.Name="Height brush mode" />
                <ComboBox ItemsSource="{Binding Falloffs}" SelectedItem="{Binding Falloff}" IsVisible="{Binding !Shape.IsShaped}"
                          AutomationProperties.Name="Brush falloff" AutomationProperties.HelpText="How a round brush fades from its centre to its edge: smooth, linear, or sharp (the same everywhere)" />
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Radius, StringFormat='Radius: {0:0} ogrids'}" />
                  <Slider Minimum="1" Maximum="128" Value="{Binding Radius}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Brush radius in ogrids" />
                </StackPanel>
                <StackPanel Classes="inline" IsVisible="{Binding UsesStrength}">
                  <TextBlock Classes="label" Text="{Binding Strength, StringFormat='Strength: {0:0.00}'}" />
                  <Slider Minimum="0.01" Maximum="{Binding StrengthMaximum}" Value="{Binding Strength}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Height brush strength" />
                </StackPanel>
                <StackPanel Classes="inline" IsVisible="{Binding UsesTarget}">
                  <TextBlock Classes="label" Text="{Binding TargetLabel}" />
                  <TextBlock Classes="label mono" Text="{Binding Target, StringFormat='{}{0:0.0}'}" />
                  <Slider Minimum="0" Maximum="256" Value="{Binding Target}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Height to flatten to, set or scale around" />
                </StackPanel>
                <StackPanel Classes="inline" IsVisible="{Binding IsScaling}">
                  <TextBlock Classes="label" Text="{Binding Factor, StringFormat='Factor: {0:0.00}'}" />
                  <Slider Minimum="0.5" Maximum="2" Value="{Binding Factor}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Scale factor"
                          AutomationProperties.HelpText="Above 1 hills grow and valleys deepen around the height; below 1 the terrain flattens towards it" />
                </StackPanel>
                <StackPanel Classes="inline" IsVisible="{Binding IsNoise}">
                  <TextBlock Classes="label" Text="{Binding NoiseScale, StringFormat='Noise size: {0:0} ogrids'}" />
                  <Slider Minimum="2" Maximum="128" Value="{Binding NoiseScale}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Size of the noise in ogrids" />
                </StackPanel>
                <CheckBox Content="Limits" IsChecked="{Binding Limited}" AutomationProperties.Name="Keep the heights within limits"
                          AutomationProperties.HelpText="The brush raises no height above the highest and lowers none below the lowest" />
                <StackPanel Classes="inline" IsVisible="{Binding Limited}">
                  <TextBox Classes="toolfield" Text="{Binding MinHeight, UpdateSourceTrigger=LostFocus, Converter={x:Static controls:NumberTextConverter.Instance}}" AutomationProperties.Name="Lowest height the brush makes" />
                  <TextBlock Classes="label" Text="to" />
                  <TextBox Classes="toolfield" Text="{Binding MaxHeight, UpdateSourceTrigger=LostFocus, Converter={x:Static controls:NumberTextConverter.Instance}}" AutomationProperties.Name="Highest height the brush makes" />
                </StackPanel>
                <ContentControl Content="{Binding Shape}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- pressing a height stamp (T-2): its picture, mode, size, height, base and edge -->
            <DataTemplate DataType="tools:StampTool">
              <controls:ToolRow Classes="toolrow">
                <ComboBox ItemsSource="{Binding Shape.Choices}" SelectedItem="{Binding Shape.Chosen}" MaxWidth="{StaticResource ToolSliderWidth}"
                          ToolTip.Tip="{Binding Shape.Chosen.Path}" AutomationProperties.Name="Stamp picture"
                          AutomationProperties.HelpText="A picture of the workspace's brushes folder; choosing a brush on the asset shelf chooses it here, and shift and a drag take one from the map" />
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" AutomationProperties.Name="Stamp mode"
                          AutomationProperties.HelpText="Raise or lower by the picture, or set the heights to the base plus the picture" />
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Radius, StringFormat='Radius: {0:0}'}" />
                  <Slider Minimum="1" Maximum="512" Value="{Binding Radius}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Stamp radius, half its side in ogrids" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="Height" />
                  <TextBox Classes="toolfield" Text="{Binding Height, UpdateSourceTrigger=LostFocus, Converter={x:Static controls:NumberTextConverter.Instance}}"
                           AutomationProperties.Name="Stamp height" AutomationProperties.HelpText="The height the picture's white stands for, in game units" />
                </StackPanel>
                <CheckBox Content="Base on the ground" IsChecked="{Binding BaseFromGround}" IsVisible="{Binding IsSetting}" AutomationProperties.Name="Stamp base on the ground"
                          AutomationProperties.HelpText="The picture's black is the height of the ground under the click; else the base typed beside it" />
                <StackPanel Classes="inline" IsVisible="{Binding IsSetting}">
                  <TextBlock Classes="label" Text="Base" />
                  <TextBox Classes="toolfield" Text="{Binding Base, UpdateSourceTrigger=LostFocus, Converter={x:Static controls:NumberTextConverter.Instance}}" IsEnabled="{Binding !BaseFromGround}"
                           AutomationProperties.Name="Stamp base height" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Edge, StringFormat='Edge: {0:0.00}'}" />
                  <Slider Minimum="0" Maximum="0.5" Value="{Binding Edge}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Stamp edge"
                          AutomationProperties.HelpText="How much of the picture fades out towards its sides, so it merges with the terrain" />
                </StackPanel>
                <ContentControl Content="{Binding Shape}" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- marking walkability by hand (T-7): blocked or open, or erasing the marks -->
            <DataTemplate DataType="tools:WalkabilityMarkTool">
              <controls:ToolRow Classes="toolrow">
                <ComboBox ItemsSource="{Binding Marks}" SelectedItem="{Binding Mark}" IsEnabled="{Binding !Erase}" AutomationProperties.Name="Walkability mark"
                          AutomationProperties.HelpText="Blocked: land units must not pass; open: they may" />
                <CheckBox Content="Erase" IsChecked="{Binding Erase}" AutomationProperties.Name="Erase the walkability marks" />
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Radius, StringFormat='Radius: {0:0} ogrids'}" />
                  <Slider Minimum="1" Maximum="128" Value="{Binding Radius}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Brush radius in ogrids" />
                </StackPanel>
                <ComboBox ItemsSource="{Binding Shape.Choices}" SelectedItem="{Binding Shape.Chosen}" MaxWidth="{StaticResource ToolSliderWidth}"
                          ToolTip.Tip="{Binding Shape.Chosen.Path}" AutomationProperties.Name="Brush shape" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- painting a stratum's mask (S-1), where the slope and height allow -->
            <DataTemplate DataType="tools:StrataTool">
              <controls:ToolRow Classes="toolrow">
                <ComboBox ItemsSource="{Binding Shape.Choices}" SelectedItem="{Binding Shape.Chosen}" MaxWidth="{StaticResource ToolSliderWidth}"
                          ToolTip.Tip="{Binding Shape.Chosen.Path}" AutomationProperties.Name="Brush shape"
                          AutomationProperties.HelpText="Round, or a picture of the workspace's brushes folder; choosing a brush on the asset shelf chooses it here" />
                <ComboBox ItemsSource="{Binding Falloffs}" SelectedItem="{Binding Falloff}" IsVisible="{Binding !Shape.IsShaped}"
                          AutomationProperties.Name="Brush falloff" AutomationProperties.HelpText="How a round brush fades from its centre to its edge: smooth, linear, or sharp (the same everywhere)" />
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Radius, StringFormat='Radius: {0:0} ogrids'}" />
                  <Slider Minimum="1" Maximum="128" Value="{Binding Radius}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Brush radius in ogrids" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Strength, StringFormat='Strength: {0:0.00}'}" />
                  <Slider Minimum="0.01" Maximum="1" Value="{Binding Strength}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Strata brush strength" />
                </StackPanel>
                <CheckBox Content="Erase" IsChecked="{Binding Erase}" AutomationProperties.Name="Erase the layer" />
                <CheckBox Content="Slope" IsChecked="{Binding Limiting.BySlope}" AutomationProperties.Name="Paint only within a range of slopes" />
                <StackPanel Classes="inline" IsVisible="{Binding Limiting.BySlope}">
                  <TextBox Classes="toolfield" Text="{Binding Limiting.MinSlope, UpdateSourceTrigger=LostFocus, Converter={x:Static controls:NumberTextConverter.Instance}}" AutomationProperties.Name="Gentlest slope to paint, in degrees" />
                  <TextBlock Classes="label" Text="to" />
                  <TextBox Classes="toolfield" Text="{Binding Limiting.MaxSlope, UpdateSourceTrigger=LostFocus, Converter={x:Static controls:NumberTextConverter.Instance}}" AutomationProperties.Name="Steepest slope to paint, in degrees" />
                  <TextBlock Classes="label" Text="°" />
                </StackPanel>
                <CheckBox Content="Height" IsChecked="{Binding Limiting.ByHeight}" AutomationProperties.Name="Paint only within a range of heights" />
                <StackPanel Classes="inline" IsVisible="{Binding Limiting.ByHeight}">
                  <TextBox Classes="toolfield" Text="{Binding Limiting.MinHeight, UpdateSourceTrigger=LostFocus, Converter={x:Static controls:NumberTextConverter.Instance}}" AutomationProperties.Name="Lowest height to paint" />
                  <TextBlock Classes="label" Text="to" />
                  <TextBox Classes="toolfield" Text="{Binding Limiting.MaxHeight, UpdateSourceTrigger=LostFocus, Converter={x:Static controls:NumberTextConverter.Instance}}" AutomationProperties.Name="Highest height to paint" />
                </StackPanel>
                <ContentControl Content="{Binding Shape}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- painting the water's foam, flatness or depth bias (W-2) -->
            <DataTemplate DataType="tools:WaterPaintTool">
              <controls:ToolRow Classes="toolrow">
                <TextBlock Classes="label" Text="{Binding Painted.Title, StringFormat='Map: {0}'}" ToolTip.Tip="{Binding Painted.Help}"
                           AutomationProperties.Name="Water map painted" AutomationProperties.HelpText="Foam, flatness or depth bias, chosen in the Water panel; the top view shows it" />
                <ComboBox ItemsSource="{Binding Shape.Choices}" SelectedItem="{Binding Shape.Chosen}" MaxWidth="{StaticResource ToolSliderWidth}"
                          ToolTip.Tip="{Binding Shape.Chosen.Path}" AutomationProperties.Name="Brush shape"
                          AutomationProperties.HelpText="Round, or a picture of the workspace's brushes folder; choosing a brush on the asset shelf chooses it here" />
                <ComboBox ItemsSource="{Binding Falloffs}" SelectedItem="{Binding Falloff}" IsVisible="{Binding !Shape.IsShaped}"
                          AutomationProperties.Name="Brush falloff" AutomationProperties.HelpText="How a round brush fades from its centre to its edge: smooth, linear, or sharp (the same everywhere)" />
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Radius, StringFormat='Radius: {0:0} ogrids'}" />
                  <Slider Minimum="1" Maximum="128" Value="{Binding Radius}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Brush radius in ogrids" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Strength, StringFormat='Strength: {0:0.00}'}" />
                  <Slider Minimum="0.01" Maximum="1" Value="{Binding Strength}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Water brush strength" />
                </StackPanel>
                <CheckBox Content="Erase" IsChecked="{Binding Erase}" AutomationProperties.Name="Erase the water mask" />
                <ContentControl Content="{Binding Shape}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- painting a mask for tools (K-1), chosen in the Paint panel -->
            <DataTemplate DataType="tools:MaskPaintTool">
              <controls:ToolRow Classes="toolrow">
                <TextBlock Classes="label" Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Masks.Chosen, StringFormat='Mask: {0}', TargetNullValue='No mask: add one in the panel'}" />
                <ComboBox ItemsSource="{Binding Shape.Choices}" SelectedItem="{Binding Shape.Chosen}" MaxWidth="{StaticResource ToolSliderWidth}"
                          ToolTip.Tip="{Binding Shape.Chosen.Path}" AutomationProperties.Name="Brush shape"
                          AutomationProperties.HelpText="Round, or a picture of the workspace's brushes folder; choosing a brush on the asset shelf chooses it here" />
                <ComboBox ItemsSource="{Binding Falloffs}" SelectedItem="{Binding Falloff}" IsVisible="{Binding !Shape.IsShaped}"
                          AutomationProperties.Name="Brush falloff" AutomationProperties.HelpText="How a round brush fades from its centre to its edge: smooth, linear, or sharp (the same everywhere)" />
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Radius, StringFormat='Radius: {0:0} ogrids'}" />
                  <Slider Minimum="1" Maximum="128" Value="{Binding Radius}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Brush radius in ogrids" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Strength, StringFormat='Strength: {0:0.00}'}" />
                  <Slider Minimum="0.01" Maximum="1" Value="{Binding Strength}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Mask brush strength" />
                </StackPanel>
                <CheckBox Content="Erase" IsChecked="{Binding Erase}" AutomationProperties.Name="Erase the mask" />
                <ContentControl Content="{Binding Shape}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- painting the terrain types (T-6): the type, the legend of the types the map uses, then the brush -->
            <DataTemplate DataType="tools:TerrainTypeTool">
              <controls:ToolRow Classes="toolrow">
                <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Chosen}" MaxWidth="{StaticResource ToolChoiceWidth}" ToolTip.Tip="{Binding Chosen.Description}"
                          AutomationProperties.Name="Terrain type to paint" AutomationProperties.HelpText="The game's terrain types, each in its colour in the top view">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="tools:TerrainTypeChoice">
                      <StackPanel Classes="inline" ToolTip.Tip="{Binding Description}">
                        <Border Classes="swatch" Background="{Binding Colour, Converter={x:Static controls:ArgbBrushConverter.Instance}}" />
                        <TextBlock Text="{Binding Title}" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="overline" Text="{Binding Source='In the map', Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                <ItemsControl ItemsSource="{Binding Legend}" AutomationProperties.Name="Terrain types in the map">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Classes="toolrow" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="tools:TerrainTypeChoice">
                      <StackPanel Classes="inline" ToolTip.Tip="{Binding CountText}">
                        <Border Classes="swatch" Background="{Binding Colour, Converter={x:Static controls:ArgbBrushConverter.Instance}}" />
                        <TextBlock Classes="caption" TextWrapping="NoWrap" Text="{Binding Type.Name}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ComboBox ItemsSource="{Binding Falloffs}" SelectedItem="{Binding Falloff}" IsVisible="{Binding !Shape.IsShaped}"
                          AutomationProperties.Name="Brush falloff" AutomationProperties.HelpText="How a round brush fades from its centre to its edge: smooth, linear, or sharp (the same everywhere)" />
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Radius, StringFormat='Radius: {0:0} ogrids'}" />
                  <Slider Minimum="1" Maximum="128" Value="{Binding Radius}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Brush radius in ogrids" />
                </StackPanel>
                <ComboBox ItemsSource="{Binding Shape.Choices}" SelectedItem="{Binding Shape.Chosen}" MaxWidth="{StaticResource ToolSliderWidth}"
                          ToolTip.Tip="{Binding Shape.Chosen.Path}" AutomationProperties.Name="Brush shape"
                          AutomationProperties.HelpText="Round, or a picture of the workspace's brushes folder; choosing a brush on the asset shelf chooses it here" />
                <ContentControl Content="{Binding Shape}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- selecting and moving what lies on the map (F-11) -->
            <DataTemplate DataType="tools:SelectTool">
              <controls:ToolRow Classes="toolrow">
                <!-- the selection filter (F-11): the kinds it picks; an unchecked kind is locked -->
                <StackPanel Classes="inline" IsVisible="{Binding HasFilters}">
                  <TextBlock Classes="label" Text="Picks" />
                  <ItemsControl ItemsSource="{Binding Filters}" AutomationProperties.Name="Kinds the select tool picks">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Classes="inline" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="tools:SelectionFilterItem">
                        <CheckBox Content="{Binding Title}" IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Label}"
                                  AutomationProperties.HelpText="Unchecked, clicks and boxes leave this kind alone (it is locked)" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <!-- units chosen by what they are (U-10): the popover lies over the top view (SelectByPopover in MainWindow) -->
                <Button Content="Select by..." IsVisible="{Binding PicksUnits}" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="select.by"
                        AutomationProperties.Name="Select units by what they are"
                        AutomationProperties.HelpText="Opens a popover: choose the army, faction, kind, tech level, blueprint and wrecks, within the map, the selection or an area; Add keeps the selection, Select replaces it" />
                <StackPanel Classes="inline" IsVisible="{Binding PicksUnits}">
                  <TextBlock Classes="label" Text="{Binding UnitPicksLabel}" />
                  <ItemsControl ItemsSource="{Binding UnitPickChoices}" AutomationProperties.Name="How units are picked">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Classes="inline" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="tools:UnitPickChoice">
                        <Button Classes="chip" Classes.on="{Binding IsOn}" Content="{Binding Title}" Command="{Binding ChooseCommand}"
                                AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}" ToolTip.Tip="{Binding Help}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Classes="inline" DataContext="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Handles}">
                  <CheckBox Content="Handles" IsChecked="{Binding Show}" AutomationProperties.Name="Show the handles of the selection"
                            AutomationProperties.HelpText="The square moves, the arrows move along x or z, the ring turns, the squares on the box scale" />
                  <TextBlock Classes="label" Text="About" />
                  <ComboBox ItemsSource="{Binding Pivots}" SelectedItem="{Binding Pivot}" AutomationProperties.Name="What turns and scales go about"
                            AutomationProperties.HelpText="Selection: about the selection's centre, the things go round it; Each: each thing about its own centre" />
                  <TextBlock Classes="label" Text="Shift snaps to" />
                  <ComboBox ItemsSource="{Binding Snaps}" SelectedItem="{Binding Snap}" AutomationProperties.Name="Grid a move snaps to with shift"
                            AutomationProperties.HelpText="Shift snaps a move to this grid, a turn to 15 degrees, a scale to tenths" />
                  <CheckBox Content="Keep on grid" IsChecked="{Binding KeepOnGrid}" AutomationProperties.Name="Keep structures on the build grid"
                            AutomationProperties.HelpText="A move of a selection with structures is rounded so that the first structure lands on the build grid; everything else moves by the same amount" />
                </StackPanel>
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- the Decals mode's select tool (F-11, D-1): what dragging the selection does -->
            <DataTemplate DataType="tools:DecalSelectTool">
              <controls:ToolRow Classes="toolrow">
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="Drag" />
                  <ComboBox ItemsSource="{Binding DragModes}" SelectedItem="{Binding DragMode}" AutomationProperties.Name="What dragging the selection does"
                            AutomationProperties.HelpText="Move, Scale both sides, or scale the Width or Length only; S chooses the next" />
                </StackPanel>
                <StackPanel Classes="inline" DataContext="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Handles}">
                  <CheckBox Content="Handles" IsChecked="{Binding Show}" AutomationProperties.Name="Show the handles of the selection"
                            AutomationProperties.HelpText="The square moves, the arrows move along x or z, the ring turns, the squares on the box scale" />
                  <TextBlock Classes="label" Text="About" />
                  <ComboBox ItemsSource="{Binding Pivots}" SelectedItem="{Binding Pivot}" AutomationProperties.Name="What turns and scales go about"
                            AutomationProperties.HelpText="Selection: about the selection's centre, the things go round it; Each: each thing about its own centre" />
                  <TextBlock Classes="label" Text="Shift snaps to" />
                  <ComboBox ItemsSource="{Binding Snaps}" SelectedItem="{Binding Snap}" AutomationProperties.Name="Grid a move snaps to with shift"
                            AutomationProperties.HelpText="Shift snaps a move to this grid, a turn to 15 degrees, a scale to tenths" />
                </StackPanel>
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- placing decals (D-1): the decal, its size, turn and distance -->
            <DataTemplate DataType="tools:DecalPlaceTool">
              <controls:ToolRow Classes="toolrow">
                <StackPanel Classes="inline">
                  <controls:AssetThumbnail Source="{Binding Image}" DecodeWidth="64" Width="{StaticResource ChipHeight}" Height="{StaticResource ChipHeight}"
                                           IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}" AutomationProperties.Name="Picture of the decal to place" />
                  <TextBlock Classes="label" Text="{Binding Title}" ToolTip.Tip="{Binding Help}" AutomationProperties.Name="Decal to place"
                             AutomationProperties.HelpText="{Binding Help}" />
                  <Button Content="Choose..." Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="decals.choose"
                          AutomationProperties.Name="Choose the decal to place" AutomationProperties.HelpText="Opens the picker (Ctrl+P); a decal chosen on the shelf is chosen too" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Width, StringFormat='Width: {0:0.#} ogrids'}" />
                  <Slider Minimum="1" Maximum="256" Value="{Binding Width}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Width of a new decal in ogrids"
                          AutomationProperties.HelpText="Its length follows the texture's shape; dragging while placing sets the width too" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Heading, StringFormat='Turned: {0:0}°'}" />
                  <Slider Minimum="-180" Maximum="180" Value="{Binding Heading}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Turn of a new decal in degrees" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding CutOffLod, StringFormat='Shown within: {0:0}'}" />
                  <Slider Minimum="50" Maximum="2000" SmallChange="50" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="50" Value="{Binding CutOffLod}" Width="{StaticResource ToolSliderWidth}"
                          AutomationProperties.Name="Distance a new decal shows within"
                          AutomationProperties.HelpText="The game does not draw the decal when the camera is further away (its cut-off LOD); maps mostly use 200 to 800" />
                </StackPanel>
                <!-- decals along a curve (T-4, D2): this decal, width and cut-off, with the curve inspector's spacing, offset and sides -->
                <Button Content="Along a curve..." Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DecalsAlong.PlaceToolCommand}"
                        AutomationProperties.Name="Place the decal along a curve"
                        AutomationProperties.HelpText="Places this decal along the chosen curve layer (else the topmost curve), with the spacing, offset and sides of the curve's Decals along the curve" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- placing units (U-2) or a units preset (U-4): how to place (U-7: one, a line, a rectangle, a ring, a scatter) and
                 the settings of that way first, then what, for which army, into which group, facing where -->
            <DataTemplate DataType="tools:UnitPlaceTool">
              <controls:ToolRow Classes="toolrow">
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding ModeChoice}" AutomationProperties.Name="How to place"
                          AutomationProperties.HelpText="One unit a click, a line or rectangle dragged out, a ring around the selection, or a scatter brush">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="tools:PlaceModeChoice">
                      <TextBlock Text="{Binding Title}" AutomationProperties.Name="{Binding Label}" ToolTip.Tip="{Binding Help}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="units.pick" ToolTip.Tip="{Binding UnitTitle}"
                        AutomationProperties.Name="Choose a unit to place" AutomationProperties.HelpText="Opens the unit picker; a unit chosen on the asset shelf is placed too">
                  <StackPanel Classes="inline">
                    <controls:AssetThumbnail Model="{Binding Unit.Model}" Width="{StaticResource ToolButtonHeight}" Height="{StaticResource ToolButtonHeight}"
                                             IsVisible="{Binding HasUnit}" AutomationProperties.Name="Picture of the unit to place" />
                    <TextBlock Text="{Binding UnitButtonText}" MaxWidth="{StaticResource ToolSliderWidth}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
                <!-- the army and the group have no label of their own: the names say what they are, and the row is short at 1280 pixels -->
                <ComboBox ItemsSource="{Binding Armies}" SelectedItem="{Binding Army}" MaxWidth="{StaticResource ToolSliderWidth}" ToolTip.Tip="Army: the units are placed for it"
                          AutomationProperties.Name="Army to place units for" />
                <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding ChosenGroup}" MaxWidth="{StaticResource ToolSliderWidth}" ToolTip.Tip="Group: the units are placed into it"
                          AutomationProperties.Name="Group to place units into"
                          AutomationProperties.HelpText="The group chosen in the Units mode's tree is this one; the game creates the units of INITIAL, with its groups, when the game starts" />
                <CheckBox Content="Face along" IsChecked="{Binding FaceAlong}" IsVisible="{Binding IsLine}" AutomationProperties.Name="Face along the line"
                          AutomationProperties.HelpText="Each unit faces the way the line goes (a structure in the nearest quarter turn); unchecked, the facing below" />
                <CheckBox Content="Hollow" IsChecked="{Binding Hollow}" IsVisible="{Binding IsRectangle}" AutomationProperties.Name="Only the rectangle's border"
                          AutomationProperties.HelpText="A wall around a yard: only the border is filled" />
                <StackPanel Classes="inline" IsVisible="{Binding IsRing}">
                  <TextBlock Classes="label" Text="Distance" />
                  <TextBox Classes="toolfield" Text="{Binding Distance, UpdateSourceTrigger=LostFocus, Converter={x:Static controls:NumberTextConverter.Instance}}"
                           AutomationProperties.Name="Distance of the ring from what it goes around in ogrids" AutomationProperties.HelpText="Between the footprints of the selected units (or the structure under the mouse) and the ring" />
                </StackPanel>
                <StackPanel Classes="inline" IsVisible="{Binding IsScatter}">
                  <TextBlock Classes="label" Text="Count" />
                  <TextBox Classes="toolfield" Text="{Binding Count, UpdateSourceTrigger=LostFocus, Converter={x:Static controls:NumberTextConverter.Instance}}"
                           AutomationProperties.Name="Units a click scatters" AutomationProperties.HelpText="How many a click puts in the brush's circle; a drag goes on at that density" />
                  <TextBlock Classes="label" Text="Least distance" />
                  <TextBox Classes="toolfield" Text="{Binding LeastDistance, UpdateSourceTrigger=LostFocus, Converter={x:Static controls:NumberTextConverter.Instance}}"
                           AutomationProperties.Name="Least distance between scattered units in ogrids" />
                  <TextBlock Classes="label" Text="{Binding Radius, StringFormat='Radius: {0:0}'}" />
                  <Slider Minimum="1" Maximum="128" Value="{Binding Radius}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Scatter brush radius in ogrids" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="Facing" />
                  <TextBox Classes="toolfield" Text="{Binding Heading, UpdateSourceTrigger=LostFocus, Converter={x:Static controls:NumberTextConverter.Instance}}"
                           AutomationProperties.Name="Facing of placed units in degrees" AutomationProperties.HelpText="Clockwise from +x in the top view; Q and E turn it (a structure a quarter turn)" />
                </StackPanel>
                <StackPanel Classes="inline" IsVisible="{Binding UsesSpacing}">
                  <TextBlock Classes="label" Text="Spacing" />
                  <TextBox Classes="toolfield" Text="{Binding Spacing, UpdateSourceTrigger=LostFocus, Converter={x:Static controls:NumberTextConverter.Instance}}"
                           AutomationProperties.Name="Spacing of mobile units in ogrids" AutomationProperties.HelpText="Between the centres of mobile units in a line, rectangle or ring; structures butt together at their footprint" />
                </StackPanel>
                <CheckBox Content="As wrecks" IsChecked="{Binding AsWrecks}" AutomationProperties.Name="Place units as wrecks"
                          AutomationProperties.HelpText="They go into the army's WRECKAGE group, which the game turns into wrecks when it starts" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- placing markers of a kind (R-1): the grid, an AI marker's type, the last deposit's slope -->
            <DataTemplate DataType="tools:PlaceMarkerTool">
              <controls:ToolRow Classes="toolrow">
                <ComboBox ItemsSource="{Binding Snaps}" SelectedItem="{Binding Snap}" IsVisible="{Binding CanSnap}" AutomationProperties.Name="Snap markers to a grid" />
                <ComboBox ItemsSource="{Binding AiTypes}" SelectedItem="{Binding AiType}" IsVisible="{Binding IsAi}" AutomationProperties.Name="Type of AI marker to place" />
                <TextBlock Classes="warning" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Markers.PlacementWarning}" ToolTip.Tip="{Binding Markers.PlacementWarning}"
                           IsVisible="{Binding !CanSnap}" AutomationProperties.Name="Slope of the last deposit" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- placing and linking path nodes by hand (R-3) -->
            <DataTemplate DataType="tools:PathTool">
              <controls:ToolRow Classes="toolrow">
                <ComboBox ItemsSource="{Binding Layers}" SelectedItem="{Binding Layer}" AutomationProperties.Name="Layer of the path nodes to place" />
                <ComboBox ItemsSource="{Binding Snaps}" SelectedItem="{Binding Snap}" AutomationProperties.Name="Snap path nodes to a grid" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- placing a markers preset (F-10) -->
            <DataTemplate DataType="tools:MarkerPresetTool">
              <controls:ToolRow Classes="toolrow">
                <TextBlock Classes="label" Text="{Binding Title}" AutomationProperties.Name="Markers preset to place" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- placing a selection preset of several kinds (F-10) -->
            <DataTemplate DataType="tools:SelectionPresetTool">
              <controls:ToolRow Classes="toolrow">
                <TextBlock Classes="label" Text="{Binding Title}" ToolTip.Tip="{Binding Title}" AutomationProperties.Name="Selection preset to place" />
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="Units for" />
                  <ComboBox ItemsSource="{Binding Armies}" SelectedItem="{Binding Army}" AutomationProperties.Name="Army of the preset's units"
                            IsEnabled="{Binding !HoldsSpawn}" ToolTip.Tip="{Binding ArmyHelp}" AutomationProperties.HelpText="{Binding ArmyHelp}" />
                </StackPanel>
                <TextBlock Classes="label" Text="{Binding Heading, StringFormat='Turned: {0:0}°'}" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- putting markers in a chain (R-4) -->
            <DataTemplate DataType="tools:ChainTool">
              <controls:ToolRow Classes="toolrow">
                <TextBlock Classes="label" Text="{Binding Markers.SelectedChain.Summary, FallbackValue='A new chain', TargetNullValue='A new chain'}" AutomationProperties.Name="Chain the clicks add to" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- placing props one by one (P-1): the prop a click places, chosen in the picker or on the shelf -->
            <DataTemplate DataType="tools:PropPlaceTool">
              <controls:ToolRow Classes="toolrow">
                <Border Classes="thumbnail toolthumb">
                  <controls:AssetThumbnail Model="{Binding Prop.Model}" DecodeWidth="64" IsVisible="{Binding HasProp}" AutomationProperties.Name="Picture of the prop to place" />
                </Border>
                <TextBlock Classes="label" Text="{Binding Name}" AutomationProperties.Name="Prop to place" />
                <Button Content="Choose..." Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="props.choose"
                        AutomationProperties.HelpText="Choose the prop to place in the picker; a prop chosen on the shelf in the Props mode is chosen as well" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- painting props of the palette (P-2), only where a layer covers (P-3) -->
            <DataTemplate DataType="tools:PropPaintTool">
              <controls:ToolRow Classes="toolrow">
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Radius, StringFormat='Radius: {0:0}'}" />
                  <Slider Minimum="1" Maximum="128" Value="{Binding Radius}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Paint brush radius in ogrids" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Density, StringFormat='Density: {0:0.#}'}" />
                  <Slider Minimum="0.1" Maximum="50" Value="{Binding Density}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Props per 100 square ogrids"
                          AutomationProperties.HelpText="How many props a stroke paints on a square of 10 by 10 ogrids, up to the spacing" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Spacing, StringFormat='Spacing: {0:0.#}'}" />
                  <Slider Minimum="0" Maximum="32" Value="{Binding Spacing}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Least distance between props in ogrids" />
                </StackPanel>
                <TextBlock Classes="label" Text="Only on" />
                <ComboBox ItemsSource="{Binding Layers}" SelectedItem="{Binding OnlyOn}" MaxWidth="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Paint only where this layer covers"
                          AutomationProperties.HelpText="A stratum whose mask must cover the place at least the threshold" />
                <TextBlock Classes="label" Text="Not on" />
                <ComboBox ItemsSource="{Binding Layers}" SelectedItem="{Binding NotOn}" MaxWidth="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Paint nowhere this layer covers"
                          AutomationProperties.HelpText="A stratum whose mask must not cover the place as much as the threshold" />
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Threshold, StringFormat='Covered: {0:P0}'}" />
                  <Slider Minimum="0" Maximum="1" Value="{Binding Threshold}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="How much a layer covers to count" />
                </StackPanel>
              </controls:ToolRow>
            </DataTemplate>
            <!-- taking props away with a brush (P-2) -->
            <DataTemplate DataType="tools:PropEraseTool">
              <controls:ToolRow Classes="toolrow">
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Radius, StringFormat='Radius: {0:0} ogrids'}" />
                  <Slider Minimum="1" Maximum="128" Value="{Binding Radius}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Eraser radius in ogrids" />
                </StackPanel>
                <CheckBox Content="Only the palette's props" IsChecked="{Binding OnlyPalette}" AutomationProperties.Name="Erase only the props of the palette" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- drawing, moving and resizing areas (M-5) -->
            <DataTemplate DataType="tools:AreaTool">
              <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Hint}" ToolTip.Tip="{Binding Help}" />
            </DataTemplate>
            <!-- growing or cropping the map (M-3) -->
            <DataTemplate DataType="tools:MapSizeTool">
              <controls:ToolRow Classes="toolrow">
                <Button Content="Apply" Command="{Binding ApplyCommand}" ToolTip.Tip="{Binding Summary}" AutomationProperties.HelpText="Resize the map: one step of undo" />
                <StackPanel Classes="inline">
                  <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding NewWidth}" AutomationProperties.Name="New width in ogrids"
                            AutomationProperties.HelpText="256 is 5 km, 512 10 km, 1024 20 km, 2048 40 km, 4096 81 km" />
                  <TextBlock Classes="label" Text="by" />
                  <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding NewHeight}" AutomationProperties.Name="New height in ogrids" />
                </StackPanel>
                <ComboBox ItemsSource="{Binding Anchors}" SelectedItem="{Binding Anchor}" AutomationProperties.Name="Where the old map lies in the new one" />
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="at" />
                  <TextBox Classes="toolfield" Text="{Binding OffsetX, UpdateSourceTrigger=LostFocus, Converter={x:Static controls:NumberTextConverter.Instance}}" AutomationProperties.Name="Old map's left edge in the new map, in ogrids" />
                  <TextBox Classes="toolfield" Text="{Binding OffsetZ, UpdateSourceTrigger=LostFocus, Converter={x:Static controls:NumberTextConverter.Instance}}" AutomationProperties.Name="Old map's top edge in the new map, in ogrids" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <CheckBox Content="Fill at" IsChecked="{Binding FillWithHeight}" AutomationProperties.Name="Fill what the map gains at a height"
                            AutomationProperties.HelpText="Off, the heights at the old map's edges continue outwards" />
                  <TextBox Classes="toolfield" Text="{Binding FillHeight, UpdateSourceTrigger=LostFocus, Converter={x:Static controls:NumberTextConverter.Instance}}" IsEnabled="{Binding FillWithHeight}" AutomationProperties.Name="Height of the terrain the map gains" />
                </StackPanel>
                <CheckBox Content="Fit the playable area" IsChecked="{Binding FitPlayableArea}" AutomationProperties.Name="Make the playable area the whole new map" />
                <TextBlock Classes="caption mono" TextWrapping="NoWrap" Text="{Binding Summary}" AutomationProperties.Name="New map size" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- moving, scaling and turning a projected image (N-2): its opacity and proportions, a fit to the map, a new picture, and how to use it -->
            <DataTemplate DataType="tools:ImageTool">
              <controls:ToolRow Classes="toolrow">
                <StackPanel Classes="inline" IsVisible="{Binding Images.HasChosen}">
                  <TextBlock Classes="label" Text="{Binding Images.Opacity.Text, StringFormat='Opacity: {0}%'}" />
                  <Slider Minimum="0" Maximum="100" Value="{Binding Images.Opacity.Value}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Opacity of the chosen image in percent" />
                </StackPanel>
                <StackPanel Classes="inline" IsVisible="{Binding Images.HasChosen}">
                  <TextBlock Classes="label" Text="Turn:" />
                  <TextBox Classes="toolfield commit mono" Text="{Binding Images.Turn.Text, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Turn of the chosen image in degrees"
                           AutomationProperties.HelpText="Degrees clockwise about its middle; the knob above the image turns it too" />
                </StackPanel>
                <CheckBox Content="Keep proportions" IsChecked="{Binding Images.KeepProportions.IsOn}" IsVisible="{Binding Images.HasChosen}"
                          AutomationProperties.Name="Keep the chosen image's proportions"
                          AutomationProperties.HelpText="A corner scales both sides together, and a fit keeps the picture's proportions" />
                <Button Content="Fit to map" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="images.fitToMap"
                        IsVisible="{Binding Images.HasChosen}" AutomationProperties.Name="Fit the chosen image to the map" />
                <Button Content="Project an image..." Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="images.project"
                        AutomationProperties.Name="Project an image from the tool's row" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Hint}" ToolTip.Tip="{Binding Help}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- measuring distances and heights (V-5) -->
            <DataTemplate DataType="tools:RulerTool">
              <TextBlock Classes="mono" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Text}" ToolTip.Tip="{Binding Text}" VerticalAlignment="Center"
                         AutomationProperties.Name="Measurement" />
            </DataTemplate>
            <!-- the Sketch mode's pencil (N-1): the six colours (keys 1 to 6), the width ([ and ]), Mirror, Smooth and the sheet drawn into -->
            <DataTemplate DataType="tools:PencilTool">
              <controls:ToolRow Classes="toolrow">
                <ItemsControl ItemsSource="{Binding Colours}" AutomationProperties.Name="Pencil colours">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Classes="inline" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SketchColourChoice">
                      <Button Classes="chip icononly" Classes.on="{Binding IsOn}" Command="{Binding ChooseCommand}" ToolTip.Tip="{Binding Help}"
                              AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}">
                        <Border Classes="swatch" Background="{Binding Argb, Converter={x:Static controls:ArgbBrushConverter.Instance}}" BorderBrush="{Binding RimArgb, Converter={x:Static controls:ArgbBrushConverter.Instance}}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="Width" />
                  <ItemsControl ItemsSource="{Binding Widths}" AutomationProperties.Name="Pencil widths">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Classes="inline" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SketchWidthChoice">
                        <Button Classes="chip" Classes.on="{Binding IsOn}" Content="{Binding Title}" Command="{Binding ChooseCommand}"
                                ToolTip.Tip="[ makes the pencil thinner, ] thicker" AutomationProperties.Name="{Binding Label}"
                                AutomationProperties.HelpText="The width of the strokes on screen, the same at every zoom; [ and ] step it" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <CheckBox Content="Mirror" IsChecked="{Binding Mirror}" AutomationProperties.Name="Mirror strokes by the symmetry"
                          AutomationProperties.HelpText="A stroke is repeated by the map's symmetry, as the brushes are; off for a one-off note" />
                <CheckBox Content="Smooth" IsChecked="{Binding Smooth}" AutomationProperties.Name="Smooth the line"
                          AutomationProperties.HelpText="The line you draw is smoothed and thinned to few places when you let go" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding SheetText}" VerticalAlignment="Center"
                           AutomationProperties.Name="Sheet drawn into" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Text="Shift: a straight line · 1 to 6 colour · [ ] width · Ctrl+Shift+K shows or hides the sketch" AutomationProperties.Name="Pencil keys" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- the Sketch mode's eraser (N-1): its radius, Mirror, whole strokes (also Alt) and the sheet it erases in -->
            <DataTemplate DataType="tools:EraserTool">
              <controls:ToolRow Classes="toolrow">
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Radius, StringFormat='Radius: {0:0} ogrids'}" />
                  <Slider Minimum="1" Maximum="64" Value="{Binding Radius}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Eraser radius in ogrids" />
                </StackPanel>
                <CheckBox Content="Whole strokes" IsChecked="{Binding Whole}" AutomationProperties.Name="Erase whole strokes, symbols and labels"
                          AutomationProperties.HelpText="A stroke, symbol or label the eraser touches goes entirely, as with Alt held; off, it rubs out only where it passes strokes and leaves symbols and labels" />
                <CheckBox Content="Mirror" IsChecked="{Binding Mirror}" AutomationProperties.Name="Erase where the symmetry repeats the eraser"
                          AutomationProperties.HelpText="The eraser also works in the other parts of a symmetric map" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding SheetText}" VerticalAlignment="Center"
                           AutomationProperties.Name="Sheet erased in" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Text="Alt: whole strokes, symbols and labels · [ ] radius" AutomationProperties.Name="Eraser keys" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- the Sketch mode's Symbol tool (N-4): the six symbols, the colour (keys 1 to 6), the size, the turn of an arrow, Mirror and the sheet stamped into -->
            <DataTemplate DataType="tools:SymbolTool">
              <controls:ToolRow Classes="toolrow">
                <ItemsControl ItemsSource="{Binding Kinds}" AutomationProperties.Name="Symbols">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Classes="inline" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SketchSymbolChoice">
                      <Button Classes="chip icononly" Classes.on="{Binding IsOn}" Command="{Binding ChooseCommand}" ToolTip.Tip="{Binding Help}"
                              AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}">
                        <Path Classes="icon small" Data="{Binding Icon, Converter={x:Static controls:IconConverter.Instance}}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Colours}" AutomationProperties.Name="Symbol colours">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Classes="inline" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SketchColourChoice">
                      <Button Classes="chip icononly" Classes.on="{Binding IsOn}" Command="{Binding ChooseCommand}" ToolTip.Tip="{Binding Help}"
                              AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}">
                        <Border Classes="swatch" Background="{Binding Argb, Converter={x:Static controls:ArgbBrushConverter.Instance}}" BorderBrush="{Binding RimArgb, Converter={x:Static controls:ArgbBrushConverter.Instance}}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="Size" />
                  <ItemsControl ItemsSource="{Binding Sizes}" AutomationProperties.Name="Symbol sizes">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Classes="inline" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SketchSizeChoice">
                        <Button Classes="chip" Classes.on="{Binding IsOn}" Content="{Binding Title}" Command="{Binding ChooseCommand}"
                                AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="How large the symbol is on the map, in ogrids: it grows and shrinks with the zoom" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Classes="inline" IsVisible="{Binding IsArrow}">
                  <TextBlock Classes="label" Text="Turn:" />
                  <TextBox Classes="toolfield commit mono" Text="{Binding TurnText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Turn of the arrow in degrees"
                           AutomationProperties.HelpText="Degrees clockwise from pointing right; dragging while you place the arrow points it where the mouse goes" />
                </StackPanel>
                <CheckBox Content="Mirror" IsChecked="{Binding Mirror}" AutomationProperties.Name="Mirror symbols by the symmetry"
                          AutomationProperties.HelpText="A symbol is repeated by the map's symmetry, an arrow turned with it; off for a one-off note" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding SheetText}" VerticalAlignment="Center"
                           AutomationProperties.Name="Sheet stamped into" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Text="Click to stamp · arrow: drag to point it · 1 to 6 colour" AutomationProperties.Name="Symbol keys" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- the Sketch mode's Label tool (N-4): the colour (keys 1 to 6), the size and how to write -->
            <DataTemplate DataType="tools:LabelTool">
              <controls:ToolRow Classes="toolrow">
                <ItemsControl ItemsSource="{Binding Colours}" AutomationProperties.Name="Label colours">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Classes="inline" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SketchColourChoice">
                      <Button Classes="chip icononly" Classes.on="{Binding IsOn}" Command="{Binding ChooseCommand}" ToolTip.Tip="{Binding Help}"
                              AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}">
                        <Border Classes="swatch" Background="{Binding Argb, Converter={x:Static controls:ArgbBrushConverter.Instance}}" BorderBrush="{Binding RimArgb, Converter={x:Static controls:ArgbBrushConverter.Instance}}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="Size" />
                  <ItemsControl ItemsSource="{Binding Sizes}" AutomationProperties.Name="Label sizes">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Classes="inline" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SketchSizeChoice">
                        <Button Classes="chip" Classes.on="{Binding IsOn}" Content="{Binding Title}" Command="{Binding ChooseCommand}"
                                AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="How high the letters are on the map, in ogrids: they grow and shrink with the zoom" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding SheetText}" VerticalAlignment="Center"
                           AutomationProperties.Name="Sheet written in" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Text="Click to write · Enter keeps · Escape drops · written once, not mirrored" AutomationProperties.Name="Label keys" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- the Sketch mode's Select tool (N-4): what is selected, and the colours and sizes that change it -->
            <DataTemplate DataType="tools:SketchSelectTool">
              <controls:ToolRow Classes="toolrow">
                <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding Summary}" AutomationProperties.Name="Selection" />
                <ItemsControl ItemsSource="{Binding Colours}" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Colours for the selection">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Classes="inline" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SketchColourChoice">
                      <Button Classes="chip icononly" Command="{Binding ChooseCommand}" ToolTip.Tip="{Binding Help}"
                              AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="Gives everything selected this colour, as the colour keys do">
                        <Border Classes="swatch" Background="{Binding Argb, Converter={x:Static controls:ArgbBrushConverter.Instance}}" BorderBrush="{Binding RimArgb, Converter={x:Static controls:ArgbBrushConverter.Instance}}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Classes="inline" IsEnabled="{Binding HasSelection}">
                  <TextBlock Classes="label" Text="Size" />
                  <ItemsControl ItemsSource="{Binding Sizes}" AutomationProperties.Name="Sizes for the selection">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Classes="inline" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SketchSizeChoice">
                        <Button Classes="chip" Content="{Binding Title}" Command="{Binding ChooseCommand}"
                                AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="Sizes the selected symbols and labels; strokes have no size" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <Button Content="Delete" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="sketch.deleteSelected"
                        IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Delete the selected items of the sketch" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Text="Click or drag a box · Shift adds · drag to move · double-click a label to edit · Delete" AutomationProperties.Name="Select keys" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- choosing a connected region of the navigation mesh (T-8) -->
            <DataTemplate DataType="tools:RegionTool">
              <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Text}" ToolTip.Tip="{Binding Text}" VerticalAlignment="Center"
                         AutomationProperties.Name="Chosen connected region" />
            </DataTemplate>
            <!-- edits by hand on top of the generated path networks (R-3) -->
            <DataTemplate DataType="tools:PathNodeEditTool">
              <controls:ToolRow Classes="toolrow">
                <ComboBox ItemsSource="{Binding Layers}" SelectedItem="{Binding Layer}" AutomationProperties.Name="Layer of the generated path nodes to edit" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- placing and aiming wave generators (W-1) -->
            <DataTemplate DataType="tools:WaveTool">
              <controls:ToolRow Classes="toolrow">
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Heading, StringFormat='Heading: {0:0}°'}" />
                  <Slider Minimum="0" Maximum="359" Value="{Binding Heading}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Heading of a click's waves"
                          AutomationProperties.HelpText="The compass heading the waves of a generator placed with a click roll: 0 north, 90 east; a drag aims them itself" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="Speed" />
                  <TextBox Classes="toolfield" Text="{Binding Speed, Converter={x:Static controls:NumberTextConverter.Instance}}" AutomationProperties.Name="Speed of new waves"
                           AutomationProperties.HelpText="How fast the waves of a new generator roll, in ogrids a tick (the vault's maps: 0.01 to 0.045)" />
                </StackPanel>
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- turning the sun (L-1) -->
            <DataTemplate DataType="tools:SunTool">
              <controls:ToolRow Classes="toolrow">
                <TextBlock Classes="mono" Text="{Binding Angles}" AutomationProperties.Name="Sun angles" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- drawing curves that shape the terrain (T-4): what a new curve gets; the chosen curve's own are in the inspector -->
            <DataTemplate DataType="tools:CurveTool">
              <controls:ToolRow Classes="toolrow">
                <ComboBox ItemsSource="{x:Static tools:CurveTool.Profiles}" SelectedItem="{Binding Profile}" AutomationProperties.Name="Profile of a new curve"
                          AutomationProperties.HelpText="Ridge raises, valley lowers, road flattens to the terrain under its points, cliff raises the left side" />
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding CurveWidth, StringFormat='Width: {0:0} ogrids'}" />
                  <Slider Minimum="0" Maximum="64" Value="{Binding CurveWidth}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Width of a new curve in ogrids" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Falloff, StringFormat='Falloff: {0:0} ogrids'}" />
                  <Slider Minimum="0" Maximum="64" Value="{Binding Falloff}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Falloff of a new curve in ogrids" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Height, StringFormat='Height: {0:0.0}'}" />
                  <Slider Minimum="0" Maximum="100" Value="{Binding Height}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Height of a new ridge, valley or cliff"
                          AutomationProperties.HelpText="How much it rises or sinks in game units; a road's points lie on the terrain" />
                </StackPanel>
                <!-- where a new point's height comes from (T-4): a ramp's points follow the ground -->
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="New point's height" />
                  <ComboBox ItemsSource="{x:Static tools:CurveTool.PointHeightChoices}" SelectedItem="{Binding PointHeightChoice}" AutomationProperties.Name="Height of a new point"
                            AutomationProperties.HelpText="Automatic: the ground for a road, else the last point's height. Last point's, the ground under the click, or a height you type" />
                  <TextBox Classes="toolfield mono commit" IsVisible="{Binding IsTypedHeight}" Text="{Binding TypedHeight, UpdateSourceTrigger=LostFocus, Converter={x:Static controls:NumberTextConverter.Instance}}"
                           AutomationProperties.Name="Typed height of a new point" />
                </StackPanel>
                <CheckBox Content="Show width and fade" IsChecked="{Binding ShowReach}" AutomationProperties.Name="Show the curve's width and fade lines"
                          AutomationProperties.HelpText="Dashed lines where the curve's full width ends, dotted lines where its fade ends, in both views" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- a Lua plugin's tool (F-15): the plugin's fields it names, as on the Plugins page -->
            <DataTemplate DataType="tools:PluginTool">
              <controls:ToolRow Classes="toolrow" controls:ToolRowItems.Source="{Binding Settings}" AutomationProperties.Name="{Binding Title, StringFormat='{}{0}: settings'}">
                <!-- each field a setting of the row of its own, so only those that do not fit go behind More -->
                <controls:ToolRow.DataTemplates>
                  <DataTemplate DataType="vm:NumberSetting">
                    <StackPanel Classes="inline" ToolTip.Tip="{Binding Help}">
                      <TextBlock Classes="label" Text="{Binding Label}" />
                      <Slider IsVisible="{Binding HasSlider}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" Width="{StaticResource ToolSliderWidth}"
                              AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}" />
                      <TextBox Classes="toolfield" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{Binding Label, StringFormat='{}{0}, as a number'}" />
                    </StackPanel>
                  </DataTemplate>
                  <DataTemplate DataType="vm:BoolSetting">
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" ToolTip.Tip="{Binding Help}" AutomationProperties.HelpText="{Binding Help}" />
                  </DataTemplate>
                  <DataTemplate DataType="vm:ChoiceSetting">
                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Chosen}" ToolTip.Tip="{Binding Help}"
                              AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}" />
                  </DataTemplate>
                  <DataTemplate DataType="vm:TextSetting">
                    <StackPanel Classes="inline" ToolTip.Tip="{Binding Help}">
                      <TextBlock Classes="label" Text="{Binding Label}" />
                      <TextBox Classes="toolfield" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{Binding Label}" />
                    </StackPanel>
                  </DataTemplate>
                </controls:ToolRow.DataTemplates>
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Description}" ToolTip.Tip="{Binding Description}" IsVisible="{Binding HasDescription}" />
              </controls:ToolRow>
            </DataTemplate>
            <!-- how a brush's picture is turned; the shape itself is the first choice of the row -->
            <DataTemplate DataType="tools:BrushShapeSettings">
              <StackPanel Classes="toolrow">
                <StackPanel Classes="inline" IsVisible="{Binding IsShaped}">
                  <TextBlock Classes="label" Text="{Binding Rotation, StringFormat='Turned: {0:0}°'}" />
                  <Slider Minimum="-180" Maximum="180" Value="{Binding Rotation}" IsEnabled="{Binding !RandomRotation}" Width="{StaticResource ToolSliderWidth}"
                          AutomationProperties.Name="Brush rotation in degrees" />
                </StackPanel>
                <CheckBox Content="Random" IsChecked="{Binding RandomRotation}" IsVisible="{Binding IsShaped}"
                          AutomationProperties.Name="Turn each dab at random" />
              </StackPanel>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <!-- a tool not built yet -->
        <StackPanel Classes="inline" IsVisible="{Binding IsToolIncomplete}">
          <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding ActiveTool.Definition.Missing}"
                     ToolTip.Tip="{Binding ActiveTool.Definition.Missing}" />
          <TextBlock Classes="story" Text="{Binding ActiveTool.Definition.Story, StringFormat='Not built yet: user story {0}'}" />
        </StackPanel>
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
