<!-- The active tool's settings, in one row that wraps; a tool not built yet says what it will do. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             x:Class="FAForever.MapEditor.App.Views.ToolOptions"
             x:DataType="vm:MainViewModel">
  <Border Classes="toolbar">
    <WrapPanel Classes="row" IsEnabled="{Binding HasMap}">
      <TextBlock Classes="heading" VerticalAlignment="Center" Text="{Binding ActiveTool.Definition.Title}" />

      <!-- sculpting the heights (T-1) -->
      <ComboBox IsVisible="{Binding IsSculpting}" ItemsSource="{Binding BrushModes}" SelectedItem="{Binding BrushMode}" AutomationProperties.Name="Height brush mode" />
      <StackPanel Classes="inline" IsVisible="{Binding IsSculpting}">
        <TextBlock Classes="caption" Text="{Binding BrushStrength, StringFormat='Strength: {0:0.00}'}" />
        <Slider Minimum="0.01" Maximum="5" Value="{Binding BrushStrength}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Height brush strength" />
      </StackPanel>
      <StackPanel Classes="inline" IsVisible="{Binding IsSculpting}">
        <TextBlock Classes="caption" Text="{Binding BrushTarget, StringFormat='Flatten to: {0:0.0}'}" />
        <Slider Minimum="0" Maximum="256" Value="{Binding BrushTarget}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Height to flatten to" />
      </StackPanel>

      <!-- painting a stratum's mask (S-1) -->
      <StackPanel Classes="inline" IsVisible="{Binding IsPaintingStrata}">
        <TextBlock Classes="caption" Text="{Binding MaskStrength, StringFormat='Strength: {0:0.00}'}" />
        <Slider Minimum="0.01" Maximum="1" Value="{Binding MaskStrength}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Mask brush strength" />
      </StackPanel>
      <CheckBox IsVisible="{Binding IsPaintingStrata}" Content="Erase" IsChecked="{Binding MaskErase}" AutomationProperties.Name="Erase the layer" />

      <!-- both brushes -->
      <StackPanel Classes="inline" IsVisible="{Binding CanPaint}">
        <TextBlock Classes="caption" Text="{Binding BrushRadius, StringFormat='Radius: {0:0} ogrids'}" />
        <Slider Minimum="1" Maximum="128" Value="{Binding BrushRadius}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Brush radius in ogrids" />
      </StackPanel>

      <!-- a tool not built yet -->
      <StackPanel Classes="inline" IsVisible="{Binding IsToolIncomplete}">
        <TextBlock Classes="caption" Text="{Binding ActiveTool.Definition.Missing}" />
        <TextBlock Classes="story" Text="{Binding ActiveTool.Definition.Story, StringFormat='Not built yet: user story {0}'}" />
      </StackPanel>
    </WrapPanel>
  </Border>
</UserControl>
