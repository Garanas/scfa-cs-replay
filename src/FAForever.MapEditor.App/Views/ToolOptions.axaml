<!-- The active tool's settings, in one row of a fixed height whatever the tool, so the views never move:
     a template per tool class; a tool not built yet says what it will do. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:tools="using:FAForever.MapEditor.App.Tools"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             x:Class="FAForever.MapEditor.App.Views.ToolOptions"
             x:DataType="vm:MainViewModel">
  <Border Classes="toolbar options">
    <!-- a window too narrow scrolls the row; Fluent's scroll bar lies over it, so the height stays -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <StackPanel Classes="toolrow" IsEnabled="{Binding HasMap}">
        <TextBlock Classes="heading" Text="{Binding ActiveTool.Definition.Title}" />

        <ContentControl Content="{Binding ActiveTool.Tool}" IsVisible="{Binding ActiveTool.Tool, Converter={x:Static ObjectConverters.IsNotNull}}">
          <ContentControl.DataTemplates>
            <!-- sculpting the heights (T-1) -->
            <DataTemplate DataType="tools:SculptTool">
              <StackPanel Classes="toolrow">
                <ComboBox ItemsSource="{Binding Shape.Choices}" SelectedItem="{Binding Shape.Chosen}" MaxWidth="{StaticResource ToolSliderWidth}"
                          ToolTip.Tip="{Binding Shape.Chosen.Path}" AutomationProperties.Name="Brush shape"
                          AutomationProperties.HelpText="Round, or a picture of the workspace's brushes folder; choosing a brush on the asset shelf chooses it here" />
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" AutomationProperties.Name="Height brush mode" />
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Radius, StringFormat='Radius: {0:0} ogrids'}" />
                  <Slider Minimum="1" Maximum="128" Value="{Binding Radius}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Brush radius in ogrids" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Strength, StringFormat='Strength: {0:0.00}'}" />
                  <Slider Minimum="0.01" Maximum="{Binding StrengthMaximum}" Value="{Binding Strength}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Height brush strength" />
                </StackPanel>
                <StackPanel Classes="inline" IsVisible="{Binding IsFlattening}">
                  <TextBlock Classes="label" Text="{Binding Target, StringFormat='Flatten to: {0:0.0}'}" />
                  <Slider Minimum="0" Maximum="256" Value="{Binding Target}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Height to flatten to" />
                </StackPanel>
                <ContentControl Content="{Binding Shape}" />
              </StackPanel>
            </DataTemplate>
            <!-- painting a stratum's mask (S-1) -->
            <DataTemplate DataType="tools:StrataTool">
              <StackPanel Classes="toolrow">
                <ComboBox ItemsSource="{Binding Shape.Choices}" SelectedItem="{Binding Shape.Chosen}" MaxWidth="{StaticResource ToolSliderWidth}"
                          ToolTip.Tip="{Binding Shape.Chosen.Path}" AutomationProperties.Name="Brush shape"
                          AutomationProperties.HelpText="Round, or a picture of the workspace's brushes folder; choosing a brush on the asset shelf chooses it here" />
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Radius, StringFormat='Radius: {0:0} ogrids'}" />
                  <Slider Minimum="1" Maximum="128" Value="{Binding Radius}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Brush radius in ogrids" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Strength, StringFormat='Strength: {0:0.00}'}" />
                  <Slider Minimum="0.01" Maximum="1" Value="{Binding Strength}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Mask brush strength" />
                </StackPanel>
                <CheckBox Content="Erase" IsChecked="{Binding Erase}" AutomationProperties.Name="Erase the layer" />
                <ContentControl Content="{Binding Shape}" />
              </StackPanel>
            </DataTemplate>
            <!-- selecting and moving what lies on the map (F-11) -->
            <DataTemplate DataType="tools:SelectTool">
              <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
            </DataTemplate>
            <!-- the Decals mode's select tool (F-11, D-1): what dragging the selection does -->
            <DataTemplate DataType="tools:DecalSelectTool">
              <StackPanel Classes="toolrow">
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="Drag" />
                  <ComboBox ItemsSource="{Binding DragModes}" SelectedItem="{Binding DragMode}" AutomationProperties.Name="What dragging the selection does"
                            AutomationProperties.HelpText="Move, Scale both sides, or scale the Width or Length only; S chooses the next" />
                </StackPanel>
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </StackPanel>
            </DataTemplate>
            <!-- placing decals (D-1): the decal, its size, turn and distance -->
            <DataTemplate DataType="tools:DecalPlaceTool">
              <StackPanel Classes="toolrow">
                <StackPanel Classes="inline">
                  <controls:AssetThumbnail Source="{Binding Image}" DecodeWidth="64" Width="{StaticResource ChipHeight}" Height="{StaticResource ChipHeight}"
                                           IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}" AutomationProperties.Name="Picture of the decal to place" />
                  <TextBlock Classes="label" Text="{Binding Title}" ToolTip.Tip="{Binding Help}" AutomationProperties.Name="Decal to place"
                             AutomationProperties.HelpText="{Binding Help}" />
                  <Button Content="Choose..." Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="decals.choose"
                          AutomationProperties.Name="Choose the decal to place" AutomationProperties.HelpText="Opens the picker (Ctrl+P); a decal chosen on the shelf is chosen too" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Width, StringFormat='Width: {0:0.#} ogrids'}" />
                  <Slider Minimum="1" Maximum="256" Value="{Binding Width}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Width of a new decal in ogrids"
                          AutomationProperties.HelpText="Its length follows the texture's shape; dragging while placing sets the width too" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding Heading, StringFormat='Turned: {0:0}°'}" />
                  <Slider Minimum="-180" Maximum="180" Value="{Binding Heading}" Width="{StaticResource ToolSliderWidth}" AutomationProperties.Name="Turn of a new decal in degrees" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="{Binding CutOffLod, StringFormat='Shown within: {0:0}'}" />
                  <Slider Minimum="50" Maximum="2000" SmallChange="50" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="50" Value="{Binding CutOffLod}" Width="{StaticResource ToolSliderWidth}"
                          AutomationProperties.Name="Distance a new decal shows within"
                          AutomationProperties.HelpText="The game does not draw the decal when the camera is further away (its cut-off LOD); maps mostly use 200 to 800" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
            <!-- placing units (U-2) or a units preset (U-4): what, for which army, into which group, facing where -->
            <DataTemplate DataType="tools:UnitPlaceTool">
              <StackPanel Classes="toolrow">
                <StackPanel Classes="inline">
                  <controls:AssetThumbnail Model="{Binding Unit.Model}" Width="{StaticResource ToolButtonHeight}" Height="{StaticResource ToolButtonHeight}"
                                           IsVisible="{Binding HasUnit}" AutomationProperties.Name="Picture of the unit to place" />
                  <TextBlock Classes="label" Text="{Binding UnitTitle}" ToolTip.Tip="{Binding UnitTitle}" />
                  <Button Content="Choose..." Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="units.pick"
                          AutomationProperties.Name="Choose a unit to place" AutomationProperties.HelpText="Opens the unit picker; a unit chosen on the asset shelf is placed too" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="Army" />
                  <ComboBox ItemsSource="{Binding Armies}" SelectedItem="{Binding Army}" AutomationProperties.Name="Army to place units for" />
                </StackPanel>
                <StackPanel Classes="inline">
                  <TextBlock Classes="label" Text="Group" />
                  <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding ChosenGroup}" MaxWidth="{StaticResource ToolSliderWidth}"
                            AutomationProperties.Name="Group to place units into"
                            AutomationProperties.HelpText="The game creates the units of INITIAL, with its groups, when the game starts" />
                </StackPanel>
                <TextBlock Classes="label" Text="{Binding Heading, StringFormat='Facing: {0:0}°'}" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </StackPanel>
            </DataTemplate>
            <!-- placing markers of a kind (R-1): the grid, an AI marker's type, the last deposit's slope -->
            <DataTemplate DataType="tools:PlaceMarkerTool">
              <StackPanel Classes="toolrow">
                <ComboBox ItemsSource="{Binding Snaps}" SelectedItem="{Binding Snap}" IsVisible="{Binding CanSnap}" AutomationProperties.Name="Snap markers to a grid" />
                <ComboBox ItemsSource="{Binding AiTypes}" SelectedItem="{Binding AiType}" IsVisible="{Binding IsAi}" AutomationProperties.Name="Type of AI marker to place" />
                <TextBlock Classes="warning" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Markers.PlacementWarning}" ToolTip.Tip="{Binding Markers.PlacementWarning}"
                           IsVisible="{Binding !CanSnap}" AutomationProperties.Name="Slope of the last deposit" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </StackPanel>
            </DataTemplate>
            <!-- placing and linking path nodes by hand (R-3) -->
            <DataTemplate DataType="tools:PathTool">
              <StackPanel Classes="toolrow">
                <ComboBox ItemsSource="{Binding Layers}" SelectedItem="{Binding Layer}" AutomationProperties.Name="Layer of the path nodes to place" />
                <ComboBox ItemsSource="{Binding Snaps}" SelectedItem="{Binding Snap}" AutomationProperties.Name="Snap path nodes to a grid" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </StackPanel>
            </DataTemplate>
            <!-- putting markers in a chain (R-4) -->
            <DataTemplate DataType="tools:ChainTool">
              <StackPanel Classes="toolrow">
                <TextBlock Classes="label" Text="{Binding Markers.SelectedChain.Summary, FallbackValue='A new chain', TargetNullValue='A new chain'}" AutomationProperties.Name="Chain the clicks add to" />
                <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Help}" ToolTip.Tip="{Binding Help}" />
              </StackPanel>
            </DataTemplate>
            <!-- how either brush's picture is turned; the shape itself is the first choice of the row -->
            <DataTemplate DataType="tools:BrushShapeSettings">
              <StackPanel Classes="toolrow">
                <StackPanel Classes="inline" IsVisible="{Binding IsShaped}">
                  <TextBlock Classes="label" Text="{Binding Rotation, StringFormat='Turned: {0:0}°'}" />
                  <Slider Minimum="-180" Maximum="180" Value="{Binding Rotation}" IsEnabled="{Binding !RandomRotation}" Width="{StaticResource ToolSliderWidth}"
                          AutomationProperties.Name="Brush rotation in degrees" />
                </StackPanel>
                <CheckBox Content="Random" IsChecked="{Binding RandomRotation}" IsVisible="{Binding IsShaped}"
                          AutomationProperties.Name="Turn each dab at random" />
              </StackPanel>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <!-- a tool not built yet -->
        <StackPanel Classes="inline" IsVisible="{Binding IsToolIncomplete}">
          <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding ActiveTool.Definition.Missing}"
                     ToolTip.Tip="{Binding ActiveTool.Definition.Missing}" />
          <TextBlock Classes="story" Text="{Binding ActiveTool.Definition.Story, StringFormat='Not built yet: user story {0}'}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
