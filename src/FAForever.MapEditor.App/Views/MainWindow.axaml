<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
        xmlns:controls="using:FAForever.MapEditor.App.Controls"
        xmlns:views="using:FAForever.MapEditor.App.Views"
        x:Class="FAForever.MapEditor.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenProjectCommand}" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding ImportMapCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportMapCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoEditCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoEditCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoEditCommand}" />
  </Window.KeyBindings>

  <Grid>
  <DockPanel IsVisible="{Binding IsReady}">
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open project..." InputGesture="Ctrl+O" Command="{Binding OpenProjectCommand}" />
        <MenuItem Header="_Import map folder..." InputGesture="Ctrl+I" Command="{Binding ImportMapCommand}" />
        <Separator />
        <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
        <MenuItem Header="Save _as project..." InputGesture="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
        <Separator />
        <MenuItem Header="_Export to the vault" InputGesture="Ctrl+E" Command="{Binding ExportMapCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="{Binding UndoHeader}" InputGesture="Ctrl+Z" Command="{Binding UndoEditCommand}" />
        <MenuItem Header="{Binding RedoHeader}" InputGesture="Ctrl+Y" Command="{Binding RedoEditCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Fit the map" Click="OnFit" />
        <Separator />
        <MenuItem Header="_Markers" ToggleType="CheckBox" IsChecked="{Binding ShowMarkers}" />
        <MenuItem Header="_Path nodes" ToggleType="CheckBox" IsChecked="{Binding ShowPathNodes}" />
        <MenuItem Header="3D _camera in the top view" ToggleType="CheckBox" IsChecked="{Binding ShowCamera}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Classes="bar">
      <DockPanel>
        <TextBlock x:Name="CursorText" DockPanel.Dock="Right" Margin="{StaticResource InlineGap}" AutomationProperties.Name="Place under the mouse" />
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Status" AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
    </Border>

    <views:SidePanel DockPanel.Dock="Right" />

    <!-- the tabs only choose: both views stay in the tree, so the 3D view keeps its textures on the graphics card -->
    <DockPanel>
      <TabControl x:Name="Views" DockPanel.Dock="Top" Padding="0" SelectionChanged="OnViewChosen" AutomationProperties.Name="View">
        <TabItem Header="Top" />
        <TabItem Header="3D" />
      </TabControl>
      <Grid>
        <controls:HeightmapView x:Name="Heightmap" ClipToBounds="True" AutomationProperties.Name="Top view"
                                 AutomationProperties.HelpText="Left mouse paints; right or middle moves; the wheel zooms; control and a click sends the 3D camera there" />
        <controls:TerrainViewGpu x:Name="Terrain3D" IsVisible="False" AutomationProperties.Name="3D view"
                                  AutomationProperties.HelpText="The wheel zooms towards the mouse; middle moves; space and the mouse turn; F focuses; Home shows the whole map" />
      </Grid>
    </DockPanel>
  </DockPanel>

  <views:SetupPage IsVisible="{Binding IsSettingUp}" />
  <views:UpdateAssetsPage IsVisible="{Binding IsAskingToUpdate}" />
  <views:ConvertingPage IsVisible="{Binding IsConverting}" />
  </Grid>
</Window>
