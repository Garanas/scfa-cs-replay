<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
        xmlns:controls="using:FAForever.MapEditor.App.Controls"
        x:Class="FAForever.MapEditor.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenProjectCommand}" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding ImportMapCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportMapCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoEditCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoEditCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoEditCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open project..." InputGesture="Ctrl+O" Command="{Binding OpenProjectCommand}" />
        <MenuItem Header="_Import map folder..." InputGesture="Ctrl+I" Command="{Binding ImportMapCommand}" />
        <Separator />
        <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
        <MenuItem Header="Save _as project..." InputGesture="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
        <Separator />
        <MenuItem Header="_Export map..." InputGesture="Ctrl+E" Command="{Binding ExportMapCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="{Binding UndoHeader}" InputGesture="Ctrl+Z" Command="{Binding UndoEditCommand}" />
        <MenuItem Header="{Binding RedoHeader}" InputGesture="Ctrl+Y" Command="{Binding RedoEditCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Fit the map" Click="OnFit" />
        <Separator />
        <MenuItem Header="_Markers" ToggleType="CheckBox" IsChecked="{Binding ShowMarkers}" />
        <MenuItem Header="_Path nodes" ToggleType="CheckBox" IsChecked="{Binding ShowPathNodes}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Padding="8,4" Background="#202020">
      <DockPanel>
        <TextBlock x:Name="CursorText" DockPanel.Dock="Right" Margin="16,0,0,0" />
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Right" Width="240" Padding="12" Background="#1a1a1a">
      <StackPanel Spacing="8" IsEnabled="{Binding HasMap}">
        <TextBlock Text="Brush" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding PaintTargets}" SelectedItem="{Binding SelectedPaintTarget}" HorizontalAlignment="Stretch" />
        <TextBlock Text="{Binding BrushRadius, StringFormat='Radius: {0:0} ogrids'}" />
        <Slider Minimum="1" Maximum="128" Value="{Binding BrushRadius}" />
        <StackPanel Spacing="8" IsVisible="{Binding IsPaintingHeight}">
          <ComboBox ItemsSource="{Binding BrushModes}" SelectedItem="{Binding BrushMode}" HorizontalAlignment="Stretch" />
          <TextBlock Text="{Binding BrushStrength, StringFormat='Strength: {0:0.00}'}" />
          <Slider Minimum="0.01" Maximum="5" Value="{Binding BrushStrength}" />
          <TextBlock Text="{Binding BrushTarget, StringFormat='Flatten to: {0:0.0}'}" />
          <Slider Minimum="0" Maximum="256" Value="{Binding BrushTarget}" />
        </StackPanel>
        <StackPanel Spacing="8" IsVisible="{Binding IsPaintingLayer}">
          <TextBlock Text="{Binding MaskStrength, StringFormat='Strength: {0:0.00}'}" />
          <Slider Minimum="0.01" Maximum="1" Value="{Binding MaskStrength}" />
          <CheckBox Content="Erase" IsChecked="{Binding MaskErase}" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                   Text="Left mouse: paint. Right or middle mouse: move. Wheel: zoom. A stroke is one step of Undo." />
        <TextBlock Text="History" FontWeight="SemiBold" Margin="0,12,0,0" />
        <ListBox ItemsSource="{Binding History}" SelectedIndex="{Binding HistoryIndex, Mode=TwoWay}" MaxHeight="320">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryEntry">
              <TextBlock Text="{Binding Description}" Classes.undone="{Binding IsUndone}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.Styles>
            <Style Selector="TextBlock.undone">
              <Setter Property="Opacity" Value="0.4" />
              <Setter Property="FontStyle" Value="Italic" />
            </Style>
          </ListBox.Styles>
        </ListBox>
      </StackPanel>
    </Border>

    <controls:HeightmapView x:Name="Heightmap" ClipToBounds="True" />
  </DockPanel>
</Window>
