<!--
  The editor's window (concept A of the UI design): the menu, the rail of modes, the mode's panel,
  the tool's options, the views with their overlays, the dock, the inspector and the status bar;
  over them the pages of the start and the command palette. The menus and shortcuts are made from
  the controller's commands (MainWindow.axaml.cs).
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
        xmlns:controls="using:FAForever.MapEditor.App.Controls"
        xmlns:views="using:FAForever.MapEditor.App.Views"
        x:Class="FAForever.MapEditor.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800">

  <Grid>
    <DockPanel IsVisible="{Binding Setup.IsReady}">
      <Border DockPanel.Dock="Top" Classes="menubar">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Classes="mapname" Text="{Binding MapName}" IsVisible="{Binding HasMap}" AutomationProperties.Name="Map" />
          <Button DockPanel.Dock="Right" Classes="search" Command="{Binding RunCommand}" CommandParameter="view.palette"
                  AutomationProperties.Name="Command palette">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Classes="shortcut" Text="Ctrl K" />
              <StackPanel>
                <Path Classes="icon small" Data="{StaticResource Icon.Search}" />
                <TextBlock Text="Run a command" />
              </StackPanel>
            </DockPanel>
          </Button>
          <Menu x:Name="MainMenu" />
        </DockPanel>
      </Border>

      <Border DockPanel.Dock="Bottom" Classes="bar">
        <DockPanel>
          <TextBlock x:Name="CursorText" DockPanel.Dock="Left" Classes="mono" AutomationProperties.Name="Place under the mouse" />
          <TextBlock DockPanel.Dock="Right" Classes="warning" Margin="{StaticResource InlineGap}" Text="{Binding Generation.Summary}"
                     IsVisible="{Binding Generation.HasStale}" AutomationProperties.Name="Generated results out of date"
                     ToolTip.Tip="Generate, Everything out of date makes them again" />
          <TextBlock DockPanel.Dock="Right" Classes="secondary mono" Margin="{StaticResource InlineGap}" Text="{Binding SelectionStatus}"
                     IsVisible="{Binding Selection.HasAny}" AutomationProperties.Name="Selection and its size" />
          <TextBlock DockPanel.Dock="Right" Classes="secondary" Margin="{StaticResource InlineGap}" AutomationProperties.Name="Mode and tool">
            <Run Text="{Binding SelectedMode.Definition.Title}" /><Run Text=" · " /><Run Text="{Binding ActiveTool.Definition.Title}" />
          </TextBlock>
          <TextBlock Text="{Binding Status}" Margin="{StaticResource InlineGap}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Status" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
      </Border>

      <views:ModeRail DockPanel.Dock="Left" />
      <views:ModePanel DockPanel.Dock="Left" />
      <views:Inspector DockPanel.Dock="Right" />

      <DockPanel>
        <views:ToolOptions DockPanel.Dock="Top" />

        <!-- which view, and what it shows over the terrain; the tabs only choose: both views stay in the tree,
             so the 3D view keeps its textures on the graphics card -->
        <Border DockPanel.Dock="Top" Classes="toolbar views">
          <WrapPanel Classes="row">
            <!-- in the order of MapViewTab -->
            <TabControl x:Name="Views" Classes="segmented" SelectedIndex="{Binding View, Converter={x:Static controls:EnumIndexConverter.Instance}}" AutomationProperties.Name="View">
              <TabItem Header="Top" />
              <TabItem Header="3D" />
            </TabControl>
            <Button Classes="chip planned" Content="Side by side" Command="{Binding RunCommand}" CommandParameter="view.sideBySide"
                    ToolTip.Tip="Not built yet: user story V-4" />
            <Border Classes="barseparator" />
            <TextBlock Classes="caption" Text="Show" />
            <ItemsControl ItemsSource="{Binding Overlays}" AutomationProperties.Name="Shown over the terrain">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Classes="chips" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OverlayItem">
                  <Button Classes="chip" Classes.on="{Binding IsOn}" Classes.planned="{Binding IsIncomplete}" Content="{Binding Title}"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="{Binding Definition.CommandId}"
                          AutomationProperties.Name="{Binding Title, StringFormat='Show {0}'}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="barseparator" />
            <TextBlock Classes="caption" Text="Symmetry" />
            <ComboBox ItemsSource="{Binding Symmetry.Choices}" SelectedItem="{Binding Symmetry.Chosen}"
                      AutomationProperties.Name="Symmetry"
                      AutomationProperties.HelpText="The symmetry edits are mirrored by; the top view shows its guides" />
            <CheckBox Content="Mirror edits" IsVisible="{Binding Symmetry.IsOn}" IsChecked="{Binding Symmetry.MirrorsEdits}"
                      AutomationProperties.HelpText="On, brush strokes, placing, moving, turning and deleting work in every part of the map; off, the symmetry shows its guides only" />
          </WrapPanel>
        </Border>

        <views:Dock DockPanel.Dock="Bottom" />

        <Grid>
          <controls:HeightmapView x:Name="Heightmap" ClipToBounds="True" AutomationProperties.Name="Top view"
                                   AutomationProperties.HelpText="The left mouse uses the tool; right or middle moves; the wheel zooms; alt and a click sends the 3D camera there; after a click the active tool takes keys (the Select tool: Q, E, the arrows, Escape)" />
          <controls:TerrainViewGpu x:Name="Terrain3D" IsVisible="False" AutomationProperties.Name="3D view"
                                    AutomationProperties.HelpText="The wheel zooms towards the mouse; middle moves; space and the mouse turn; F focuses; Home shows the whole map" />
        </Grid>
      </DockPanel>
    </DockPanel>

    <views:SetupPage IsVisible="{Binding Setup.IsSettingUp}" />
    <views:UpdateAssetsPage IsVisible="{Binding Setup.IsAskingToUpdate}" />
    <views:ConvertingPage IsVisible="{Binding Setup.IsConverting}" />
    <views:CommandPalette x:Name="Palette" IsVisible="{Binding Palette.IsOpen}" />
    <Panel IsVisible="{Binding Picker.IsOpen}">
      <views:AssetPicker x:Name="Picker" DataContext="{Binding Picker}" />
    </Panel>
    <views:DiagnosticsPage IsVisible="{Binding Diagnostics.IsOpen}" />
    <views:VersionControlPage IsVisible="{Binding VersionControl.IsOpen}" />
    <views:NewMapPage IsVisible="{Binding NewMapPage.IsOpen}" />
  </Grid>
</Window>
