<!-- The path networks in the Procedural mode (R-3): their settings, Generate, how they stand, the edits by hand. On the part's own view model, so it fits a panel or an inspector. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             x:Class="FAForever.MapEditor.App.Views.ProceduralPanels.PathNodesPanel"
             x:DataType="vm:PathNodesViewModel">
  <Border Classes="group">
    <StackPanel Classes="stack">
      <TextBlock Classes="overline" Text="{Binding Source=How they are generated, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
      <UniformGrid Columns="2">
        <CheckBox Content="Land" IsChecked="{Binding Land}" AutomationProperties.Name="Generate the land network" />
        <CheckBox Content="Water" IsChecked="{Binding Water}" AutomationProperties.Name="Generate the water network" />
        <CheckBox Content="Amphibious" IsChecked="{Binding Amphibious}" AutomationProperties.Name="Generate the amphibious network" />
        <CheckBox Content="Air" IsChecked="{Binding Air}" AutomationProperties.Name="Generate the air network" />
      </UniformGrid>
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Classes="secondary" Text="Spacing" Width="{StaticResource FactLabelWidth}" />
        <TextBox Classes="mono commit" Text="{Binding Spacing}" AutomationProperties.Name="Spacing of the path nodes"
                 AutomationProperties.HelpText="About how far apart the nodes lie along the corridors, in ogrids; empty: a sixteenth of the map, 16 to 64" />
      </DockPanel>
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Classes="secondary" Text="Smoothing" Width="{StaticResource FactLabelWidth}" />
        <TextBox Classes="mono commit" Text="{Binding Smoothing}" AutomationProperties.Name="Rounds of smoothing"
                 AutomationProperties.HelpText="How many rounds each node moves halfway toward the middle of its neighbours, kept inside its region; 0 to 10" />
      </DockPanel>
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Classes="secondary" Text="Closest" Width="{StaticResource FactLabelWidth}" />
        <TextBox Classes="mono commit" Text="{Binding MinimumDistance}" AutomationProperties.Name="Minimum distance between path nodes"
                 AutomationProperties.HelpText="Nodes closer than this, in ogrids, are merged; empty: 0.4 of the spacing" />
      </DockPanel>
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Classes="secondary" Text="Air spacing" Width="{StaticResource FactLabelWidth}" />
        <TextBox Classes="mono commit" Text="{Binding AirSpacing}" AutomationProperties.Name="Spacing of the air path nodes"
                 AutomationProperties.HelpText="How far apart the air nodes lie, in ogrids; empty: a grid of 16 by 16 over the playable area, as the game's maps have" />
      </DockPanel>
      <CheckBox Content="Fill open ground" IsChecked="{Binding Fill}" AutomationProperties.Name="Fill open ground with path nodes"
                AutomationProperties.HelpText="On: open ground away from the skeleton gets nodes about a spacing apart. Off: nodes only along the skeleton" />
      <CheckBox Content="Write into the map on export" IsChecked="{Binding OnExport}" AutomationProperties.Name="Write the path networks on export"
                AutomationProperties.HelpText="The export writes the generated networks, with the edits by hand, into the markers of the map's files; the project never holds them" />
      <CheckBox Content="Replace the map's own path nodes" IsChecked="{Binding Replace}" AutomationProperties.Name="Replace the map's own path nodes on export"
                AutomationProperties.HelpText="On: the export removes the path-node markers of the generated layers (placed by hand, or generated by an older editor). Off: both are written, each piece of the map's own linked to the network" />
      <Button Content="Generate" Command="{Binding GenerateCommand}" AutomationProperties.Name="Generate path networks"
              AutomationProperties.HelpText="Nodes along the middle of every connected region, smoothed and linked where units walk straight; previewed in the views" />
      <TextBlock Classes="caption" Classes.warning="{Binding IsStale}" TextWrapping="Wrap" Text="{Binding Status}" AutomationProperties.Name="How the path networks stand" />
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Result}" IsVisible="{Binding Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="What was generated" />
      <TextBlock Classes="caption" Classes.warning="{Binding HasUnmatched}" TextWrapping="Wrap" Text="{Binding EditsText}" AutomationProperties.Name="Edits of the path networks by hand"
                 ToolTip.Tip="Made with the Path nodes tool; applied again after every generation. An edit whose node is gone after a change keeps waiting for it" />
      <UniformGrid Columns="2" IsVisible="{Binding HasEdits}">
        <Button Content="Forget unmatched" Command="{Binding ForgetUnmatchedCommand}" IsEnabled="{Binding HasUnmatched}"
                AutomationProperties.Name="Forget the path edits without their node" AutomationProperties.HelpText="Forgets the edits whose generated node is gone; one step of undo" />
        <Button Content="Forget all edits" Command="{Binding ClearEditsCommand}" AutomationProperties.Name="Forget the path edits"
                AutomationProperties.HelpText="Forgets every edit by hand of the path networks; one step of undo" />
      </UniformGrid>
    </StackPanel>
  </Border>
</UserControl>
