<!-- The sky cube map (L-1) in the Procedural inspector: its faces, how it stands, the sky it shows, Generate and Use, and
     its settings (resolution, eye height, the terrain, the sun's disc). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             x:Class="FAForever.MapEditor.App.Views.ProceduralPanels.SkyCubeView"
             x:DataType="vm:SkyCubeViewModel">
  <StackPanel>
    <Border Classes="group">
      <StackPanel Classes="stack">
        <TextBlock Classes="overline" Text="{Binding Source=Sky cube map, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
        <Border Classes="thumbnail skycubepreview" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}">
          <controls:ImagePreview Picture="{Binding Preview}" LargeSize="768" AutomationProperties.Name="The sky cube map's faces: +x, -x, +y, -y, +z, -z" />
        </Border>
        <TextBlock Classes="caption" Text="{Binding Status}" AutomationProperties.Name="How the sky cube map stands" />
        <TextBlock Classes="caption" Text="{Binding SkyLine}" AutomationProperties.Name="The sky the cube map shows" />
        <TextBlock Classes="caption" Text="{Binding UseLine}" AutomationProperties.Name="What uses the sky cube map" />
        <Button Content="{Binding GenerateText}" Command="{Binding GenerateNowCommand}" IsEnabled="{Binding !IsGenerating}"
                AutomationProperties.Name="Generate the sky cube map"
                AutomationProperties.HelpText="Draws the six faces from above the map's middle and keeps them in the project's env folder" />
        <Button Content="Use for sky, units and water" Command="{Binding UseEverywhereCommand}" IsEnabled="{Binding CanUse}"
                AutomationProperties.Name="Use the sky cube map for the sky, the units and the water"
                AutomationProperties.HelpText="Makes it the sky's cube map, the one units reflect and the one the water reflects" />
      </StackPanel>
    </Border>
    <Border Classes="group">
      <controls:SettingList DataContext="{Binding Settings}" ShowsTitle="False" />
    </Border>
  </StackPanel>
</UserControl>
