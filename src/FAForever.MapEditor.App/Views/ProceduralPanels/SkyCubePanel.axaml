<!-- The sky cube map (L-1) in the Procedural panel: its faces small, how it stands, Generate; choosing the entry shows its
     settings in the inspector (SkyCubeView). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             x:Class="FAForever.MapEditor.App.Views.ProceduralPanels.SkyCubePanel"
             x:DataType="vm:SkyCubeViewModel">
  <Border Classes="group">
    <StackPanel Classes="partgroup">
      <TextBlock Classes="overline" Text="{Binding Source=Sky cube map, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
      <StackPanel Classes="partentries">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Generate" Command="{Binding GenerateNowCommand}" IsEnabled="{Binding !IsGenerating}"
                  AutomationProperties.Name="Generate the sky cube map"
                  AutomationProperties.HelpText="Draws the six faces from above the map's middle and keeps them in the project's env folder" />
          <Button Classes="partentry skycubeentry" Classes.selected="{Binding Part.IsChosen}"
                  Command="{Binding Parts.ChooseItemCommand}" CommandParameter="{Binding Part}"
                  ToolTip.Tip="{Binding Help}"
                  AutomationProperties.Name="Sky cube map" AutomationProperties.HelpText="{Binding Part.Label}">
            <DockPanel>
              <Border DockPanel.Dock="Left" Classes="thumbnail imagepreview">
                <controls:ImagePreview Picture="{Binding Preview}" AutomationProperties.Name="Preview of the sky cube map's faces" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Part.Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="partdetail skycubedetail" Text="{Binding Part.Detail}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DockPanel>
          </Button>
        </DockPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
