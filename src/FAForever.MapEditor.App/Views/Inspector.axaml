<!-- The inspector: the properties of what is selected or active (F-11), by mode; its parts a line apart.
     An asset chosen in the shelf shows here until the choice is cleared (F-8, F-9); what is selected on
     the map shows here instead of the mode's parts, with its shared fields and a section per kind. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             xmlns:workspaces="using:FAForever.MapEditor.Project.Workspaces"
             xmlns:panels="using:FAForever.MapEditor.App.Views.MapPanels"
             x:Class="FAForever.MapEditor.App.Views.Inspector"
             x:DataType="vm:MainViewModel">
  <Border Classes="inspector">
    <ScrollViewer>
      <Panel>
        <StackPanel IsVisible="{Binding Assets.HasSelection}" AutomationProperties.Name="Asset">
          <Border Classes="panelhead">
            <StackPanel>
              <TextBlock Classes="overline" Text="{Binding Source=Inspector, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
              <TextBlock Classes="panelname" Text="{Binding Assets.Shown.Name}" TextWrapping="Wrap" AutomationProperties.Name="Asset name" />
              <TextBlock Classes="caption" Text="{Binding Assets.ShownDetail}" />
            </StackPanel>
          </Border>
          <Border Classes="group">
            <StackPanel Classes="stack">
              <Border Classes="thumbnail preview">
                <Panel>
                  <controls:AssetThumbnail Source="{Binding Assets.ShownImage}" Model="{Binding Assets.ShownModel}" DecodeWidth="512" IsVisible="{Binding Assets.HasShownImage}"
                                           AutomationProperties.Name="Picture of the asset" />
                  <Path Classes="icon" Data="{Binding Assets.ShownGlyph, Converter={x:Static controls:IconConverter.Instance}}" IsVisible="{Binding !Assets.HasShownImage}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
              </Border>
              <StackPanel Classes="inline" IsVisible="{Binding Assets.HasShownNormalImage}">
                <Border Classes="thumbnail normalpreview">
                  <controls:AssetThumbnail Source="{Binding Assets.ShownNormalImage}" AutomationProperties.Name="Normal map of the asset" />
                </Border>
                <TextBlock Classes="caption" Text="Normal map" />
              </StackPanel>
              <TextBlock Classes="caption" Text="{Binding Assets.ShownUses}" IsVisible="{Binding Assets.ShownUses, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         AutomationProperties.Name="Uses of the asset" />
            </StackPanel>
          </Border>
          <Border Classes="group" IsVisible="{Binding Assets.IsFamilySelected}">
            <StackPanel Classes="stack">
              <TextBlock Classes="heading" Text="Variants" />
              <ListBox ItemsSource="{Binding Assets.Selected.Members}" SelectedItem="{Binding Assets.SelectedMember}" AutomationProperties.Name="Variants">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="workspaces:AssetEntry">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>
          <Border Classes="group">
            <StackPanel Classes="stack">
              <ItemsControl ItemsSource="{Binding Assets.Shown.Facts}" AutomationProperties.Name="Facts">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="workspaces:AssetFact">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Classes="secondary" Text="{Binding Label}" Width="{StaticResource FactLabelWidth}" />
                      <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="label" Text="{Binding Assets.ShownKeyLabel}" />
              <TextBox Classes="mono" Text="{Binding Assets.Shown.Key, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                       AutomationProperties.Name="Path of the asset" AutomationProperties.HelpText="How a map or the workspace names it; select it to copy" />
            </StackPanel>
          </Border>
          <Border Classes="group">
            <StackPanel Classes="stack">
              <TextBlock Classes="caption" Text="{Binding Assets.ShownUse}" IsVisible="{Binding Assets.ShownUse, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <Border Classes="planned" IsVisible="{Binding Assets.ShownPlanned, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Classes="stack">
                  <TextBlock Classes="caption" Text="{Binding Assets.ShownPlanned}" />
                  <TextBlock Classes="story" Text="Not built yet" />
                </StackPanel>
              </Border>
              <StackPanel Classes="inline">
                <Button Content="Show the file" Command="{Binding RunCommand}" CommandParameter="assets.showFile" />
                <Button Content="Clear" Command="{Binding Assets.ClearSelectionCommand}" AutomationProperties.HelpText="The inspector shows the mode again" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <!-- what is selected on the map (F-11): the fields all kinds share, then a section per kind -->
        <StackPanel IsVisible="{Binding Selection.HasAny}" AutomationProperties.Name="Selection">
          <Border Classes="panelhead">
            <StackPanel>
              <TextBlock Classes="overline" Text="{Binding Source=Selection, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
              <TextBlock Classes="panelname" Text="{Binding Selection.Inspector.Title}" TextWrapping="Wrap" AutomationProperties.Name="Selected" />
              <TextBlock Classes="caption" Text="{Binding Selection.Inspector.Kinds}" AutomationProperties.Name="Kinds selected" />
            </StackPanel>
          </Border>
          <Border Classes="group">
            <StackPanel Classes="stack">
              <TextBlock Classes="heading" Text="Place" />
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Classes="secondary" Text="X" Width="{StaticResource FactLabelWidth}" />
                <TextBox Classes="mono commit" Text="{Binding Selection.Inspector.X, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="X of the selection"
                         AutomationProperties.HelpText="In ogrids; a value puts every selected thing there; a dash when they differ" />
              </DockPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Classes="secondary" Text="Z" Width="{StaticResource FactLabelWidth}" />
                <TextBox Classes="mono commit" Text="{Binding Selection.Inspector.Z, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Z of the selection"
                         AutomationProperties.HelpText="In ogrids; a value puts every selected thing there; a dash when they differ" />
              </DockPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Classes="secondary" Text="Height" Width="{StaticResource FactLabelWidth}" />
                <TextBlock Classes="mono" Text="{Binding Selection.Inspector.Height}" AutomationProperties.Name="Height of the selection"
                           ToolTip.Tip="It follows the terrain" />
              </DockPanel>
              <DockPanel IsVisible="{Binding Selection.Inspector.CanTurn}">
                <TextBlock DockPanel.Dock="Left" Classes="secondary" Text="Heading" Width="{StaticResource FactLabelWidth}" />
                <TextBox Classes="mono commit" Text="{Binding Selection.Inspector.Heading, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Heading of the selection"
                         AutomationProperties.HelpText="In degrees, clockwise from the right in the top view; a value turns every selected thing to it; a dash when they differ" />
              </DockPanel>
              <StackPanel Classes="inline">
                <Button Content="Duplicate" Command="{Binding RunCommand}" CommandParameter="edit.duplicate" />
                <Button Content="Delete" Command="{Binding RunCommand}" CommandParameter="edit.delete" />
                <Button Content="Select none" Command="{Binding RunCommand}" CommandParameter="select.none" AutomationProperties.HelpText="The inspector shows the mode again" />
              </StackPanel>
            </StackPanel>
          </Border>
          <!-- a template per kind: each kind's own fields go into its section class (ViewModels/SelectionInspector.cs) and its template -->
          <ItemsControl ItemsSource="{Binding Selection.Inspector.Sections}" AutomationProperties.Name="Selected by kind">
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="vm:MarkerSelection">
                <Border Classes="group">
                  <StackPanel Classes="stack">
                    <TextBlock Classes="heading" Text="{Binding Title}" />
                    <ItemsControl ItemsSource="{Binding Lines}" AutomationProperties.Name="Selected markers" />
                  </StackPanel>
                </Border>
              </DataTemplate>
              <DataTemplate DataType="vm:PropSelection">
                <Border Classes="group">
                  <StackPanel Classes="stack">
                    <TextBlock Classes="heading" Text="{Binding Title}" />
                    <ItemsControl ItemsSource="{Binding Lines}" AutomationProperties.Name="Selected props" />
                  </StackPanel>
                </Border>
              </DataTemplate>
              <DataTemplate DataType="vm:DecalSelection">
                <Border Classes="group">
                  <StackPanel Classes="stack">
                    <TextBlock Classes="heading" Text="{Binding Title}" />
                    <ItemsControl ItemsSource="{Binding Lines}" AutomationProperties.Name="Selected decals" />
                  </StackPanel>
                </Border>
              </DataTemplate>
              <DataTemplate DataType="vm:UnitSelection">
                <Border Classes="group">
                  <StackPanel Classes="stack">
                    <TextBlock Classes="heading" Text="{Binding Title}" />
                    <ItemsControl ItemsSource="{Binding Lines}" AutomationProperties.Name="Selected units" />
                  </StackPanel>
                </Border>
              </DataTemplate>
              <DataTemplate DataType="vm:AreaSelection">
                <Border Classes="group">
                  <StackPanel Classes="stack">
                    <TextBlock Classes="heading" Text="{Binding Title}" />
                    <ItemsControl ItemsSource="{Binding Lines}" AutomationProperties.Name="Selected areas" />
                    <!-- one area alone: its name and corners to type (M-5) -->
                    <TextBlock Classes="caption" Text="The playable area: the first area of the map" IsVisible="{Binding IsPlayable}" />
                    <Panel IsVisible="{Binding IsSingle}">
                      <controls:SettingList DataContext="{Binding Fields}" ShowsTitle="False" />
                    </Panel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
        </StackPanel>
        <StackPanel>
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!Assets.HasSelection" />
              <Binding Path="!Selection.HasAny" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <Border Classes="panelhead">
            <StackPanel>
              <TextBlock Classes="overline" Text="{Binding Source=Inspector, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
              <TextBlock Classes="panelname" Text="{Binding SelectedMode.Definition.Title}" />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding SelectedMode.Definition.Inspector}" AutomationProperties.Name="Inspector">
            <ItemsControl.DataTemplates>
              <!-- the map and its atmosphere (M-1, W-1, S-2): a view of their own each, on the editor's view model -->
              <DataTemplate DataType="vm:MapFactsSection">
                <panels:MapFactsPanel DataContext="{Binding $parent[UserControl].((vm:MainViewModel)DataContext)}" />
              </DataTemplate>
              <DataTemplate DataType="vm:WaterDetailsSection">
                <panels:WaterDetailsPanel DataContext="{Binding $parent[UserControl].((vm:MainViewModel)DataContext)}" />
              </DataTemplate>
              <DataTemplate DataType="vm:LayerSection">
                <panels:LayerPanel DataContext="{Binding $parent[UserControl].((vm:MainViewModel)DataContext)}" />
              </DataTemplate>
              <DataTemplate DataType="vm:PlannedSection">
                <Border Classes="group">
                  <StackPanel Classes="stack">
                    <TextBlock Classes="heading" Text="{Binding Title}" />
                    <Border Classes="planned">
                      <StackPanel Classes="stack">
                        <TextBlock Classes="caption" Text="{Binding Missing}" />
                        <TextBlock Classes="story" Text="{Binding Story, StringFormat='Not built yet: user story {0}'}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
          <Border Classes="group">
            <StackPanel Classes="stack">
              <TextBlock Classes="heading" Text="Selection" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Nothing is selected. Choose a mode's Select tool and click a thing in the top view, or drag a box around several; shift adds, control toggles." />
              <Border Classes="planned">
                <StackPanel Classes="stack">
                  <TextBlock Classes="caption" Text="Move, rotate and scale with handles in the views." />
                  <TextBlock Classes="story" Text="Not built yet: user story F-11" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </Panel>
    </ScrollViewer>
  </Border>
</UserControl>
