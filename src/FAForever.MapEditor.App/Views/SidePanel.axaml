<!-- Beside the map: the brush, how the views are used, and the history. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             x:Class="FAForever.MapEditor.App.Views.SidePanel"
             x:DataType="vm:MainViewModel">
  <Border Classes="panel" Width="{StaticResource SidePanelWidth}">
    <StackPanel Classes="stack" IsEnabled="{Binding HasMap}">
      <controls:Section Header="Brush">
        <StackPanel Classes="stack">
          <ComboBox ItemsSource="{Binding PaintTargets}" SelectedItem="{Binding SelectedPaintTarget}" HorizontalAlignment="Stretch" AutomationProperties.Name="What the brush paints" />
          <TextBlock Text="{Binding BrushRadius, StringFormat='Radius: {0:0} ogrids'}" />
          <Slider Minimum="1" Maximum="128" Value="{Binding BrushRadius}" AutomationProperties.Name="Brush radius in ogrids" />
          <StackPanel Classes="stack" IsVisible="{Binding IsPaintingHeight}">
            <ComboBox ItemsSource="{Binding BrushModes}" SelectedItem="{Binding BrushMode}" HorizontalAlignment="Stretch" AutomationProperties.Name="Height brush mode" />
            <TextBlock Text="{Binding BrushStrength, StringFormat='Strength: {0:0.00}'}" />
            <Slider Minimum="0.01" Maximum="5" Value="{Binding BrushStrength}" AutomationProperties.Name="Height brush strength" />
            <TextBlock Text="{Binding BrushTarget, StringFormat='Flatten to: {0:0.0}'}" />
            <Slider Minimum="0" Maximum="256" Value="{Binding BrushTarget}" AutomationProperties.Name="Height to flatten to" />
          </StackPanel>
          <StackPanel Classes="stack" IsVisible="{Binding IsPaintingLayer}">
            <TextBlock Text="{Binding MaskStrength, StringFormat='Strength: {0:0.00}'}" />
            <Slider Minimum="0.01" Maximum="1" Value="{Binding MaskStrength}" AutomationProperties.Name="Mask brush strength" />
            <CheckBox Content="Erase" IsChecked="{Binding MaskErase}" AutomationProperties.Name="Erase the layer" />
          </StackPanel>
          <TextBlock Classes="caption"
                     Text="Top view: left mouse paints, right or middle moves, the wheel zooms, control and a click sends the 3D camera there. 3D view: the wheel zooms, middle moves, space and the mouse turn, F focuses, Home shows all. A stroke is one step of Undo." />
        </StackPanel>
      </controls:Section>

      <controls:Section Classes="section" Header="History">
        <ListBox ItemsSource="{Binding History}" SelectedIndex="{Binding HistoryIndex, Mode=TwoWay}" MaxHeight="320" AutomationProperties.Name="History"
                 AutomationProperties.HelpText="Choosing a step undoes or redoes up to it">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryEntry">
              <TextBlock Text="{Binding Description}" Classes.undone="{Binding IsUndone}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </controls:Section>
    </StackPanel>
  </Border>
</UserControl>
