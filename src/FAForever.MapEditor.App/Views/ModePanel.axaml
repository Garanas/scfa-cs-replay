<!-- The selected mode's panel: its name, its tools, then its sections, a line apart; what is not built yet says its story. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             xmlns:ws="using:FAForever.MapEditor.Project.Workspaces"
             x:Class="FAForever.MapEditor.App.Views.ModePanel"
             x:DataType="vm:MainViewModel">
  <Border Classes="modepanel">
    <ScrollViewer>
      <StackPanel>
        <Border Classes="panelhead">
          <StackPanel Classes="stack">
            <TextBlock Classes="panelname" Text="{Binding SelectedMode.Definition.Title}" />
            <TextBlock Classes="caption" Text="{Binding SelectedMode.Definition.Help}" />
          </StackPanel>
        </Border>

        <Border Classes="group">
          <StackPanel Classes="stack">
            <TextBlock Classes="overline" Text="{Binding Source=Tools, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
            <ItemsControl ItemsSource="{Binding Tools}" AutomationProperties.Name="Tools">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Classes="tools" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolItem">
                  <Button Classes="tool" Classes.active="{Binding IsActive}" Classes.planned="{Binding Definition.IsIncomplete}"
                          Content="{Binding Definition.Title}"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}"
                          CommandParameter="{Binding Definition.CommandId}"
                          ToolTip.Tip="{Binding Definition.Missing}"
                          AutomationProperties.Name="{Binding Definition.Title}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding SelectedMode.Definition.Sections}">
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:PlannedSection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <Border Classes="planned">
                    <StackPanel Classes="stack">
                      <TextBlock Classes="caption" Text="{Binding Missing}" />
                      <TextBlock Classes="story" Text="{Binding Story, StringFormat='Not built yet: user story {0}'}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:StrataSection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <ListBox ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).StrataTool.Strata}"
                           SelectedItem="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).StrataTool.Painted}"
                           AutomationProperties.Name="Strata" />
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- the workspace's presets of the panel's kind: a button applies one, the cross deletes it; Save keeps the settings as they are -->
            <DataTemplate DataType="vm:PresetSection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.Shown}" AutomationProperties.Name="{Binding Title}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="ws:Preset">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Classes="beside" Content="×"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.DeleteShownCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding Name, StringFormat='Delete the preset {0}'}" />
                          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding Name}"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.ApplyShownCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding Name, StringFormat='Apply the preset {0}'}" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="caption" Text="None yet: save the tool's settings to use them again."
                             IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.IsEmpty}" />
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="beside" Content="Save"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.SaveNewCommand}"
                            IsEnabled="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.HasLibrary}"
                            AutomationProperties.Name="Save the settings as a preset" />
                    <TextBox Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.NewName}" PlaceholderText="Name (optional)"
                             AutomationProperties.Name="Name of the new preset"
                             AutomationProperties.HelpText="Left empty, the preset is named after its settings" />
                  </DockPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- the mode's overlays; a check box runs the overlay's command, as its chip does -->
            <DataTemplate DataType="vm:OverlaySection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PanelOverlays}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:OverlayItem">
                        <CheckBox Content="{Binding Title}" IsChecked="{Binding IsOn, Mode=OneWay}"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="{Binding Definition.CommandId}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- the Markers mode (R-4 to R-6): the kinds shown, the chains, the adaptive map; their controls run the markers.* commands -->
            <DataTemplate DataType="vm:MarkerKindsSection">
              <Border Classes="group">
                <StackPanel Classes="stack" DataContext="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Markers}" x:DataType="vm:MarkersViewModel">
                  <TextBlock Classes="overline" Text="{Binding Source=By kind, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <ItemsControl ItemsSource="{Binding Kinds}" AutomationProperties.Name="Kinds of markers shown">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MarkerKindItem">
                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn, Mode=OneWay}"
                                  Command="{Binding $parent[ItemsControl].((vm:MarkersViewModel)DataContext).ToggleKindCommand}" CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:ChainsSection">
              <Border Classes="group">
                <StackPanel Classes="stack" DataContext="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Markers}" x:DataType="vm:MarkersViewModel">
                  <TextBlock Classes="overline" Text="{Binding Source=Chains, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <ListBox ItemsSource="{Binding Chains}" SelectedItem="{Binding SelectedChain}" AutomationProperties.Name="Chains"
                           IsVisible="{Binding !!Chains.Count}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ChainItem">
                        <TextBlock Text="{Binding Summary}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !Chains.Count}"
                             Text="None yet: select markers in order and make a chain of them, or click them with the chain tool." />
                  <StackPanel Classes="inline">
                    <Button Content="From the selection" Command="{Binding AddChainCommand}"
                            AutomationProperties.HelpText="Makes a chain of the selected markers, in the order they were selected" />
                    <Button Content="Select" Command="{Binding SelectChainMarkersCommand}" AutomationProperties.Name="Select the chain's markers" />
                    <Button Content="Delete" Command="{Binding DeleteChainCommand}" AutomationProperties.Name="Delete the chain" />
                  </StackPanel>
                  <StackPanel Classes="stack" IsVisible="{Binding HasChain}">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Classes="secondary" Text="Name" Width="{StaticResource FactLabelWidth}" />
                      <TextBox Classes="commit" Text="{Binding ChainName, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Name of the chain" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding SelectedChain.Entries}" AutomationProperties.Name="Markers of the chain">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChainEntry">
                          <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="beside" Content="×"
                                    Command="{Binding $parent[ItemsControl].((vm:MarkersViewModel)DataContext).RemoveEntryCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Take {0} out of the chain'}" />
                            <Button DockPanel.Dock="Right" Classes="beside" Content="↓"
                                    Command="{Binding $parent[ItemsControl].((vm:MarkersViewModel)DataContext).MoveDownCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Move {0} down'}" />
                            <Button DockPanel.Dock="Right" Classes="beside" Content="↑"
                                    Command="{Binding $parent[ItemsControl].((vm:MarkersViewModel)DataContext).MoveUpCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Move {0} up'}" />
                            <TextBlock Text="{Binding Line}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:AdaptiveSection">
              <Border Classes="group">
                <StackPanel Classes="stack" DataContext="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Markers}" x:DataType="vm:MarkersViewModel">
                  <TextBlock Classes="overline" Text="{Binding Source=Adaptive map, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <CheckBox Content="Leave out the deposits of armies no one plays" IsChecked="{Binding IsAdaptive, Mode=OneWay}" Command="{Binding ToggleAdaptiveCommand}"
                            AutomationProperties.Name="Adaptive map" />
                  <TextBlock Classes="caption" Text="{Binding AlwaysThere}" />
                  <ItemsControl ItemsSource="{Binding AdaptiveArmies}" AutomationProperties.Name="Deposits per army">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AdaptiveArmy">
                        <TextBlock Classes="caption" Text="{Binding Line}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="caption" TextWrapping="Wrap" Text="Select deposits to choose the army they wait for in the inspector." />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
