<!-- The selected mode's panel: its name, its tools, then its sections, a line apart; what is not built yet says its story. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             xmlns:ws="using:FAForever.MapEditor.Project.Workspaces"
             x:Class="FAForever.MapEditor.App.Views.ModePanel"
             x:DataType="vm:MainViewModel">
  <Border Classes="modepanel">
    <ScrollViewer>
      <StackPanel>
        <Border Classes="panelhead">
          <StackPanel Classes="stack">
            <TextBlock Classes="panelname" Text="{Binding SelectedMode.Definition.Title}" />
            <TextBlock Classes="caption" Text="{Binding SelectedMode.Definition.Help}" />
          </StackPanel>
        </Border>

        <Border Classes="group">
          <StackPanel Classes="stack">
            <TextBlock Classes="overline" Text="{Binding Source=Tools, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
            <ItemsControl ItemsSource="{Binding Tools}" AutomationProperties.Name="Tools">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Classes="tools" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolItem">
                  <Button Classes="tool" Classes.active="{Binding IsActive}" Classes.planned="{Binding Definition.IsIncomplete}"
                          Content="{Binding Definition.Title}"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}"
                          CommandParameter="{Binding Definition.CommandId}"
                          ToolTip.Tip="{Binding Definition.Missing}"
                          AutomationProperties.Name="{Binding Definition.Title}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding SelectedMode.Definition.Sections}">
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:PlannedSection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <Border Classes="planned">
                    <StackPanel Classes="stack">
                      <TextBlock Classes="caption" Text="{Binding Missing}" />
                      <TextBlock Classes="story" Text="{Binding Story, StringFormat='Not built yet: user story {0}'}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:StrataSection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <ListBox ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).StrataTool.Strata}"
                           SelectedItem="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).StrataTool.Painted}"
                           AutomationProperties.Name="Strata" />
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- the workspace's presets of the panel's kind: a button applies one, the cross deletes it; Save keeps the settings as they are -->
            <DataTemplate DataType="vm:PresetSection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.Shown}" AutomationProperties.Name="{Binding Title}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="ws:Preset">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Classes="beside" Content="×"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.DeleteShownCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding Name, StringFormat='Delete the preset {0}'}" />
                          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding Name}"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.ApplyShownCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding Name, StringFormat='Apply the preset {0}'}" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="caption" Text="{Binding EmptyText}"
                             IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.IsEmpty}" />
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="beside" Content="Save"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.SaveNewCommand}"
                            IsEnabled="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.HasLibrary}"
                            AutomationProperties.Name="Save the settings as a preset" />
                    <TextBox Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.NewName}" PlaceholderText="Name (optional)"
                             AutomationProperties.Name="Name of the new preset"
                             AutomationProperties.HelpText="Left empty, the preset is named after its settings" />
                  </DockPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- what is generated from the height layers: per result how it stands and its button; walkability's layer and what changed -->
            <DataTemplate DataType="vm:GeneratedSection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <TextBlock Classes="caption" Text="Open a map to generate from it." IsVisible="{Binding !$parent[UserControl].((vm:MainViewModel)DataContext).HasMap}" />
                  <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Generation.Rows}" AutomationProperties.Name="Generated results">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Classes="stack" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GeneratedRow">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Classes="beside" Content="{Binding ButtonText}" IsEnabled="{Binding !IsRunning}"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="{Binding CommandId}"
                                  AutomationProperties.Name="{Binding ButtonLabel}" />
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Classes="caption" Classes.warning="{Binding IsStale}" Text="{Binding Status}" />
                          </StackPanel>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Classes="stack" IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).HasMap}">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Classes="label" Text="Units" VerticalAlignment="Center" />
                      <ComboBox Margin="{StaticResource InlineGap}" HorizontalAlignment="Stretch" ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Walkability.Layers}" SelectedItem="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Walkability.Layer}"
                                AutomationProperties.Name="Walkability of the units of a layer"
                                AutomationProperties.HelpText="Land, hover, amphibious or naval (water) units" />
                    </DockPanel>
                    <CheckBox Content="Show walkability" IsChecked="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowWalkability, Mode=OneWay}"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="view.overlay.walkability" />
                    <CheckBox Content="Show what changed" IsChecked="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Walkability.ShowChanges}"
                              AutomationProperties.HelpText="Ogrids blocked or opened since walkability was generated the time before" />
                    <TextBlock Classes="caption" Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Walkability.ChangesText}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- the armies and their trees of unit groups (U-3): choosing one is where new units and groups go -->
            <DataTemplate DataType="vm:UnitGroupsSection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <TreeView ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.Tree}"
                            SelectedItem="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.ChosenGroup}"
                            AutomationProperties.Name="Armies and their unit groups"
                            AutomationProperties.HelpText="Choose an army or group: the place tool places into it, and the buttons below work on it">
                    <TreeView.Styles>
                      <Style Selector="TreeViewItem" x:DataType="vm:GroupNode">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Description}" />
                      </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                      <TreeDataTemplate DataType="vm:GroupNode" ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Label}" />
                      </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                  </TreeView>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="beside" Content="Add"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.AddGroupCommand}"
                            IsEnabled="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.HasChosenGroup}"
                            AutomationProperties.Name="Add a group to the chosen army or group" />
                    <TextBox Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.GroupName}" PlaceholderText="Group name"
                             AutomationProperties.Name="Name of the group"
                             AutomationProperties.HelpText="The name a new group gets, or the chosen group's new name" />
                  </DockPanel>
                  <UniformGrid Columns="2">
                    <Button HorizontalAlignment="Stretch" Content="Rename"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.RenameGroupCommand}"
                            IsEnabled="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.CanChangeChosenGroup}"
                            AutomationProperties.Name="Rename the chosen group" />
                    <Button HorizontalAlignment="Stretch" Content="Remove"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.RemoveGroupCommand}"
                            IsEnabled="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.CanChangeChosenGroup}"
                            AutomationProperties.Name="Remove the chosen group"
                            AutomationProperties.HelpText="Its units and groups go to the group above it" />
                    <Button HorizontalAlignment="Stretch" Content="Select units"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.SelectGroupUnitsCommand}"
                            IsEnabled="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.HasChosenGroup}"
                            AutomationProperties.Name="Select the units of the chosen group" />
                    <Button HorizontalAlignment="Stretch" Content="Move here"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.MoveSelectionHereCommand}"
                            IsEnabled="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.HasChosenGroup}"
                            AutomationProperties.Name="Move the selected units into the chosen group" />
                  </UniformGrid>
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- the armies (M-4): the list, then the chosen army's name, whether players take it, its team, factions and alliances -->
            <DataTemplate DataType="vm:ArmiesSection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <ListBox ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.Rows}"
                           SelectedItem="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.ChosenArmy}"
                           AutomationProperties.Name="Armies">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ArmyRow">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock Classes="caption" Text="{Binding Summary}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <UniformGrid Columns="2">
                    <Button HorizontalAlignment="Stretch" Content="Add army"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.AddArmyCommand}"
                            AutomationProperties.Name="Add a playable army" AutomationProperties.HelpText="With a spawn in the middle of the map" />
                    <Button HorizontalAlignment="Stretch" Content="Add extra"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.AddExtraArmyCommand}"
                            AutomationProperties.Name="Add an extra army" AutomationProperties.HelpText="An army no player takes, such as civilians" />
                  </UniformGrid>
                  <StackPanel Classes="stack" IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.HasChosenArmy}">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Classes="beside" Content="Rename"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.RenameArmyCommand}"
                              AutomationProperties.Name="Rename the chosen army" />
                      <TextBox Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.ArmyName}"
                               AutomationProperties.Name="Name of the chosen army"
                               AutomationProperties.HelpText="Its spawn marker takes the new name too" />
                    </DockPanel>
                    <CheckBox Content="Playable" IsChecked="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.Playable}"
                              AutomationProperties.Name="Players take the chosen army"
                              AutomationProperties.HelpText="A playable army gets a spawn when it has none; an extra army is one no player takes" />
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Classes="beside" Content="Set"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.SetTeamCommand}"
                              AutomationProperties.Name="Put the chosen army in the team" />
                      <TextBox Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.Team}" PlaceholderText="Team (none)"
                               AutomationProperties.Name="Team of the chosen army"
                               AutomationProperties.HelpText="Empty for no team. The game's lobby reads only the team FFA of every playable army, which the export writes first" />
                    </DockPanel>
                    <TextBlock Classes="label" Text="Limited to the factions (none: any)" />
                    <UniformGrid Columns="2">
                      <CheckBox Content="UEF" IsChecked="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.Uef}" />
                      <CheckBox Content="Aeon" IsChecked="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.Aeon}" />
                      <CheckBox Content="Cybran" IsChecked="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.Cybran}" />
                      <CheckBox Content="Seraphim" IsChecked="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.Seraphim}" />
                    </UniformGrid>
                    <TextBlock Classes="label" Text="Alliances" />
                    <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.Alliances}" AutomationProperties.Name="Alliances of the chosen army">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AllianceRow">
                          <DockPanel>
                            <ComboBox DockPanel.Dock="Right" ItemsSource="{x:Static vm:AllianceRow.Choices}" SelectedItem="{Binding Stance}"
                                      AutomationProperties.Name="{Binding Other, StringFormat='Stance towards {0}'}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding Other}" />
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button HorizontalAlignment="Stretch" Content="Remove the army"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Armies.RemoveArmyCommand}"
                            AutomationProperties.Name="Remove the chosen army"
                            AutomationProperties.HelpText="With its units and its spawn" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- the decal groups (D-2): shown or hidden in the views (the editor's, not saved), renamed, filled from the selection -->
            <DataTemplate DataType="vm:DecalGroupsSection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Decals.Groups}" AutomationProperties.Name="Decal groups">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DecalGroupItem">
                        <StackPanel Classes="stack">
                          <DockPanel>
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsShown}"
                                      AutomationProperties.Name="{Binding Name, StringFormat='Show the decal group {0}'}"
                                      AutomationProperties.HelpText="Hidden decals are not drawn in the 3D view and cannot be selected; the map keeps them" />
                            <TextBlock DockPanel.Dock="Right" Classes="caption" Text="{Binding Detail}" VerticalAlignment="Center" />
                            <TextBox Classes="commit" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                     AutomationProperties.Name="{Binding Detail, StringFormat='Name of the decal group of {0}'}" />
                          </DockPanel>
                          <StackPanel Classes="inline">
                            <Button Content="Select" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Decals.SelectGroupCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Select the decals of {0}'}" />
                            <Button Content="Add" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Decals.AddToGroupCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Add the selected decals to {0}'}" />
                            <Button Content="Take out" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Decals.RemoveFromGroupCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Take the selected decals out of {0}'}" />
                            <Button Classes="beside" Content="×" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Decals.DeleteGroupCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Delete the decal group {0}'}" ToolTip.Tip="Its decals stay on the map" />
                          </StackPanel>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="caption" TextWrapping="Wrap" Text="None yet: select decals and make a group of them, to select, show or hide them together."
                             IsVisible="{Binding !$parent[UserControl].((vm:MainViewModel)DataContext).Decals.HasGroups}" />
                  <Button Content="New group from the selection" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="decals.addGroup"
                          AutomationProperties.HelpText="A group of the selected decals; rename it in its field" />
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- how the place and paint tools stand props on the terrain (P-1, P-2) -->
            <DataTemplate DataType="vm:PropPlacementSection">
              <Border Classes="group">
                <StackPanel Classes="stack" DataContext="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Props}" x:DataType="vm:PropsViewModel">
                  <TextBlock Classes="overline" Text="{Binding Source=Placing, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Classes="secondary" Text="Stand" Width="{StaticResource FactLabelWidth}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding ChosenAlignment}" HorizontalAlignment="Stretch" AutomationProperties.Name="How placed props stand"
                              AutomationProperties.HelpText="By kind: rocks, crystals, logs and clutter tilt with the ground, trees and the rest stand upright; or all upright; or all with the terrain" />
                  </DockPanel>
                  <CheckBox Content="Turn at random" IsChecked="{Binding RandomTurn}" AutomationProperties.Name="Turn each placed prop at random" />
                  <StackPanel>
                    <TextBlock Classes="label" Text="{Binding RandomTilt, StringFormat='Tilt at random: up to {0:0}°'}" />
                    <Slider Minimum="0" Maximum="45" Value="{Binding RandomTilt}" AutomationProperties.Name="Most a placed prop leans at random in degrees" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Classes="label" Text="{Binding ScaleMin, StringFormat='Scale from {0:0.00}'}" />
                    <Slider Minimum="0.1" Maximum="4" Value="{Binding ScaleMin}" AutomationProperties.Name="Smallest scale of a placed prop" />
                    <TextBlock Classes="label" Text="{Binding ScaleMax, StringFormat='to {0:0.00}'}" />
                    <Slider Minimum="0.1" Maximum="4" Value="{Binding ScaleMax}" AutomationProperties.Name="Largest scale of a placed prop" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Classes="label" Text="{Binding Sink, StringFormat='Sink into the ground: {0:0.00}'}" />
                    <Slider Minimum="0" Maximum="5" Value="{Binding Sink}" AutomationProperties.Name="How far placed props sink into the terrain"
                            AutomationProperties.HelpText="In game units; Drop to ground sinks the selected props as far" />
                  </StackPanel>
                  <CheckBox Content="Props follow the terrain" IsChecked="{Binding FollowTerrain, Mode=OneWay}"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="props.followTerrain"
                            AutomationProperties.HelpText="A height brush that raises or lowers the terrain sets the props on it back on the ground, in the same step of undo" />
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- the props the paint tool paints, with their weights (P-2) -->
            <DataTemplate DataType="vm:PropPaletteSection">
              <Border Classes="group">
                <StackPanel Classes="stack" DataContext="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Props}" x:DataType="vm:PropsViewModel">
                  <TextBlock Classes="overline" Text="{Binding Source=Palette, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <ItemsControl ItemsSource="{Binding Palette}" AutomationProperties.Name="Palette">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PaletteItem">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Classes="beside" Content="×"
                                  Command="{Binding $parent[ItemsControl].((vm:PropsViewModel)DataContext).RemoveItemCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding Name, StringFormat='Take {0} out of the palette'}" />
                          <TextBox DockPanel.Dock="Right" Classes="mono number" Text="{Binding Weight}"
                                   AutomationProperties.Name="{Binding Name, StringFormat='Weight of {0}'}"
                                   AutomationProperties.HelpText="How often it is painted against the others; 0 never" />
                          <Border DockPanel.Dock="Left" Classes="thumbnail toolthumb">
                            <controls:AssetThumbnail Model="{Binding Model}" DecodeWidth="64" AutomationProperties.Name="{Binding Name, StringFormat='Picture of {0}'}" />
                          </Border>
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="{StaticResource InlineGap}" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsPaletteEmpty}"
                             Text="Empty: add props, or choose them on the shelf while the paint tool is active." />
                  <Button Content="Add a prop..." Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="props.addToPalette"
                          AutomationProperties.HelpText="Choose a prop for the palette in the picker" />
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- the mass and energy of the props, for the map and per area (P-5) -->
            <DataTemplate DataType="vm:PropReclaimSection">
              <Border Classes="group">
                <StackPanel Classes="stack" DataContext="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Props}" x:DataType="vm:PropsViewModel">
                  <TextBlock Classes="overline" Text="{Binding Source=Reclaim, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding ReclaimText}" AutomationProperties.Name="Reclaim of the map" />
                  <TextBlock Classes="caption warning" TextWrapping="Wrap" Text="{Binding ReclaimNote}" IsVisible="{Binding ReclaimNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <ItemsControl ItemsSource="{Binding ReclaimAreas}" AutomationProperties.Name="Reclaim per area">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- the mode's overlays; a check box runs the overlay's command, as its chip does -->
            <DataTemplate DataType="vm:OverlaySection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PanelOverlays}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:OverlayItem">
                        <CheckBox Content="{Binding Title}" IsChecked="{Binding IsOn, Mode=OneWay}"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="{Binding Definition.CommandId}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- the Markers mode (R-4 to R-6): the kinds shown, the chains, the adaptive map; their controls run the markers.* commands -->
            <DataTemplate DataType="vm:MarkerKindsSection">
              <Border Classes="group">
                <StackPanel Classes="stack" DataContext="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Markers}" x:DataType="vm:MarkersViewModel">
                  <TextBlock Classes="overline" Text="{Binding Source=By kind, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <ItemsControl ItemsSource="{Binding Kinds}" AutomationProperties.Name="Kinds of markers shown">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MarkerKindItem">
                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn, Mode=OneWay}"
                                  Command="{Binding $parent[ItemsControl].((vm:MarkersViewModel)DataContext).ToggleKindCommand}" CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:ChainsSection">
              <Border Classes="group">
                <StackPanel Classes="stack" DataContext="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Markers}" x:DataType="vm:MarkersViewModel">
                  <TextBlock Classes="overline" Text="{Binding Source=Chains, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <ListBox ItemsSource="{Binding Chains}" SelectedItem="{Binding SelectedChain}" AutomationProperties.Name="Chains"
                           IsVisible="{Binding !!Chains.Count}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ChainItem">
                        <TextBlock Text="{Binding Summary}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !Chains.Count}"
                             Text="None yet: select markers in order and make a chain of them, or click them with the chain tool." />
                  <StackPanel Classes="inline">
                    <Button Content="From the selection" Command="{Binding AddChainCommand}"
                            AutomationProperties.HelpText="Makes a chain of the selected markers, in the order they were selected" />
                    <Button Content="Select" Command="{Binding SelectChainMarkersCommand}" AutomationProperties.Name="Select the chain's markers" />
                    <Button Content="Delete" Command="{Binding DeleteChainCommand}" AutomationProperties.Name="Delete the chain" />
                  </StackPanel>
                  <StackPanel Classes="stack" IsVisible="{Binding HasChain}">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Classes="secondary" Text="Name" Width="{StaticResource FactLabelWidth}" />
                      <TextBox Classes="commit" Text="{Binding ChainName, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Name of the chain" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding SelectedChain.Entries}" AutomationProperties.Name="Markers of the chain">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChainEntry">
                          <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="beside" Content="×"
                                    Command="{Binding $parent[ItemsControl].((vm:MarkersViewModel)DataContext).RemoveEntryCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Take {0} out of the chain'}" />
                            <Button DockPanel.Dock="Right" Classes="beside" Content="↓"
                                    Command="{Binding $parent[ItemsControl].((vm:MarkersViewModel)DataContext).MoveDownCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Move {0} down'}" />
                            <Button DockPanel.Dock="Right" Classes="beside" Content="↑"
                                    Command="{Binding $parent[ItemsControl].((vm:MarkersViewModel)DataContext).MoveUpCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Move {0} up'}" />
                            <TextBlock Text="{Binding Line}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:AdaptiveSection">
              <Border Classes="group">
                <StackPanel Classes="stack" DataContext="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Markers}" x:DataType="vm:MarkersViewModel">
                  <TextBlock Classes="overline" Text="{Binding Source=Adaptive map, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <CheckBox Content="Leave out the deposits of armies no one plays" IsChecked="{Binding IsAdaptive, Mode=OneWay}" Command="{Binding ToggleAdaptiveCommand}"
                            AutomationProperties.Name="Adaptive map" />
                  <TextBlock Classes="caption" Text="{Binding AlwaysThere}" />
                  <ItemsControl ItemsSource="{Binding AdaptiveArmies}" AutomationProperties.Name="Deposits per army">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AdaptiveArmy">
                        <TextBlock Classes="caption" Text="{Binding Line}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="caption" TextWrapping="Wrap" Text="Select deposits to choose the army they wait for in the inspector." />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
