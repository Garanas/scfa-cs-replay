<!-- The selected mode's panel: its name, its tools, then its sections, a line apart; what is not built yet says its story. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FAForever.MapEditor.App.ViewModels"
             xmlns:controls="using:FAForever.MapEditor.App.Controls"
             xmlns:ws="using:FAForever.MapEditor.Project.Workspaces"
             x:Class="FAForever.MapEditor.App.Views.ModePanel"
             x:DataType="vm:MainViewModel">
  <Border Classes="modepanel">
    <ScrollViewer>
      <StackPanel>
        <Border Classes="panelhead">
          <StackPanel Classes="stack">
            <TextBlock Classes="panelname" Text="{Binding SelectedMode.Definition.Title}" />
            <TextBlock Classes="caption" Text="{Binding SelectedMode.Definition.Help}" />
          </StackPanel>
        </Border>

        <Border Classes="group">
          <StackPanel Classes="stack">
            <TextBlock Classes="overline" Text="{Binding Source=Tools, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
            <ItemsControl ItemsSource="{Binding Tools}" AutomationProperties.Name="Tools">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Classes="tools" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolItem">
                  <Button Classes="tool" Classes.active="{Binding IsActive}" Classes.planned="{Binding Definition.IsIncomplete}"
                          Content="{Binding Definition.Title}"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}"
                          CommandParameter="{Binding Definition.CommandId}"
                          ToolTip.Tip="{Binding Definition.Missing}"
                          AutomationProperties.Name="{Binding Definition.Title}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding SelectedMode.Definition.Sections}">
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:PlannedSection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <Border Classes="planned">
                    <StackPanel Classes="stack">
                      <TextBlock Classes="caption" Text="{Binding Missing}" />
                      <TextBlock Classes="story" Text="{Binding Story, StringFormat='Not built yet: user story {0}'}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:StrataSection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <ListBox ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).StrataTool.Strata}"
                           SelectedItem="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).StrataTool.Painted}"
                           AutomationProperties.Name="Strata" />
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- the workspace's presets of the panel's kind: a button applies one, the cross deletes it; Save keeps the settings as they are -->
            <DataTemplate DataType="vm:PresetSection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.Shown}" AutomationProperties.Name="{Binding Title}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="ws:Preset">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Classes="beside" Content="×"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.DeleteShownCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding Name, StringFormat='Delete the preset {0}'}" />
                          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding Name}"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.ApplyShownCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding Name, StringFormat='Apply the preset {0}'}" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="caption" Text="None yet: save the tool's settings to use them again."
                             IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.IsEmpty}" />
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="beside" Content="Save"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.SaveNewCommand}"
                            IsEnabled="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.HasLibrary}"
                            AutomationProperties.Name="Save the settings as a preset" />
                    <TextBox Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Presets.NewName}" PlaceholderText="Name (optional)"
                             AutomationProperties.Name="Name of the new preset"
                             AutomationProperties.HelpText="Left empty, the preset is named after its settings" />
                  </DockPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- what is generated from the height layers: per result how it stands and its button; walkability's layer and what changed -->
            <DataTemplate DataType="vm:GeneratedSection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <TextBlock Classes="caption" Text="Open a map to generate from it." IsVisible="{Binding !$parent[UserControl].((vm:MainViewModel)DataContext).HasMap}" />
                  <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Generation.Rows}" AutomationProperties.Name="Generated results">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Classes="stack" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GeneratedRow">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Classes="beside" Content="{Binding ButtonText}" IsEnabled="{Binding !IsRunning}"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="{Binding CommandId}"
                                  AutomationProperties.Name="{Binding ButtonLabel}" />
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Classes="caption" Classes.warning="{Binding IsStale}" Text="{Binding Status}" />
                          </StackPanel>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Classes="stack" IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).HasMap}">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Classes="label" Text="Units" VerticalAlignment="Center" />
                      <ComboBox Margin="{StaticResource InlineGap}" HorizontalAlignment="Stretch" ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Walkability.Layers}" SelectedItem="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Walkability.Layer}"
                                AutomationProperties.Name="Walkability of the units of a layer"
                                AutomationProperties.HelpText="Land, hover, amphibious or naval (water) units" />
                    </DockPanel>
                    <CheckBox Content="Show walkability" IsChecked="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowWalkability, Mode=OneWay}"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="view.overlay.walkability" />
                    <CheckBox Content="Show what changed" IsChecked="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Walkability.ShowChanges}"
                              AutomationProperties.HelpText="Ogrids blocked or opened since walkability was generated the time before" />
                    <TextBlock Classes="caption" Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Walkability.ChangesText}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- the decal groups (D-2): shown or hidden in the views (the editor's, not saved), renamed, filled from the selection -->
            <DataTemplate DataType="vm:DecalGroupsSection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Decals.Groups}" AutomationProperties.Name="Decal groups">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DecalGroupItem">
                        <StackPanel Classes="stack">
                          <DockPanel>
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsShown}"
                                      AutomationProperties.Name="{Binding Name, StringFormat='Show the decal group {0}'}"
                                      AutomationProperties.HelpText="Hidden decals are not drawn in the 3D view and cannot be selected; the map keeps them" />
                            <TextBlock DockPanel.Dock="Right" Classes="caption" Text="{Binding Detail}" VerticalAlignment="Center" />
                            <TextBox Classes="commit" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                     AutomationProperties.Name="{Binding Detail, StringFormat='Name of the decal group of {0}'}" />
                          </DockPanel>
                          <StackPanel Classes="inline">
                            <Button Content="Select" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Decals.SelectGroupCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Select the decals of {0}'}" />
                            <Button Content="Add" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Decals.AddToGroupCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Add the selected decals to {0}'}" />
                            <Button Content="Take out" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Decals.RemoveFromGroupCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Take the selected decals out of {0}'}" />
                            <Button Classes="beside" Content="×" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Decals.DeleteGroupCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Delete the decal group {0}'}" ToolTip.Tip="Its decals stay on the map" />
                          </StackPanel>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="caption" TextWrapping="Wrap" Text="None yet: select decals and make a group of them, to select, show or hide them together."
                             IsVisible="{Binding !$parent[UserControl].((vm:MainViewModel)DataContext).Decals.HasGroups}" />
                  <Button Content="New group from the selection" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="decals.addGroup"
                          AutomationProperties.HelpText="A group of the selected decals; rename it in its field" />
                </StackPanel>
              </Border>
            </DataTemplate>
            <!-- the mode's overlays; a check box runs the overlay's command, as its chip does -->
            <DataTemplate DataType="vm:OverlaySection">
              <Border Classes="group">
                <StackPanel Classes="stack">
                  <TextBlock Classes="overline" Text="{Binding Title, Converter={x:Static controls:UpperCaseConverter.Instance}}" />
                  <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PanelOverlays}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:OverlayItem">
                        <CheckBox Content="{Binding Title}" IsChecked="{Binding IsOn, Mode=OneWay}"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCommand}" CommandParameter="{Binding Definition.CommandId}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
