<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FAForever.MapEditor.App.App"
             RequestedThemeVariant="Dark">
  <!-- Fluent for the controls; the editor's own look is in Styles/ (see the guide's UI rules) -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://faf-map-editor/Styles/Tokens.axaml" />
        <ResourceInclude Source="avares://faf-map-editor/Styles/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="{StaticResource AccentColor}" />
        <ColorPaletteResources x:Key="Light" Accent="{StaticResource AccentColor}" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://faf-map-editor/Styles/Classes.axaml" />
  </Application.Styles>
</Application>
