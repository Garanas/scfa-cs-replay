# Copy to .env next to compose.yaml on the server (never commit .env).

# Let's Encrypt account e-mail (optional, used for important notices about the account).
ACME_EMAIL=

# Host name of the replay vault; its DNS A/AAAA records must point at this server.
VAULT_HOST=vault.jipwijnia.nl

# Image to run; pin a tag (e.g. sha-1a2b3c4) to roll back.
VAULT_IMAGE=ghcr.io/garanas/scfa-cs-replay:latest
