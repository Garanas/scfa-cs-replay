@using FAForever.Replay

@* Line chart of actions per minute. Mark/interaction specs follow the dataviz method:
   2px lines, >=8px end markers, hairline solid gridlines, crosshair + one tooltip for
   all series, a legend plus direct labels, and a table view as the contrast-relief and
   accessibility channel. At most eight concurrent series (the validated --viz-1..8 slots);
   direct end labels only up to four series - beyond that the legend and tooltip carry
   identity. Colors follow the player while shown. *@

@if (series.Count == 0)
{
    <p class="text-sm text-ink-muted">Select a player to chart their actions per minute.</p>
}
else
{
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1" aria-hidden="true">
        @foreach (Series line in series)
        {
            <span class="inline-flex items-center gap-1.5 text-sm">
                <span class="inline-block h-0.75 w-3.5 rounded-full" style="background: @line.Color"></span>
                <span class="font-medium">@line.Name</span>
            </span>
        }
        @if (SelectedSourceIds.Count > series.Count)
        {
            <span class="text-xs text-ink-faint">chart shows the first eight selected players</span>
        }
    </div>

    <div class="relative mt-4" @onmouseleave="() => hoveredBucket = null">
        <svg viewBox="0 0 @((int)Width) @((int)Height)" class="w-full" role="img"
             aria-label="Actions per minute over time, per selected player. The table below holds the same data.">
            @* Gridlines + y labels *@
            @for (int line = 0; line <= GridLines; line++)
            {
                double value = yMax * line / GridLines;
                double y = YFor(value);
                <line x1="@Fmt(Left)" x2="@Fmt(Width - RightPad)" y1="@Fmt(y)" y2="@Fmt(y)"
                      stroke="var(--th-edge)" stroke-width="1" />
                @SvgText(Left - 8, y + 3.5, "end", "var(--th-ink-muted)", ((int)value).ToString(), 400)
            }

            @* X labels *@
            @foreach (int bucket in XTicks())
            {
                @SvgText(XForBucket(bucket), Height - 6, "middle", "var(--th-ink-muted)", GameTime.Format(BucketStart(bucket)), 400)
            }

            @* Series *@
            @foreach (Series line in series)
            {
                <polyline points="@line.Points" fill="none" stroke="@line.Color"
                          stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
                <circle cx="@Fmt(line.EndX)" cy="@Fmt(line.EndY)" r="4" fill="@line.Color" />
                @if (series.Count <= 4)
                {
                    @SvgText(line.EndX + 9, line.LabelY + 3.5, "start", "var(--th-ink)", line.Name, 600)
                }
            }

            @* Crosshair *@
            @if (hoveredBucket is int hovered)
            {
                <line x1="@Fmt(XForBucket(hovered))" x2="@Fmt(XForBucket(hovered))" y1="@Fmt(Top)" y2="@Fmt(Height - BottomPad)"
                      stroke="var(--th-ink-faint)" stroke-width="1" />
            }

            @* Hover hit targets, one per bucket, full plot height *@
            @for (int bucket = 0; bucket < bucketCount; bucket++)
            {
                int captured = bucket;
                <rect x="@Fmt(HitLeft(bucket))" y="@Fmt(Top)" width="@Fmt(HitWidth(bucket))" height="@Fmt(Height - TopBottom)"
                      fill="transparent" @onmouseover="() => hoveredBucket = captured" />
            }
        </svg>

        @if (hoveredBucket is int tooltipBucket)
        {
            <div class="pointer-events-none absolute top-2 z-10 min-w-36 rounded-md border border-edge bg-raised px-3 py-2 text-xs shadow-lg"
                 style="left: @Fmt(100.0 * XForBucket(tooltipBucket) / Width)%; transform: translateX(@(XForBucket(tooltipBucket) > Width * 0.62 ? "-105%" : "5%"))">
                <p class="font-semibold text-ink-muted">@GameTime.Format(BucketStart(tooltipBucket))&ndash;@GameTime.Format(BucketEnd(tooltipBucket))</p>
                <ul class="mt-1 space-y-1">
                    @foreach (Series line in series.OrderByDescending(entry => entry.Values[tooltipBucket]))
                    {
                        <li class="flex items-center gap-2">
                            <span class="inline-block h-0.75 w-3.5 shrink-0 rounded-full" style="background: @line.Color" aria-hidden="true"></span>
                            <span class="font-semibold">@((int)Math.Round(line.Values[tooltipBucket]))</span>
                            <span class="truncate text-ink-muted">@line.Name</span>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    <details class="mt-4">
        <summary class="cursor-pointer text-sm text-ink-muted transition hover:text-ink">View as table</summary>
        <div class="mt-2 max-h-64 overflow-y-auto rounded-md border border-edge">
            <table class="w-full text-left text-xs">
                <thead class="sticky top-0 bg-raised">
                    <tr>
                        <th class="px-3 py-2 font-semibold">Time</th>
                        @foreach (Series line in series)
                        {
                            <th class="px-3 py-2 text-right font-semibold">@line.Name</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int bucket = 0; bucket < bucketCount; bucket++)
                    {
                        <tr class="border-t border-edge/60">
                            <td class="px-3 py-1.5 font-mono text-ink-muted">@GameTime.Format(BucketStart(bucket))&ndash;@GameTime.Format(BucketEnd(bucket))</td>
                            @foreach (Series line in series)
                            {
                                <td class="px-3 py-1.5 text-right font-mono">@((int)Math.Round(line.Values[bucket]))</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
}

@code {
    private const int MaxSeries = 8;
    private const int GridLines = 4;

    private const double Width = 720;
    private const double Height = 280;
    private const double Left = 40;
    private const double RightPad = 110;
    private const double Top = 14;
    private const double BottomPad = 26;
    private const double TopBottom = Top + BottomPad;

    [Parameter, EditorRequired] public required Replay Replay { get; set; }

    /// <summary>The selected players in display order; the chart draws the first four.</summary>
    [Parameter, EditorRequired] public required IReadOnlyList<int> SelectedSourceIds { get; set; }

    [Parameter] public TimeSpan? From { get; set; }

    [Parameter] public TimeSpan? To { get; set; }

    private sealed record Series(int SourceId, string Name, string Color, double[] Values, string Points, double EndX, double EndY, double LabelY);

    private readonly Dictionary<int, int> slotByPlayer = [];
    private List<Series> series = [];
    private int bucketCount;
    private int bucketSeconds = 60;
    private int firstBucket;
    private double yMax = 20;
    private int? hoveredBucket;

    protected override void OnParametersSet()
    {
        TimeSpan duration = ReplayAnalysis.GetDuration(Replay);
        TimeSpan windowFrom = From ?? TimeSpan.Zero;
        TimeSpan windowTo = To is { } to && to < duration ? to : duration;
        bool windowed = From is not null || To is not null;

        // Finer buckets for a short window: roughly thirty points, in 5 s steps.
        bucketSeconds = windowed
            ? Math.Clamp((int)Math.Round((windowTo - windowFrom).TotalSeconds / 30 / 5) * 5, 5, 60)
            : 60;

        Dictionary<int, int[]> buckets = ReplayAnalysis.GetActionBuckets(Replay, bucketSeconds);
        int totalBuckets = buckets.Values.FirstOrDefault()?.Length ?? 0;
        if (totalBuckets > 0)
        {
            firstBucket = Math.Clamp((int)(windowFrom.TotalSeconds / bucketSeconds), 0, totalBuckets - 1);
            int lastBucket = Math.Clamp((int)Math.Ceiling(windowTo.TotalSeconds / bucketSeconds), firstBucket + 1, totalBuckets);
            bucketCount = lastBucket - firstBucket;
        }
        else
        {
            firstBucket = 0;
            bucketCount = 0;
        }

        // Sticky color slots: players that stay selected keep their color.
        List<int> drawn = SelectedSourceIds.Take(MaxSeries).ToList();
        foreach (int sourceId in slotByPlayer.Keys.Where(sourceId => !drawn.Contains(sourceId)).ToList())
        {
            slotByPlayer.Remove(sourceId);
        }
        foreach (int sourceId in drawn)
        {
            if (!slotByPlayer.ContainsKey(sourceId))
            {
                slotByPlayer[sourceId] = Enumerable.Range(0, MaxSeries).First(candidate => !slotByPlayer.ContainsValue(candidate));
            }
        }

        double scale = 60.0 / bucketSeconds;
        List<Series> lines = [];
        foreach (int sourceId in drawn)
        {
            double[] values = new double[bucketCount];
            if (buckets.TryGetValue(sourceId, out int[]? counts))
            {
                for (int bucket = 0; bucket < bucketCount; bucket++)
                {
                    values[bucket] = counts[firstBucket + bucket] * scale;
                }
            }

            lines.Add(new Series(sourceId, PlayerName(sourceId), $"var(--viz-{slotByPlayer[sourceId] + 1})", values, "", 0, 0, 0));
        }

        yMax = Math.Max(20, Math.Ceiling(lines.SelectMany(line => line.Values).DefaultIfEmpty(0).Max() / 20) * 20);

        // Geometry per series, now that the scale is known.
        for (int index = 0; index < lines.Count; index++)
        {
            Series line = lines[index];
            System.Text.StringBuilder points = new();
            for (int bucket = 0; bucket < bucketCount; bucket++)
            {
                points.Append(Fmt(XForBucket(bucket))).Append(',').Append(Fmt(YFor(line.Values[bucket]))).Append(' ');
            }

            double endY = bucketCount > 0 ? YFor(line.Values[bucketCount - 1]) : YFor(0);
            lines[index] = line with { Points = points.ToString().TrimEnd(), EndX = XForBucket(Math.Max(bucketCount - 1, 0)), EndY = endY, LabelY = endY };
        }

        // Nudge the direct labels apart when line ends sit close together.
        List<Series> byY = lines.OrderBy(line => line.LabelY).ToList();
        for (int index = 1; index < byY.Count; index++)
        {
            if (byY[index].LabelY - byY[index - 1].LabelY < 14)
            {
                int position = lines.IndexOf(byY[index]);
                byY[index] = byY[index] with { LabelY = byY[index - 1].LabelY + 14 };
                lines[position] = byY[index];
            }
        }

        series = lines;
        hoveredBucket = hoveredBucket is { } hovered && hovered < bucketCount ? hovered : null;
    }

    private string PlayerName(int sourceId)
    {
        ReplaySource[] clients = Replay.Header.Clients;
        return sourceId >= 0 && sourceId < clients.Length ? clients[sourceId].PlayerName : $"Source {sourceId}";
    }

    private TimeSpan BucketStart(int bucket) => TimeSpan.FromSeconds((firstBucket + bucket) * bucketSeconds);

    private TimeSpan BucketEnd(int bucket) => TimeSpan.FromSeconds((firstBucket + bucket + 1) * bucketSeconds);

    private double XForBucket(int bucket)
        => bucketCount <= 1 ? Left + (Width - Left - RightPad) / 2 : Left + (Width - Left - RightPad) * bucket / (bucketCount - 1);

    private double YFor(double value) => Top + (Height - TopBottom) * (1 - value / yMax);

    private double HitLeft(int bucket) => bucket == 0 ? Left : (XForBucket(bucket - 1) + XForBucket(bucket)) / 2;

    private double HitWidth(int bucket)
    {
        double right = bucket == bucketCount - 1 ? Width - RightPad : (XForBucket(bucket) + XForBucket(bucket + 1)) / 2;
        return Math.Max(right - HitLeft(bucket), 1);
    }

    private IEnumerable<int> XTicks()
    {
        if (bucketCount <= 1)
        {
            yield break;
        }

        int step = Math.Max(1, (int)Math.Ceiling(bucketCount / 6.0));
        for (int bucket = 0; bucket < bucketCount; bucket += step)
        {
            yield return bucket;
        }
    }

    private static string Fmt(double value) => value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>
    /// Renders an SVG text element. Razor reserves the literal &lt;text&gt; tag, so the
    /// element is emitted as markup; the content is HTML-encoded (player names are data).
    /// </summary>
    private static MarkupString SvgText(double x, double y, string anchor, string fill, string content, int weight)
        => new($"<text x=\"{Fmt(x)}\" y=\"{Fmt(y)}\" text-anchor=\"{anchor}\" font-size=\"11\" font-weight=\"{weight}\" fill=\"{fill}\">{System.Net.WebUtility.HtmlEncode(content)}</text>");
}
