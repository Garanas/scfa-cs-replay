@using FAForever.Replay
@inherits UrlStateComponent
@inject IJSRuntime JS

<article>
    @* Two columns: what was played (map preview, map, player count) and which replay it is
       (title, game length, vault number). *@
    <header class="grid items-center gap-4 border-b border-edge pb-6 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <div class="flex min-w-0 items-center gap-4">
            <div class="w-20 shrink-0">
                <MapCanvas Model="Model" AriaLabel="@($"Map preview of {MapName}")" />
            </div>
            <div class="min-w-0">
                <h1 class="truncate text-2xl font-bold sm:text-3xl">@MapName</h1>
                <p class="mt-1 text-lg font-semibold text-ink-muted">@PlayerCount @(PlayerCount == 1 ? "player" : "players")</p>
            </div>
        </div>
        <div class="flex min-w-0 flex-col gap-2 sm:items-end sm:text-right">
            <p class="m-0 max-w-full truncate font-medium" title="@Title">@Title</p>
            <div class="flex flex-wrap items-center gap-2 sm:justify-end">
                <span class="badge" title="In-game duration">@FormatDuration(duration)</span>
                @if (Model.Origin is ReplayOrigin.Vault vault)
                {
                    <button type="button" class="badge cursor-pointer transition hover:border-primary hover:text-primary"
                            title="Copy the replay id" @onclick="() => CopyReplayId(vault.ReplayId)">
                        @(copied ? "copied!" : OriginLabel)
                    </button>
                }
                else
                {
                    <span class="badge">@OriginLabel</span>
                }
                @if (!Model.Replay.Body.InSync)
                {
                    <span class="badge border-primary text-primary" title="The checksums of the players diverged during this game">desync</span>
                }
            </div>
        </div>
    </header>

    <nav class="mt-6 flex flex-wrap gap-1 border-b border-edge pb-px" aria-label="Replay sections">
        @foreach (Tab tab in Enum.GetValues<Tab>())
        {
            @* Moderation is a different use of the page than the analysis tabs, so it sits apart, on the right. *@
            <button type="button" class="@(tab == activeTab ? ActiveTabClass : TabClass) @(tab == Tab.Moderation ? "ml-auto" : "")" @onclick="() => SelectTab(tab)">
                @TabLabel(tab)
            </button>
        }
    </nav>

    <div class="py-6">
        @switch (activeTab)
        {
            case Tab.Overview:
                <OverviewPanel Model="Model" />
                break;
            case Tab.Players:
                <PlayersPanel Model="Model" />
                break;
            case Tab.Playthrough:
                <PlaythroughPanel Model="Model" />
                break;
            case Tab.BuildOrder:
                <BuildOrderPanel Model="Model" />
                break;
            case Tab.Chat:
                <ChatPanel Model="Model" />
                break;
            case Tab.Events:
                <EventsPanel Model="Model" />
                break;
            case Tab.Callbacks:
                <CallbacksPanel Model="Model" />
                break;
            case Tab.Moderation:
                <ModerationPanel Model="Model" />
                break;
        }
    </div>
</article>

@code {
    private const string TabClass = "cursor-pointer rounded-t-md px-4 py-2 text-sm font-medium text-ink-muted transition hover:bg-raised hover:text-ink";
    private const string ActiveTabClass = "cursor-pointer rounded-t-md border-b-2 border-primary bg-raised px-4 py-2 text-sm font-semibold text-primary";

    private enum Tab
    {
        Overview,
        Players,
        Playthrough,
        BuildOrder,
        Chat,
        Events,
        Callbacks,
        Moderation,
    }

    [Parameter, EditorRequired] public required LoadedReplay Model { get; set; }

    private Tab activeTab = Tab.Overview;
    private TimeSpan duration;
    private bool copied;

    protected override void OnParametersSet()
    {
        duration = ReplayAnalysis.GetDuration(Model.Replay);
        // The URL is the source of truth for the active tab, so a view can be shared.
        activeTab = ParseTab(UrlQuery.Get(Navigation, "tab"));
    }

    /// <summary>Copies the vault id (what the FAF client's replay search takes) and confirms it on the badge for a moment.</summary>
    private async Task CopyReplayId(int replayId)
    {
        if (!await JS.InvokeAsync<bool>("fafReplay.copyText", replayId.ToString(System.Globalization.CultureInfo.InvariantCulture)))
        {
            return;
        }

        copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        copied = false;
    }

    private void SelectTab(Tab tab)
    {
        activeTab = tab;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tab", TabQueryValue(tab)), replace: true);
    }

    private static Tab ParseTab(string? value) => value?.ToLowerInvariant() switch
    {
        "players" => Tab.Players,
        "playthrough" => Tab.Playthrough,
        "buildorder" => Tab.BuildOrder,
        "chat" => Tab.Chat,
        "events" => Tab.Events,
        "callbacks" => Tab.Callbacks,
        "moderation" => Tab.Moderation,
        _ => Tab.Overview,
    };

    private static string? TabQueryValue(Tab tab)
        => tab == Tab.Overview ? null : tab.ToString().ToLowerInvariant();

    private string Title => Model.Metadata?.title is { Length: > 0 } title
        ? title
        : Model.Origin is ReplayOrigin.LocalFile localFile
            ? localFile.FileName
            : $"Replay #{(Model.Origin as ReplayOrigin.Vault)?.ReplayId}";

    private string MapName => Model.Replay.Header.Scenario.Map.DisplayName is { Length: > 0 } name
        ? name
        : Model.Metadata?.mapname ?? "Unknown map";

    private int PlayerCount
    {
        get
        {
            int armies = Model.Replay.Header.Armies.Count(army => army.Civilian != true);
            return armies > 0 ? armies : Model.Metadata?.num_players ?? Model.Replay.Header.Clients.Length;
        }
    }

    private string OriginLabel => Model.Origin switch
    {
        ReplayOrigin.Vault vault => $"vault #{vault.ReplayId}",
        ReplayOrigin.LocalFile => "local file",
        _ => "replay",
    };

    private string TabLabel(Tab tab) => tab switch
    {
        Tab.Overview => "Overview",
        Tab.Players => "Players",
        Tab.Playthrough => "Playthrough",
        Tab.BuildOrder => "Build order",
        Tab.Chat => "Chat",
        Tab.Events => "Events",
        Tab.Callbacks => "Callbacks",
        Tab.Moderation => "Moderation",
        _ => tab.ToString(),
    };

    internal static string FormatDuration(TimeSpan duration)
        => duration.TotalHours >= 1 ? duration.ToString(@"h\:mm\:ss") : duration.ToString(@"m\:ss");
}
