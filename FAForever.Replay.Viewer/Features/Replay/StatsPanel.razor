@using FAForever.Replay

@* The end-of-game statistics (ReplaySemantics.GetGameStats): the numbers of the in-game score
   screen (lua/ui/dialogs/hotstats.lua). Only games that ended normally carry them, so the tab
   is always there but may only explain why it is empty; the caveat on top is always shown. *@

<p class="mb-6 rounded-md border border-edge bg-raised/50 px-4 py-3 text-sm text-ink-muted" role="note">
    <span class="font-semibold text-ink">No guarantees.</span>
    These are the numbers of the in-game score screen. They are not part of the recorded game itself but a report
    the game sends to the server when it ends, which happens to be logged in the replay@(stats is null ? "" : $" — this one by {Reporter} at {ReplayView.FormatDuration(stats.Timestamp)}").
    A replay may not have it at all, and when it does, it can be incomplete: it only covers what the game tracks,
    defeated players stop being updated shortly after their defeat, and mods or game versions can change what is reported.
    @if (stats is not null)
    {
        <text>Kills count enemy units destroyed; the score is the game's own formula of resources spent and the value of units destroyed and lost.</text>
    }
</p>

@if (stats is null)
{
    <div class="card mx-auto max-w-2xl text-center">
        <p class="font-semibold">No end-of-game statistics in this replay</p>
        <p class="mt-2 text-sm text-ink-muted">
            When a game ends, every player's game reports the score screen's statistics to the
            server, and that report is recorded in the replay. Games that did not end normally, and
            replays recorded before FAF started logging the report, do not have it.
        </p>
    </div>
}
else
{
    <div class="space-y-6">
        <section class="card overflow-x-auto p-0">
            <h3 class="px-4 pt-4 text-xs font-semibold uppercase tracking-wide text-ink-muted">Summary</h3>
            <table class="mt-2 w-full text-left text-sm">
                <thead>
                    <tr class="border-b border-edge text-xs uppercase tracking-wide text-ink-muted">
                        <th class="px-4 py-3 font-semibold">Player</th>
                        @foreach (Column column in SummaryColumns)
                        {
                            <th class="px-3 py-3 text-right font-semibold" title="@column.Title"><span class="inline-flex items-center gap-1 align-middle">@StatIcon(column.Icon)@column.Label</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (Row row in rows)
                    {
                        <tr class="border-b border-edge/60 last:border-0 hover:bg-raised/50">
                            <td class="px-4 py-2">@PlayerCell(row)</td>
                            @foreach (Column column in SummaryColumns)
                            {
                                double value = column.Value(row.Stats);
                                double max = rows.Max(other => column.Value(other.Stats));
                                <td class="min-w-24 px-3 py-2 text-right font-mono">
                                    <span class="block">@Format(value)</span>
                                    <span class="mt-1 block h-1 overflow-hidden rounded-full bg-edge/60" aria-hidden="true">
                                        <span class="ml-auto block h-1 rounded-full bg-primary" style="width: @Percentage(value, max)"></span>
                                    </span>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        @foreach ((string title, List<(string Key, string Label)> group) in categoryGroups)
        {
            <section class="card overflow-x-auto p-0">
                <h3 class="px-4 pt-4 text-xs font-semibold uppercase tracking-wide text-ink-muted">@title</h3>
                <table class="mt-2 w-full text-sm">
                    <thead>
                        <tr class="text-xs uppercase tracking-wide text-ink-muted">
                            <th class="px-4 pt-3"></th>
                            @foreach ((string key, string label) in group)
                            {
                                <th colspan="3" class="border-b border-l border-edge px-2 pt-3 pb-1 text-center font-semibold">@label</th>
                            }
                        </tr>
                        <tr class="border-b border-edge text-xs text-ink-muted">
                            <th class="px-4 py-2 text-left font-semibold uppercase tracking-wide">Player</th>
                            @foreach ((string key, string label) in group)
                            {
                                <th class="border-l border-edge py-2 pr-1.5 pl-2 text-right font-normal" title="Units built">built</th>
                                <th class="px-1.5 py-2 text-right font-normal" title="Enemy units killed">killed</th>
                                <th class="py-2 pr-2 pl-1.5 text-right font-normal" title="Own units lost">lost</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (Row row in rows)
                        {
                            <tr class="border-b border-edge/60 last:border-0 hover:bg-raised/50">
                                <td class="px-4 py-2">@PlayerCell(row, compact: true)</td>
                                @foreach ((string key, string label) in group)
                                {
                                    ReplayUnitTally? tally = row.Stats.Units.GetValueOrDefault(key);
                                    <td class="border-l border-edge py-2 pr-1.5 pl-2 text-right font-mono tabular-nums">@Tally(tally?.Built)</td>
                                    <td class="px-1.5 py-2 text-right font-mono tabular-nums">@Tally(tally?.Kills)</td>
                                    <td class="py-2 pr-2 pl-1.5 text-right font-mono tabular-nums">@Tally(tally?.Lost)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }

        <section class="card overflow-x-auto p-0">
            <h3 class="px-4 pt-4 text-xs font-semibold uppercase tracking-wide text-ink-muted">Economy</h3>
            <table class="mt-2 w-full text-left text-sm">
                <thead>
                    <tr class="text-xs uppercase tracking-wide text-ink-muted">
                        <th class="px-4 pt-3 font-semibold"></th>
                        <th colspan="4" class="border-b border-edge px-3 pt-3 pb-1 text-center font-semibold"><span class="inline-flex items-center gap-1 align-middle">@StatIcon("mass")Mass</span></th>
                        <th colspan="4" class="border-b border-edge px-3 pt-3 pb-1 text-center font-semibold"><span class="inline-flex items-center gap-1 align-middle">@StatIcon("energy")Energy</span></th>
                    </tr>
                    <tr class="border-b border-edge text-xs uppercase tracking-wide text-ink-muted">
                        <th class="px-4 py-2 font-semibold">Player</th>
                        @for (int i = 0; i < 2; i++)
                        {
                            <th class="px-3 py-2 text-right font-semibold" title="Everything produced, reclaim included">Produced</th>
                            <th class="px-3 py-2 text-right font-semibold" title="The part of the production that came from reclaim">Reclaimed</th>
                            <th class="px-3 py-2 text-right font-semibold">Spent</th>
                            <th class="px-3 py-2 text-right font-semibold" title="Production lost because storage was full">Wasted</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (Row row in rows)
                    {
                        ReplayArmyResourceStats resources = row.Stats.Resources;
                        <tr class="border-b border-edge/60 last:border-0 hover:bg-raised/50">
                            <td class="px-4 py-2">@PlayerCell(row)</td>
                            @foreach ((ReplayResourceIncome income, ReplayResourceExpense expense) in new[] { (resources.MassIn, resources.MassOut), (resources.EnergyIn, resources.EnergyOut) })
                            {
                                <td class="px-3 py-2 text-right font-mono">@Format(income.Total)</td>
                                <td class="px-3 py-2 text-right font-mono">@Format(income.Reclaimed)</td>
                                <td class="px-3 py-2 text-right font-mono">@Format(expense.Total)</td>
                                <td class="px-3 py-2 text-right font-mono">@Format(expense.Excess)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        @if (tracked.Count > 0)
        {
            <section class="card overflow-x-auto p-0">
                <h3 class="px-4 pt-4 text-xs font-semibold uppercase tracking-wide text-ink-muted">Tracked units</h3>
                <p class="px-4 pt-1 text-xs text-ink-faint">
                    The units the server keeps statistics on for achievements: commanders, air superiority fighters and experimentals.
                </p>
                <table class="mt-2 w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-edge text-xs uppercase tracking-wide text-ink-muted">
                            <th class="px-4 py-3 font-semibold">Unit</th>
                            <th class="px-3 py-3 font-semibold">Player</th>
                            <th class="px-3 py-3 text-right font-semibold"><span class="inline-flex items-center gap-1 align-middle">@StatIcon("build")Built</span></th>
                            <th class="px-3 py-3 text-right font-semibold"><span class="inline-flex items-center gap-1 align-middle">@StatIcon("kills")Killed</span></th>
                            <th class="px-3 py-3 text-right font-semibold">Lost</th>
                            <th class="px-3 py-3 text-right font-semibold" title="The lowest health the unit had during the game"><span class="inline-flex items-center gap-1 align-middle">@StatIcon("redcross")Lowest health</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (TrackedRow item in tracked)
                        {
                            <tr class="border-b border-edge/60 last:border-0 hover:bg-raised/50">
                                <td class="px-4 py-2">
                                    <span class="flex items-center gap-2">
                                        <UnitIcon BlueprintId="@item.BlueprintId" Size="28" Title="@item.UnitName" />
                                        <span>@item.UnitName</span>
                                        <span class="font-mono text-xs text-ink-faint">@item.BlueprintId</span>
                                    </span>
                                </td>
                                <td class="px-3 py-2"><PlayerLabel Name="@item.Row.Name" Color="@item.Row.Color" /></td>
                                <td class="px-3 py-2 text-right font-mono">@Format(item.Tally.Built)</td>
                                <td class="px-3 py-2 text-right font-mono">@Format(item.Tally.Kills)</td>
                                <td class="px-3 py-2 text-right font-mono">@Format(item.Tally.Lost)</td>
                                <td class="px-3 py-2 text-right font-mono">@(item.Tally.LowestHealth is { } health ? Format(health) : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public required LoadedReplay Model { get; set; }

    private sealed record Row(ReplayArmyStats Stats, string Name, string? Color, int? Faction, string Team);

    private sealed record TrackedRow(string BlueprintId, string UnitName, Row Row, ReplayUnitTally Tally);

    private sealed record Column(string Label, string? Icon, string? Title, Func<ReplayArmyStats, double> Value);

    private static readonly Column[] SummaryColumns =
    [
        new("Score", null, "The in-game score: resources spent plus the value of enemy units destroyed minus own losses", stats => stats.General.Score),
        new("Built", "build", "Units built", stats => stats.General.Built.Count),
        new("Kills", "kills", "Enemy units destroyed", stats => stats.General.Kills.Count),
        new("Losses", null, "Own units lost", stats => stats.General.Lost.Count),
        new("Mass killed", null, "Mass value of the enemy units destroyed", stats => stats.General.Kills.Mass),
        new("Mass lost", null, "Mass value of the own units lost", stats => stats.General.Lost.Mass),
        new("Mass", "mass", "Total mass produced, reclaim included", stats => stats.Resources.MassIn.Total),
        new("Energy", "energy", "Total energy produced, reclaim included", stats => stats.Resources.EnergyIn.Total),
    ];

    /// <summary>The unit categories of lua/sim/score.lua: those of the score screen, then those the server tracks for achievements.</summary>
    private static readonly (string Title, (string Key, string Label)[] Categories)[] CategoryGroups =
    [
        ("Units by type",
        [
            ("land", "Land"),
            ("air", "Air"),
            ("naval", "Naval"),
            ("experimental", "Experimental"),
            ("structures", "Structures"),
            ("cdr", "ACU"),
        ]),
        ("Units by role and tech level",
        [
            ("engineer", "Engineers"),
            ("transportation", "Transports"),
            ("sacu", "SACU"),
            ("tech1", "Tech 1"),
            ("tech2", "Tech 2"),
            ("tech3", "Tech 3"),
        ]),
    ];

    private LoadedReplay? derivedFrom;
    private ReplayGameStats? stats;
    private List<Row> rows = [];
    private List<(string Title, List<(string Key, string Label)> Categories)> categoryGroups = [];
    private List<TrackedRow> tracked = [];

    protected override void OnParametersSet()
    {
        // Nothing here depends on the URL, so derive once per replay.
        if (ReferenceEquals(derivedFrom, Model))
        {
            return;
        }

        derivedFrom = Model;
        Replay replay = Model.Replay;
        stats = ReplaySemantics.GetGameStats(replay);
        if (stats is null)
        {
            return;
        }

        // The report names armies by nickname; the lobby options add colour and team.
        Dictionary<string, ReplayPlayerOptions> armies = replay.Header.Armies
            .Where(army => army.PlayerName is not null)
            .GroupBy(army => army.PlayerName!)
            .ToDictionary(group => group.Key, group => group.First());

        rows = stats.Armies
            .Select((army, index) =>
            {
                ReplayPlayerOptions? options = army.Name is not null ? armies.GetValueOrDefault(army.Name) : null;
                return new Row(army, army.Name ?? $"Army {index + 1}", options?.Color, army.Faction ?? options?.Faction, TeamLabel(options));
            })
            .OrderBy(row => row.Team)
            .ThenByDescending(row => row.Stats.General.Score)
            .ToList();

        categoryGroups = CategoryGroups
            .Select(group => (group.Title, group.Categories
                .Where(category => rows.Any(row => row.Stats.Units.ContainsKey(category.Key)))
                .ToList()))
            .Where(group => group.Item2.Count > 0)
            .ToList();

        tracked = rows
            .SelectMany(row => row.Stats.Blueprints.Select(blueprint => (blueprint.Key, Row: row, Tally: blueprint.Value)))
            .Where(item => item.Tally.Built > 0 || item.Tally.Kills > 0 || item.Tally.Lost > 0)
            .GroupBy(item => item.Key)
            .OrderBy(group => group.Key.EndsWith("0001") ? 0 : 1)
            .ThenByDescending(group => group.Sum(item => item.Tally.Built))
            .SelectMany(group => group.Select(item => new TrackedRow(item.Key, UnitNames.GetOrNull(item.Key) ?? item.Key, item.Row, item.Tally)))
            .ToList();
    }

    /// <summary>A count in the units tables; zeros and missing categories fade so the numbers stand out.</summary>
    private static RenderFragment Tally(double? value) => value switch
    {
        null => @<span class="text-ink-faint">—</span>,
        var count when Math.Round(count.Value) == 0 => @<span class="text-ink-faint">0</span>,
        var count => @<span>@Format(count.Value)</span>,
    };

    private RenderFragment PlayerCell(Row row, bool compact = false) => @<span class="flex items-center gap-2 whitespace-nowrap">
        <span class="h-4 w-1 shrink-0 rounded-full" style="background: @(row.Color ?? "transparent")" aria-hidden="true"></span>
        @if (Factions.IconPath(row.Faction) is { } factionIcon)
        {
            <img src="@factionIcon" alt="@Factions.Name(row.Faction)" title="@Factions.Name(row.Faction)" class="h-5 w-5 shrink-0" loading="lazy" />
        }
        <span class="font-medium">@row.Name</span>
        @if (row.Stats.Type is { } type && type != "Human")
        {
            <span class="badge">@type</span>
        }
        @if (row.Stats.EliminatedEarly && !compact)
        {
            <span class="badge" title="Statistics stopped updating at @ReplayView.FormatDuration(TimeSpan.FromSeconds(row.Stats.General.LastUpdateTick / 10))">defeated</span>
        }
        @if (!compact)
        {
            <span class="text-xs text-ink-faint">@row.Team</span>
        }
    </span>;

    /// <summary>One of the game's unit view icons (wwwroot/images/stats, see tools/convert-stat-icons.ps1); decorative.</summary>
    private static RenderFragment StatIcon(string? name) => name is null
        ? _ => { }
        : @<img src="images/stats/@(name).png" alt="" class="stat-icon" aria-hidden="true" />;

    private static string TeamLabel(ReplayPlayerOptions? army) => army switch
    {
        { DisplayTeam: { } team } => $"Team {team}",
        { Team: 1 } => "FFA",
        _ => "",
    };

    private string Reporter => stats is not null && stats.SourceId >= 0 && stats.SourceId < Model.Replay.Header.Clients.Length
        ? Model.Replay.Header.Clients[stats.SourceId].PlayerName
        : "a player";

    /// <summary>Counts and totals, rounded: the game reports floats, with noise in the decimals.</summary>
    private static string Format(double value) => Math.Round(value).ToString("N0");

    private static string Percentage(double value, double max)
        => max > 0 ? $"{Math.Clamp(value / max * 100, 0, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%" : "0%";
}
