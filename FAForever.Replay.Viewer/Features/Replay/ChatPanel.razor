@using FAForever.Replay
@inherits UrlStateComponent
@inject IJSRuntime JS

@* What the players communicated, laid out like the Playthrough tab: filters | map | feed.
   The feed holds the chat messages, drawings (brush strokes) and pings in time order; the
   map shows the drawings and pings of the same selection, always on the whole map (the
   vault previews are too coarse to zoom in on). Built for moderation: the shared from/to
   and players parameters decide exactly what is shown, so the address of the page is the
   evidence: a drawing made of several strokes shows up as a whole when the window covers
   all of them. Clicking an item, in the feed or on the map, highlights it in both without
   touching the window; the selection is a pointer aid and stays out of the URL. *@

<div class="grid gap-6 lg:grid-cols-[1fr_2.4fr_1.6fr]">
    <div class="card max-h-[70vh] self-start overflow-y-auto p-2">
        <h3 class="px-3 pb-1 pt-2 text-xs font-semibold uppercase tracking-wide text-ink-muted">Filters</h3>
        <TimeWindowFilter Duration="duration" />
        @if (playerItems.Count == 0)
        {
            <p class="px-3 py-1.5 text-sm text-ink-muted">Nobody chatted, drew or pinged.</p>
        }
        else
        {
            <PlayerFilterList Items="playerItems" />
        }
        <label class="flex w-full cursor-pointer items-center gap-2 rounded-md px-3 py-1.5 text-ink-muted transition hover:bg-raised hover:text-ink">
            <input type="checkbox" class="accent-primary" checked="@showPings" @onchange="TogglePings" />
            <span class="text-sm">Pings</span>
        </label>

        <p class="px-3 pb-2 pt-4 text-xs text-ink-faint">
            In game, drawings are only shown to the author's allies and to observers, and fade after
            25 seconds. Drawings by observers are not stored in the replay.
        </p>
    </div>

    <div class="card flex flex-col gap-3 self-start">
        <MapView Model="Model" MarkerScale="0.6" AriaLabel="Drawings and pings of the players">
            <Overlay>
                <ChatMapLayer Items="visible" Highlighted="Highlighted" PingRadius="PingRadius" OnSelect="SelectFromMap" />
            </Overlay>
        </MapView>
        <p class="text-sm text-ink-muted">
            <span class="font-semibold text-ink">@visible.Count(item => item.Message is not null).ToString("N0")</span> messages,
            <span class="font-semibold text-ink">@visible.Count(item => item.Drawing is not null).ToString("N0")</span> drawings,
            <span class="font-semibold text-ink">@visible.Count(item => item.Ping is not null).ToString("N0")</span> pings
            @(windowFrom is { } from && windowTo is { } to ? $"between {GameTime.Format(from)} and {GameTime.Format(to)}" : "in the whole game")
        </p>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 border-t border-edge/60 pt-2 text-xs text-ink-muted"
             role="list" aria-label="Map legend">
            <span role="listitem" class="inline-flex items-center gap-1">
                <svg viewBox="0 0 10 10" class="h-4 w-4" aria-hidden="true"><path d="M1.5 7 C3 2.5 5 8.5 8.5 3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
                Drawing
            </span>
            @foreach ((string type, string label) in PingLegend)
            {
                <span role="listitem" class="inline-flex items-center gap-1">
                    <span class="w-4 text-center font-semibold" style="color: @(PingColor(type) ?? "inherit")" aria-hidden="true">@PingGlyph(type)</span>
                    @label
                </span>
            }
        </div>
    </div>

    <div class="card max-h-[70vh] self-start overflow-y-auto p-2">
        <h3 class="px-3 pb-1 pt-2 text-xs font-semibold uppercase tracking-wide text-ink-muted">Feed</h3>
        <ChatFeed Items="visible" Selected="selected" OnSelect="Select" OnHover="Hover"
                  EmptyText="@(allItems.Count == 0 ? "No chat messages, drawings or pings in this replay." : "Nothing matches the filters.")" />
    </div>
</div>

@code {
    private const string PingsParameter = "pings";

    private static readonly (string Type, string Label)[] PingLegend =
    [
        ("alert", "Alert"),
        ("attack", "Attack"),
        ("move", "Move"),
        ("marker", "Marker"),
        ("nuke", "Nuke"),
    ];

    [Parameter, EditorRequired] public required LoadedReplay Model { get; set; }

    /// <summary>
    /// A chat message, drawing or ping; exactly one of the three is set. <see cref="Key"/>
    /// is stable for a replay. Color is the player's in-game colour.
    /// </summary>
    public sealed record Item(int Key, TimeSpan Timestamp, string Player, string? Color,
        ReplayChatMessage? Message, ReplayDrawing? Drawing, ReplayPing? Ping);

    private LoadedReplay? extractedFrom;
    private List<Item> allItems = [];
    private List<Item> visible = [];
    private List<(string Name, int Count, string? Color)> playerItems = [];
    private TimeSpan duration;
    private TimeSpan? windowFrom;
    private TimeSpan? windowTo;
    private bool showPings = true;
    private int? hovered;
    private int? selected;
    private bool scrollToSelected;

    /// <summary>The item to emphasise on the map: the hovered one, else the selected one.</summary>
    private int? Highlighted => hovered ?? selected;

    private double PingRadius => MapCanvas.MapSize(Model.Replay.Header).X / 70.0;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(extractedFrom, Model))
        {
            // Extract once per replay: OnParametersSet re-runs on every query change.
            extractedFrom = Model;
            duration = ReplayAnalysis.GetDuration(Model.Replay);
            allItems = ExtractItems(Model.Replay);
            playerItems = allItems
                .GroupBy(item => item.Player)
                .OrderByDescending(group => group.Count())
                .ThenBy(group => group.Key)
                .Select(group => (group.Key, group.Count(), group.First().Color))
                .ToList();
        }

        // The URL is the source of truth for every filter, so the view can be shared as evidence.
        (windowFrom, windowTo) = TimeWindowFilter.ReadWindow(Navigation, required: false, duration);
        showPings = !string.Equals(UrlQuery.Get(Navigation, PingsParameter), "off", StringComparison.OrdinalIgnoreCase);
        HashSet<string> selectedNames = PlayerFilterList.SelectedFrom(Navigation, playerItems.Select(item => item.Name));

        visible = allItems
            .Where(item => showPings || item.Ping is null)
            .Where(item => selectedNames.Contains(item.Player))
            .Where(item => windowFrom is not { } from || item.Timestamp >= from)
            .Where(item => windowTo is not { } to || item.Timestamp <= to)
            .ToList();

        // A selection that the filters hide is dropped, so nothing invisible stays emphasised.
        if (selected is { } key && !visible.Any(item => item.Key == key))
        {
            selected = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollToSelected && selected is { } key)
        {
            scrollToSelected = false;
            await JS.InvokeVoidAsync("fafReplay.scrollIntoView", ChatFeed.RowId(key));
        }
    }

    /// <summary>
    /// All chat messages, drawings and pings of a replay in time order, with stable keys.
    /// The Playthrough tab uses the drawings and pings among them.
    /// </summary>
    public static List<Item> ExtractItems(Replay replay)
    {
        Dictionary<string, string> colorsByName = GameColors.ByName(replay.Header);
        Dictionary<int, string> colorsBySource = GameColors.BySource(replay.Header);
        ReplaySource[] clients = replay.Header.Clients;
        string PlayerName(int sourceId) => sourceId >= 0 && sourceId < clients.Length ? clients[sourceId].PlayerName : $"Source {sourceId}";

        IEnumerable<Item> messages = ReplaySemantics.GetChatMessages(replay).Select(message =>
            new Item(0, message.Timestamp, message.Sender, colorsByName.GetValueOrDefault(message.Sender), message, null, null));
        IEnumerable<Item> drawings = ReplaySemantics.GetDrawings(replay).Select(drawing =>
            new Item(0, drawing.Timestamp, PlayerName(drawing.SourceId), colorsBySource.GetValueOrDefault(drawing.SourceId), null, drawing, null));
        IEnumerable<Item> pings = ReplaySemantics.GetPings(replay).Select(ping =>
            new Item(0, ping.Timestamp, PlayerName(ping.SourceId), colorsBySource.GetValueOrDefault(ping.SourceId), null, null, ping));

        // OrderBy is stable: at equal timestamps messages come before drawings and pings.
        return messages.Concat(drawings).Concat(pings)
            .OrderBy(item => item.Timestamp)
            .Select((item, index) => item with { Key = index })
            .ToList();
    }

    /// <summary>Selects an item, or clears the selection when it was already selected.</summary>
    private void Select(Item item) => selected = selected == item.Key ? null : item.Key;

    /// <summary>A click on the map also brings the item's feed row into view.</summary>
    private void SelectFromMap(Item item)
    {
        Select(item);
        scrollToSelected = selected is not null;
    }

    private void Hover(int? key) => hovered = key;

    private void TogglePings()
        => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter(PingsParameter, showPings ? "off" : null), replace: true);

    /// <summary>What an item is, e.g. "Drawing (12 points)" or "Alert ping “Base”".</summary>
    public static string Describe(Item item) => item switch
    {
        { Message: { } message } => message.Message,
        { Drawing: { } drawing } => $"Drawing ({drawing.Points.Count} points)",
        { Ping: { Name: { } name } ping } => $"{ping.Type} ping “{name}”",
        { Ping: { } ping } => $"{ping.Type} ping",
        _ => string.Empty,
    };

    /// <summary>
    /// The colour of a ping type, after the in-game ring of that type (PingTypes in
    /// lua/ui/game/ping.lua): blue for move, yellow for alert, red for attack. Null for the
    /// other types, which keep the colour of the player (markers carry their own).
    /// </summary>
    public static string? PingColor(string type) => type.ToLowerInvariant() switch
    {
        "move" => "#33b5ff",
        "alert" => "#ffcc00",
        "attack" => "#ff3333",
        _ => null,
    };

    public static string PingGlyph(string type) => type.ToLowerInvariant() switch
    {
        "alert" => "!",
        "attack" => "✕",
        "move" => "➜",
        "marker" => "◆",
        "nuke" => "☢",
        _ => "•",
    };

    /// <summary>Game time with tenths: strokes of one drawing are often seconds apart.</summary>
    public static string FormatTime(TimeSpan time) => $"{GameTime.Format(time)}.{time.Milliseconds / 100}";
}
