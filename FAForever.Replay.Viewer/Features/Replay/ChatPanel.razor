@using FAForever.Replay
@inherits UrlStateComponent

@* Two views on what the players communicated: the chat messages, and what they drew and
   pinged on the map. The sub-tab lives in the "view" query parameter; the time window and
   the player selection are shared by both. *@

<div class="segmented mb-4" role="tablist" aria-label="Chat views">
    <button type="button" role="tab" aria-selected="@(!showMap)" class="segmented-item @(showMap ? "" : "active")"
            @onclick="() => SelectView(map: false)">
        Messages <span class="badge">@allMessages.Count.ToString("N0")</span>
    </button>
    <button type="button" role="tab" aria-selected="@showMap" class="segmented-item @(showMap ? "active" : "")"
            @onclick="() => SelectView(map: true)">
        Drawings &amp; pings <span class="badge">@mapItemCount.ToString("N0")</span>
    </button>
</div>

@if (showMap)
{
    <DrawingsPanel Model="Model" />
}
else if (allMessages.Count == 0)
{
    <div class="card text-center text-sm text-ink-muted">No chat messages in this replay.</div>
}
else
{
    <div class="grid gap-6 lg:grid-cols-[1fr_3fr]">
    <div class="card max-h-[70vh] self-start overflow-y-auto p-2">
        <h3 class="px-3 pb-1 pt-2 text-xs font-semibold uppercase tracking-wide text-ink-muted">Filters</h3>
        <TimeWindowFilter Duration="duration" />

        <h3 class="px-3 pb-1 pt-3 text-xs font-semibold uppercase tracking-wide text-ink-muted">Players</h3>
        <PlayerFilterList Items="senders" />
    </div>

    <div class="card max-h-[70vh] self-start overflow-y-auto p-0">
        <ChatMessagesTable Messages="FilteredMessages.ToList()" Colors="colorsByName" />
    </div>
    </div>
}

@code {
    private const string ViewParameter = "view";

    [Parameter, EditorRequired] public required LoadedReplay Model { get; set; }

    private List<ReplayChatMessage> allMessages = [];
    private List<(string Sender, int Count, string? Color)> senders = [];
    private Dictionary<string, string> colorsByName = [];
    private HashSet<string> selectedSenders = [];
    private TimeSpan duration;
    private TimeSpan? fromTime;
    private TimeSpan? toTime;
    private bool showMap;
    private LoadedReplay? countedFrom;
    private int mapItemCount;

    private IEnumerable<ReplayChatMessage> FilteredMessages
    {
        get
        {
            IEnumerable<ReplayChatMessage> messages = selectedSenders.Count == senders.Count
                ? allMessages
                : allMessages.Where(message => selectedSenders.Contains(message.Sender));
            if (fromTime is { } from)
            {
                messages = messages.Where(message => message.Timestamp >= from);
            }
            if (toTime is { } to)
            {
                messages = messages.Where(message => message.Timestamp <= to);
            }

            return messages;
        }
    }

    protected override void OnParametersSet()
    {
        // Absent or unknown means the messages, so the default stays out of the URL.
        showMap = string.Equals(UrlQuery.Get(Navigation, ViewParameter), "map", StringComparison.OrdinalIgnoreCase);
        allMessages = ReplaySemantics.GetChatMessages(Model.Replay);
        if (!ReferenceEquals(countedFrom, Model))
        {
            countedFrom = Model;
            mapItemCount = ReplaySemantics.GetDrawings(Model.Replay).Count + ReplaySemantics.GetPings(Model.Replay).Count;
        }
        duration = ReplayAnalysis.GetDuration(Model.Replay);
        colorsByName = GameColors.ByName(Model.Replay.Header);
        senders = allMessages
            .GroupBy(message => message.Sender)
            .Select(group => (group.Key, group.Count(), colorsByName.GetValueOrDefault(group.Key)))
            .OrderByDescending(pair => pair.Item2)
            .ThenBy(pair => pair.Item1)
            .ToList();

        // The URL is the source of truth for both filters.
        selectedSenders = PlayerFilterList.SelectedFrom(Navigation, senders.Select(pair => pair.Sender));
        (fromTime, toTime) = TimeWindowFilter.ReadWindow(Navigation, required: false, duration);
    }

    private void SelectView(bool map)
    {
        showMap = map;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter(ViewParameter, map ? "map" : null), replace: true);
    }
}
