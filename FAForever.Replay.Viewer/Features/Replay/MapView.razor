@using FAForever.Replay

@* Minimap: the vault preview (when it exists) with the estimated start position of every
   player on top. Positions are derived from the first construction orders, so they work
   for any replay — including generated maps that have no preview at all (the themed grid
   backdrop takes over). World coordinates: (0,0) is the top-left corner, X right, Z down. *@

<div class="map-grid relative w-full overflow-hidden rounded-lg border border-edge" style="aspect-ratio: @sizeX / @sizeZ">
    @if (PreviewUrl is { } previewUrl)
    {
        <img src="@previewUrl" alt="Map preview of @MapName" loading="lazy"
             class="absolute inset-0 h-full w-full object-cover"
             onerror="this.style.display='none'" />
    }

    @if (markers.Count > 0 || Overlay is not null)
    {
        <svg class="absolute inset-0 h-full w-full" viewBox="0 0 @sizeX @sizeZ" role="img"
             aria-label="Estimated start positions of the players">
            @foreach (SpawnMarker marker in markers)
            {
                <g>
                    <title>@marker.Title</title>
                    <circle cx="@Fmt(marker.X)" cy="@Fmt(marker.Y)" r="@Fmt(IconSize * 0.62)" fill="rgba(10, 12, 18, 0.55)"
                            stroke="@(marker.ArmyColor ?? "transparent")" stroke-width="@Fmt(IconSize * 0.09)" />
                    @if (marker.Icon is { } icon)
                    {
                        <image href="@icon" x="@Fmt(marker.X - IconSize / 2)" y="@Fmt(marker.Y - IconSize / 2)"
                               width="@Fmt(IconSize)" height="@Fmt(IconSize)" />
                    }
                    else
                    {
                        <circle cx="@Fmt(marker.X)" cy="@Fmt(marker.Y)" r="@Fmt(IconSize * 0.3)" fill="@marker.Swatch" />
                    }
                    @SvgLabel(marker.X, marker.Y + IconSize * 1.15, marker.Label)
                </g>
            }
            @Overlay
        </svg>
    }
</div>

@code {
    [Parameter, EditorRequired] public required LoadedReplay Model { get; set; }

    /// <summary>
    /// Extra SVG content rendered on top of the spawn markers, in world coordinates
    /// (the viewBox spans 0,0 to SizeX,SizeZ).
    /// </summary>
    [Parameter] public RenderFragment? Overlay { get; set; }

    /// <summary>
    /// The world-unit size of the map, with the fallback for maps that do not state one.
    /// </summary>
    public static (int SizeX, int SizeZ) Size(ReplayScenarioMap map)
        => (map.SizeX is > 0 and int x ? x : 1024, map.SizeZ is > 0 and int z ? z : 1024);

    private sealed record SpawnMarker(float X, float Y, string Label, string Title, string? Icon, string Swatch, string? ArmyColor);

    private readonly List<SpawnMarker> markers = [];
    private int sizeX = 1024;
    private int sizeZ = 1024;

    private double IconSize => Math.Max(sizeX, sizeZ) / 16.0;

    private string MapName => Model.Replay.Header.Scenario.Map.DisplayName ?? Model.Metadata?.mapname ?? "map";

    private string? PreviewUrl
    {
        get
        {
            string? folder = Model.Metadata?.mapname;
            if (folder is null && Model.Replay.Header.Scenario.Map.SCMapReference is { Length: > 0 } reference)
            {
                string[] segments = reference.Split('/', StringSplitOptions.RemoveEmptyEntries);
                folder = segments.Length >= 2 ? segments[^2] : null;
            }

            return folder is { Length: > 0 }
                ? $"https://content.faforever.com/maps/previews/large/{folder.ToLowerInvariant()}.png"
                : null;
        }
    }

    protected override void OnParametersSet()
    {
        (sizeX, sizeZ) = Size(Model.Replay.Header.Scenario.Map);

        markers.Clear();
        Dictionary<int, ReplayAnalysis.MapPosition> spawns = ReplayAnalysis.GetEstimatedSpawnPositions(Model.Replay);
        foreach (ReplayPlayerOptions army in Model.Replay.Header.Armies)
        {
            if (army.SourceId is not int sourceId || !spawns.TryGetValue(sourceId, out ReplayAnalysis.MapPosition? spawn))
            {
                continue;
            }

            // Keep markers inside the view, also for spawns near the map edge.
            float margin = (float)IconSize;
            float markerX = Math.Clamp(spawn.X, margin, sizeX - margin);
            float markerY = Math.Clamp(spawn.Z, margin, sizeZ - margin);

            string name = army.PlayerName ?? Model.Replay.Header.Clients[sourceId].PlayerName;
            string faction = Factions.Name(army.Faction) ?? "Unknown faction";
            markers.Add(new SpawnMarker(
                markerX,
                markerY,
                name,
                $"{name} — {faction}{(army.DisplayTeam is { } team ? $", team {team}" : "")} (estimated start)",
                Factions.IconPath(army.Faction),
                Factions.Swatch(army.Faction),
                army.Color));
        }
    }

    private static string Fmt(double value) => value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>
    /// A name label under a marker. Razor reserves the &lt;text&gt; tag, so the element is
    /// emitted as markup; white fill with a dark stroke stays readable on any backdrop.
    /// </summary>
    private MarkupString SvgLabel(double x, double y, string content)
        => new($"<text x=\"{Fmt(x)}\" y=\"{Fmt(y)}\" text-anchor=\"middle\" font-size=\"{Fmt(IconSize * 0.42)}\" font-weight=\"600\" fill=\"#ffffff\" stroke=\"rgba(10, 12, 18, 0.8)\" stroke-width=\"{Fmt(IconSize * 0.08)}\" paint-order=\"stroke\">{System.Net.WebUtility.HtmlEncode(content)}</text>");
}
