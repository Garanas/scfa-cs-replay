@using FAForever.Replay

@if (Entries.Count == 0)
{
    <p class="text-sm text-ink-muted">No construction orders match the current filters.</p>
}
else
{
    <div class="max-h-96 overflow-y-auto rounded-md border border-edge">
        <table class="w-full text-left text-sm">
            <thead class="sticky top-0 bg-raised text-xs uppercase tracking-wide text-ink-muted">
                <tr>
                    <th class="px-3 py-2 font-semibold">Time</th>
                    <th class="px-3 py-2 font-semibold">Player</th>
                    <th class="px-3 py-2 font-semibold">Order</th>
                    <th class="px-3 py-2 font-semibold">Blueprint</th>
                    <th class="px-3 py-2 text-right font-semibold" title="Number of units or factories that received the order">Units</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Row row in Entries.Take(MaxRows))
                {
                    <tr class="border-t border-edge/60 hover:bg-raised/50">
                        <td class="px-3 py-1.5 font-mono text-ink-muted">@GameTime.Format(row.Timestamp)</td>
                        <td class="whitespace-nowrap px-3 py-1.5 font-medium">@row.Player</td>
                        <td class="px-3 py-1.5">@OrderLabel(row.Type)</td>
                        @* TODO(unit-names): map blueprint ids to unit names via a static lookup. *@
                        <td class="px-3 py-1">
                            <span class="flex items-center gap-2">
                                <UnitIcon BlueprintId="@row.BlueprintId" />
                                <span class="font-mono">@row.BlueprintId</span>
                            </span>
                        </td>
                        <td class="px-3 py-1.5 text-right font-mono">@row.UnitCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="mt-2 text-xs text-ink-faint">
        @(Entries.Count > MaxRows ? $"Showing the first {MaxRows} of {Entries.Count:N0} construction orders — narrow the window or the filters." : $"{Entries.Count:N0} construction orders.")
    </p>
}

@code {
    private const int MaxRows = 250;

    [Parameter, EditorRequired] public required Replay Replay { get; set; }

    /// <summary>The players to show, in display order.</summary>
    [Parameter, EditorRequired] public required IReadOnlyList<int> SelectedSourceIds { get; set; }

    [Parameter] public TimeSpan? From { get; set; }

    [Parameter] public TimeSpan? To { get; set; }

    private sealed record Row(TimeSpan Timestamp, string Player, CommandType Type, string BlueprintId, int UnitCount);

    private List<Row> Entries { get; set; } = [];

    protected override void OnParametersSet()
    {
        List<Row> rows = [];
        foreach (int sourceId in SelectedSourceIds)
        {
            string player = sourceId >= 0 && sourceId < Replay.Header.Clients.Length
                ? Replay.Header.Clients[sourceId].PlayerName
                : $"Source {sourceId}";
            foreach (ReplayAnalysis.BuildOrderEntry entry in ReplayAnalysis.GetBuildOrder(Replay, sourceId))
            {
                if ((From is not { } from || entry.Timestamp >= from) && (To is not { } to || entry.Timestamp <= to))
                {
                    rows.Add(new Row(entry.Timestamp, player, entry.Type, entry.BlueprintId, entry.UnitCount));
                }
            }
        }

        Entries = rows.OrderBy(row => row.Timestamp).ToList();
    }

    private static string OrderLabel(CommandType type) => type switch
    {
        CommandType.IssueBuildFactory => "Build (factory)",
        CommandType.IssueBuildMobile => "Build (engineer)",
        CommandType.IssueUpgrade => "Upgrade",
        CommandType.IssueSiloBuildNuke => "Nuke silo",
        CommandType.IssueSiloBuildTactical => "Tactical silo",
        _ => type.ToString(),
    };
}
