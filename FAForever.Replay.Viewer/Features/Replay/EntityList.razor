@using FAForever.Replay

@* One player's units on the Build order tab (view=units): every entity that received orders
   in the opening, with what it probably is (see ReplayEntityKind; only the commander is
   certain) and its orders on a horizontal time lane with one block per minute. Construction
   orders show as the unit icon at their moment (several of the same unit within a few seconds
   as one icon with a count), other orders as a tick in the colour of their type, and a queue -
   orders shift-queued after each other (ReplayEntity.ContinuesChain) - as a line from the
   first order to the last. Mirrored (the left player) runs the time from right to left, so
   0:00 is against the centre for both players. Clicking a row shows the unit's route on the map. *@

<div class="flex flex-col gap-1">
    @* The time axis stays in view while the lanes scroll (sticky in the panel's scroll box). *@
    <div class="@(Mirrored ? "flex-row-reverse" : "") sticky top-0 z-10 flex items-end gap-3 bg-surface">
        <span class="w-36 shrink-0"></span>
        <div class="flex-1 px-3">
            <div class="relative h-4">
                @for (int minute = 0; minute <= MinuteCount; minute++)
                {
                    <span class="absolute font-mono text-[10px] text-ink-muted @AxisAlign(minute * 60)" style="left: @Pct(minute * 60)">@minute:00</span>
                }
            </div>
        </div>
    </div>

    <ol class="m-0 flex list-none flex-col gap-0.5 p-0" aria-label="@($"Units of {Player}")">
        @if (lanes.Count == 0)
        {
            <li class="px-2 py-3 text-sm text-ink-muted">No units received orders.</li>
        }
        @foreach (Lane lane in lanes)
        {
            ReplayEntity entity = lane.Entity;
            bool isSelected = Selected == entity.EntityId;
            <li @key="entity.EntityId">
                <button type="button" aria-pressed="@(isSelected ? "true" : "false")"
                        class="@(Mirrored ? "flex-row-reverse" : "") flex w-full cursor-pointer items-center gap-3 rounded-md px-1 py-0.5 text-left transition hover:bg-raised @(isSelected ? "bg-raised ring-1 ring-primary" : "")"
                        title="@($"{Label(entity)} — entity 0x{entity.EntityId:X8}, {entity.Orders.Count} orders — click to show its route")"
                        @onclick="() => OnSelect.InvokeAsync(entity)"
                        @onmouseenter="() => OnHover.InvokeAsync(entity.EntityId)" @onmouseleave="() => OnHover.InvokeAsync(null)">
                    <span class="@(Mirrored ? "flex-row-reverse text-right" : "") flex w-36 shrink-0 items-baseline gap-2">
                        <span class="truncate text-xs @(entity.Kind == ReplayEntityKind.Commander ? "font-semibold text-ink" : "text-ink-muted")">@Label(entity)</span>
                        <span class="font-mono text-[10px] text-ink-faint">#@entity.Serial</span>
                    </span>
                    <span class="minute-lane @(Mirrored ? "minute-lane-mirrored" : "") block h-6 flex-1 rounded">
                        <span class="relative block h-full">
                            @foreach ((double From, double To) queue in lane.Queues)
                            {
                                <span class="absolute top-1/2 h-0.5 -translate-y-1/2 opacity-60"
                                      style="left: @Pct(Mirrored ? queue.To : queue.From); width: @Width(queue.To - queue.From); background: @(Color ?? "var(--th-ink-muted)")"></span>
                            }
                            @foreach (Tick tick in lane.Ticks)
                            {
                                <span class="absolute top-1 h-4 w-[3px] -translate-x-1/2 rounded-sm" title="@tick.Title"
                                      style="left: @Pct(tick.Seconds); background: @tick.Color"></span>
                            }
                            @foreach (Build build in lane.Builds)
                            {
                                <span class="absolute top-0.5 inline-flex -translate-x-1/2 items-center rounded bg-surface" title="@build.Title"
                                      style="left: @Pct(build.Seconds); box-shadow: 0 0 0 1px @(Color ?? "var(--th-edge)")">
                                    <UnitIcon BlueprintId="@build.BlueprintId" Size="18" />
                                    @if (build.Count > 1)
                                    {
                                        <span class="px-0.5 font-mono text-[9px] text-ink">×@build.Count</span>
                                    }
                                </span>
                            }
                        </span>
                    </span>
                </button>
            </li>
        }
    </ol>
</div>

@code {
    /// <summary>Gaps up to this many seconds merge equal construction orders into one icon.</summary>
    private const double MergeSeconds = 3;

    [Parameter, EditorRequired] public required string Player { get; set; }

    /// <summary>The entities to list, in display order.</summary>
    [Parameter, EditorRequired] public required IReadOnlyList<ReplayEntity> Entities { get; set; }

    /// <summary>The span of the lanes: the opening (shorter when the game was).</summary>
    [Parameter, EditorRequired] public required TimeSpan Span { get; set; }

    /// <summary>The player's in-game colour, for the queues and the frame of construction icons.</summary>
    [Parameter] public string? Color { get; set; }

    [Parameter] public int? Selected { get; set; }

    /// <summary>Time runs from right to left, for the left player: 0:00 against the centre.</summary>
    [Parameter] public bool Mirrored { get; set; }

    [Parameter] public EventCallback<ReplayEntity> OnSelect { get; set; }

    [Parameter] public EventCallback<int?> OnHover { get; set; }

    private sealed record Build(double Seconds, string BlueprintId, int Count, string Title);

    private sealed record Tick(double Seconds, string Color, string Title);

    private sealed record Lane(ReplayEntity Entity, List<Build> Builds, List<Tick> Ticks, List<(double From, double To)> Queues);

    private List<Lane> lanes = [];
    private IReadOnlyList<ReplayEntity>? lanesOf;
    private IReadOnlyList<ReplayEntity>? renderedLanes;
    private int? renderedSelected;
    private bool renderedMirrored;

    private double SpanSeconds => Math.Max(1, Span.TotalSeconds);

    private int MinuteCount => (int)Math.Floor(SpanSeconds / 60);

    /// <summary>
    /// The colour of an order type on the lanes, the same in every theme like the in-game
    /// colours. Construction has no colour: it shows the unit icon.
    /// </summary>
    public static string CategoryColor(CommandCategory category) => category switch
    {
        CommandCategory.Move => "#5b9bff",
        CommandCategory.Reclaim => "#e0b341",
        CommandCategory.Guard => "#9b8cff",
        CommandCategory.Repair => "#4fc29a",
        CommandCategory.Patrol => "#5bc8d6",
        CommandCategory.Attack => "#ff6b6b",
        CommandCategory.Aggressive => "#ff9f5a",
        _ => "#93a0bd",
    };

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(lanesOf, Entities))
        {
            lanesOf = Entities;
            lanes = Entities.Select(ToLane).ToList();
        }
    }

    /// <summary>Hovering re-renders the panel; the lanes only change with their own inputs.</summary>
    protected override bool ShouldRender()
    {
        bool changed = !ReferenceEquals(lanesOf, renderedLanes) || Selected != renderedSelected || Mirrored != renderedMirrored;
        renderedLanes = lanesOf;
        renderedSelected = Selected;
        renderedMirrored = Mirrored;
        return changed;
    }

    private static Lane ToLane(ReplayEntity entity)
    {
        List<Build> builds = [];
        List<Tick> ticks = [];
        List<(double From, double To)> queues = [];
        double? queueStart = null;

        for (int index = 0; index < entity.Orders.Count; index++)
        {
            ReplayEntityOrder order = entity.Orders[index];
            double seconds = order.Timestamp.TotalSeconds;

            // A queue runs from the first order of a chain to its last.
            if (entity.ContinuesChain(index))
            {
                queueStart ??= entity.Orders[index - 1].Timestamp.TotalSeconds;
            }
            else if (queueStart is { } start)
            {
                queues.Add((start, entity.Orders[index - 1].Timestamp.TotalSeconds));
                queueStart = null;
            }

            CommandCategory category = CommandCategories.GetCategory(order.CommandType);
            string verb = ReplayInputFormatter.Verb(order.CommandType);
            if (category == CommandCategory.Build && order.BlueprintId is { } blueprintId)
            {
                if (builds.Count > 0 && builds[^1].BlueprintId == blueprintId && seconds - builds[^1].Seconds <= MergeSeconds)
                {
                    builds[^1] = builds[^1] with { Count = builds[^1].Count + 1 };
                }
                else
                {
                    builds.Add(new Build(seconds, blueprintId, 1, $"{GameTime.Format(order.Timestamp)} · {verb} {UnitNames.GetOrNull(blueprintId) ?? blueprintId}"));
                }
            }
            else
            {
                ticks.Add(new Tick(seconds, CategoryColor(category), $"{GameTime.Format(order.Timestamp)} · {verb}{(order.FromFactory ? " (factory order)" : "")}"));
            }
        }

        if (queueStart is { } last)
        {
            queues.Add((last, entity.Orders[^1].Timestamp.TotalSeconds));
        }

        return new Lane(entity, builds, ticks, queues.Where(queue => queue.To > queue.From).ToList());
    }

    /// <summary>The horizontal position of a moment on the lane, mirrored when the time runs leftwards.</summary>
    private string Pct(double seconds)
    {
        double share = Math.Clamp(seconds / SpanSeconds, 0, 1);
        return Percent(Mirrored ? 1 - share : share);
    }

    /// <summary>Axis labels centre on their minute, except at the ends, where they stay inside.</summary>
    private string AxisAlign(double seconds)
    {
        double share = Math.Clamp(seconds / SpanSeconds, 0, 1);
        double position = Mirrored ? 1 - share : share;
        return position <= 0 ? "" : position >= 1 ? "-translate-x-full" : "-translate-x-1/2";
    }

    private string Width(double seconds) => Percent(Math.Clamp(seconds / SpanSeconds, 0, 1));

    private static string Percent(double share) => $"{(share * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";

    /// <summary>
    /// What an entity is, as a label: "ACU" is certain, the rest are guesses (prefixed with ~).
    /// A factory is named after what it built, a structure after its upgrade.
    /// </summary>
    public static string Label(ReplayEntity entity) => entity.Kind switch
    {
        ReplayEntityKind.Commander => "ACU",
        ReplayEntityKind.Engineer => "~Engineer",
        ReplayEntityKind.Factory => FactoryLabel(entity),
        ReplayEntityKind.Structure => entity.Orders.FirstOrDefault(order => order.BlueprintId is not null)?.BlueprintId is { } upgrade
            ? $"~{UnitNames.GetOrNull(upgrade) ?? "Structure"}"
            : "~Structure",
        _ => "~Unit",
    };

    /// <summary>A factory by the layer of the units it built: the third letter of their blueprint ids (l, a, s).</summary>
    private static string FactoryLabel(ReplayEntity entity)
    {
        char? layer = entity.Orders
            .Where(order => order.CommandType == CommandType.IssueBuildFactory && order.BlueprintId is { Length: > 3 })
            .Select(order => (char?)char.ToLowerInvariant(order.BlueprintId![2]))
            .FirstOrDefault(letter => letter is 'l' or 'a' or 's');
        return layer switch
        {
            'l' => "~Land factory",
            'a' => "~Air factory",
            's' => "~Naval factory",
            _ => "~Factory",
        };
    }
}
