@inherits UrlStateComponent

@* Checkbox list backed by the shared "players" query parameter (absent = everyone
   selected). Parents derive the same selection with SelectedFrom. *@

<div role="group" aria-label="Players">
    @foreach ((string name, int count, string? color) in Items)
    {
        bool isSelected = selected.Contains(name);
        <label class="@(isSelected ? SelectedClass : UnselectedClass)">
            <input type="checkbox" class="accent-primary" checked="@isSelected"
                   @onchange="() => Toggle(name)" />
            <span class="h-3.5 w-1 shrink-0 rounded-full" style="background: @(color ?? "transparent")" aria-hidden="true"></span>
            <span class="truncate text-sm">@name</span>
            <span class="badge ml-auto shrink-0">@count.ToString("N0")</span>
        </label>
    }
</div>

@code {
    private const string QueryParameter = "players";
    private const string UnselectedClass = "flex w-full cursor-pointer items-center gap-2 rounded-md px-3 py-1.5 text-ink-muted transition hover:bg-raised hover:text-ink";
    private const string SelectedClass = "flex w-full cursor-pointer items-center gap-2 rounded-md px-3 py-1.5 font-medium text-ink transition hover:bg-raised";

    [Parameter, EditorRequired] public required IReadOnlyList<(string Name, int Count, string? Color)> Items { get; set; }

    private HashSet<string> selected = [];

    protected override void OnParametersSet()
        => selected = SelectedFrom(Navigation, Items.Select(item => item.Name));

    /// <summary>
    /// The selection according to the URL: the listed names intersected with the parameter,
    /// or all of them when the parameter is absent. Unknown names are ignored.
    /// </summary>
    public static HashSet<string> SelectedFrom(NavigationManager navigation, IEnumerable<string> names)
    {
        string? fromQuery = UrlQuery.Get(navigation, QueryParameter);
        return fromQuery is { Length: > 0 }
            ? names.Intersect(fromQuery.Split(','), StringComparer.Ordinal).ToHashSet()
            : names.ToHashSet();
    }

    private void Toggle(string name)
    {
        if (!selected.Remove(name))
        {
            selected.Add(name);
        }

        // Keep the item order so the parameter is stable and shareable.
        string? value = selected.Count == Items.Count
            ? null
            : string.Join(',', Items.Select(item => item.Name).Where(selected.Contains));
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter(QueryParameter, value), replace: true);
    }
}
