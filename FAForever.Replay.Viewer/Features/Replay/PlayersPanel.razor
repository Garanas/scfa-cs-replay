@using FAForever.Replay

<div class="card overflow-x-auto p-0">
    <table class="w-full text-left text-sm">
        <thead>
            <tr class="border-b border-edge text-xs uppercase tracking-wide text-ink-muted">
                <th class="px-4 py-3 font-semibold">Player</th>
                <th class="px-4 py-3 font-semibold">Team</th>
                <th class="px-4 py-3 text-right font-semibold" title="Lobby rating: mean − 3 × deviation">Rating</th>
                <th class="px-4 py-3 text-right font-semibold" title="All input a player issues within a single simulation tick counts as one action">Actions</th>
                <th class="px-4 py-3 text-right font-semibold" title="Raw orders the sim received — drag-building a line of walls counts one order per wall">Orders</th>
                <th class="px-4 py-3 text-right font-semibold" title="Average actions per minute">APM</th>
                <th class="px-4 py-3 text-right font-semibold" title="Construction orders issued">Build orders</th>
            </tr>
        </thead>
        <tbody>
            @foreach (PlayerRow row in Rows)
            {
                <tr class="border-b border-edge/60 last:border-0 hover:bg-raised/50">
                    <td class="px-4 py-3">
                        <span class="flex items-center gap-2">
                            <span class="h-4 w-1 shrink-0 rounded-full" style="background: @(row.Color ?? "transparent")"
                                  title="In-game colour" aria-hidden="true"></span>
                            @if (Factions.IconPath(row.Faction) is { } factionIcon)
                            {
                                <img src="@factionIcon" alt="@Factions.Name(row.Faction)" title="@Factions.Name(row.Faction)"
                                     class="h-5 w-5 shrink-0" loading="lazy" />
                            }
                            else
                            {
                                <span class="inline-block h-2.5 w-2.5 shrink-0 rounded-full" style="background: @Factions.Swatch(row.Faction)"
                                      title="Unknown faction" aria-hidden="true"></span>
                            }
                            <span class="font-medium">@row.Name</span>
                            @if (row.Clan is { Length: > 0 } clan)
                            {
                                <span class="text-xs text-ink-faint">[@clan]</span>
                            }
                            @if (row.Tag is { } tag)
                            {
                                <span class="badge">@tag</span>
                            }
                        </span>
                    </td>
                    <td class="px-4 py-3">@row.Team</td>
                    <td class="px-4 py-3 text-right font-mono">@(row.Rating?.ToString("0") ?? "—")</td>
                    <td class="px-4 py-3 text-right font-mono">@(row.Actions?.ToString("N0") ?? "—")</td>
                    <td class="px-4 py-3 text-right font-mono">@(row.Orders?.ToString("N0") ?? "—")</td>
                    <td class="px-4 py-3 text-right font-mono">@(row.AveragePerMinute?.ToString("0") ?? "—")</td>
                    <td class="px-4 py-3 text-right font-mono">@(row.BuildOrders?.ToString("N0") ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<p class="mt-3 text-xs text-ink-faint">
    All input a player issues within a single simulation tick (100 ms) counts as one action.
    Drag-building a line of walls, for example, would otherwise count as one action for each wall
    in the drag. Factions, teams and ratings come from the lobby options in the replay header.
    Who won is not stored in a replay; that verdict lives in the FAForever API.
</p>

@code {
    [Parameter, EditorRequired] public required LoadedReplay Model { get; set; }

    private sealed record PlayerRow(
        string Name, string? Clan, string? Tag, int? Faction, string? Color,
        string Team, int? Rating, int? Actions, int? Orders, double? AveragePerMinute, int? BuildOrders);

    private List<PlayerRow> Rows { get; set; } = [];

    protected override void OnParametersSet()
    {
        Replay replay = Model.Replay;
        Dictionary<int, int> actions = ReplayAnalysis.CountPlayerActions(replay);
        Dictionary<int, int> orders = ReplayAnalysis.CountPlayerOrders(replay);
        double minutes = Math.Max(ReplayAnalysis.GetDuration(replay).TotalMinutes, 1e-9);

        List<PlayerRow> rows = [];
        HashSet<int> clientsWithArmy = [];

        foreach (ReplayPlayerOptions army in replay.Header.Armies)
        {
            if (army.Civilian == true)
            {
                continue;
            }

            int? actionCount = null;
            int? orderCount = null;
            double? apm = null;
            int? buildOrders = null;
            if (army.SourceId is int sourceId)
            {
                clientsWithArmy.Add(sourceId);
                actionCount = actions.GetValueOrDefault(sourceId);
                orderCount = orders.GetValueOrDefault(sourceId);
                apm = actionCount / minutes;
                buildOrders = ReplayAnalysis.GetBuildOrder(replay, sourceId).Count;
            }

            rows.Add(new PlayerRow(
                army.PlayerName ?? (army.SourceId is int id ? replay.Header.Clients[id].PlayerName : "Unknown"),
                army.Clan,
                army.Human == true ? null : "AI",
                army.Faction,
                army.Color,
                TeamLabel(army),
                army.Rating,
                actionCount,
                orderCount,
                apm,
                buildOrders));
        }

        // Clients without an army are observers (they can chat, but command nothing).
        for (int sourceId = 0; sourceId < replay.Header.Clients.Length; sourceId++)
        {
            if (!clientsWithArmy.Contains(sourceId))
            {
                rows.Add(new PlayerRow(
                    replay.Header.Clients[sourceId].PlayerName, null, "observer",
                    null, null, "—", null, null, null, null, null));
            }
        }

        Rows = rows
            .OrderBy(row => row.Tag == "observer")
            .ThenBy(row => row.Team)
            .ThenByDescending(row => row.Actions ?? -1)
            .ToList();
    }

    private static string TeamLabel(ReplayPlayerOptions army) => army switch
    {
        { DisplayTeam: { } team } => $"Team {team}",
        { Team: 1 } => "FFA",
        _ => "—",
    };

}
