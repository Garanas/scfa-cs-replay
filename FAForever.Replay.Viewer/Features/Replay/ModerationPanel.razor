@using FAForever.Replay
@inherits UrlStateComponent
@inject IJSRuntime JS

@* Everything a moderator reads through (ModerationLog): what the game logs for moderators (pings,
   markers, self-destructs, focus-army changes, messages to the FAF server), plus chat, units given
   away, recall votes, pauses and players leaving. Messages are shown verbatim (they are evidence),
   and each time links to the Events tab: that player's raw input around the moment, for the
   details. It always covers the whole game: the shared time window is ignored, so a window left
   behind by another tab (or by such a link) never hides events. *@

<div class="grid gap-6 lg:grid-cols-[1fr_3fr]">
    <div class="card max-h-[70vh] self-start overflow-y-auto p-2">
        <h3 class="px-3 pb-1 pt-2 text-xs font-semibold uppercase tracking-wide text-ink-muted">Players</h3>
        <PlayerFilterList Items="playerItems" />

        <h3 class="px-3 pb-1 pt-3 text-xs font-semibold uppercase tracking-wide text-ink-muted">Kinds</h3>
        <div role="group" aria-label="Event kinds">
            @foreach ((ModerationKind kind, int count) in kindItems)
            {
                bool isSelected = selectedKinds.Contains(kind);
                <label class="@(isSelected ? SelectedKindClass : KindClass)">
                    <input type="checkbox" class="accent-primary" checked="@isSelected"
                           @onchange="() => ToggleKind(kind)" />
                    <span class="truncate text-xs">@ModerationLog.Label(kind)</span>
                    <span class="badge ml-auto shrink-0">@count.ToString("N0")</span>
                </label>
            }
        </div>

        <h3 class="px-3 pb-1 pt-3 text-xs font-semibold uppercase tracking-wide text-ink-muted">Export</h3>
        <div class="px-3 pb-2">
            <button type="button" class="btn-secondary w-full px-3 py-1.5 text-sm" disabled="@(promptEntries.Count == 0)" @onclick="CopyPrompt">
                @(copied ? "Copied!" : "Copy as AI prompt")
            </button>
            <p class="mt-2 text-xs text-ink-faint">
                @promptEntries.Count.ToString("N0") entries of the selected players &mdash; the kinds shown, plus always their
                chat, pings and drawings &mdash; with instructions and how to link back here, to paste into an AI
                assistant for a first analysis. It contains player names and chat.
            </p>
        </div>
    </div>

    <div class="card max-h-[70vh] self-start overflow-y-auto p-0">
        <table class="w-full text-left text-sm">
            <thead class="sticky top-0 bg-raised text-xs uppercase tracking-wide text-ink-muted">
                <tr>
                    <th class="px-4 py-3 font-semibold">Time</th>
                    <th class="px-4 py-3 font-semibold">Player</th>
                    <th class="px-4 py-3 font-semibold">Kind</th>
                    <th class="w-full px-4 py-3 font-semibold">Message</th>
                </tr>
            </thead>
            <tbody>
                @foreach (ModerationEntry row in visible)
                {
                    <tr class="border-t border-edge/60 align-top hover:bg-raised/50">
                        <td class="px-4 py-1.5 font-mono">
                            <a href="@EventsLink(row)" class="text-ink-muted hover:text-primary hover:underline"
                               title="Show @row.Player's input around this moment on the Events tab">@GameTime.Format(row.Timestamp)</a>
                        </td>
                        <td class="whitespace-nowrap px-4 py-1.5"><PlayerLabel Name="@row.Player" Color="@colorsByName.GetValueOrDefault(row.Player)" /></td>
                        <td class="whitespace-nowrap px-4 py-1.5"><span class="badge">@ModerationLog.Label(row.Kind)</span></td>
                        <td class="@(row.Kind == ModerationKind.Chat ? "text-sm text-ink" : "font-mono text-xs text-ink-muted") px-4 py-1.5">@row.Message</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (rows.Count == 0)
        {
            <p class="px-4 py-3 text-sm text-ink-muted">Nothing for moderators in this replay.</p>
        }
        else if (visible.Count == 0)
        {
            <p class="px-4 py-3 text-sm text-ink-muted">Nothing matches the current filters.</p>
        }
    </div>
</div>

@code {
    private const string KindsParameter = "kinds";
    private const string KindClass = "flex w-full cursor-pointer items-center gap-2 rounded-md px-3 py-1 text-left text-ink-muted transition hover:bg-raised hover:text-ink";
    private const string SelectedKindClass = "flex w-full cursor-pointer items-center gap-2 rounded-md px-3 py-1 text-left font-medium text-ink transition hover:bg-raised";

    [Parameter, EditorRequired] public required LoadedReplay Model { get; set; }

    private LoadedReplay? parsedModel;
    private List<ModerationEntry> rows = [];
    private List<ModerationEntry> visible = [];
    private List<ModerationEntry> promptEntries = [];
    private TimeSpan duration;
    private Dictionary<string, string> colorsByName = [];
    private List<(string Name, int Count, string? Color)> playerItems = [];
    private List<(ModerationKind Kind, int Count)> kindItems = [];
    private HashSet<ModerationKind> selectedKinds = [];
    private bool copied;

    /// <summary>The kinds shown without a <c>kinds</c> parameter: everything in this replay.</summary>
    private IEnumerable<ModerationKind> DefaultKinds => kindItems.Select(item => item.Kind);

    protected override void OnParametersSet()
    {
        Replay replay = Model.Replay;
        if (!ReferenceEquals(parsedModel, Model))
        {
            parsedModel = Model;
            duration = ReplayAnalysis.GetDuration(replay);
            colorsByName = GameColors.ByName(replay.Header);
            rows = ModerationLog.Collect(replay);
            playerItems = rows
                .GroupBy(row => row.Player)
                .OrderByDescending(group => group.Count())
                .Select(group => (group.Key, group.Count(), colorsByName.GetValueOrDefault(group.Key)))
                .ToList();
            kindItems = rows
                .GroupBy(row => row.Kind)
                .OrderBy(group => group.Key)
                .Select(group => (group.Key, group.Count()))
                .ToList();
        }

        HashSet<string> selectedNames = PlayerFilterList.SelectedFrom(Navigation, playerItems.Select(item => item.Name));

        HashSet<string> requested = (UrlQuery.Get(Navigation, KindsParameter) ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        selectedKinds = kindItems.Select(item => item.Kind).Where(kind => requested.Contains(kind.ToString())).ToHashSet();
        if (selectedKinds.Count == 0)
        {
            // No parameter, or only unknown kinds in the link: the default rather than an empty page.
            selectedKinds = DefaultKinds.ToHashSet();
        }

        visible = rows
            .Where(row => selectedNames.Contains(row.Player) && selectedKinds.Contains(row.Kind))
            .ToList();
        promptEntries = rows
            .Where(row => selectedNames.Contains(row.Player) && (selectedKinds.Contains(row.Kind) || ModerationLog.IsCommunication(row.Kind)))
            .ToList();
    }

    private void ToggleKind(ModerationKind kind)
    {
        if (!selectedKinds.Remove(kind))
        {
            selectedKinds.Add(kind);
        }

        string? value = selectedKinds.Count == 0 || selectedKinds.SetEquals(DefaultKinds)
            ? null
            : string.Join(',', kindItems.Select(item => item.Kind).Where(selectedKinds.Contains).Select(item => item.ToString().ToLowerInvariant()));
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter(KindsParameter, value), replace: true);
    }

    /// <summary>Copies the entries as a prompt, and confirms it on the button for a moment.</summary>
    private async Task CopyPrompt()
    {
        string prompt = ModerationLog.BuildPrompt(Model, promptEntries, Navigation.Uri, Navigation.BaseUri);
        if (!await JS.InvokeAsync<bool>("fafReplay.copyText", prompt))
        {
            return;
        }

        copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        copied = false;
    }

    /// <summary>How far before and after the event the Events tab shows: enough to see what led to it.</summary>
    private static readonly TimeSpan EventsMargin = TimeSpan.FromSeconds(15);

    /// <summary>The Events tab, narrowed to this player and a short window around the event.</summary>
    private string EventsLink(ModerationEntry row)
    {
        TimeSpan moment = TimeSpan.FromSeconds(Math.Floor(row.Timestamp.TotalSeconds));
        TimeSpan from = moment > EventsMargin ? moment - EventsMargin : TimeSpan.Zero;
        TimeSpan to = moment + EventsMargin < duration ? moment + EventsMargin : duration;
        return Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["tab"] = "events",
            ["players"] = row.Player,
            ["from"] = GameTime.Format(from),
            ["to"] = GameTime.Format(to),
        });
    }
}
