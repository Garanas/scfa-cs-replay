@using FAForever.Replay

@* The chat message table, shared by the Chat tab and the Analysis tab. The parent
   provides the (filtered) messages and the scroll container. *@

@if (Messages.Count == 0)
{
    <p class="px-4 py-3 text-sm text-ink-muted">No chat messages match the current filters.</p>
}
else
{
    <table class="w-full text-left text-sm">
        <thead class="sticky top-0 bg-raised text-xs uppercase tracking-wide text-ink-muted">
            <tr>
                <th class="px-4 py-3 font-semibold">Time</th>
                <th class="px-4 py-3 font-semibold">From</th>
                <th class="px-4 py-3 font-semibold">To</th>
                <th class="w-full px-4 py-3 font-semibold">Message</th>
            </tr>
        </thead>
        <tbody>
            @foreach (ReplayChatMessage message in Messages)
            {
                <tr class="border-t border-edge/60 align-top hover:bg-raised/50">
                    <td class="px-4 py-2 font-mono text-ink-muted">@GameTime.Format(message.Timestamp)</td>
                    <td class="whitespace-nowrap px-4 py-2 font-medium">@message.Sender</td>
                    <td class="px-4 py-2"><span class="badge">@message.Receiver</span></td>
                    <td class="px-4 py-2">@message.Message</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<ReplayChatMessage> Messages { get; set; }
}
