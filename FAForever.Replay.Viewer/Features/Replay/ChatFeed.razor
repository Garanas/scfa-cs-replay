@using FAForever.Replay

@* The feed of the Chat tab: chat messages, drawings and pings of the current selection,
   oldest on top so a conversation reads top-down. Same rows as the Playthrough feed
   (.feed-row); clicking a row selects it (again to clear), hovering or selecting
   highlights the drawing or ping on the map. *@

<div role="log" aria-label="Chat messages, drawings and pings">
    @if (Items.Count == 0)
    {
        <p class="px-3 py-2 text-xs text-ink-faint">@EmptyText</p>
    }
    @foreach (ChatPanel.Item item in Items)
    {
        <button type="button" @key="item.Key" id="@RowId(item.Key)" aria-pressed="@(Selected == item.Key ? "true" : "false")"
                class="feed-row items-start py-1 @(Selected == item.Key ? "bg-raised ring-1 ring-primary" : "")"
                title="@($"{ChatPanel.FormatTime(item.Timestamp)} · {item.Player}: {ChatPanel.Describe(item)} — click to highlight")"
                @onclick="() => OnSelect.InvokeAsync(item)"
                @onmouseenter="() => OnHover.InvokeAsync(item.Key)" @onmouseleave="() => OnHover.InvokeAsync(null)">
            <span class="feed-time leading-4">@GameTime.Format(item.Timestamp)</span>
            <span class="feed-chip mt-px" style="background: @(item.Color ?? "transparent")" aria-hidden="true"></span>
            <span class="flex h-4 w-4 shrink-0 items-center justify-center text-ink-muted" aria-hidden="true">
                @if (item.Message is not null)
                {
                    <svg viewBox="0 0 10 10" class="h-3.5 w-3.5"><path d="M1.5 2 H8.5 V6.5 H4.5 L2.5 8.5 V6.5 H1.5 Z" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round" /></svg>
                }
                else if (item.Drawing is not null)
                {
                    <svg viewBox="0 0 10 10" class="h-3.5 w-3.5"><path d="M1.5 7 C3 2.5 5 8.5 8.5 3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
                }
                else if (item.Ping is { } ping)
                {
                    <span class="font-semibold">@ChatPanel.PingGlyph(ping.Type)</span>
                }
            </span>
            @if (item.Message is { } message)
            {
                <span class="min-w-0 break-words leading-4 text-ink">
                    <span class="font-semibold">@message.Sender</span><span class="text-ink-faint"> to @message.Receiver:</span>
                    @message.Message
                </span>
            }
            else
            {
                <span class="min-w-0 break-words leading-4 text-ink-muted">
                    <span class="font-semibold text-ink">@item.Player</span> @ChatPanel.Describe(item)
                </span>
            }
        </button>
    }
</div>

@code {
    /// <summary>The visible items, in time order.</summary>
    [Parameter, EditorRequired] public required IReadOnlyList<ChatPanel.Item> Items { get; set; }

    [Parameter] public string EmptyText { get; set; } = "Nothing matches the filters.";

    /// <summary>The key of the selected row, if any.</summary>
    [Parameter] public int? Selected { get; set; }

    [Parameter] public EventCallback<ChatPanel.Item> OnSelect { get; set; }

    /// <summary>The key of the hovered row, or null when the pointer leaves it.</summary>
    [Parameter] public EventCallback<int?> OnHover { get; set; }

    /// <summary>The element id of an item's row, for scrolling it into view.</summary>
    public static string RowId(int key) => $"chat-item-{key}";
}
