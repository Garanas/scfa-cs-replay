@implements IDisposable
@inject IJSRuntime JS

@* A new version of the installed app is ready (js/app.js, registerServiceWorker). It waits for
   the user: switching reloads the page, which would drop a local replay held in memory. *@
@if (updateAvailable)
{
    <div class="border-b border-edge bg-surface" role="status">
        <div class="mx-auto flex w-full @Container flex-wrap items-center justify-between gap-3 px-4 py-2 text-sm sm:px-6">
            <span class="text-ink-muted">A new version of the app is available.</span>
            <span class="flex items-center gap-2">
                <button type="button" class="btn-secondary" @onclick="() => updateAvailable = false">Later</button>
                <button type="button" class="btn-primary" @onclick="ApplyUpdate">Reload</button>
            </span>
        </div>
    </div>
}

@code {
    /// <summary>The max-width class shared with the page (see MainLayout).</summary>
    [Parameter] public string Container { get; set; } = "max-w-6xl";

    private bool updateAvailable;
    private DotNetObjectReference<UpdateBanner>? listener;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            listener = DotNetObjectReference.Create(this);
            if (await JS.InvokeAsync<bool>("fafReplay.onUpdateAvailable", listener))
            {
                OnUpdateAvailable();
            }
        }
    }

    [JSInvokable]
    public void OnUpdateAvailable()
    {
        updateAvailable = true;
        StateHasChanged();
    }

    private async Task ApplyUpdate() => await JS.InvokeVoidAsync("fafReplay.applyUpdate");

    public void Dispose() => listener?.Dispose();
}
