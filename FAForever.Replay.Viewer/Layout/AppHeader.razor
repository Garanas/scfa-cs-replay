<header class="sticky top-0 z-40 border-b border-edge bg-nav/85 backdrop-blur">
    <div class="mx-auto flex h-14 w-full @Container items-center gap-6 px-4 sm:px-6">
        <a href="" class="flex items-center gap-2.5 font-display text-lg font-bold tracking-wide">
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-primary shadow-[0_0_14px_var(--th-glow)]" aria-hidden="true"></span>
            <span>Vault of <span class="text-primary">FAF</span></span>
        </a>

        <nav class="hidden items-center gap-1 sm:flex" aria-label="Main">
            <NavLink href="" Match="NavLinkMatch.All" class="nav-link" ActiveClass="active">Home</NavLink>
            <NavLink href="search" class="nav-link" ActiveClass="active">Search</NavLink>
        </nav>

        <div class="ml-auto flex items-center gap-3">
            @* About sits apart from the main sections, with the settings on the right. *@
            <NavLink href="about" class="nav-link hidden sm:inline-flex" ActiveClass="active">About</NavLink>
            <ModeToggle />
            <FactionSwitcher />
            <UserMenu />
        </div>
    </div>
</header>

@code {
    /// <summary>The max-width class shared with the page (see MainLayout).</summary>
    [Parameter] public string Container { get; set; } = "max-w-6xl";
}
