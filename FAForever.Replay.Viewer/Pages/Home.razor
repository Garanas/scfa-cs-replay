@page "/"
@implements IDisposable
@inject NavigationManager Navigation
@inject ReplayLoadingService Loader
@inject ReplaySessionState Session
@inject IJSRuntime JS

<PageTitle>Vault of FAF</PageTitle>

<section class="py-14 text-center sm:py-20">
    <h1 class="mx-auto max-w-2xl text-4xl font-extrabold tracking-tight sm:text-5xl">
        Explore <span class="text-primary">FAForever</span> replays
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-ink-muted">
        Search the vault, replay the build orders and analyse every command, straight from your browser.
    </p>
</section>

<section class="mx-auto grid max-w-3xl gap-6 sm:grid-cols-2">
    <div class="card">
        <h2 class="text-lg font-bold">From the vault</h2>
        <p class="mt-1 text-sm text-ink-muted">Paste a replay ID or link, e.g. <span class="font-mono text-ink">25692731</span>.</p>
        <form class="mt-4 flex gap-2" @onsubmit="OpenVaultReplay" @onsubmit:preventDefault>
            <input @ref="vaultReplayInput" class="input-field font-mono" placeholder="Replay ID" inputmode="numeric"
                   @bind="vaultReplayId" @bind:event="oninput" @bind:after="ExtractReplayIdFromLink" disabled="@IsLoading" />
            <button type="submit" class="btn-primary" disabled="@(!CanOpenVaultReplay)">Open</button>
        </form>
    </div>

    <div class="card">
        <h2 class="text-lg font-bold">From a file</h2>
        <p class="mt-1 text-sm text-ink-muted">A <span class="font-mono text-ink">.fafreplay</span> or <span class="font-mono text-ink">.scfareplay</span> file.</p>
        <div class="relative mt-4 flex min-h-20 cursor-pointer items-center justify-center rounded-md border-2 border-dashed border-edge px-4 text-sm text-ink-muted transition hover:border-primary hover:text-ink">
            <InputFile OnChange="OnFileSelected" accept=".fafreplay,.scfareplay" disabled="@IsLoading"
                       class="absolute inset-0 cursor-pointer opacity-0" title="" />
            <span>Choose a replay file, or drop one here</span>
        </div>
    </div>
</section>

<section class="mx-auto mt-6 max-w-3xl" aria-live="polite">
    @if (IsLoading)
    {
        <LoadProgress Progress="progress" OnCancel="CancelLoad" />
    }
    @if (error is not null)
    {
        <div class="card border-primary/50" role="alert">
            <p class="font-semibold">Could not load the replay</p>
            <p class="mt-1 text-sm text-ink-muted">@error</p>
        </div>
    }
</section>

@code {
    // Generous cap: the largest known .scfareplay files are tens of MB.
    private const long MaxReplayFileBytes = 256L * 1024 * 1024;

    private string vaultReplayId = string.Empty;
    private ElementReference vaultReplayInput;
    private string? error;
    private ReplayLoadProgress? progress;
    private CancellationTokenSource? loadCancellation;
    private DotNetObjectReference<Home>? launchListener;

    private bool IsLoading => loadCancellation is not null;

    private bool CanOpenVaultReplay => !IsLoading && NormalizeReplayId() is not null;

    private void OpenVaultReplay()
    {
        if (NormalizeReplayId() is int replayId)
        {
            Navigation.NavigateTo($"replay/{replayId}");
        }
    }

    // The FAF client copies a replay as a link (https://replay.faforever.com/25692731); keep just the id.
    private void ExtractReplayIdFromLink()
    {
        if (TryParseFafReplayLink(vaultReplayId.Trim(), out int replayId))
        {
            vaultReplayId = replayId.ToString(System.Globalization.CultureInfo.InvariantCulture);
        }
    }

    private static bool TryParseFafReplayLink(string candidate, out int replayId)
    {
        replayId = 0;
        return Uri.TryCreate(candidate, UriKind.Absolute, out Uri? link)
            && link.Host.Equals("replay.faforever.com", StringComparison.OrdinalIgnoreCase)
            && int.TryParse(link.AbsolutePath.Trim('/'), out replayId) && replayId > 0;
    }

    protected override void OnInitialized()
    {
        // Web Share Target (manifest.webmanifest): sharing to the installed app opens it here with
        // the shared title, text and url. Apps put a link in any of them, often amid other text.
        string[] shared = new[] { "url", "text", "title" }
            .Select(name => UrlQuery.Get(Navigation, name))
            .OfType<string>()
            .Where(value => value.Length > 0)
            .ToArray();
        if (shared.Length > 0)
        {
            OpenSharedLink(shared);
        }
    }

    /// <summary>
    /// Opens what was shared: a link into this app as is (it carries its view), a FAF replay link or
    /// a bare replay id as that replay. Anything else lands in the replay input, to be fixed by hand.
    /// </summary>
    private void OpenSharedLink(string[] shared)
    {
        foreach (string value in shared)
        {
            string[] words = value.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries);
            foreach (string word in words)
            {
                if (word.StartsWith(Navigation.BaseUri, StringComparison.OrdinalIgnoreCase))
                {
                    Navigation.NavigateTo(word, replace: true);
                    return;
                }

                // A number only counts as an id when it is all that was shared, not "3 replays".
                if (TryParseFafReplayLink(word, out int replayId)
                    || words.Length == 1 && int.TryParse(word.TrimStart('#'), out replayId) && replayId > 0)
                {
                    Navigation.NavigateTo($"replay/{replayId}", replace: true);
                    return;
                }
            }
        }

        vaultReplayId = shared[0];
        Navigation.NavigateTo("", replace: true);
    }

    private int? NormalizeReplayId()
    {
        string candidate = vaultReplayId.Trim().TrimStart('#');
        return int.TryParse(candidate, out int replayId) && replayId > 0 ? replayId : null;
    }

    private Task OnFileSelected(InputFileChangeEventArgs args)
    {
        IBrowserFile file = args.File;
        return LoadFileAsync(file.Name, cancellationToken => Task.FromResult(file.OpenReadStream(MaxReplayFileBytes, cancellationToken)));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Ready to paste a replay id or link right away.
            await vaultReplayInput.FocusAsync();

            // The installed app opens .fafreplay and .scfareplay files ("Open with"); see js/app.js.
            launchListener = DotNetObjectReference.Create(this);
            if (await JS.InvokeAsync<bool>("fafReplay.onFileLaunched", launchListener))
            {
                await OnFileLaunched();
            }
        }
    }

    [JSInvokable]
    public async Task OnFileLaunched()
    {
        if (IsLoading || await JS.InvokeAsync<string?>("fafReplay.takeLaunchedFileName") is not string fileName)
        {
            return;
        }

        await using IJSStreamReference content = await JS.InvokeAsync<IJSStreamReference>("fafReplay.takeLaunchedFileContent");
        await LoadFileAsync(fileName, async cancellationToken => await content.OpenReadStreamAsync(MaxReplayFileBytes, cancellationToken));
        StateHasChanged();
    }

    private async Task LoadFileAsync(string fileName, Func<CancellationToken, Task<Stream>> openRead)
    {
        error = null;

        if (ReplayFormats.FromFileName(fileName) is not ReplayFormat format)
        {
            error = $"'{fileName}' is not a .fafreplay or .scfareplay file.";
            return;
        }

        using CancellationTokenSource cancellation = new();
        loadCancellation = cancellation;
        try
        {
            progress = new ReplayLoadProgress("Reading file", null);
            StateHasChanged();

            using MemoryStream buffer = new();
            await using (Stream source = await openRead(cancellation.Token))
            {
                await source.CopyToAsync(buffer, cancellation.Token);
            }
            buffer.Position = 0;

            ReplayLoadResult result = await Loader.LoadAsync(buffer, format, new Progress<ReplayLoadProgress>(OnProgress), cancellation.Token);
            switch (result)
            {
                case ReplayLoadResult.Success success:
                    Session.Set(new LoadedReplay(success.Replay, success.Metadata, new ReplayOrigin.LocalFile(fileName)));
                    Navigation.NavigateTo("replay/local");
                    break;
                case ReplayLoadResult.Failure failure:
                    error = failure.Message;
                    break;
            }
        }
        catch (OperationCanceledException)
        {
            // The user cancelled; nothing to report.
        }
        catch (Exception exception)
        {
            error = $"Could not read the file: {exception.Message}";
        }
        finally
        {
            loadCancellation = null;
            progress = null;
        }
    }

    private void OnProgress(ReplayLoadProgress update)
    {
        progress = update;
        StateHasChanged();
    }

    private void CancelLoad() => loadCancellation?.Cancel();

    public void Dispose()
    {
        loadCancellation?.Cancel();
        if (launchListener is not null)
        {
            _ = JS.InvokeVoidAsync("fafReplay.offFileLaunched").AsTask().ContinueWith(_ => launchListener.Dispose());
        }
    }
}
